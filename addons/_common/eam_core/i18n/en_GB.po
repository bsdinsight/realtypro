#. module: eam_core
#: model_terms:ir.ui.view,arch_db:eam_core.view_eam_outage_form
msgid ""
"Cùng vị trí, cùng lúc, có khoảng dừng loại khác.\n"
"                        <b>Không phải lỗi</b> — một máy có thể vừa hỏng vừa\n"
"                        bị cắt giảm. Nhưng phải có người phân xử giờ đó\n"
"                        tính vào loại nào, không để máy tự chọn."
msgstr ""
"Same location, same moment, an outage of another category.\n"
"                        <b>Not an error</b> — a machine can be faulty and curtailed\n"
"                        at once. But a person has to arbitrate which category those\n"
"                        hours count against; do not let the machine choose."

#. module: eam_core
#: model:ir.model.fields,help:eam_core.field_eam_outage__has_overlap
