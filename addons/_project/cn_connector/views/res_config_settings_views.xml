<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cn" model="ir.ui.view">
        <field name="name">res.config.settings.form.cn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Construction Network" name="cn_connector"
                     logo="/base/static/img/config_settings.png">
                    <block title="Kết nối Construction Network"
                           name="cn_connector_block">
                        <setting string="Hub URL"
                                 help="Vd https://cnhub.realtypro.vn">
                            <field name="cn_hub_url"/>
                        </setting>
                        <setting string="API Key"
                                 help="Khớp cn_hub.api_key trên Hub">
                            <field name="cn_hub_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
