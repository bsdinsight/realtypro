<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_re_party" model="ir.ui.view">
        <field name="name">res.partner.form.re.party</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Realty Identity" name="realty_identity">
                    <group>
                        <group string="Vietnam Identity">
                            <field name="vn_national_id"
                                   placeholder="9 digits (CMND) or 12 digits (CCCD)"/>
                            <field name="vn_national_id_issue_date"/>
                            <field name="vn_national_id_issue_place"/>
                            <field name="passport_number"/>
                        </group>
                        <group string="Legal / Contact">
                            <field name="vn_tax_code"
                                   placeholder="0123456789 or 0123456789-001"/>
                            <field name="phone_secondary"/>
                        </group>
                        <!-- Lối thoát cho trường hợp trùng có chủ ý. Không
                             có nó thì ràng buộc mã số thuế là cấm tuyệt
                             đối, và người dùng sẽ gõ sai mã số thuế để lách
                             — phá đúng cái khoá mà ràng buộc muốn giữ. -->
                        <group string="Duplicate handling">
                            <field name="identity_dup_ack"/>
                            <field name="identity_dup_reason"
                                   invisible="not identity_dup_ack"
                                   required="identity_dup_ack"
                                   placeholder="Vì sao vẫn giữ bản ghi trùng này"/>
                        </group>
                    </group>
                    <group string="Permanent Address (Thường trú)">
                        <field name="vn_permanent_address" nolabel="1"
                               placeholder="Nơi thường trú theo CCCD/CMND. Ví dụ: Số 123 đường Nguyễn Văn A, Phường X, TP Hà Nội."/>
                    </group>
                    <group string="Roles in RealtyPro">
                        <group>
                            <field name="is_re_customer"/>
                            <field name="is_re_resident"/>
                            <field name="is_re_broker"/>
                            <field name="is_bank"/>
                        </group>
                        <group>
                            <field name="is_re_vendor"/>
                            <field name="is_re_contractor"/>
                            <field name="is_re_distributor"/>
                        </group>
                    </group>
                    <group string="Corporate Group (Tập đoàn)"
                           invisible="not is_company">
                        <field name="parent_company_id"/>
                        <field name="subsidiary_ids" nolabel="1" readonly="1"
                               invisible="not subsidiary_ids"/>
                    </group>
                    <separator string="Family / Personal Relationships"/>
                    <field name="relationship_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="related_partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="relationship_type"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
