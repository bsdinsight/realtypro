<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rp_schedule.RpGantt">
        <div class="rp-gantt-container o_action_manager">
            <div class="rp-gantt-toolbar">
                <span class="rp-gantt-title" t-esc="state.title"/>
                <span class="badge text-bg-secondary ms-2">
                    <t t-esc="state.count"/> công việc
                </span>
                <div class="btn-group btn-group-sm ms-auto" role="group">
                    <button t-foreach="['Day','Week','Month']" t-as="m" t-key="m"
                            type="button" class="btn"
                            t-att-class="state.viewMode === m ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setViewMode(m)">
                        <t t-if="m === 'Day'">Ngày</t>
                        <t t-elif="m === 'Week'">Tuần</t>
                        <t t-else="">Tháng</t>
                    </button>
                </div>
            </div>

            <div t-if="state.empty" class="alert alert-info m-3">
                Hợp đồng này chưa có công việc nào có ngày bắt đầu để vẽ Gantt.
                Hãy import lịch thi công (MS Project XML / Excel) hoặc khai ngày kế hoạch.
            </div>

            <!-- Thân: lưới task trái (sticky) + timeline phải, chung 1 vùng cuộn -->
            <div class="rp-gantt-body" t-att-class="state.empty ? 'd-none' : ''">
                <div class="rp-gantt-left"
                     t-attf-style="width: {{state.leftW}}px;">
                    <div class="rp-gantt-left-head"
                         t-attf-style="height: {{state.headH}}px;">
                        <span class="col-wbs">WBS</span>
                        <span class="col-name">Công việc</span>
                        <span class="col-date">Bắt đầu</span>
                        <span class="col-date">Kết thúc</span>
                        <span class="col-pct">%</span>
                    </div>
                    <div t-foreach="state.rows" t-as="r" t-key="r.id"
                         class="rp-gantt-left-row"
                         t-att-class="(r.milestone ? 'is-milestone ' : '') + (r.nodate ? 'is-nodate ' : '') + (r.parent ? 'is-parent' : '')"
                         t-attf-style="height: {{state.rowH}}px;">
                        <span class="col-wbs" t-esc="r.wbs"/>
                        <span class="col-name" t-att-title="r.name"
                              t-attf-style="padding-left: {{r.level * 16}}px;">
                            <i t-if="r.parent"
                               class="rp-caret fa me-1"
                               t-att-class="r.open ? 'fa-caret-down' : 'fa-caret-right'"
                               t-on-click.stop="() => this.toggleRow(r)"/>
                            <i t-elif="r.milestone" class="fa fa-diamond me-1 text-warning"/>
                            <t t-esc="r.name"/>
                        </span>
                        <span class="col-date" t-esc="r.start"/>
                        <span class="col-date" t-esc="r.end"/>
                        <span class="col-pct" t-esc="r.progress + '%'"/>
                    </div>
                </div>
                <div class="rp-gantt-splitter"
                     t-attf-style="left: {{state.leftW}}px;"
                     t-on-pointerdown="onSplitterDown"/>
                <div class="rp-gantt-right">
                    <!-- Header timeline HTML sticky (thay header SVG):
                         margin-bottom âm = không chiếm flow → SVG không bị
                         đẩy xuống, hàng 2 bên vẫn khớp pixel -->
                    <div class="rp-gantt-timeline-head"
                         t-attf-style="height: {{state.headH}}px; margin-bottom: -{{state.headH}}px; width: {{state.tl.width}}px;">
                        <t t-foreach="state.tl.cells" t-as="c" t-key="c_index">
                            <span t-if="c.upper" class="rp-tl-upper"
                                  t-attf-style="left: {{c.x + 4}}px;"
                                  t-esc="c.upper"/>
                            <span class="rp-tl-lower"
                                  t-attf-style="left: {{c.x}}px; width: {{state.tl.col}}px;"
                                  t-esc="c.lower"/>
                        </t>
                    </div>
                    <svg t-ref="gantt" class="rp-gantt-svg"/>
                </div>
            </div>
        </div>
    </t>

</templates>
