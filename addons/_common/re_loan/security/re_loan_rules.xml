<?xml version="1.0" encoding="utf-8"?>
<!--
    Multi-company record rules for Realty Loan.

    Each loan-related model carries a `company_id` field, so the standard
    Odoo multi-company pattern applies: filter rows by the user's
    `company_ids` (the set of companies the session is currently allowed
    to see, which is the user's allowed_company_ids intersected with the
    company switcher).

    Rules are `global="True"` — they apply to ALL users, including users
    in `group_loan_manager`. This is intentional: a manager scoped to
    Company A should not see Company B's HĐ tín dụng / khế ước / lãi /
    thế chấp. The Odoo super user (`base.group_system`) implicitly
    bypasses ir.rule, so the system admin still has cross-company access.

    `re.loan.collateral.type` is reference data (collateral classifications
    like real-estate, securities, equipment), shared across companies, so
    no rule is defined for it.

    Pattern: ('company_id', 'in', company_ids) — supports users with
    multiple allowed companies switching via the topbar widget.
-->
<odoo>

    <record id="rule_re_loan_credit_contract_company" model="ir.rule">
        <field name="name">re.loan.credit.contract: multi-company</field>
        <field name="model_id" ref="model_re_loan_credit_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_re_loan_facility_company" model="ir.rule">
        <field name="name">re.loan.facility: multi-company</field>
        <field name="model_id" ref="model_re_loan_facility"/>
