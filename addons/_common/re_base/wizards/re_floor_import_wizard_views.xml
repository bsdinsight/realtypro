<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_floor_import_wizard_form" model="ir.ui.view">
        <field name="name">re.floor.import.wizard.form</field>
        <field name="model">re.floor.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Floors">
                <sheet>
                    <group invisible="state == 'done'">
                        <field name="project_id"/>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="update_existing"/>
                    </group>
                    <group invisible="state != 'done'">
                        <group>
                            <field name="success_count"/>
                            <field name="error_count"/>
                            <field name="skipped_count"/>
                        </group>
                    </group>
                    <separator string="Log" invisible="state != 'done'"/>
                    <field name="log_text" widget="text" nolabel="1" readonly="1"
                           invisible="state != 'done'"/>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_download_template" string="Download Template" type="object"
                            class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_import" string="Import" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_re_floor_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Floors</field>
        <field name="res_model">re.floor.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
