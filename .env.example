# Realty Project Community — environment configuration.
#
# Copy this file to .env (gitignored) and fill in real values.
# NEVER paste secrets into chat, commits, or PR descriptions.
#
# Required on first boot:
#   - POSTGRES_PASSWORD: must be set BEFORE the first `docker compose
#     up -d db`. Postgres only applies the password during data-dir
#     initialization; later changes require ALTER USER inside psql.
#   - TUNNEL_TOKEN: required only if running the `cloudflared` profile.
#     Get it from Cloudflare Zero Trust → Tunnels → <your tunnel> →
#     Install connector → Docker (the docker run command embeds it).

# -- Postgres ---------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD

# -- Cloudflare Tunnel (optional) ------------------------------------
# Leave empty if not using Cloudflare. Required to run
# `docker compose --profile tunnel up -d cloudflared`.
TUNNEL_TOKEN=

# -- Laptop dev (consumed by compose.override.yml only) --------------
# Override port mappings if 8169 / 5432 / 8072 conflict with another
# stack on your laptop. Ignored on VPS (compose.override.yml is
# gitignored and not present there).
HTTP_PORT=8169
LONGPOLLING_PORT=8072
DB_PORT=5432
