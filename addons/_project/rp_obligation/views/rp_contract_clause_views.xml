<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_contract_clause_list" model="ir.ui.view">
        <field name="name">rp.contract.clause.list</field>
        <field name="model">rp.contract.clause</field>
        <field name="arch" type="xml">
            <list string="Điều khoản hợp đồng"
                  decoration-muted="not is_current"
                  decoration-info="source == 'may'">
                <field name="sequence" widget="handle"/>
                <field name="contract_id" optional="hide"/>
                <field name="number"/>
                <field name="name"/>
                <field name="page"/>
                <field name="notice_days" string="Số ngày quy định"/>
                <field name="amendment_id" string="Theo phụ lục"
                       optional="show"/>
                <field name="is_current" string="Hiện hành" optional="show"/>
                <field name="obligation_count" string="Nghĩa vụ"
                       optional="show"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'may'"
                       decoration-success="source == 'xac_nhan'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_contract_clause_form" model="ir.ui.view">
        <field name="name">rp.contract.clause.form</field>
        <field name="model">rp.contract.clause</field>
        <field name="arch" type="xml">
            <form string="Điều khoản hợp đồng">
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="source != 'may'">
                        <i class="fa fa-robot me-1"/>
                        Điều khoản này do <b>máy trích</b> và
                        <b>chưa có người xác nhận</b>. Đối chiếu với bản
                        giấy trước khi dùng để tính hạn hay trích vào thư
                        — một điều khoản sai mà trông như đã kiểm thì
                        nguy hơn là không có.
                    </div>
                    <div class="alert alert-secondary" role="alert"
                         invisible="is_current">
                        <i class="fa fa-history me-1"/>
                        Bản này <b>đã bị thay thế</b>. Giữ lại để tra cứu
                        hiệu lực tại thời điểm ký, không dùng để tính hạn.
                    </div>

                    <div class="oe_title">
                        <label for="number" string="Điều"/>
                        <h1><field name="number" placeholder="13.3"/></h1>
                        <h2><field name="name"
                                   placeholder="Tiêu đề điều khoản"/></h2>
                    </div>

                    <group>
                        <group string="Thuộc về">
                            <field name="contract_id"
                                   options="{'no_create': True}"/>
                            <field name="project_id" readonly="1"/>
                            <field name="amendment_id"
                                   domain="[('contract_id', '=', contract_id)]"
                                   options="{'no_create_edit': True}"/>
                            <field name="date_effective" readonly="1"/>
                        </group>
                        <group string="Neo vào bản giấy">
                            <field name="page"/>
                            <field name="notice_days"/>
                            <field name="source"/>
                            <field name="confidence"
                                   invisible="source == 'nguoi'"/>
                        </group>
                    </group>

                    <group string="Phiên bản">
                        <field name="replaces_id"
                               domain="[('contract_id', '=', contract_id),
                                        ('id', '!=', id)]"
                               options="{'no_create': True}"/>
                        <field name="is_current" readonly="1"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>

                    <notebook>
                        <page string="Nghĩa vụ điều này đặt ra" name="mo_ta">
                            <div class="alert alert-secondary" role="alert">
                                <i class="fa fa-lightbulb-o me-1"/>
                                Đây là cách <b>ta hiểu</b> điều khoản, nói
                                bằng lời của ta. Khi tranh chấp thì chỉ ô
                                <b>Trích đoạn nguyên văn</b> bên cạnh mới
                                có giá trị — giữ riêng hai thứ.
                            </div>
                            <field name="mo_ta" nolabel="1"/>
                        </page>
                        <page string="Trích đoạn nguyên văn" name="text">
                            <field name="text" nolabel="1"
                                   placeholder="Chép nguyên văn từ hợp đồng — không diễn giải."/>
                        </page>
                        <page string="Nghĩa vụ phát sinh" name="obligations">
                            <field name="obligation_ids" nolabel="1"
                                   readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="ben"/>
                                    <field name="han"/>
                                    <field name="trang_thai" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_contract_clause_search" model="ir.ui.view">
        <field name="name">rp.contract.clause.search</field>
        <field name="model">rp.contract.clause</field>
        <field name="arch" type="xml">
            <search string="Điều khoản hợp đồng">
                <field name="number"/>
                <field name="name"/>
                <field name="text"/>
                <field name="contract_id"/>
                <filter name="f_hien_hanh" string="Bản hiện hành"
                        domain="[('is_current', '=', True)]"/>
                <filter name="f_cho_xac_nhan" string="Máy trích — chờ xác nhận"
                        domain="[('source', '=', 'may')]"/>
                <filter name="f_co_han" string="Có quy định thời hạn"
                        domain="[('notice_days', '>', 0)]"/>
                <separator/>
                <filter name="group_contract" string="Hợp đồng"
                        context="{'group_by': 'contract_id'}"/>
                <filter name="group_amendment" string="Bản ký"
                        context="{'group_by': 'amendment_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_contract_clause" model="ir.actions.act_window">
        <field name="name">Điều khoản hợp đồng</field>
        <field name="res_model">rp.contract.clause</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_hien_hanh': 1,
                               'search_default_group_contract': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa khai điều khoản nào</p>
            <p>Khai số điều, trang và trích đoạn để mọi nghĩa vụ neo được
               vào đúng chỗ trong bản giấy — và để các đồng hồ hạn đọc số
               ngày từ chính hợp đồng thay vì mặc định của phần mềm.</p>
        </field>
    </record>

</odoo>
