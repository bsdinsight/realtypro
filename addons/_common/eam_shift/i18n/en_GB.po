#. module: eam_shift
#: model_terms:ir.ui.view,arch_db:eam_shift.view_eam_shift_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        <b>Bàn giao một chiều</b> — đã giao nhưng chưa ai ký\n"
"                        nhận. Không chặn vận hành, nhưng đây đúng là cái cớ\n"
"                        kinh điển khi tranh chấp: <i>\"tôi không được bàn\n"
"                        giao việc đó\"</i>."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        <b>One-way handover</b> — handed over but nobody has\n"
"                        signed for it. It does not block operations, but this is\n"
"                        precisely the classic excuse in a dispute: <i>\"that was\n"
"                        never handed over to me\"</i>."

#. module: eam_shift
#: model_terms:ir.ui.view,arch_db:eam_shift.view_eam_shift_form
msgid ""
"<i class=\"fa fa-repeat me-1\"/>\n"
