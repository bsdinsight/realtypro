<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ HĐ với CĐT ============ -->
    <record id="view_rp_owner_contract_list" model="ir.ui.view">
        <field name="name">rp.owner.contract.list</field>
        <field name="model">rp.owner.contract</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('completed', 'terminated')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="contract_value_pretax" width="185px" sum="Σ"/>
                <field name="accepted_to_date" width="185px" sum="Σ"/>
                <field name="paid_to_date" width="185px" sum="Σ"/>
                <field name="receivable" width="185px" sum="Σ"
                       decoration-bf="receivable &gt; 0"/>
                <field name="progress_percent" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'signed'"
                       decoration-warning="state == 'executing'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'terminated'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rp_owner_contract_form" model="ir.ui.view">
        <field name="name">rp.owner.contract.form</field>
        <field name="model">rp.owner.contract</field>
        <field name="arch" type="xml">
            <form string="HĐ với Chủ đầu tư">
                <header>
                    <button name="action_sign" type="object" string="Ký HĐ"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_execute" type="object"
                            string="Bắt đầu thi công" class="btn-primary"
                            invisible="state != 'signed'"/>
                    <button name="action_complete" type="object"
                            string="Hoàn thành"
                            invisible="state not in ('signed', 'executing')"/>
                    <button name="action_terminate" type="object"
                            string="Chấm dứt"
                            confirm="Chấm dứt HĐ với CĐT này?"
                            invisible="state in ('completed', 'terminated')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,signed,executing,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_acceptances" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="acceptance_count" widget="statinfo"
                                   string="Hồ sơ NT"/>
                        </button>
                        <button name="action_view_milestones" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="milestone_count" widget="statinfo"
                                   string="Đợt thu"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo"
                                   string="Hoá đơn"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="HĐ/2026/..."/></h1>
                    </div>
                    <group>
                        <group string="Đối tượng">
                            <field name="project_id"
                                   options="{'no_create': True}"/>
                            <field name="owner_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="date_contract"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Giá trị">
                            <field name="contract_value_pretax"/>
                            <field name="vat_rate"/>
                            <field name="contract_value_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="ipc_box">
                        <button name="action_open_ipc" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="ipc_count" widget="statinfo"
                                   string="IPC"/>
                        </button>
                    </div>
                    <group string="Điều khoản thanh toán (dùng để tính giảm trừ mỗi BBNT)">
                        <group>
                            <field name="retention_percent"/>
                            <field name="retention_cap_percent"/>
                            <field name="retention_held" readonly="1"/>
                        </group>
                        <group>
                            <field name="advance_amount"/>
                            <field name="advance_recovery_percent"/>
                            <field name="advance_balance" readonly="1"/>
                        </group>
                    </group>
                    <group string="Sản lượng &amp; doanh thu">
                        <group>
                            <field name="accepted_gross_to_date"/>
                            <field name="accepted_to_date"
                                   decoration-bf="1"/>
                            <field name="revenue_invoiced"/>
                            <field name="received_to_date"/>
                        </group>
                        <group>
                            <field name="receivable_invoiced"
                                   decoration-bf="receivable_invoiced &gt; 0"/>
                            <field name="receivable"
                                   decoration-info="receivable &lt; 0"/>
                            <field name="progress_percent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kế hoạch thanh toán (dòng tiền thu)"
                              name="milestones">
                            <field name="milestone_ids"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom"
                                      decoration-muted="state == 'cancelled'"
                                      decoration-success="state == 'received'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="milestone_type"/>
                                    <field name="percent"/>
                                    <field name="amount" width="185px" sum="Σ kế hoạch"/>
                                    <field name="due_date"/>
                                    <field name="amount_received" width="170px"
                                           sum="Σ đã thu"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="invoice_id" column_invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'planned'"
                                           decoration-warning="state == 'invoiced'"
                                           decoration-success="state == 'received'"/>
                                    <button name="action_create_invoice"
                                            type="object" icon="fa-file-text"
                                            string="Xuất HĐ"
                                            invisible="state != 'planned'"/>
                                    <button name="action_view_invoice"
                                            type="object" icon="fa-external-link"
                                            string="Xem HĐ"
                                            invisible="not invoice_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Hồ sơ nghiệm thu" name="acceptances">
                            <field name="acceptance_ids"
                                   context="{'default_contract_id': id}">
                                <list decoration-muted="state == 'cancelled'"
                                      decoration-info="state == 'draft'">
                                    <field name="name"/>
                                    <field name="date_submitted"/>
                                    <field name="date_approved"/>
                                    <field name="amount_this_period" width="185px"
                                           sum="Σ"/>
                                    <field name="retention_amount" width="185px"
                                           sum="Σ" optional="show"/>
                                    <field name="amount_certified" width="200px"
                                           sum="Σ" decoration-bf="1"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'proposed'"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'cancelled'"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Thanh toán của CĐT" name="payments">
                            <field name="payment_ids"
                                   context="{'default_contract_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="payment_type"/>
                                    <field name="amount" width="185px" sum="Σ"/>
                                    <field name="reference"/>
                                    <field name="note"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ BBNT với CĐT (standalone) ============ -->
    <record id="view_rp_owner_acceptance_form" model="ir.ui.view">
        <field name="name">rp.owner.acceptance.form</field>
        <field name="model">rp.owner.acceptance</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ nghiệm thu với Chủ đầu tư">
                <header>
                    <button name="action_propose" type="object"
                            string="Đề xuất" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="CĐT duyệt" class="btn-primary"
                            invisible="state != 'proposed'"/>
                    <button name="action_reset_draft" type="object"
                            string="Về nháp"
                            invisible="state not in ('proposed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Huỷ"
                            invisible="state not in ('draft', 'proposed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,proposed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"
                                   options="{'no_create': True}"/>
                            <field name="project_id"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="date_submitted"/>
                            <field name="date_approved"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Sản lượng kỳ này: Gross → Ròng">
                        <group>
                            <field name="amount_this_period"/>
                            <field name="advance_recovery"/>
                            <field name="retention_amount"/>
                        </group>
                        <group>
                            <field name="backcharge"/>
                            <field name="adjustment"/>
                            <field name="amount_certified"
                                   decoration-bf="1"/>
                            <field name="amount_net"/>
                        </group>
                    </group>
                    <field name="note"
                           placeholder="Ghi chú... (ghi rõ lý do khi có Điều chỉnh khác)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_owner_acceptance_list" model="ir.ui.view">
        <field name="name">rp.owner.acceptance.list</field>
        <field name="model">rp.owner.acceptance</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="date_submitted"/>
                <field name="amount_this_period" width="185px" sum="Σ"/>
                <field name="retention_amount" width="185px" sum="Σ"
                       optional="show"/>
                <field name="advance_recovery" width="185px" sum="Σ"
                       optional="hide"/>
                <field name="amount_certified" width="200px" sum="Σ"
                       decoration-bf="1"/>
                <field name="amount_net" width="185px" sum="Σ"
                       optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'proposed'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============ Actions + Menu ============ -->
    <record id="action_rp_owner_contract" model="ir.actions.act_window">
        <field name="name">HĐ với Chủ đầu tư</field>
        <field name="res_model">rp.owner.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo HĐ thi công đầu ra đầu tiên với Chủ đầu tư
            </p>
            <p>Ghi nhận BBNT sản lượng với CĐT + thanh toán của CĐT →
               theo dõi khoản phải thu (quyền đòi nợ) làm TSBĐ vay vốn.</p>
        </field>
    </record>

    <record id="action_rp_owner_acceptance" model="ir.actions.act_window">
        <field name="name">Nghiệm thu gửi CĐT</field>
        <field name="res_model">rp.owner.acceptance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Hoá đơn phát hành CĐT (out_invoice gắn HĐ với CĐT) -->
    <record id="view_owner_invoice_list" model="ir.ui.view">
        <field name="name">account.move.owner.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Hoá đơn phát hành CĐT"
                  decoration-info="state == 'draft'"
                  decoration-success="payment_state in ('paid','in_payment')"
                  decoration-warning="payment_state == 'partial'">
                <field name="invoice_date" string="Ngày HĐ"/>
                <field name="name" string="Số hoá đơn"/>
                <field name="owner_project_id" string="Dự án" optional="show"/>
                <field name="partner_id" string="Chủ đầu tư"/>
                <field name="owner_contract_id" string="HĐ với CĐT" optional="show"/>
                <field name="invoice_date_due" string="Hạn thu" optional="show"/>
                <field name="amount_untaxed_signed" string="Doanh thu (trước thuế)"
                       width="185px" sum="Σ doanh thu"/>
                <field name="amount_total_signed" string="Tổng" width="185px"
                       sum="Σ tổng"/>
                <field name="amount_residual_signed" string="Còn phải thu"
                       width="185px" sum="Σ phải thu"
                       decoration-bf="amount_residual_signed &gt; 0"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state in ('paid','in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_owner_invoice" model="ir.actions.act_window">
        <field name="name">Hoá đơn phát hành CĐT</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_owner_invoice_list"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('owner_contract_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <!-- Thu tiền (Receipt) — account.payment chiều thu từ CĐT -->
    <record id="action_owner_receipt" model="ir.actions.act_window">
        <field name="name">Thu tiền (Receipt)</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'inbound'), ('partner_type', '=', 'customer')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer'}</field>
    </record>

    <!-- Kế hoạch dòng tiền thu — pivot mốc theo tháng -->
    <record id="view_owner_milestone_pivot" model="ir.ui.view">
        <field name="name">rp.owner.payment.milestone.pivot</field>
        <field name="model">rp.owner.payment.milestone</field>
        <field name="arch" type="xml">
            <pivot string="Kế hoạch dòng tiền thu">
                <field name="due_date" interval="month" type="col"/>
                <field name="project_id" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_owner_milestone_list" model="ir.ui.view">
        <field name="name">rp.owner.payment.milestone.list</field>
        <field name="model">rp.owner.payment.milestone</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'received'">
                <field name="due_date"/>
                <field name="project_id" optional="show"/>
                <field name="contract_id"/>
                <field name="owner_id"/>
                <field name="name"/>
                <field name="milestone_type"/>
                <field name="amount" width="185px" sum="Σ kế hoạch"/>
                <field name="amount_received" width="170px" sum="Σ đã thu"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'invoiced'"
                       decoration-success="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="action_owner_cashflow" model="ir.actions.act_window">
        <field name="name">Kế hoạch dòng tiền thu</field>
        <field name="res_model">rp.owner.payment.milestone</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
    </record>

    <!-- Chủ đầu tư (danh bạ) -->
    <record id="action_partner_owner" model="ir.actions.act_window">
        <field name="name">Chủ đầu tư</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_project_owner', '=', True)]</field>
        <field name="context">{'default_is_project_owner': True, 'default_is_company': True, 'res_partner_search_mode': 'supplier'}</field>
    </record>

    <!-- ============ Menu root: Doanh thu ============ -->
    <menuitem id="menu_owner_revenue"
              name="Doanh thu"
              parent="rp_estimate.menu_realty_project_root"
              sequence="42"/>

    <menuitem id="menu_rp_owner_contract"
              name="HĐ với Chủ đầu tư"
              parent="menu_owner_revenue"
              action="action_rp_owner_contract"
              sequence="10"/>
    <menuitem id="menu_rp_owner_acceptance"
              name="Nghiệm thu gửi CĐT"
              parent="menu_owner_revenue"
              action="action_rp_owner_acceptance"
              sequence="20"/>
    <menuitem id="menu_owner_invoice"
              name="Hoá đơn phát hành CĐT"
              parent="menu_owner_revenue"
              action="action_owner_invoice"
              sequence="30"/>
    <menuitem id="menu_owner_receipt"
              name="Thu tiền (Receipt)"
              parent="menu_owner_revenue"
              action="action_owner_receipt"
              sequence="40"/>
    <menuitem id="menu_owner_cashflow"
              name="Kế hoạch dòng tiền thu"
              parent="menu_owner_revenue"
              action="action_owner_cashflow"
              sequence="50"/>

    <!-- ============ Cấu hình: danh bạ đối tác ============ -->
    <menuitem id="menu_cfg_partner_owner"
              name="Chủ đầu tư"
              parent="rp_estimate.menu_rp_configuration"
              action="action_partner_owner"
              sequence="40"/>
    <menuitem id="menu_cfg_contractor"
              name="Nhà thầu"
              parent="rp_estimate.menu_rp_configuration"
              action="rp_contractor.action_rp_contractor"
              sequence="45"/>

</odoo>
