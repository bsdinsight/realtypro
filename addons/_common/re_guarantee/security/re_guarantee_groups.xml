<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_guarantee_user" model="res.groups">
        <field name="name">Realty / Guarantee User</field>
        <field name="comment">Đọc + tạo BL, đề xuất phát hành. Không huỷ.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_guarantee_manager" model="res.groups">
        <field name="name">Realty / Guarantee Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_guarantee_user'))]"/>
        <field name="comment">Phát hành / giải tỏa / thu BL.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
