<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ SỔ DỰNG MÁY (ô: vị trí × cổng) ============ -->
    <record id="view_rp_erection_step_list" model="ir.ui.view">
        <field name="name">rp.erection.step.list</field>
        <field name="model">rp.erection.step</field>
        <field name="arch" type="xml">
            <list string="Sổ dựng máy" editable="bottom" multi_edit="1"
                  expand="1"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'blocked'"
                  decoration-warning="state != 'done' and days_late &gt; 0"
                  decoration-muted="state == 'pending'">
                <field name="location_code" string="Vị trí" width="110px"
                       readonly="1"/>
                <field name="location_id" column_invisible="1"/>
                <field name="gate_sequence" column_invisible="1"/>
                <field name="gate_id" width="230px" readonly="1"/>
                <field name="structure_id" optional="hide" readonly="1"/>
                <field name="state" width="150px"/>
                <field name="blocked_reason" string="Kẹt vì" width="180px"
                       required="state == 'blocked'"/>
                <field name="blocked_note" optional="hide"/>
                <field name="date_plan" width="130px"/>
                <field name="date_done" width="130px"/>
                <field name="days_late" string="Trễ (ngày)" width="110px"/>
                <field name="out_of_order" string="Lệch thứ tự"
                       optional="show" readonly="1"/>
                <field name="note" optional="hide"/>
                <button name="action_xong" type="object" icon="fa-check"
                        title="Đánh dấu xong"
                        invisible="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_erection_step_form" model="ir.ui.view">
        <field name="name">rp.erection.step.form</field>
        <field name="model">rp.erection.step</field>
        <field name="arch" type="xml">
            <form string="Bước dựng máy">
                <header>
                    <button name="action_bat_dau" type="object"
                            string="Bắt đầu"
                            invisible="state in ('in_progress', 'done')"/>
                    <button name="action_xong" type="object" string="Xong"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id"
                                   options="{'no_create': True}"/>
                            <field name="gate_id"
                                   options="{'no_create': True}"/>
                            <field name="structure_id"/>
                        </group>
                        <group>
                            <field name="date_plan"/>
                            <field name="date_done"/>
                            <field name="days_late"/>
                            <field name="out_of_order"/>
                        </group>
                    </group>
                    <group string="Đang kẹt" invisible="state != 'blocked'">
                        <field name="blocked_reason"
                               required="state == 'blocked'"/>
                        <field name="blocked_note"/>
                    </group>
                    <div class="alert alert-warning" role="status"
                         invisible="not out_of_order">
                        Ô này đã xong trong khi <b>cổng trước đó chưa
                        xong</b>. Hệ thống KHÔNG chặn, vì phần lớn là do
                        người ghi quên tích cổng trước chứ không phải
                        dựng tháp lên bùn — chặn thì họ sẽ tích bừa cho
                        qua và mất sạch dấu vết. Nhưng nên soi lại.
                    </div>
                    <group string="Ghi chú">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_erection_step_search" model="ir.ui.view">
        <field name="name">rp.erection.step.search</field>
        <field name="model">rp.erection.step</field>
        <field name="arch" type="xml">
            <search string="Sổ dựng máy">
                <field name="location_code"/>
                <field name="location_id"/>
                <field name="gate_id"/>
                <field name="structure_id"/>
                <separator/>
                <filter name="f_ket" string="Đang kẹt"
                        domain="[('state', '=', 'blocked')]"/>
                <filter name="f_tre" string="Trễ kế hoạch"
                        domain="[('state', '!=', 'done'),
                                 ('days_late', '&gt;', 0)]"/>
                <filter name="f_chua" string="Chưa xong"
                        domain="[('state', '!=', 'done')]"/>
                <filter name="f_xong" string="Đã xong"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="f_lech" string="Ghi lệch thứ tự"
                        domain="[('out_of_order', '=', True)]"/>
                <separator/>
                <filter name="g_vitri" string="Vị trí"
                        context="{'group_by': 'location_code'}"/>
                <filter name="g_cong" string="Cổng"
                        context="{'group_by': 'gate_id'}"/>
                <filter name="g_hm" string="Hạng mục"
                        context="{'group_by': 'structure_id'}"/>
                <filter name="g_tt" string="Trạng thái"
                        context="{'group_by': 'state'}"/>
                <filter name="g_ket" string="Kẹt vì"
                        context="{'group_by': 'blocked_reason'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_erection_step" model="ir.actions.act_window">
        <field name="name">Sổ dựng máy</field>
        <field name="res_model">rp.erection.step</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_vitri': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sổ còn trống</p>
            <p>Mỗi ô là <b>một vị trí × một cổng</b>. Dùng nút
            <b>Sinh sổ dựng máy</b> để tạo đủ lưới cho cả nhà máy.</p>
            <p>Lịch của nhà thầu gom theo lô vận chuyển và nhánh điện —
            một việc ôm ba bốn trụ. Sổ này mịn hơn một bậc, để trả lời
            được câu <b>trụ số 7 đang kẹt ở đâu</b>.</p>
        </field>
    </record>

    <record id="action_rp_erection_blocked" model="ir.actions.act_window">
        <field name="name">Đang kẹt &amp; trễ</field>
        <field name="res_model">rp.erection.step</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('state', '=', 'blocked'),
                              '&amp;', ('state', '!=', 'done'),
                              ('days_late', '&gt;', 0)]</field>
        <field name="context">{'search_default_g_ket': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không có trụ nào kẹt
            hay trễ</p>
            <p>Màn hình trả lời câu <b>công trường đang tắc ở đâu</b>.
            Gom theo lý do kẹt: chờ cẩu và chờ thời tiết là ràng buộc
            thật của điện gió, không phải cái cớ.</p>
        </field>
    </record>

    <!-- ============ CỔNG ============ -->
    <record id="view_rp_erection_gate_list" model="ir.ui.view">
        <field name="name">rp.erection.gate.list</field>
        <field name="model">rp.erection.gate</field>
        <field name="arch" type="xml">
            <list string="Cổng dựng máy" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code" width="130px"/>
                <field name="name" width="280px"/>
                <field name="weight" width="110px"/>
                <field name="structure_id" width="260px"/>
                <field name="done_count" string="Đã qua"/>
                <field name="total_count" string="Tổng vị trí"/>
                <field name="percent" string="%" widget="progressbar"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rp_erection_gate_form" model="ir.ui.view">
        <field name="name">rp.erection.gate.form</field>
        <field name="model">rp.erection.gate</field>
        <field name="arch" type="xml">
            <form string="Cổng dựng máy">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" class="oe_inline"
                                   placeholder="Mã"/>
                            <field name="name" class="oe_inline"
                                   placeholder="Tên cổng"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="weight"/>
                            <field name="structure_id"/>
                        </group>
                        <group>
                            <field name="done_count"/>
                            <field name="total_count"/>
                            <field name="percent" widget="progressbar"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        <b>Trọng số không chia đều.</b> Đổ móng một trụ
                        tua-bin 6 MW là vài trăm mét khối bê tông và vài
                        tuần; đấu một đầu cáp vào feeder là một ngày. Đếm
                        "7/9 cổng = 78%" sẽ vẽ ra đường cong tiến độ
                        không giống thực tế.
                    </div>
                    <group string="Mô tả / tiêu chí nghiệm thu">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rp_erection_gate" model="ir.actions.act_window">
        <field name="name">Cổng dựng máy</field>
        <field name="res_model">rp.erection.gate</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ WIZARD SINH SỔ ============ -->
    <record id="view_rp_erection_generate_form" model="ir.ui.view">
        <field name="name">rp.erection.generate.form</field>
        <field name="model">rp.erection.generate</field>
        <field name="arch" type="xml">
            <form string="Sinh sổ dựng máy">
                <group>
                    <field name="plant_id" options="{'no_create': True}"/>
                    <field name="gate_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="date_start"/>
                    <field name="days_per_gate"
                           invisible="not date_start"/>
                </group>
                <div class="text-muted">
                    Chạy lại được nhiều lần: chỉ <b>tạo ô còn thiếu</b>,
                    không đụng ô đã ghi. Thêm một cổng mới giữa chừng là
                    chuyện bình thường, và lúc đó phải sinh bù cho cả đội
                    mà không xoá mất những gì đã có.
                </div>
                <footer>
                    <button name="action_sinh" type="object" string="Sinh sổ"
                            class="btn-primary"/>
                    <button string="Huỷ" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rp_erection_generate" model="ir.actions.act_window">
        <field name="name">Sinh sổ dựng máy</field>
        <field name="res_model">rp.erection.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============ GẮN VÀO VỊ TRÍ & HẠNG MỤC ============ -->
    <record id="view_eam_location_form_erection" model="ir.ui.view">
        <field name="name">eam.location.form.erection</field>
        <field name="model">eam.location</field>
        <field name="inherit_id" ref="eam_core.view_eam_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Tiến độ dựng máy" name="gr_erection"
                       invisible="location_type != 'position'">
                    <group>
                        <field name="erection_percent"
                               widget="progressbar"/>
                        <field name="erection_gate_id"/>
                        <field name="erection_days_late"/>
                    </group>
                    <group>
                        <field name="erection_blocked"/>
                        <field name="erection_blocked_why"
                               invisible="not erection_blocked"/>
                        <field name="erection_out_of_order"/>
                    </group>
                    <field name="erection_step_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="gate_sequence" column_invisible="1"/>
                            <field name="gate_id" readonly="1" width="230px"/>
                            <field name="state" width="150px"/>
                            <field name="blocked_reason"
                                   required="state == 'blocked'"/>
                            <field name="date_plan"/>
                            <field name="date_done"/>
                            <field name="days_late"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_rp_structure_form_erection" model="ir.ui.view">
        <field name="name">rp.structure.form.erection</field>
        <field name="model">rp.structure</field>
        <field name="inherit_id" ref="rp_cost_base.view_rp_structure_form"/>
        <field name="arch" type="xml">
            <!-- Neo vào <notebook>, KHÔNG neo vào field progress_percent:
                 trường đó không nằm trong form hạng mục (nó ở màn nghiệm
                 thu), nên xpath sẽ nổ lúc nâng cấp. -->
            <xpath expr="//notebook" position="inside">
                <page string="Tiến độ dựng máy" name="erection"
                      invisible="not erection_total">
                    <group>
                        <group>
                            <field name="erection_total" invisible="1"/>
                            <field name="erection_percent"
                                   widget="progressbar"/>
                            <field name="erection_done"/>
                        </group>
                        <group>
                            <field name="progress_percent"
                                   string="% hoàn thành (nghiệm thu)"
                                   readonly="1"/>
                            <field name="erection_gap"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        <b>Hai con số này đo hai thứ khác nhau, và chênh
                        lệch giữa chúng chính là thông tin.</b><br/>
                        <b>% vật lý</b> đếm từ sổ dựng máy: bao nhiêu vị
                        trí đã qua cổng.
                        <b>% hoàn thành</b> tính theo giá trị nghiệm thu
                        đã duyệt chia cho dự toán — tức tiến độ
                        <i>thanh toán</i>.<br/>
                        Chênh <b>dương</b> nghĩa là hiện trường đi trước
                        hồ sơ: việc đã xong mà chưa nghiệm thu được, tức
                        chưa ra tiền. Chênh <b>âm</b> thì đáng soi lại.
                        Trộn hai cái làm một sẽ mất đúng khoảng cách đó —
                        thứ duy nhất chỉ ra hồ sơ đang tắc ở đâu.
                    </div>
                    <field name="erection_gate_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="sequence" column_invisible="1"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="weight"/>
                            <field name="done_count" string="Đã qua"/>
                            <field name="total_count" string="Tổng"/>
                            <field name="percent" widget="progressbar"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============ MENU ============ -->
    <menuitem id="menu_rp_erection" name="Tiến độ dựng máy"
              parent="rp_estimate.menu_project_master" sequence="35"/>
    <menuitem id="menu_rp_erection_step" name="Sổ dựng máy"
              parent="menu_rp_erection"
              action="action_rp_erection_step" sequence="10"/>
    <menuitem id="menu_rp_erection_blocked" name="Đang kẹt &amp; trễ"
              parent="menu_rp_erection"
              action="action_rp_erection_blocked" sequence="20"/>
    <menuitem id="menu_rp_erection_generate" name="Sinh sổ dựng máy"
              parent="menu_rp_erection"
              action="action_rp_erection_generate" sequence="30"
              groups="base.group_system"/>
    <menuitem id="menu_rp_erection_gate" name="Cổng dựng máy"
              parent="rp_estimate.menu_rp_configuration"
              action="action_rp_erection_gate" sequence="40"/>

</odoo>
