<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence cho số chứng từ giải ngân -->
    <record id="seq_re_loan_disbursement" model="ir.sequence">
        <field name="name">Giải ngân khế ước</field>
        <field name="code">re.loan.note.disbursement</field>
        <field name="prefix">GN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_re_loan_bank_advice" model="ir.sequence">
        <field name="name">Giấy báo nợ NH</field>
        <field name="code">re.loan.bank.advice</field>
        <field name="prefix">GBC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
