<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit rp.contract form: SLA + smart button BBN -->
    <record id="view_rp_contract_form_inherit_progress" model="ir.ui.view">
        <field name="name">rp.contract.form.progress</field>
        <field name="model">rp.contract</field>
        <field name="inherit_id" ref="rp_contract.view_rp_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_acceptances" type="object"
                            class="oe_stat_button" icon="fa-check-square-o">
                        <field name="acceptance_count" widget="statinfo"
                               string="BBN"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Tiến độ nghiệm thu">
                    <group>
                        <field name="sla_response_days"/>
                        <field name="acceptance_count"/>
                    </group>
                    <group>
                        <field name="acceptance_value_to_date"/>
                        <field name="acceptance_progress_percent"
                               widget="percentage"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
