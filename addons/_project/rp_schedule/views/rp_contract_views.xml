<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rp_contract_form_schedule" model="ir.ui.view">
        <field name="name">rp.contract.form.schedule</field>
        <field name="model">rp.contract</field>
        <field name="inherit_id" ref="rp_contract.view_rp_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_schedule" type="object"
                        class="oe_stat_button" icon="fa-tasks">
                    <field name="task_count" widget="statinfo"
                           string="Công việc"/>
                </button>
                <button name="action_open_gantt" type="object"
                        class="oe_stat_button" icon="fa-exclamation-triangle"
                        invisible="critical_task_count == 0">
                    <field name="critical_task_count" widget="statinfo"
                           string="Trên đường găng"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_import_schedule" type="object"
                        string="Import lịch thi công" icon="fa-upload"/>
                <button name="action_open_gantt" type="object"
                        string="Xem Gantt" icon="fa-bar-chart"
                        invisible="task_count == 0"/>
                <button name="action_set_schedule_baseline" type="object"
                        string="Chốt baseline" icon="fa-thumb-tack"
                        invisible="task_count == 0"
                        confirm="Chốt lịch kế hoạch hiện hành làm baseline gốc? (Ghi đè baseline cũ nếu có.)"/>
                <button name="action_recompute_critical_path" type="object"
                        string="Tính đường găng" icon="fa-sitemap"
                        invisible="task_count == 0"/>
            </xpath>
            <!-- Đưa nút trạng thái Hoàn thành / Chấm dứt xuống CUỐI header
                 (sau các nút thao tác lịch thi công). -->
            <xpath expr="//header" position="inside">
                <xpath expr="//button[@name='action_complete']"
                       position="move"/>
                <xpath expr="//button[@name='action_open_termination']"
                       position="move"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <!-- Lịch thi công là thứ CHI PHỐI mọi con số khác trên
                     form này — giá trị hoàn thành, đường găng, cảnh báo
                     trượt đều tính từ nó — nhưng trước đây muốn nhìn thì
                     phải RỜI form: hộp thoại từ nút thống kê, hoặc màn
                     Gantt riêng. Đọc hợp đồng mà không thấy lịch nằm
                     cạnh lịch thanh toán và BOQ thì mất chỗ đối chiếu
                     thường xuyên nhất.
                     Danh sách để CHỈ ĐỌC: sửa tiến độ là việc của màn
                     lịch/Gantt, nơi còn có đường găng và baseline để
                     nhìn hệ quả; sửa lén trong tab hợp đồng thì không
                     thấy mình vừa làm vỡ cái gì. -->
                <page string="Lịch thi công" name="schedule_tasks"
                      invisible="task_count == 0">
                    <field name="task_ids" nolabel="1" readonly="1">
                        <list default_order="wbs_seq, id"
                              create="false" delete="false"
                              decoration-warning="is_critical"
                              decoration-muted="exec_status == 'done'">
                            <field name="wbs_code" string="Mã WBS"/>
                            <field name="name" string="Công việc"/>
                            <field name="planned_start" string="Bắt đầu (KH)"/>
                            <field name="planned_end" string="Kết thúc (KH)"/>
                            <field name="planned_days" string="Thời lượng"
                                   sum="Σ ngày"/>
                            <field name="progress_percent"
                                   string="% hoàn thành"
                                   widget="progressbar"/>
                            <field name="total_float" string="Dư địa (ngày)"
                                   optional="show"/>
                            <field name="is_critical" string="Găng"
                                   optional="show"/>
                            <field name="exec_status" string="Tình trạng"
                                   widget="badge" optional="show"/>
                            <field name="user_ids" string="Người thực hiện"
                                   widget="many2many_avatar_user"
                                   optional="hide"/>
                            <field name="wbs_seq" column_invisible="1"/>
                        </list>
                    </field>
                    <div class="text-muted mt8">
                        Danh sách chỉ đọc, xếp theo mã WBS. Sửa tiến độ,
                        chốt <b>baseline</b> hay xem <b>đường găng</b> thì mở
                        <b>Xem Gantt</b> trên thanh nút ở đầu form.
                    </div>
                </page>
                <page string="Phân tích tiến độ" name="schedule_analysis"
                      invisible="task_count == 0">
                    <group>
                        <group string="Tiến độ">
                            <field name="task_count"/>
                            <field name="schedule_progress"
                                   widget="progressbar"/>
                        </group>
                        <group string="Baseline &amp; Đường găng">
                            <field name="has_baseline"/>
                            <field name="critical_task_count"/>
                            <field name="near_critical_count"/>
                            <field name="critical_pct"
                                   string="% công việc trên đường găng"/>
                            <field name="baseline_slip_max"/>
                        </group>
                    </group>
                    <div class="text-muted mt8">
                        Nút <b>Chốt baseline</b> đông cứng kế hoạch gốc để đo
                        trượt tiến độ; <b>Tính đường găng</b> cập nhật Total
                        Float cho công việc. Mở <b>Xem Gantt</b> để bật lớp
                        Đường cơ sở / Đường găng trực quan.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
