msgid ""
"Đặt ngưỡng trên <b>giờ máy chạy</b> là trùng\n"
"                                việc với kế hoạch bảo trì phòng ngừa — rồi\n"
"                                hai cơ chế cùng sinh lệnh cho một việc."
msgstr ""
"Putting a threshold on <b>running hours</b> duplicates\n"
"                                the preventive maintenance plan — and then two\n"
"                                mechanisms raise orders for the same job."

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm__repeat_after_fix
msgid "Đếm số lần cảnh báo QUAY LẠI sau khi đã đóng lệnh sửa. Lớn hơn 0 là lần sửa trước không giữ được — đây là cách duy nhất phân biệt \"đã sửa\" với \"đã đóng lệnh\"."
msgstr "Counts how many times an alarm COMES BACK after a repair order was closed. Above 0 means the previous repair did not hold — this is the only way to tell \"repaired\" from \"order closed\"."

