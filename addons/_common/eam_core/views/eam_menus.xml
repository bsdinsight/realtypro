    <!-- ===== Nhánh gốc chia theo VAI người dùng =====
         Trước đây mọi module đều gắn menu vào "Vận hành", nên nhánh đó
         phình lên 34 mục con và có 5 cặp trùng số thứ tự — dấu hiệu
         không ai nhìn tổng thể. Nay mỗi nhánh một vai:

           Dự án        bàn giao từ EPCOne
           Tài sản      sổ sách tài sản — gồm "máy có bền không" (MTBF)
           Vận hành     người trực ca
           Bảo trì      thợ và trưởng bảo trì — gồm KPI bảo trì
           Kho phụ tùng thủ kho
           Hiệu suất    kỹ sư phân tích — sản lượng, tổn thất, khả dụng
           Hợp đồng     hợp đồng O&amp;M, chấm KPI/SLA
           Cấu hình     quản trị

         Module mới gắn menu vào ĐÚNG nhánh theo vai, không gắn bừa vào
         Vận hành.

         LUẬT: nhánh gốc phải có NHIỀU HƠN MỘT mục con. Một màn hình
         đứng riêng ở cấp gốc trông như một nhánh nhưng không phải —
         "Độ tin cậy & KPI bảo trì" từng như vậy, và cái tên có dấu "&"
         để lộ rằng nó còn gom hai câu hỏi của hai người đọc khác nhau.
         Đã tách: MTBF về Tài sản, MTTR/%phòng ngừa về Bảo trì. -->

    <menuitem id="menu_eam_ops" name="Vận hành"
              parent="menu_eam_root" sequence="20"/>
    <menuitem id="menu_eam_outage" name="Sổ dừng máy"
              parent="menu_eam_ops" action="action_eam_outage"
              sequence="20"/>

    <menuitem id="menu_eam_maint" name="Bảo trì"
              parent="menu_eam_root" sequence="30"/>

    <menuitem id="menu_eam_store" name="Kho phụ tùng"
              parent="menu_eam_root" sequence="40"/>

    <menuitem id="menu_eam_perf" name="Hiệu suất"
              parent="menu_eam_root" sequence="50"/>
    <menuitem id="menu_eam_config" name="Cấu hình"
              parent="menu_eam_root" sequence="90"/>
    <menuitem id="menu_eam_asset_category" name="Loại cấu phần"
