msgid "Danh mục"
msgstr "Reference data"

#. module: eam_om_contract
#: model_terms:ir.actions.act_window,help:eam_om_contract.action_eam_om_contract_type
msgid "Danh mục loại hợp đồng"
msgstr "Contract type catalogue"

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_contract_form
msgid ""
"Dòng mờ là cam kết hệ <b>chưa đo được</b>.\n"
"                                Kỳ vẫn sinh dòng kết quả cho nó, ghi rõ lý\n"
"                                do và <b>không tính phạt</b> — chứ không\n"
"                                lặng lẽ thay bằng cơ sở khác. Hai cơ sở ra\n"
"                                hai con số khác nhau, lấy nhầm là tính tiền\n"
"                                sai mà biên bản vẫn trông hoàn chỉnh."
msgstr ""
"A greyed-out row is a commitment the system <b>could not\n"
"                                measure</b>. The period still produces a result row\n"
"                                for it, states the reason and charges <b>no\n"
"                                penalty</b> — rather than quietly substituting\n"
"                                another basis. Two bases give two different figures,\n"
"                                and taking the wrong one charges the wrong money\n"
"                                while the certificate still looks complete."

#. module: eam_om_contract
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_contract__note
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_contract_plant__note
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_contract_type__note
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_contract_form
