<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_building_list" model="ir.ui.view">
        <field name="name">re.building.list</field>
        <field name="model">re.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="subzone_id" optional="show"/>
                <field name="building_type" optional="show"/>
                <field name="total_floors"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'operation'"
                       decoration-info="state == 'selling'"
                       decoration-warning="state == 'construction'"
                       decoration-muted="state in ('planning', 'closed')"/>
                <field name="is_lifecycle_owner" optional="hide"/>
                <field name="progress_percent" widget="progressbar"/>
                <field name="floor_count"/>
                <field name="unit_count"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_re_building_form" model="ir.ui.view">
        <field name="name">re.building.form</field>
        <field name="model">re.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <header>
                    <!-- Generate Floors wizard (always available) -->
                    <button name="%(action_re_floor_generate_wizard)d"
                            type="action"
                            string="Generate Floors"
                            class="btn-secondary"
                            context="{'default_building_id': id}"
                            groups="re_base.group_re_manager"/>

                    <!-- Lifecycle transitions (only when building is owner) -->
                    <button name="action_pre_launch" type="object"
                            string="Open Pre-Launch" class="btn-primary"
                            invisible="not is_lifecycle_owner or state != 'planning'"
                            groups="re_base.group_re_user"/>
                    <button name="action_open_for_sale" type="object"
                            string="🚀 Open for Sale" class="btn-primary"
                            invisible="not is_lifecycle_owner or state != 'pre_launch'"
                            groups="re_base.group_re_admin"
                            confirm="Mở bán chính thức?"/>
                    <button name="action_start_construction" type="object"
                            string="Start Construction"
                            invisible="not is_lifecycle_owner or state != 'selling'"
                            groups="re_base.group_re_admin"/>
                    <button name="action_start_product_handover" type="object"
                            string="Start Product Handover" class="btn-primary"
                            invisible="not is_lifecycle_owner or state not in ('selling', 'construction')"
                            groups="re_base.group_re_admin"/>
                    <button name="action_start_certificate_handover" type="object"
                            string="Start Certificate Handover"
                            invisible="not is_lifecycle_owner or state != 'product_handover'"
                            groups="re_base.group_re_admin"/>
                    <button name="action_to_operation" type="object"
                            string="Move to Operation" class="btn-primary"
                            invisible="not is_lifecycle_owner or state not in ('product_handover', 'certificate_handover')"
                            groups="re_base.group_re_admin"/>
                    <button name="action_close" type="object"
                            string="Close"
                            invisible="not is_lifecycle_owner or state != 'operation'"
                            groups="re_base.group_re_admin"
                            confirm="Archive building vĩnh viễn?"/>
                    <button name="action_reset_to_planning" type="object"
                            string="Reset to Planning" class="text-danger"
                            invisible="not is_lifecycle_owner or state == 'planning'"
                            groups="re_base.group_re_admin"
                            confirm="Reset state về Planning?"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="planning,pre_launch,selling,construction,product_handover,certificate_handover,operation"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"
                         invisible="is_lifecycle_owner">
                        <strong>Lifecycle managed at subzone level.</strong>
                        This project tracks its phase per subzone (low-rise development),
                        not per building. Open the parent subzone to see lifecycle controls.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_floors" type="object"
                                class="oe_stat_button" icon="fa-bars">
                            <field name="floor_count" widget="statinfo" string="Floors"/>
                        </button>
                        <button name="action_view_units" type="object"
                                class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Building name..."/></h1>
                        <field name="tagline" placeholder="Tagline..."/>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="project_id"/>
                            <field name="subzone_id" options="{'no_create': True}"/>
                            <field name="building_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="position_in_subzone"/>
                            <field name="sequence"/>
                            <field name="is_open_for_sale" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Specifications" name="specs">
                            <group>
                                <group>
                                    <field name="total_floors"/>
                                    <field name="basement_count"/>
                                    <field name="elevator_count"/>
                                </group>
                                <group>
                                    <field name="parking_capacity"/>
                                    <field name="motorbike_capacity"/>
                                    <field name="total_units_planned"/>
                                </group>
                            </group>
                        </page>
                        <page string="Construction" name="construction">
                            <group>
                                <group>
                                    <field name="construction_start_date" options="{'format': 'dd/MM/yyyy'}"/>
                                    <field name="expected_handover_date" options="{'format': 'dd/MM/yyyy'}"/>
                                    <field name="actual_handover_date" options="{'format': 'dd/MM/yyyy'}"/>
                                </group>
                                <group>
                                    <field name="progress_percent" widget="progressbar"/>
                                </group>
                            </group>
                        </page>
                        <page string="Legal" name="legal">
                            <group>
                                <field name="legal_doc_type"/>
                                <field name="legal_doc_number"/>
                                <field name="legal_doc_date" options="{'format': 'dd/MM/yyyy'}"/>
                            </group>
                        </page>
                        <page string="Floor Plate" name="floor_plate">
                            <field name="floor_plate_image" widget="image" options="{'size': [1200, 800]}"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_building_search" model="ir.ui.view">
        <field name="name">re.building.search</field>
        <field name="model">re.building</field>
        <field name="arch" type="xml">
            <search string="Buildings">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="subzone_id"/>
                <separator/>
                <filter string="Pre-Launch" name="pre_launch"
                        domain="[('state', '=', 'pre_launch')]"/>
                <filter string="Selling" name="selling"
                        domain="[('state', '=', 'selling')]"/>
                <filter string="Construction" name="construction"
                        domain="[('state', '=', 'construction')]"/>
                <filter string="Product Handover" name="product_handover"
                        domain="[('state', '=', 'product_handover')]"/>
                <filter string="Operation" name="operation"
                        domain="[('state', '=', 'operation')]"/>
                <separator/>
                <filter string="Lifecycle Owners" name="lifecycle_owner"
                        domain="[('is_lifecycle_owner', '=', True)]"
                        help="Only buildings whose project tracks lifecycle at building level."/>
                <separator/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                <filter string="Subzone" name="group_subzone" context="{'group_by': 'subzone_id'}"/>
                <filter string="Phase" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">re.building</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_re_building_search"/>
    </record>

</odoo>
