<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thêm field xây dựng vào form task -->
    <record id="view_task_form2_rp_schedule" model="ir.ui.view">
        <field name="name">project.task.form.rp.schedule</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Lịch thi công (xây dựng)"
                       name="rp_schedule">
                    <group>
                        <field name="rp_contract_id"/>
                        <field name="rp_structure_id"/>
                        <field name="wbs_code"/>
                        <field name="wbs_seq" readonly="1"/>
                        <field name="wbs_level" readonly="1"/>
                        <field name="is_milestone"/>
                        <field name="rp_event_marker"/>
                    </group>
                    <group>
                        <field name="planned_start"/>
                        <field name="planned_end"/>
                        <field name="planned_days"/>
                        <!-- KHÔNG dùng widget progressbar: Odoo 19 render
                             read-only, người dùng không gõ % được -->
                        <field name="progress_percent"/>
                    </group>
                    <!-- Quan hệ khai trực tiếp ở đây, có loại và độ lệch.
                         Cột "lệch thực tế" đặt cạnh "lệch khai" để thấy
                         ngay chỗ ngày và logic không khớp nhau. -->
                    <field name="link_ids" colspan="2" nolabel="1">
                        <list editable="bottom"
                              decoration-danger="is_violated">
                            <field name="predecessor_id"
                                   options="{'no_create': True}"/>
                            <field name="link_type"/>
                            <field name="lag_days" string="Lệch khai"
                                   width="130px"/>
                            <field name="lag_actual" string="Lệch thực tế"
                                   width="130px"/>
                            <field name="is_violated" string="Vi phạm"
                                   width="100px"/>
                            <field name="note" optional="hide"/>
                        </list>
                    </field>
                    <group string="Baseline &amp; Đường găng" col="4">
                        <field name="baseline_start" readonly="1"/>
                        <field name="baseline_end" readonly="1"/>
                        <field name="baseline_slip_days" readonly="1"/>
                        <field name="is_critical" readonly="1"/>
                        <field name="total_float" readonly="1"/>
                    </group>
                    <field name="external_uid" readonly="1" optional="hide"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Thêm cột vào list task -->
    <record id="view_task_tree2_rp_schedule" model="ir.ui.view">
        <field name="name">project.task.list.rp.schedule</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="wbs_seq" string="STT" optional="show"
                       width="70px"/>
                <field name="wbs_code" optional="show"/>
                <field name="wbs_level" string="Cấp" optional="hide"
                       width="70px"/>
                <field name="rp_contract_id" optional="hide"/>
                <field name="planned_start" optional="show"/>
                <field name="planned_end" optional="show"/>
                <field name="progress_percent" widget="progressbar"
                       optional="show"/>
                <field name="is_milestone" optional="hide"/>
                <field name="total_float" optional="show"/>
                <field name="is_critical" optional="show"/>
                <field name="baseline_slip_days" string="Trượt baseline"
                       optional="hide"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">is_critical</attribute>
            </xpath>
        </field>
    </record>

    <!-- Filter đường găng / cận găng / trễ baseline -->
    <record id="view_task_search_rp_schedule" model="ir.ui.view">
        <field name="name">project.task.search.rp.schedule</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="rp_critical" string="Trên đường găng"
                        domain="[('is_critical', '=', True)]"/>
                <filter name="rp_near_critical" string="Cận găng (≤5 ngày)"
                        domain="[('total_float', '&gt;', 0),
                                 ('total_float', '&lt;=', 5)]"/>
                <filter name="rp_baseline_slip" string="Trễ so baseline"
                        domain="[('baseline_slip_days', '&gt;', 0)]"/>
                <separator/>
                <filter name="rp_group_critical" string="Đường găng"
                        context="{'group_by': 'is_critical'}"/>
                <filter name="rp_group_level" string="Cấp WBS"
                        context="{'group_by': 'wbs_level'}"/>
            </xpath>
        </field>
    </record>

    <!-- Pane lọc bên trái cho màn hình lịch thi công.

         KHÔNG gắn vào search view gốc của project.task: màn hình Công
         việc của app Project lõi cũng dùng view đó, mà ở đó trục dự án
         bất động sản / gói thầu / hợp đồng vô nghĩa. Nên đây là view
         RIÊNG (mode primary, priority cao để không bị chọn mặc định),
         chỉ các action của bộ xây dựng trỏ tới. Nó vẫn thừa hưởng đủ
         filter của search view gốc và của các view mở rộng.

         Trục đi từ to xuống nhỏ: dự án → gói thầu → hợp đồng (nhà thầu).
         Dự án để một-chọn vì xem lịch thì luôn xem một dự án; gói thầu và
         hợp đồng nhiều-chọn để so hai nhà thầu cạnh nhau. -->
    <record id="view_task_search_rp_panel" model="ir.ui.view">
        <field name="name">project.task.search.rp.panel</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="rp_project_id" string="Dự án"
                           icon="fa-folder-open" color="#0F2C3F"
                           enable_counters="1"/>
                    <field name="rp_package_id" select="multi"
                           string="Gói thầu" icon="fa-gavel"
                           color="#0E8C99" enable_counters="1"/>
                    <field name="rp_contract_id" select="multi"
                           string="Hợp đồng (nhà thầu)"
                           icon="fa-file-text-o" enable_counters="1"/>
                    <field name="exec_status" string="Tình trạng thi công"
                           icon="fa-tasks" enable_counters="1"
                           select="multi"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <!-- ===== Danh sách RIÊNG cho lịch thi công =====
         Danh sách công việc của Odoo lõi khai sẵn
         `default_group_by="stage_id"` ngay trong thẻ <list>, nên màn này
         luôn mở ra ở chế độ gom theo Stage — mà 228 việc lịch thi công
         không việc nào có stage, ra đúng một nhóm "Không (228)" che hết
         danh sách. Stage cũng không phải trục của lịch: nó là cột kanban
         (DB đang có 28 stage rác kiểu Inbox / Today / This Week của app
         Việc cần làm cá nhân).

         Lịch thi công là một DÀN BÀI CÓ THỨ TỰ, nên mặc định không gom,
         sắp theo STT. Và chỉ giữ cột của lịch — bỏ Priority, Tags, Next
         Activity, Project vốn là cột của phần mềm quản lý việc văn phòng. -->
    <record id="view_rp_schedule_task_list" model="ir.ui.view">
        <field name="name">project.task.list.rp.schedule</field>
        <field name="model">project.task</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Lịch thi công" default_order="wbs_seq, id"
                  multi_edit="1" sample="1"
                  decoration-danger="exec_status == 'late'"
                  decoration-warning="is_critical and exec_status != 'done'"
                  decoration-muted="exec_status == 'done'">
                <field name="wbs_seq" string="STT" optional="show"/>
                <field name="wbs_code" string="Mã WBS" optional="show"/>
                <field name="wbs_level" string="Cấp" optional="hide"/>
                <field name="name" string="Tên công việc"/>
                <field name="rp_contract_id" string="Hợp đồng"
                       optional="show"/>
                <field name="planned_start" string="Bắt đầu (KH)"/>
                <field name="planned_end" string="Kết thúc (KH)"/>
                <field name="planned_days" string="Thời lượng"
                       sum="Σ ngày"/>
                <field name="progress_percent" string="% hoàn thành"
                       widget="progressbar"/>
                <field name="total_float" string="Dư địa (ngày)"
                       optional="show"/>
                <field name="is_critical" string="Găng" optional="show"/>
                <field name="exec_status" string="Tình trạng"
                       widget="badge"
                       decoration-muted="exec_status == 'not_started'"
                       decoration-info="exec_status == 'in_progress'"
                       decoration-success="exec_status == 'done'"
                       decoration-danger="exec_status == 'late'"/>
                <field name="is_milestone" string="Mốc" optional="hide"/>
                <field name="baseline_slip_days" string="Trượt baseline"
                       optional="hide"/>
                <!-- Baseline và đường găng là THAO TÁC, không phải danh
                     sách, nên là nút trên chính màn lịch chứ không đẻ
                     thêm mục menu. display="always" để bấm được khi chưa
                     tích dòng nào — nút chạy cho cả lịch. -->
                <header>
                    <button name="rp_action_tinh_duong_gang" type="object"
                            string="Tính đường găng" display="always"
                            class="btn-secondary"/>
                    <button name="rp_action_chot_baseline" type="object"
                            string="Chốt baseline" display="always"
                            class="btn-secondary"
                            confirm="Chốt baseline theo ngày kế hoạch hiện tại? Baseline cũ (nếu có) sẽ bị thay."/>
                    <button name="rp_action_xoa_baseline" type="object"
                            string="Xoá baseline" display="always"
                            confirm="Xoá baseline? Sau khi xoá sẽ không đo được độ trượt cho tới khi chốt lại."/>
                </header>
            </list>
        </field>
    </record>

    <!-- Action: công việc xây dựng -->
    <record id="action_rp_schedule_tasks" model="ir.actions.act_window">
        <field name="name">Lịch thi công (công việc)</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="domain">[('rp_contract_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_task_search_rp_panel"/>
    </record>

    <!-- ===== Gantt =====
         Gantt là màn hình nhận diện của cả nghề tiến độ, nhưng trước đây
         CHỈ vào được bằng nút trên form Dự án / Hợp đồng — không một mục
         menu nào trỏ tới, nên người dùng phải biết trước mới tìm ra.
         Mở từ menu thì không truyền dự án; thành phần JS đã xử lý sẵn
         trường hợp đó (domain rỗng = lấy toàn bộ lịch). -->
    <record id="action_rp_schedule_gantt" model="ir.actions.client">
        <field name="name">Gantt tiến độ</field>
        <field name="tag">rp_schedule.gantt</field>
    </record>

    <menuitem id="menu_rp_schedule_gantt" name="Gantt tiến độ"
              parent="rp_estimate.menu_schedule"
              action="action_rp_schedule_gantt" sequence="5"/>

    <!-- ===== Mốc chính =====
         Ban lãnh đạo không đọc 228 dòng công việc; họ hỏi đúng mấy mốc:
         bao giờ xong móng, bao giờ đóng điện, bao giờ COD. Trường
         `is_milestone` đã có từ lâu nhưng chưa có màn nào lọc theo nó. -->
    <record id="view_rp_milestone_list" model="ir.ui.view">
        <field name="name">project.task.list.rp.milestone</field>
        <field name="model">project.task</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Mốc chính" default_order="planned_end, wbs_seq"
                  create="0"
                  decoration-danger="exec_status == 'late'"
                  decoration-success="exec_status == 'done'">
                <field name="wbs_code" string="Mã WBS"/>
                <field name="name" string="Mốc"/>
                <field name="rp_contract_id" string="Hợp đồng"
                       optional="show"/>
                <field name="planned_end" string="Ngày mốc"/>
                <field name="baseline_end" string="Baseline"
                       optional="show"/>
                <field name="baseline_slip_days" string="Trượt (ngày)"
                       optional="show"/>
                <field name="progress_percent" string="% hoàn thành"
                       widget="progressbar"/>
                <field name="is_critical" string="Găng" optional="show"/>
                <field name="rp_event_marker" string="Vạch trục"
                       optional="show"/>
                <field name="exec_status" string="Tình trạng" widget="badge"
                       decoration-muted="exec_status == 'not_started'"
                       decoration-info="exec_status == 'in_progress'"
                       decoration-success="exec_status == 'done'"
                       decoration-danger="exec_status == 'late'"/>
            </list>
        </field>
    </record>

    <record id="action_rp_milestones" model="ir.actions.act_window">
        <field name="name">Mốc chính</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_rp_milestone_list"/>
        <field name="search_view_id" ref="view_task_search_rp_panel"/>
        <field name="domain">[('rp_contract_id', '!=', False),
                              ('is_milestone', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa đánh dấu mốc nào
            </p>
            <p>
                Đánh dấu "Là mốc" trên công việc để nó hiện ở đây. Mốc là
                thứ ban lãnh đạo hỏi, không phải 228 dòng công việc.
            </p>
        </field>
    </record>

    <!-- Mốc chính mở bằng GANTT chứ không bằng danh sách: mốc là ĐIỂM
         thời gian, đọc trên một trục chung thì thấy ngay cái nào đã trễ
         (bên trái vạch "Hôm nay") và cái nào dồn cục — danh sách bắt
         người đọc tự sắp ngày trong đầu.
         Ba làn Dự án → Gói thầu → Hợp đồng nằm trên CÙNG trục, nên mốc
         của gói này chặn mốc của gói kia là nhìn ra được. -->
    <record id="action_rp_milestone_gantt" model="ir.actions.client">
        <field name="name">Mốc chính</field>
        <field name="tag">rp_schedule.gantt</field>
        <field name="params" eval="{'mode': 'milestone'}"/>
    </record>

    <menuitem id="menu_rp_milestone_gantt" name="Mốc chính"
              parent="rp_estimate.menu_schedule"
              action="action_rp_milestone_gantt" sequence="15"/>

    <!-- Giữ danh sách: Gantt để NHÌN, danh sách để LỌC và XUẤT. Cùng một
         tập dữ liệu, hai cách dùng khác nhau. -->
    <menuitem id="menu_rp_milestones" name="Danh sách mốc"
              parent="rp_estimate.menu_schedule"
              action="action_rp_milestones" sequence="16"/>

    <record id="action_rp_schedule_tasks_list_view"
            model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rp_schedule_task_list"/>
        <field name="act_window_id" ref="action_rp_schedule_tasks"/>
    </record>

    <record id="action_rp_schedule_my_tasks" model="ir.actions.act_window">
        <field name="name">Công việc của tôi</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="domain">[('rp_contract_id', '!=', False), ('user_ids', 'in', uid)]</field>
        <field name="search_view_id" ref="view_task_search_rp_panel"/>
    </record>
</odoo>
