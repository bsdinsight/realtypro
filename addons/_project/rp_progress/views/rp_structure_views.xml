<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Danh sách hạng mục: thêm ba cột tiến độ KHỐI LƯỢNG. Trước đây
         màn này chỉ có Khái toán, nên nhìn vào không biết hạng mục nào
         đã nghiệm thu tới đâu — phải mở Gantt hạng mục mới thấy, mà
         Gantt thì không cộng tổng và không lọc được.
         `progress_percent` đã ở thang 0–100 nên dùng progressbar, KHÔNG
         dùng widget percentage (widget đó nhân thêm 100 lần nữa). -->
    <record id="view_rp_structure_list_inherit_progress" model="ir.ui.view">
        <field name="name">rp.structure.list.progress</field>
        <field name="model">rp.structure</field>
        <field name="inherit_id" ref="rp_cost_base.view_rp_structure_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='estimate_total']" position="after">
                <field name="estimate_value" string="BAC (Σ BOQ)"
                       widget="monetary" width="200px" sum="Tổng BAC"/>
                <field name="progress_value" string="Giá trị nghiệm thu"
                       widget="monetary" width="200px"
                       sum="Tổng đã nghiệm thu"/>
                <field name="progress_percent" string="% hoàn thành"
                       widget="progressbar"/>
                <field name="date_actual_start" string="Bắt đầu thực tế"
                       optional="hide"/>
                <field name="date_actual_end" string="Kết thúc thực tế"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_rp_structure_form_inherit_progress" model="ir.ui.view">
        <field name="name">rp.structure.form.progress</field>
        <field name="model">rp.structure</field>
        <field name="inherit_id"
               ref="rp_cost_base.view_rp_structure_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='estimate']" position="after">
                <page string="Dự toán (BOQ)" name="boq">
                    <field name="boq_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="project_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="category_id"/>
                            <field name="cost_element" optional="show"/>
                            <field name="description"/>
                            <field name="uom_id"/>
                            <field name="quantity"/>
                            <field name="unit_price" width="185px"/>
                            <field name="amount" width="185px" sum="Tổng dự toán"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="boq_total" widget="monetary"/>
                    </group>
                    <p class="text-muted">
                        Dự toán chi tiết theo đầu việc (khối lượng × đơn
                        giá). Khi có BOQ, dự toán = Σ BOQ; chưa bóc thì dùng số
                        khai tay. BBN nghiệm thu sẽ trỏ vào các dòng này.
                    </p>
                </page>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Tiến độ thi công">
                    <group string="Kế hoạch">
                        <field name="date_planned_start"/>
                        <field name="date_planned_end"/>
                    </group>
                    <group string="Thực tế (từ BBN approved)">
                        <field name="date_actual_start"/>
                        <field name="date_actual_end"/>
                        <field name="progress_value"/>
                        <field name="estimate_value"/>
                        <field name="progress_percent"
                               widget="progressbar"/>
                        <field name="status" widget="badge"
                               decoration-info="status == 'not_started'"
                               decoration-warning="status == 'in_progress'"
                               decoration-success="status == 'completed'"
                               decoration-danger="status == 'delayed'"
                               decoration-muted="status == 'paused'"/>
                        <field name="days_delayed"
                               invisible="not is_delayed"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Màn hình "Dự toán".

         Dự toán của một hạng mục KHÔNG phải tổng của hai bảng: nó là
         BOQ nếu đã bóc, còn chưa bóc thì lấy số khai tay
         (estimate_value = boq_total or estimate_total). Vì vậy màn hình
         mang tên Dự toán phải hiện CẢ HAI nguồn cạnh con số cuối, nếu
         không người xem không biết số mình đang nhìn là số bóc hay số
         ước — hai thứ chênh nhau rất xa về độ tin cậy. -->
    <record id="view_rp_structure_list_estimate" model="ir.ui.view">
        <field name="name">rp.structure.list.estimate</field>
        <field name="model">rp.structure</field>
        <field name="arch" type="xml">
            <list string="Dự toán theo hạng mục" sample="1" expand="1"
                  create="false" decoration-muted="not active">
                <field name="code" width="110px"/>
                <field name="name" width="340px"/>
                <field name="project_id"/>
                <field name="structure_type" optional="hide"/>
                <field name="boq_total" string="Bóc từ BOQ"
                       widget="monetary" width="190px" sum="Σ BOQ"/>
                <field name="estimate_total" string="Khai tay"
                       widget="monetary" width="190px" sum="Σ khai tay"/>
                <field name="estimate_value" string="Dự toán"
                       widget="monetary" width="200px" sum="Tổng dự toán"/>
                <field name="estimate_source" string="Nguồn" widget="badge"
                       decoration-success="estimate_source == 'boq'"
                       decoration-warning="estimate_source == 'manual'"
                       decoration-danger="estimate_source == 'none'"/>
                <field name="progress_value" string="Đã nghiệm thu"
                       widget="monetary" width="190px" optional="show"
                       sum="Σ nghiệm thu"/>
                <field name="progress_percent" string="% hoàn thành"
                       widget="progressbar" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rp_structure_search_estimate" model="ir.ui.view">
        <field name="name">rp.structure.search.estimate</field>
        <field name="model">rp.structure</field>
        <field name="inherit_id" ref="rp_cost_base.view_rp_structure_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="f_est_boq" string="Đã bóc BOQ"
                        domain="[('estimate_source', '=', 'boq')]"/>
                <filter name="f_est_manual" string="Còn chạy bằng số khai tay"
                        domain="[('estimate_source', '=', 'manual')]"/>
                <filter name="f_est_none" string="Chưa có dự toán"
                        domain="[('estimate_source', '=', 'none')]"/>
                <separator/>
                <filter name="g_est_source" string="Nguồn dự toán"
                        context="{'group_by': 'estimate_source'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_rp_structure_estimate" model="ir.actions.act_window">
        <field name="name">Dự toán</field>
        <field name="res_model">rp.structure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="view_id" ref="view_rp_structure_list_estimate"/>
        <field name="search_view_id" ref="view_rp_structure_search_estimate"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Chưa có hạng mục nào</p>
            <p>Dự toán từng hạng mục lấy từ BOQ nếu đã bóc khối lượng,
               chưa bóc thì lấy số khai tay trên form hạng mục. Cột
               "Nguồn" cho biết con số đang nhìn là số bóc hay số ước.</p>
        </field>
    </record>

    <menuitem id="menu_finance_estimate"
              name="Dự toán"
              parent="rp_estimate.menu_finance"
              action="action_rp_structure_estimate"
              sequence="12"/>

    <record id="view_rp_structure_kanban_progress" model="ir.ui.view">
        <field name="name">rp.structure.kanban.progress</field>
        <field name="model">rp.structure</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="name"/>
                <field name="progress_percent"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="is_delayed"/>
                <field name="days_delayed"/>
                <field name="date_planned_end"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <strong><field name="name"/></strong>
                            <div>Dự án: <field name="project_id"/></div>
                            <field name="progress_percent"
                                   widget="progressbar"/>
                            <div t-if="record.is_delayed.raw_value"
                                 class="text-danger">
                                <i class="fa fa-exclamation-triangle"/>
                                Trễ <field name="days_delayed"/> ngày
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
