<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_guarantee_check_expiry" model="ir.cron">
        <field name="name">BL: tự đặt expired + nhắc sắp hết hạn</field>
        <field name="model_id" ref="model_re_bank_guarantee"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall"
               eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
