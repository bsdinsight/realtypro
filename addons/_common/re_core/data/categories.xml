<?xml version="1.0" encoding="utf-8"?>
<!--
    Module categories for the Realty Pro suite.

    Declared as data records here so the four-category structure
    (Realty + Realty/Sales + Realty/Project + Realty/Living) is
    created consistently every time a customer database is
    initialised, without needing post-install SQL fixups.

    Each module manifest sets ``'category': 'Realty/<Suite>'`` (or
    just ``'Realty'`` for foundation modules); Odoo's module loader
    matches that path against these records by `name` and
    `parent_id.name` and links the module accordingly.

    `noupdate="1"`: once created, the categories are sticky — name
    edits in this file won't overwrite a customer's potentially
    customised translations. Add new sub-categories by appending new
    records, never by reassigning existing IDs.
-->
<odoo>
    <data noupdate="1">

        <record id="module_category_realty" model="ir.module.category">
            <field name="name">Realty</field>
            <field name="description">
                Realty Pro — a Vietnamese real-estate platform.
                The root category groups every Realty module together
                in the Apps directory; sub-categories below split the
                three operational suites.
            </field>
            <field name="sequence">10</field>
        </record>

        <record id="module_category_realty_sales" model="ir.module.category">
            <field name="name">Sales</field>
            <field name="parent_id" ref="module_category_realty"/>
            <field name="description">Sales operations: programs, pricing, bookings, contracts.</field>
            <field name="sequence">20</field>
        </record>

        <record id="module_category_realty_project" model="ir.module.category">
            <field name="name">Project</field>
            <field name="parent_id" ref="module_category_realty"/>
            <field name="description">Project / construction: estimates, milestones, BOQ, contractors, handover.</field>
            <field name="sequence">30</field>
        </record>

        <record id="module_category_realty_living" model="ir.module.category">
            <field name="name">Living</field>
            <field name="parent_id" ref="module_category_realty"/>
            <field name="description">Community operations: residents, service fees, facilities, maintenance, complaints.</field>
            <field name="sequence">40</field>
        </record>

    </data>
</odoo>
