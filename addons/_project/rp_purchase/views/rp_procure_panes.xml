<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Pane lọc cho ba màn cuối chuỗi mua sắm.

      Cả ba dùng view tìm kiếm RIÊNG (mode primary) chứ không kế thừa
      view gốc của Odoo: view tìm kiếm của hoá đơn và thanh toán dùng
      chung cho cả bán lẫn mua, thêm pane vào đó là nó hiện luôn ở màn
      hoá đơn bán hàng — nơi những bộ lọc này vô nghĩa.

      Pane chỉ nhận m2o/m2m/selection của CHÍNH model, không đi xuyên
      quan hệ: `account.move.project_id` dùng được vì rp_loan_bridge đã
      thêm trường thật có store; `account.payment` thì KHÔNG có trục dự
      án nên pane của nó dừng ở nhà cung cấp / sổ nhật ký / trạng thái.
    -->

    <!-- ===== Đơn mua ===== -->
    <record id="view_purchase_order_search_procure" model="ir.ui.view">
        <field name="name">purchase.order.search.procure</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search position="inside">
                <searchpanel>
                    <field name="rp_project_id" string="Dự án"
                           icon="fa-folder" enable_counters="1"/>
                    <field name="partner_id" string="Nhà cung cấp"
                           icon="fa-truck" enable_counters="1"
                           select="multi"/>
                    <field name="state" string="Trạng thái" icon="fa-tasks"
                           enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ===== Hoá đơn nhà cung cấp ===== -->
    <record id="view_account_invoice_filter_procure" model="ir.ui.view">
        <field name="name">account.move.search.procure</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search position="inside">
                <searchpanel>
                    <field name="project_id" string="Dự án" icon="fa-folder"
                           enable_counters="1"/>
                    <field name="partner_id" string="Nhà cung cấp"
                           icon="fa-truck" enable_counters="1"
                           select="multi"/>
                    <field name="payment_state" string="Tình trạng TT"
                           icon="fa-money" enable_counters="1"
                           select="multi"/>
                    <field name="state" string="Trạng thái"
                           icon="fa-check-square-o" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_procure_vendor_bills" model="ir.actions.act_window">
        <field name="name">Hoá đơn nhà cung cấp</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="search_view_id"
               ref="view_account_invoice_filter_procure"/>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <!-- ===== Thanh toán ===== -->
    <record id="view_account_payment_search_procure" model="ir.ui.view">
        <field name="name">account.payment.search.procure</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search position="inside">
                <searchpanel>
                    <field name="partner_id" string="Đơn vị thụ hưởng"
                           icon="fa-truck" enable_counters="1"/>
                    <field name="journal_id" string="Sổ nhật ký"
                           icon="fa-book" enable_counters="1"
                           select="multi"/>
                    <field name="state" string="Trạng thái" icon="fa-tasks"
                           enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_procure_payments" model="ir.actions.act_window">
        <field name="name">Thanh toán</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'supplier')]</field>
        <field name="search_view_id"
               ref="view_account_payment_search_procure"/>
        <field name="context">{'default_partner_type': 'supplier', 'default_payment_type': 'outbound'}</field>
    </record>

</odoo>
