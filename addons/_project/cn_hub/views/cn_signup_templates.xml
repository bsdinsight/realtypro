<!-- ===== Đã gửi đơn xin tham gia gói thầu ===== -->
<template id="apply_done" name="Realty Pro Network — Đã đăng ký tham gia">
  <t t-call="web.layout">
    <t t-set="html_data" t-value="{'lang': 'vi'}"/>
    <t t-set="title">Đăng ký tham gia gói thầu — Realty Pro Network</t>
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:#12283A;background:#F3F8F9;line-height:1.55}
a{text-decoration:none}
.rpn-header{background:#0F2C3F;color:#fff}
.rpn-nav{max-width:1060px;margin:0 auto;padding:0 20px;display:flex;align-items:center;height:60px}
.rpn-logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;color:#fff}
.rpn-logo-mark{width:34px;height:34px;border-radius:8px;background:linear-gradient(150deg,#46D6C0,#0E8C99);display:flex;align-items:center;justify-content:center}
.rpn-logo span{color:#46D6C0}
.rpn-main{padding:56px 20px}
.rpn-card{max-width:600px;margin:0 auto;background:#fff;border:1px solid #DDE7EA;border-radius:16px;padding:34px;box-shadow:0 20px 46px -34px rgba(15,44,63,.4)}
.rpn-ic{width:62px;height:62px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.rpn-ic.wait{background:#FFF3EA}.rpn-ic.ok{background:#E4F7EF}
.rpn-card h2{font-size:23px;font-weight:800;margin-bottom:8px;text-align:center}
.rpn-card .lead{color:#4A6472;font-size:15px;margin-bottom:22px;text-align:center}
.rpn-t{background:#F3F8F9;border:1px solid #DDE7EA;border-radius:12px;padding:16px;margin-bottom:20px}
.rpn-t b{display:block;font-size:16px;margin-bottom:6px}
.rpn-t small{color:#4A6472;font-size:13.5px;display:block}
.rpn-step{display:flex;gap:11px;align-items:flex-start;margin-bottom:12px;font-size:14px}
.rpn-dot{width:22px;height:22px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800}
.rpn-dot.done{background:#0F9D6C;color:#fff}.rpn-dot.now{background:#F59E0B;color:#241A00}.rpn-dot.todo{background:#E3F1F2;color:#6C8792}
.rpn-note{background:#E3F1F2;border-left:3px solid #0E8C99;padding:12px 14px;border-radius:8px;font-size:13.5px;color:#12283A;margin:20px 0}
.rpn-cta{display:block;background:#F59E0B;color:#241A00;font-weight:800;font-size:15.5px;padding:13px;border-radius:11px;text-align:center}
.rpn-hint{text-align:center;font-size:13.5px;color:#4A6472;margin-top:13px}
.rpn-hint a{color:#0E8C99;font-weight:700}
      </style>
    </t>
    <header class="rpn-header">
      <div class="rpn-nav">
        <a class="rpn-logo" href="/">
          <span class="rpn-logo-mark"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F2C3F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V9l7-5 7 5v12"/><path d="M9 21v-6h6v6"/></svg></span>
          <b>Realty Pro <span>Network</span></b>
        </a>
      </div>
    </header>
    <main class="rpn-main">
      <div class="rpn-card">
        <t t-if="invite.approval == 'approved'">
          <div class="rpn-ic ok"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0F9D6C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>
          <h2>Bạn đã được duyệt tham gia</h2>
          <p class="lead">Mở gói thầu để tải hồ sơ mời thầu và nộp hồ sơ dự thầu.</p>
        </t>
        <t t-elif="invite.approval == 'rejected'">
          <div class="rpn-ic wait"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg></div>
          <h2>Đăng ký chưa được chấp thuận</h2>
          <p class="lead">Bên mời thầu chưa chấp thuận đăng ký của bạn cho gói này.</p>
        </t>
        <t t-else="">
          <div class="rpn-ic wait"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
          <h2 t-if="created">Đã gửi đăng ký tham gia</h2>
          <h2 t-else="">Đăng ký của bạn đang chờ duyệt</h2>
          <p class="lead">Tổng thầu của gói thầu sẽ xem xét hồ sơ năng lực của bạn.</p>
        </t>

        <div class="rpn-t">
          <b t-esc="tender.name"/>
          <small>Bên mời thầu: <t t-esc="tender.gc_partner_id.name or 'Đang cập nhật'"/></small>
          <small t-if="tender.deadline">Hạn nộp hồ sơ: <t t-esc="tender.deadline.strftime('%d/%m/%Y')"/></small>
        </div>

        <div class="rpn-step">
          <span class="rpn-dot done">✓</span>
          <span><b>Đã gửi đăng ký</b> — <t t-esc="company.name"/></span>
        </div>
        <div class="rpn-step">
          <span t-attf-class="rpn-dot #{invite.approval == 'pending' and 'now' or 'done'}">2</span>
          <span>
            <b t-if="invite.approval == 'pending'">Chờ tổng thầu duyệt</b>
            <b t-elif="invite.approval == 'approved'">Đã được duyệt</b>
            <b t-else="">Không được chấp thuận</b>
          </span>
        </div>
        <div class="rpn-step">
          <span t-attf-class="rpn-dot #{invite.approval == 'approved' and 'now' or 'todo'}">3</span>
          <span>Tải hồ sơ mời thầu &amp; nộp hồ sơ dự thầu</span>
        </div>

        <div class="rpn-note" t-if="invite.approval == 'pending'">
          <b>Hồ sơ năng lực của bạn: <t t-esc="progress_pct"/> hoàn thiện.</b>
          Tổng thầu duyệt dựa trên hồ sơ này — hồ sơ càng đầy đủ, cơ hội được duyệt càng cao.
          Bạn sẽ nhận email khi có kết quả.
        </div>

        <a class="rpn-cta" t-if="invite.approval == 'approved'"
           t-attf-href="/my/tenders/#{tender.id}">Mở gói thầu &amp; nộp hồ sơ →</a>
        <a class="rpn-cta" t-else="" href="/my/contractor">Hoàn thiện hồ sơ năng lực →</a>
        <p class="rpn-hint">Hoặc <a href="/">xem các gói thầu khác</a>.</p>
      </div>
    </main>
  </t>
</template>

<!-- ===== /dang-ky?invite=<token> — ĐĂNG KÝ TỪ LỜI MỜI =====
