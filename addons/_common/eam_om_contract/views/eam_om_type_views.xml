<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eam_om_contract_type_list" model="ir.ui.view">
        <field name="name">eam.om.contract.type.list</field>
        <field name="model">eam.om.contract.type</field>
        <field name="arch" type="xml">
            <list string="Loại hợp đồng O&amp;M"
                  decoration-muted="not quan_ly_o_day">
                <field name="code"/>
                <field name="name"/>
                <field name="nhom"/>
                <field name="ap_dung"/>
                <field name="uu_tien_demo" optional="show"/>
                <field name="contract_count"/>
                <field name="quan_ly_o_day"/>
                <field name="quan_ly_o_dau"/>
                <field name="noi_dung" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_eam_om_contract_type_form" model="ir.ui.view">
        <field name="name">eam.om.contract.type.form</field>
        <field name="model">eam.om.contract.type</field>
        <field name="arch" type="xml">
            <form string="Loại hợp đồng O&amp;M">
                <sheet>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" placeholder="OM-01"/></h1>
                        <field name="name" placeholder="Tên loại hợp đồng"/>
                    </div>
                    <group>
                        <group>
                            <field name="nhom"/>
                            <field name="ap_dung"/>
                            <field name="uu_tien_demo"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="quan_ly_o_day" widget="boolean_toggle"/>
                            <field name="quan_ly_o_dau"
                                   invisible="quan_ly_o_day"
                                   required="not quan_ly_o_day"/>
                            <field name="contract_count"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="quan_ly_o_day">
                        <i class="fa fa-external-link me-1"/>
                        Loại này <b>đã có nơi quản lý riêng</b> nên không
                        chọn được khi lập hợp đồng O&amp;M. Nó vẫn nằm trong
                        danh mục để thấy đủ bức tranh hợp đồng của giai
                        đoạn vận hành — lập ở hai nơi thì cùng một hợp đồng
                        có hai bản và không bản nào là bản thật.
                    </div>
                    <group string="Nội dung quản lý chính">
                        <field name="noi_dung" nolabel="1"/>
                    </group>
                    <group string="Ghi chú">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eam_om_contract_type_search" model="ir.ui.view">
        <field name="name">eam.om.contract.type.search</field>
        <field name="model">eam.om.contract.type</field>
        <field name="arch" type="xml">
            <search string="Loại hợp đồng">
                <field name="code"/>
                <field name="name"/>
                <field name="noi_dung"/>
                <filter name="f_o_day" string="Quản lý tại đây"
                        domain="[('quan_ly_o_day', '=', True)]"/>
                <filter name="f_noi_khac" string="Quản lý ở nơi khác"
                        domain="[('quan_ly_o_day', '=', False)]"/>
                <filter name="f_uu_tien" string="Có trong phạm vi demo"
                        domain="[('uu_tien_demo', '>', 0)]"/>
                <separator/>
                <filter name="f_gio" string="Điện gió"
                        domain="[('ap_dung', 'in', ['gio', 'ca_hai'])]"/>
                <filter name="f_mt" string="Điện mặt trời"
                        domain="[('ap_dung', 'in', ['mat_troi', 'ca_hai'])]"/>
                <separator/>
                <filter name="g_nhom" string="Nhóm"
                        context="{'group_by': 'nhom'}"/>
                <filter name="g_ut" string="Ưu tiên demo"
                        context="{'group_by': 'uu_tien_demo'}"/>
            </search>
        </field>
    </record>

    <record id="action_eam_om_contract_type" model="ir.actions.act_window">
        <field name="name">Loại hợp đồng O&amp;M</field>
        <field name="res_model">eam.om.contract.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_nhom': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Danh mục loại hợp đồng</p>
            <p>Giai đoạn vận hành có nhiều loại hợp đồng chứ không chỉ một
            hợp đồng O&amp;M tổng. Dòng <b>mờ</b> là loại đã có nơi quản lý
            riêng — giữ trong danh mục để thấy đủ bức tranh, nhưng lập hợp
            đồng thì lập ở đúng chỗ.</p>
        </field>
    </record>

    <menuitem id="menu_eam_om_contract_type" name="Loại hợp đồng"
              parent="menu_eam_om_danh_muc"
              action="action_eam_om_contract_type" sequence="10"/>

</odoo>
