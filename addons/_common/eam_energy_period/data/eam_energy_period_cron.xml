<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_dung_ky" model="ir.cron">
        <field name="name">EAMOne: dựng sản lượng theo kỳ</field>
        <field name="model_id" ref="model_eam_energy_period"/>
        <field name="state">code</field>
        <field name="code">model._cron_dung()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <!-- Sau cron bảng tổ máy (0h10), vì kỳ CỘNG TỪ bảng ấy. Chạy
             trước thì kỳ của hôm qua dựng bằng bảng của hôm kia. -->
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=0, minute=20, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
