<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Thêm BBN nghiệm thu + HĐ nhà thầu vào hộp thoại hồ sơ giải
         ngân của module lõi re_loan_dossier. -->
    <record id="view_rp_loan_dossier_form_inherit_bridge"
            model="ir.ui.view">
        <field name="name">rp.loan.disbursement.dossier.form.bridge</field>
        <field name="model">rp.loan.disbursement.dossier</field>
        <field name="inherit_id"
               ref="re_loan_dossier.view_rp_loan_disbursement_dossier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='source']" position="inside">
                <field name="acceptance_id"
                       options="{'no_quick_create': True}"/>
                <field name="contract_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_re_loan_note_disbursement_form_dossier_bridge"
            model="ir.ui.view">
        <field name="name">re.loan.note.disbursement.form.dossier.bridge</field>
        <field name="model">re.loan.note.disbursement</field>
        <field name="inherit_id"
               ref="re_loan_dossier.view_re_loan_note_disbursement_form_inherit_dossier"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dossier']//list/field[@name='contractor_id']"
                   position="before">
                <field name="acceptance_id" string="BBN nghiệm thu"/>
            </xpath>
            <xpath expr="//page[@name='dossier']//list/field[@name='contractor_id']"
                   position="after">
                <field name="contract_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
