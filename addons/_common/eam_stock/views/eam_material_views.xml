<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eam_material_request_list" model="ir.ui.view">
        <field name="name">eam.material.request.list</field>
        <field name="model">eam.material.request</field>
        <field name="arch" type="xml">
            <list string="Yêu cầu vật tư"
                  decoration-danger="is_emergency and not ho_so_du"
                  decoration-muted="state in ('cancelled','rejected')">
                <field name="name" string="Số yêu cầu"/>
                <field name="date" string="Ngày"/>
                <field name="requester_id" string="Người yêu cầu"/>
                <field name="source" string="Phát sinh từ"/>
                <field name="work_order_id" string="Lệnh công việc" optional="show"/>
                <field name="warehouse_id" string="Kho"/>
                <field name="urgency" string="Mức khẩn" widget="badge"
                       decoration-danger="urgency == 'emergency'"
                       decoration-warning="urgency == 'urgent'"/>
                <field name="amount_total" string="Giá trị" widget="monetary"
                       width="185px" sum="Σ"/>
                <field name="ho_so_du" string="Hồ sơ đủ"
                       invisible="not is_emergency" optional="show"/>
                <field name="han_hoan_thien" string="Hạn hồ sơ" optional="hide"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state in ('approved','issued')"
                       decoration-info="state == 'to_approve'"/>
                <field name="is_emergency" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_eam_material_request_form" model="ir.ui.view">
        <field name="name">eam.material.request.form</field>
        <field name="model">eam.material.request</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu vật tư">
                <header>
                    <button name="action_trinh_duyet" type="object"
                            string="Trình duyệt" class="oe_highlight"
                            invisible="state != 'draft' or is_emergency"/>
                    <button name="action_cap_phat_khan" type="object"
                            string="Cấp phát khẩn cấp" class="btn-danger"
                            invisible="state != 'draft' or not is_emergency"/>
                    <button name="action_duyet" type="object" string="Duyệt"
                            class="oe_highlight"
                            invisible="state != 'to_approve' or not can_duyet"/>
                    <button name="action_tu_choi" type="object" string="Từ chối"
                            invisible="state != 'to_approve' or not can_duyet"/>
                    <button name="action_cap_phat" type="object"
                            string="Cấp phát" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_dong_ho_so" type="object"
                            string="Đã hoàn thiện hồ sơ"
                            invisible="not is_emergency or ho_so_du
                                       or state in ('draft','cancelled')"/>
                    <button name="action_ve_nhap" type="object" string="Về nháp"
                            invisible="state in ('draft','issued','cancelled')"/>
                    <button name="action_huy" type="object" string="Huỷ"
                            invisible="state in ('issued','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-danger" role="status"
                         invisible="not is_emergency or ho_so_du
                                    or state == 'draft'">
                        <b>Xuất khẩn cấp — còn NỢ HỒ SƠ.</b> Hàng đã rời
                        kho khi chưa ai duyệt. Yêu cầu này nằm trong danh
                        sách nợ cho tới khi bấm <i>Đã hoàn thiện hồ sơ</i>.
                        Hạn: <field name="han_hoan_thien" readonly="1"
                                    class="oe_inline"/>
                    </div>

                    <group>
                        <group string="Ai xin, xin ở đâu">
                            <field name="requester_id"/>
                            <field name="warehouse_id"
                                   options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="urgency"/>
                            <field name="is_emergency" invisible="1"/>
                            <field name="can_duyet" invisible="1"/>
                        </group>
                        <group string="Phát sinh từ đâu">
                            <field name="source"/>
                            <field name="work_order_id" invisible="source != 'wo'"
                                   required="source == 'wo'"/>
                            <field name="outage_id" invisible="source != 'outage'"
                                   required="source == 'outage'"/>
                            <field name="pm_schedule_id" invisible="source != 'pm'"/>
                            <field name="location_id"
                                   required="urgency == 'emergency'"/>
                        </group>
                    </group>

                    <group string="Bắt buộc khi xuất khẩn cấp"
                           invisible="not is_emergency">
                        <field name="receiver_name"
                               required="urgency == 'emergency'"/>
                        <field name="ho_so_du" readonly="1"/>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id" string="Vật tư" width="280px"/>
                            <field name="lot_id" string="Sê-ri / lô"
                                   options="{'no_create_edit': True}"/>
                            <field name="qty" string="Số lượng"/>
                            <field name="uom_id" string="ĐVT"/>
                            <field name="ton_kha_dung" string="Khả dụng"/>
                            <field name="unit_cost" string="Đơn giá"
                                   widget="monetary" width="170px"/>
                            <field name="amount" string="Thành tiền"
                                   widget="monetary" width="185px" sum="Σ"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_total" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                    </group>

                    <notebook>
                        <page string="Cấp duyệt" name="approval"
                              invisible="not approval_ids">
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="sequence" string="Cấp"/>
                                    <field name="rule_id" string="Theo luật"/>
                                    <field name="group_id" string="Nhóm duyệt"/>
                                    <field name="state" string="Trạng thái"
                                           widget="badge"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'"/>
                                    <field name="user_id" string="Người xử lý"/>
                                    <field name="date_action" string="Lúc"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lý do" name="reason">
                            <field name="reason" nolabel="1"
                                   placeholder="Vì sao cần vật tư này…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eam_material_request_search" model="ir.ui.view">
        <field name="name">eam.material.request.search</field>
        <field name="model">eam.material.request</field>
        <field name="arch" type="xml">
            <search string="Tìm yêu cầu vật tư">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="work_order_id"/>
                <filter name="f_cho_duyet" string="Chờ tôi duyệt"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="f_no_hs" string="Nợ hồ sơ xuất khẩn cấp"
                        domain="[('is_emergency', '=', True),
                                 ('ho_so_du', '=', False),
                                 ('state', 'not in', ('draft','cancelled'))]"/>
                <separator/>
                <filter name="g_trang_thai" string="Trạng thái"
                        context="{'group_by': 'state'}"/>
                <filter name="g_khan" string="Mức khẩn"
                        context="{'group_by': 'urgency'}"/>
                <filter name="g_kho" string="Kho"
                        context="{'group_by': 'warehouse_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_eam_material_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu vật tư</field>
        <field name="res_model">eam.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eam_material_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có yêu cầu nào</p>
            <p>Xin <b>vật tư đã có trong kho</b> — khác với <i>yêu cầu công
               việc</i> (báo có việc cần làm) và <i>yêu cầu mua</i> (xin tiền
               mua thứ chưa có).</p>
        </field>
    </record>

    <record id="action_eam_material_request_no_hs" model="ir.actions.act_window">
        <field name="name">Nợ hồ sơ xuất khẩn cấp</field>
        <field name="res_model">eam.material.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_emergency', '=', True),
                              ('ho_so_du', '=', False),
                              ('state', 'not in', ('draft','cancelled'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không còn nợ hồ sơ nào</p>
            <p>Hàng đã rời kho khi chưa ai duyệt. Mỗi dòng ở đây là một
               món nợ chứng từ — đóng sớm chừng nào tốt chừng ấy, vì
               người nhớ sự việc cũng quên dần.</p>
        </field>
    </record>

    <record id="view_eam_approval_rule_list" model="ir.ui.view">
        <field name="name">eam.approval.rule.list</field>
        <field name="model">eam.approval.rule</field>
        <field name="arch" type="xml">
            <list string="Luật duyệt" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Tên luật" width="280px"/>
                <field name="amount_from" string="Giá trị từ"
                       widget="monetary" width="185px"/>
                <field name="part_kind" string="Chỉ loại"/>
                <field name="criticality" string="Mức quan trọng"/>
                <field name="rotable_only" string="Quay vòng"/>
                <field name="group_id" string="Nhóm duyệt"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_eam_approval_rule" model="ir.actions.act_window">
        <field name="name">Luật duyệt yêu cầu vật tư</field>
        <field name="res_model">eam.approval.rule</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa khai luật nào</p>
            <p>Không luật nào áp dụng nghĩa là <b>duyệt tự động</b> — giá
               trị dưới mọi ngưỡng. Để yêu cầu treo chờ một người duyệt
               không tồn tại là cách chắc chắn làm tắc kho.</p>
        </field>
    </record>

    <menuitem id="menu_eam_material_request" name="Yêu cầu vật tư"
              parent="eam_core.menu_eam_ops"
              action="action_eam_material_request" sequence="36"/>
    <menuitem id="menu_eam_material_no_hs" name="Nợ hồ sơ xuất khẩn cấp"
              parent="eam_core.menu_eam_ops"
              action="action_eam_material_request_no_hs" sequence="37"/>
    <menuitem id="menu_eam_approval_rule" name="Luật duyệt vật tư"
              parent="eam_core.menu_eam_config"
              action="action_eam_approval_rule" sequence="49"/>

</odoo>
