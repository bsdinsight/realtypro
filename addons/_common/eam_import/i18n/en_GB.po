msgstr "the store rejected %(n)d readings: %(d)s"

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "khí tượng"
msgstr "weather"

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "khớp trong sai số %s%%"
msgstr "matches within a tolerance of %s%%"

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "ngày %(a)s nằm trong tương lai (hôm nay %(b)s). Gần như luôn là lỗi ô ngày hoặc lỗi múi giờ của máy xuất tệp."
msgstr "%(a)s lies in the future (today is %(b)s). Almost always a wrong date cell, or the time zone of the machine that produced the file."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "ngày %(a)s đã có dữ liệu (%(b)s). Bật cờ \"cho phép ghi đè\" nếu đây là bản sửa."
msgstr "%(a)s already has data (%(b)s). Tick \"allow overwriting\" if this is a corrected version."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "nhà máy \"%s\" chưa khai chuỗi điểm đo nào — không có bậc để ghi vào."
msgstr "plant \"%s\" has no metering chain declared — there is no stage to write into."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
