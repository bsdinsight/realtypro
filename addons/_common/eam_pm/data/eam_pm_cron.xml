<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_eam_pm_sinh_lenh" model="ir.cron">
        <field name="name">EAMOne: sinh lệnh bảo trì phòng ngừa</field>
        <field name="model_id" ref="model_eam_pm_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_sinh_lenh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=6, minute=0, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
