#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__clear_on_wo_done
msgid "Bỏ tích khi cảnh báo phải tự tắt bằng số đo trở lại bình thường — sửa xong mà độ rung vẫn cao thì chưa sửa được."
msgstr "Untick when the alarm must clear itself through readings returning to normal — if vibration is still high after the repair, it was not repaired."

