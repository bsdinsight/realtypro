<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_energy_period_list" model="ir.ui.view">
        <field name="name">rp.energy.period.list</field>
        <field name="model">rp.energy.period</field>
        <field name="arch" type="xml">
            <!-- Mới nhất lên đầu. Sổ sản lượng là thứ người ta mở ra để
                 xem THÁNG VỪA RỒI thế nào, không phải để đọc lại tháng
                 đầu tiên của nhà máy. Trước đây xếp xuôi nên muốn xem
                 tháng gần nhất phải cuộn qua ba năm. -->
            <list string="Sản lượng theo kỳ" default_order="date_from desc"
                  decoration-info="is_pre_cod"
                  decoration-danger="shortfall_mwh &gt; 0">
                <field name="name"/>
                <field name="project_id" optional="hide"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="is_pre_cod" string="Chạy thử" optional="show"/>
                <field name="gross_mwh" string="Phát gộp" sum="Σ"/>
                <field name="auxiliary_mwh" string="Tự dùng" optional="hide"
                       sum="Σ"/>
                <field name="loss_mwh" string="Tổn thất" optional="hide"
                       sum="Σ"/>
                <field name="net_mwh" string="Giao nhận ròng" sum="Σ"/>
                <field name="curtailed_mwh" string="Bị cắt giảm" sum="Σ"/>
                <field name="availability_percent" string="Khả dụng %"/>
                <field name="shortfall_mwh" string="Hụt khả dụng" sum="Σ"
                       optional="show"/>
                <!-- Hai cột này VẪN cộng được. Khi các dòng khác loại
                     tiền, Odoo tự quy về đồng tiền công ty rồi gắn dấu
                     `?` vào dòng tổng để báo là có trộn tiền — con số
                     ấy ĐÚNG, dấu `?` chỉ là lời cảnh báo chứ không phải
                     dấu hiệu hỏng. Đã kiểm: tổng ba nhà máy Odoo in ra
                     khớp từng đồng với phép quy đổi làm tay.
                     Giữ nhóm ngoài cùng là Dự án thì mỗi dòng tổng chỉ
                     có một loại tiền, nên không cần quy đổi và cũng
                     không còn dấu `?`. -->
                <field name="revenue_total" width="190" string="Doanh thu"
                       sum="Σ"/>
                <field name="deemed_total" width="190" optional="show"
                       string="Trong đó cắt giảm" sum="Σ"/>
                <!-- Cột quy đổi không phải để chữa con số trên, mà để
                     NÓI RA cơ sở quy đổi: nó hiện ngay trên từng dòng
                     nên người đọc thấy tỷ giá đã dùng, thay vì phải tin
                     một dấu `?` ở cuối bảng. Và bảng xoay cần một thước
                     đo không phụ thuộc loại tiền. -->
                <field name="revenue_company" width="195" sum="Σ"
                       string="Doanh thu quy đổi" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'invoiced'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_energy_period_form" model="ir.ui.view">
        <field name="name">rp.energy.period.form</field>
        <field name="model">rp.energy.period</field>
        <field name="arch" type="xml">
            <form string="Sản lượng kỳ">
                <header>
                    <button name="action_chot_cong_to" type="object"
                            string="Chốt công-tơ" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_xuat_hoa_don" type="object"
                            string="Xuất hoá đơn tiền điện"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_ve_nhap" type="object"
                            string="Về nháp" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not is_pre_cod">
                        <strong>Kỳ chạy thử (trước COD).</strong>
                        Điện phát ra trước ngày vận hành thương mại được mua
                        với giá chiết khấu theo điều khoản của từng hợp đồng.
                    </div>
                    <group>
                        <group string="Kỳ">
                            <field name="project_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="is_pre_cod" invisible="1"/>
                        </group>
                        <group string="Khả dụng">
                            <field name="availability_percent"/>
                            <field name="shortfall_mwh"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Chuỗi sản lượng">
                        <group>
                            <field name="gross_mwh"/>
                            <field name="auxiliary_mwh"/>
                            <field name="loss_mwh"/>
                        </group>
                        <group>
                            <field name="net_mwh"/>
                            <field name="curtailed_mwh"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Phân bổ theo hợp đồng" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="ppa_id"/>
                                    <field name="partner_id"/>
                                    <field name="energy_mwh" sum="Σ"/>
                                    <field name="curtailed_mwh" sum="Σ"/>
                                    <field name="tariff"/>
                                    <field name="amount_energy" width="190"
                                           sum="Σ"/>
                                    <field name="deemed_amount" width="190"
                                           sum="Σ"/>
                                    <field name="amount" width="190" sum="Σ"/>
                                    <field name="invoice_id"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Sản lượng là chuỗi số theo thời gian; đọc nó bằng danh sách thì
         mắt phải tự dựng lấy cái biểu đồ. Hai kiểu xem dưới đây để người
         dùng thấy ngay mùa vụ và xu hướng — điện gió mạnh cuối năm, điện
         mặt trời mạnh mùa khô — thứ mà 83 dòng số không nói ra được.
         ĐO bằng `net_mwh` chứ không phải doanh thu: sản lượng cùng một
         đơn vị cho mọi dự án, còn tiền thì mỗi dự án một loại. -->
    <record id="view_rp_energy_period_graph" model="ir.ui.view">
        <field name="name">rp.energy.period.graph</field>
        <field name="model">rp.energy.period</field>
        <field name="arch" type="xml">
            <graph string="Sản lượng theo kỳ" type="bar" sample="1">
                <field name="date_from" interval="month"/>
                <field name="project_id"/>
                <field name="net_mwh" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_rp_energy_period_pivot" model="ir.ui.view">
        <field name="name">rp.energy.period.pivot</field>
        <field name="model">rp.energy.period</field>
        <field name="arch" type="xml">
            <pivot string="Sản lượng theo kỳ" sample="1">
                <field name="project_id" type="row"/>
                <field name="date_from" interval="year" type="col"/>
                <field name="net_mwh" type="measure"/>
                <!-- Đo bằng cột QUY ĐỔI: bảng xoay vốn sinh ra để cộng
                     chéo nhiều dự án, mà cộng cột theo đồng tiền hợp
                     đồng là cộng đô với đồng. -->
                <field name="revenue_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rp_energy_period_search" model="ir.ui.view">
        <field name="name">rp.energy.period.search</field>
        <field name="model">rp.energy.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="f_d_date_from" string="Từ ngày"
                        date="date_from"/>
                <separator/>
                <filter name="f_pre_cod" string="Kỳ chạy thử"
                        domain="[('is_pre_cod', '=', True)]"/>
                <filter name="f_curtailed" string="Có bị cắt giảm"
                        domain="[('curtailed_mwh', '&gt;', 0)]"/>
                <filter name="f_shortfall" string="Khả dụng dưới cam kết"
                        domain="[('shortfall_mwh', '&gt;', 0)]"/>
                <separator/>
                <!-- `g_duan` để NGOÀI CÙNG và bật sẵn. Mỗi dự án bán
                     bằng một loại tiền — SAVA1 thu đô, DG123 và PV50
                     thu đồng. Gom theo dự án trước thì mỗi dòng tổng
                     chỉ có một loại tiền, đọc thẳng được, không phải
                     qua quy đổi. (Để phẳng thì Odoo VẪN cộng đúng — nó
                     tự quy về đồng tiền công ty và gắn dấu `?` — nhưng
                     một con số đã quy đổi thì khó đối chiếu với hợp
                     đồng hơn là con số nguyên tệ.) -->
                <filter name="g_duan" string="Dự án"
                        context="{'group_by': 'project_id'}"/>
                <filter name="g_nam" string="Năm"
                        context="{'group_by': 'date_from:year'}"/>
                <filter name="g_quy" string="Quý"
                        context="{'group_by': 'date_from:quarter'}"/>
                <filter name="g_month" string="Tháng"
                        context="{'group_by': 'date_from:month'}"/>
                <filter name="g_trangthai" string="Trạng thái"
                        context="{'group_by': 'state'}"/>
                <searchpanel>
                    <field name="project_id" string="Dự án" icon="fa-folder"
                           enable_counters="1"/>
                    <field name="state" string="Trạng thái" icon="fa-tasks"
                           enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_rp_energy_period" model="ir.actions.act_window">
        <field name="name">Sản lượng &amp; doanh thu</field>
        <field name="res_model">rp.energy.period</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="view_id" ref="view_rp_energy_period_list"/>
        <field name="search_view_id" ref="view_rp_energy_period_search"/>
        <!-- Mở sẵn DỰ ÁN rồi tới NĂM. Hai cấp này không phải để cho đẹp:
             một danh sách phẳng 83 dòng trải ba năm thì dòng tổng cộng cả
             2023 lẫn 2026 lại với nhau, mà cộng doanh thu bốn năm thành
             một số thì chẳng trả lời được câu hỏi nào. Gom theo năm là
             ra ngay câu người ta thật sự hỏi: "năm nay nhà máy phát được
             bao nhiêu, thu về bao nhiêu, so với năm ngoái thế nào".
             Dự án đứng ngoài vì lý do loại tiền — xem ghi chú ở `g_duan`. -->
        <field name="context">{'search_default_g_duan': 1,
                               'search_default_g_nam': 2}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Chưa có kỳ sản lượng
               nào</p>
            <p>Mỗi kỳ là một lần chốt công-tơ: phát gộp − tự dùng − tổn
               thất = <b>giao nhận ròng</b>, tức phần được trả tiền. Chốt
               công-tơ xong thì sản lượng được phân bổ cho từng hợp đồng
               mua bán điện theo tỷ lệ đã ký.</p>
            <p>Màn này mở sẵn ở dạng gom nhóm theo <b>Dự án</b> rồi
               <b>Năm</b>. Đổi cách gom ở menu <i>Gom nhóm</i>, hoặc chuyển
               sang biểu đồ và bảng xoay ở góc trên bên phải để nhìn mùa vụ
               và xu hướng.</p>
        </field>
    </record>

    <menuitem id="menu_rp_energy_period" name="Sản lượng &amp; doanh thu"
              parent="menu_energy_sale" action="action_rp_energy_period"
              sequence="20"/>
</odoo>
