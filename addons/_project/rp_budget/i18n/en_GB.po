#: model_terms:ir.ui.view,arch_db:rp_budget.view_rp_disbursement_search
msgid "Gói thầu"
msgstr "Tender packages"

#. module: rp_budget
#: model:ir.model.fields,help:rp_budget.field_re_project__budget_current
msgid "Gốc + phát sinh đã duyệt. Đây là số tiền được phép tiêu tại thời điểm này."
msgstr "Original plus approved variations. This is the amount that may be spent as things stand."

#. module: rp_budget
#: model:ir.model.fields,help:rp_budget.field_re_project__cash_need
msgid "Kế hoạch chi của các tháng tới, CỘNG phần đã quá hạn mà chưa chi — khoản quá hạn vẫn phải trả, và thường phải trả ngay."
msgstr "The spending planned for the coming months, PLUS anything already overdue and unpaid — an overdue amount still has to be paid, and usually at once."

#. module: rp_budget
#: model:ir.model.fields,field_description:rp_budget.field_rp_budget_phase__currency_id
#: model:ir.model.fields,field_description:rp_budget.field_rp_contingency_drawdown__currency_id
#: model:ir.model.fields,field_description:rp_budget.field_rp_cost_baseline__currency_id
#: model:ir.model.fields,field_description:rp_budget.field_rp_cost_baseline_line__currency_id
#: model:ir.model.fields,field_description:rp_budget.field_rp_disbursement_line__currency_id
msgid "Loại tiền"
msgstr "Currency"

#. module: rp_budget
#: model:ir.model.fields,help:rp_budget.field_rp_budget_phase__currency_id
#: model:ir.model.fields,help:rp_budget.field_rp_contingency_drawdown__currency_id
#: model:ir.model.fields,help:rp_budget.field_rp_cost_baseline__currency_id
#: model:ir.model.fields,help:rp_budget.field_rp_cost_baseline_line__currency_id
#: model:ir.model.fields,help:rp_budget.field_rp_disbursement_line__currency_id
msgid "Loại tiền quy chiếu của dự án — BAC/EV/AC và mọi chỉ số EVM đều hiện theo loại tiền này. Dự án ở nước ngoài hoặc ký hợp đồng bằng ngoại tệ thì đặt đúng loại tiền của dự án; các khoản ghi bằng tiền khác sẽ được QUY ĐỔI về đây."
msgstr "The project's reference currency — BAC, EV, AC and every EVM indicator are shown in it. For a project abroad, or one contracted in a foreign currency, set the project's own currency; amounts recorded in other currencies are CONVERTED into it."

