    <!-- ============ Nhóm ③: sáu dòng của mẫu BT1 còn thiếu ============ -->

    <!-- Hướng gió gộp từ 12 tua-bin bằng phép VECTƠ. Cộng số học thì
         350° với 10° ra 180° — ngược hẳn hướng thật, mà vẫn là một con
         số hợp lệ trong khoảng 0–360. -->
    <record id="pl_wd_wdir" model="eam.daily.profile.line">
        <field name="profile_id" ref="profile_wind"/>
        <field name="sequence">30</field>
        <field name="khoi">khi_tuong</field>
        <field name="name">Average Wind Direction</field>
        <field name="kieu">so</field>
        <field name="nguon">historian</field>
        <field name="tag_code">T*_WD</field>
        <field name="gop_nhieu">vector</field>
        <field name="cach_lay">gop</field>
        <field name="don_vi">Degrees</field>
        <field name="so_le">0</field>
    </record>

    <!-- Khả dụng luỹ kế: sổ khả dụng đã cộng sẵn, đọc chứ không cộng
         lại — cộng lần hai là mở đường cho hai con số cho cùng tháng. -->
    <record id="pl_wd_ebam" model="eam.daily.profile.line">
        <field name="profile_id" ref="profile_wind"/>
        <field name="sequence">12</field>
        <field name="khoi">kha_dung</field>
