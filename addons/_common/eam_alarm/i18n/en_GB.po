msgstr "Alarm — %s"

#. module: eam_alarm
#: model:ir.model.fields,field_description:eam_alarm.field_eam_alarm_rule__note
#: model_terms:ir.ui.view,arch_db:eam_alarm.view_eam_alarm_rule_form
msgid "Diễn giải"
msgstr "Explanation"

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__window_days
msgid "Dùng cho \"đồng hồ đứng im\" và \"mất số đọc\". Đặt ngắn hơn nhịp gửi số đọc thì luật nổ liên tục — nhịp ngày thì đừng đặt 1."
msgstr "For \"meter stalled\" and \"no readings\". Set it shorter than the reading interval and the rule fires constantly — with a daily interval, do not set 1."

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm__request_id
msgid "Dùng cho cảnh báo mức thấp: vào sổ yêu cầu để người điều độ phân loại, thay vì vào thẳng danh sách việc phải làm."
msgstr "For low-level alarms: send it to the request log for the dispatcher to triage, instead of straight onto the list of work to be done."

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__lech_pct
msgid "Dùng cho luật lệch cảm biến. Tính theo phần trăm của trị LỚN HƠN, để một cảm biến chết về 0 vẫn lộ ra thay vì chia cho 0."
msgstr "For sensor-deviation rules. Computed as a percentage of the LARGER value, so that a sensor dying to 0 still shows up instead of dividing by zero."

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__threshold_2
msgid "Dùng cho điều kiện DẢI: ngưỡng dưới ở ô Ngưỡng, ngưỡng trên ở đây."
msgstr "For BAND conditions: the lower bound goes in Threshold, the upper bound here."

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__operator
