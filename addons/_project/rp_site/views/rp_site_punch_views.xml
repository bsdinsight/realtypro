<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rp_site_punch_kanban" model="ir.ui.view">
        <field name="name">rp.site.punch.kanban</field>
        <field name="model">rp.site.punch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="severity"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <div class="fw-bold">
                                <field name="code"/> · <field name="name"/>
                            </div>
                            <div class="text-muted">
                                <field name="location"/>
                            </div>
                            <div>
                                <field name="responsible_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span t-if="record.severity.raw_value == 'critical'"
                                      class="badge text-bg-danger">Nghiêm trọng</span>
                                <span t-elif="record.severity.raw_value == 'major'"
                                      class="badge text-bg-warning">Nặng</span>
                                <span t-else="" class="badge text-bg-secondary">Nhẹ</span>
                                <span t-if="record.is_overdue.raw_value"
                                      class="badge text-bg-danger">QUÁ HẠN</span>
                                <field name="deadline"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rp_site_punch_list" model="ir.ui.view">
        <field name="name">rp.site.punch.list</field>
        <field name="model">rp.site.punch</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="code"/>
                <field name="name"/>
                <field name="contract_id" optional="show"/>
                <field name="structure_id" optional="show"/>
                <field name="location" optional="show"/>
                <field name="responsible_id"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'major'"/>
                <field name="deadline"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'open'"
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state == 'fixed'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_site_punch_form" model="ir.ui.view">
        <field name="name">rp.site.punch.form</field>
        <field name="model">rp.site.punch</field>
        <field name="arch" type="xml">
            <form string="Punch">
                <header>
                    <button name="action_start" string="Bắt đầu xử lý"
                            type="object" class="btn-primary"
                            invisible="state != 'open'"/>
                    <button name="action_fixed" string="Đã khắc phục"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Đóng (nghiệm thu lại đạt)"
                            type="object" class="btn-primary"
                            invisible="state != 'fixed'"
                            groups="re_base.group_re_manager"/>
                    <button name="action_reopen" string="Mở lại"
                            type="object"
                            invisible="state not in ('fixed', 'closed')"/>
                    <button name="action_cancel" string="Huỷ" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,in_progress,fixed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                        <h2><field name="name" placeholder="Lỗi / khiếm khuyết..."/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="structure_id" options="{'no_create': True}"/>
                            <field name="location"/>
                            <field name="diary_id" readonly="1"
                                   invisible="not diary_id"/>
                        </group>
                        <group>
                            <field name="severity"/>
                            <field name="responsible_id"/>
                            <field name="deadline"/>
                            <field name="is_overdue" invisible="not is_overdue"/>
                            <field name="assigned_user_id"
                                   widget="many2one_avatar_user"/>
                            <field name="fixed_date" invisible="not fixed_date"/>
                            <field name="closed_date" invisible="not closed_date"/>
                        </group>
                    </group>
                    <field name="description"
                           placeholder="Mô tả chi tiết lỗi, nguyên nhân, yêu cầu khắc phục..."/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_site_punch_search" model="ir.ui.view">
        <field name="name">rp.site.punch.search</field>
        <field name="model">rp.site.punch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="contract_id"/>
                <field name="responsible_id"/>
                <filter name="filter_open" string="Chưa đóng"
                        domain="[('state', 'in', ('open', 'in_progress', 'fixed'))]"/>
                <filter name="filter_overdue" string="Quá hạn"
                        domain="[('state', 'in', ('open', 'in_progress')),
                                 ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_critical" string="Nghiêm trọng"
                        domain="[('severity', '=', 'critical')]"/>
                <filter string="HĐ nhà thầu" name="group_contract"
                        context="{'group_by': 'contract_id'}"/>
                <filter string="Nhà thầu chịu trách nhiệm" name="group_responsible"
                        context="{'group_by': 'responsible_id'}"/>
                <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_site_punch" model="ir.actions.act_window">
        <field name="name">Punch list</field>
        <field name="res_model">rp.site.punch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ghi nhận lỗi hiện trường đầu tiên
            </p>
            <p>Theo dõi vòng đời lỗi: Mở → Đang xử lý → Đã khắc phục →
               Đóng. Punch chưa đóng hiện cảnh báo trên HĐ nhà thầu
               trước khi nghiệm thu/thanh toán.</p>
        </field>
    </record>
</odoo>
