#. module: eam_energy_period
#: model_terms:ir.ui.view,arch_db:eam_energy_period.view_period_form
msgid ""
".\n"
"                        Để trống chứ không ghi 0% — \"đạt 0% kế hoạch\" và\n"
"                        \"chưa ai khai kế hoạch\" là hai chuyện khác hẳn."
msgstr ""
".\n"
"                        Left empty rather than written as 0% — \"0% of plan\n"
"                        achieved\" and \"nobody has declared a plan\" are two quite\n"
"                        different things."

#. module: eam_energy_period
#: model_terms:ir.ui.view,arch_db:eam_energy_period.view_period_form
msgid "<b>Chưa so được với mục tiêu:</b>"
msgstr "<b>Not yet comparable with the target:</b>"

#. module: eam_energy_period
#: model_terms:ir.actions.act_window,help:eam_energy_period.action_period
msgid ""
"Bỏ <b>Nhà máy</b> khỏi hàng là <b>cộng gộp</b> nhiều nhà\n"
"            máy; để lại là <b>đặt cạnh nhau</b>. Muốn luỹ kế từ đầu năm\n"
"            thì bật <b>Từ đầu năm tới nay</b>, thêm <b>Cùng kỳ năm\n"
"            trước</b> để so hai năm."
msgstr ""
"Taking <b>Plant</b> out of the rows <b>adds the plants\n"
"            together</b>; leaving it in <b>sets them side by side</b>. For a\n"
"            running total from the start of the year turn on <b>Year to date</b>,\n"
"            and add <b>Same period last year</b> to compare two years."

#. module: eam_energy_period
#: model_terms:ir.actions.act_window,help:eam_energy_period.action_period
msgid ""
"Chưa có ngày nào có\n"
