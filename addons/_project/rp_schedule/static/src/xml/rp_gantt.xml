<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rp_schedule.RpGantt">
        <div class="rp-gantt-container"
             t-att-class="'rp-gantt-mode-' + mode">
            <div class="rp-gantt-toolbar">
                <span class="rp-gantt-title" t-esc="state.title"/>
                <!-- Ở màn mốc, ba huy hiệu này đã nằm trong dải số liệu
                     bên dưới — để lại là vừa lặp vừa làm vỡ thanh công cụ. -->
                <span t-if="mode !== 'milestone'"
                      class="badge text-bg-secondary ms-2">
                    <t t-esc="state.count"/> công việc
                </span>
                <span t-if="mode !== 'milestone' and state.showCriticalPath and state.critCount"
                      class="badge text-bg-danger ms-1"
                      title="Số công việc trên đường găng — chậm ở đây là chậm cả dự án.">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.critCount"/> việc găng
                </span>
                <span t-if="mode !== 'milestone' and state.showCriticalPath and state.worstFloat &lt; 0"
                      class="badge text-bg-warning ms-1"
                      title="Dư địa âm: chuỗi việc này không còn kịp mốc phải xong.">
                    Dư địa <t t-esc="state.worstFloat"/> ngày
                </span>
                <!-- Chú giải màu hình thoi — màn mốc là chỗ họp tiến độ,
                     người xem phải đọc được màu mà không cần hỏi ai. -->
                <span t-if="mode === 'milestone'"
                      class="text-muted small ms-3 rp-gantt-chu-giai d-none d-xxl-flex">
                    <span class="rp-cham" style="background:#c0453b"/>trễ
                    <span class="rp-cham ms-2" style="background:#2e8b57"/>đã xong
                    <span class="rp-cham ms-2" style="background:#e0a460"/>chưa tới
                    <span t-if="state.showCriticalPath" class="ms-2">
                        · mốc mờ = ngoài đường găng
                    </span>
                </span>
                <span t-else="" class="text-muted small ms-3 d-none d-lg-inline">
                    Kéo thanh đổi ngày · Double-click mở chi tiết ·
                    Chuột phải thêm/xoá
                </span>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <!-- Baseline (kế hoạch gốc) -->
                    <button type="button" class="btn btn-sm"
                            t-att-class="state.showBaseline ? 'btn-info' : 'btn-outline-secondary'"
                            t-att-disabled="!state.hasBaseline"
                            t-on-click="() => this.toggleBaseline()"
                            title="Hiện/ẩn baseline (kế hoạch gốc). Cần chốt baseline trước.">
                        <i class="fa fa-flag-o me-1"/>Baseline
                    </button>
                    <!-- So với bản chụp lịch nào. Mặc định là bản ĐẦU
                         (kế hoạch gốc): tái lập kế hoạch luôn xoá sạch
                         vết trượt, so với bản vừa lập thì bao giờ cũng
                         ra 0 ngày. -->
                    <select t-if="state.baselines.length"
                            class="form-select form-select-sm rp-gantt-chon-goc"
                            t-on-change="(ev) => this.setBaselineVersion(ev)"
                            title="Đường cơ sở vẽ theo phiên bản này, và độ trượt cũng đo so với nó.">
                        <option t-foreach="state.baselines" t-as="bl"
                                t-key="bl.id" t-att-value="bl.id"
                                t-att-selected="bl.id === state.baselineId">
                            So với <t t-esc="bl.name"/>
                            (<t t-esc="bl.date"/>)
                        </option>
                    </select>
                    <!-- Vạch dọc trên trục -->
                    <button type="button" class="btn btn-sm"
                            t-att-class="state.showMarkers ? 'btn-secondary' : 'btn-outline-secondary'"
                            t-on-click="() => this.toggleMarkers()"
                            title="Hiện/ẩn các vạch dọc (hôm nay, NTP, đóng điện, COD…). Nhãn của chúng che mất thanh của mấy dòng nằm cùng độ cao.">
                        <i class="fa fa-flag me-1"/>Vạch mốc
                    </button>
                    <!-- Ghi tên + dư địa cạnh hình thoi -->
                    <button t-if="mode === 'milestone'" type="button"
                            class="btn btn-sm"
                            t-att-class="state.showLabels ? 'btn-secondary' : 'btn-outline-secondary'"
                            t-on-click="() => this.toggleLabels()"
                            title="Ghi tên mốc và dư địa ngay cạnh hình thoi trên trục.">
                        <i class="fa fa-tag me-1"/>Nhãn mốc
                    </button>
                    <!-- Đường găng (critical path) -->
                    <button type="button" class="btn btn-sm"
                            t-att-class="state.showCriticalPath ? 'btn-danger' : 'btn-outline-secondary'"
                            t-on-click="() => this.toggleCriticalPath()"
                            title="Tô đỏ đường găng — chuỗi công việc quyết định ngày về đích.">
                        <i class="fa fa-exclamation-triangle me-1"/>Đường găng
                    </button>
                    <!-- Chốt / cập nhật baseline -->
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            t-on-click="() => this.setBaseline()"
                            title="Chốt lịch kế hoạch hiện hành làm baseline gốc.">
                        <i class="fa fa-thumb-tack me-1"/>
                        <t t-if="state.hasBaseline">Cập nhật baseline</t>
                        <t t-else="">Chốt baseline</t>
                    </button>
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-foreach="['Day','Week','Month']" t-as="m" t-key="m"
                                type="button" class="btn"
                                t-att-class="state.viewMode === m ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setViewMode(m)">
                            <t t-if="m === 'Day'">Ngày</t>
                            <t t-elif="m === 'Week'">Tuần</t>
                            <t t-else="">Tháng</t>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dải số liệu CỐ ĐỊNH: năm câu ban lãnh đạo hỏi, xếp đúng
                 thứ tự người ta hỏi. Nằm ngoài vùng cuộn nên cuộn lịch
                 xuống đâu nó vẫn còn đó — người trình bày chỉ tay vào
                 đây là nói được, không phải lục. -->
            <div t-if="mode === 'milestone' and state.brief"
                 class="rp-gantt-brief">
                <t t-set="b" t-value="state.brief"/>

                <!-- 1. Bao giờ về đích -->
                <div class="rp-the">
                    <div class="rp-nhan">Về đích</div>
                    <div class="rp-so" t-esc="b.ve_dich ? b.ve_dich.label : '—'"/>
                    <div class="rp-phu" t-if="b.ve_dich">
                        còn <b t-esc="b.ve_dich.days_left"/> ngày
                        <span t-if="b.truot_max" class="rp-xau">
                            · trượt <t t-esc="b.truot_max"/> ngày so gốc
                            (<t t-esc="b.truot_count"/> mốc)
                        </span>
                        <span t-elif="b.co_goc" class="rp-tot">· bám đúng gốc</span>
                        <span t-else="" class="text-muted">· chưa chốt baseline</span>
                    </div>
                </div>

                <!-- 2. Đã đạt bao nhiêu -->
                <div class="rp-the">
                    <div class="rp-nhan">Mốc đã đạt</div>
                    <div class="rp-so">
                        <t t-esc="b.xong"/>/<t t-esc="b.tong"/>
                        <span class="rp-nho"><t t-esc="b.phan_tram"/>%</span>
                    </div>
                    <div class="rp-thanh">
                        <span t-attf-style="width:{{b.phan_tram}}%"/>
                    </div>
                    <div class="rp-phu rp-goi">
                        <!-- khoá theo chỉ số, không theo mã gói: gói
                             chưa đặt mã sẽ cho hai khoá rỗng trùng nhau -->
                        <span t-foreach="b.theo_goi" t-as="g" t-key="g_index"
                              class="me-2">
                            <t t-esc="g.code"/>
                            <b><t t-esc="g.xong"/>/<t t-esc="g.tong"/></b>
                            <span t-if="g.tre" class="rp-xau">
                                ·<t t-esc="g.tre"/> trễ</span>
                        </span>
                    </div>
                </div>

                <!-- 3. Đang trễ cái gì -->
                <div class="rp-the" t-att-class="b.tre ? 'rp-the-xau' : ''">
                    <div class="rp-nhan">Đang trễ</div>
                    <div class="rp-so">
                        <t t-esc="b.tre"/> mốc
                    </div>
                    <div class="rp-phu">
                        <t t-if="b.tre_ds.length">
                            <div t-foreach="b.tre_ds" t-as="m" t-key="m.id"
                                 class="rp-dong">
                                <span class="rp-ten" t-esc="m.name"/>
                                <span class="rp-xau">trễ <t t-esc="m.days"/> ngày</span>
                            </div>
                        </t>
                        <t t-else="">không mốc nào quá hạn</t>
                    </div>
                </div>

                <!-- 4. Đường găng — câu duy nhất ban lãnh đạo quyết được -->
                <div class="rp-the rp-the-gang" t-if="b.gang_moc">
                    <div class="rp-nhan">Đường găng — chậm ở đây là chậm cả dự án</div>
                    <div class="rp-so">
                        <t t-esc="b.gang_moc"/> mốc
                        <span class="rp-nho">dư địa <t t-esc="b.du_dia"/> ngày</span>
                    </div>
                    <div class="rp-phu" t-if="b.gang_ke">
                        giữ bằng được:
                        <b t-esc="b.gang_ke.name"/>
                        · <t t-esc="b.gang_ke.date"/>
                        · còn <t t-esc="b.gang_ke.days"/> ngày
                    </div>
                    <div class="rp-phu" t-else="">
                        mọi mốc găng đã đạt
                    </div>
                </div>

                <!-- 5. Sắp phải quyết cái gì -->
                <div class="rp-the">
                    <div class="rp-nhan">Tới hạn gần nhất</div>
                    <t t-if="b.ke_tiep.length">
                        <div t-foreach="b.ke_tiep" t-as="m" t-key="m.id"
                             class="rp-dong">
                            <span class="rp-ten" t-esc="m.name"/>
                            <span class="rp-ngay">
                                <t t-esc="m.date"/> · còn <b t-esc="m.days"/> ngày
                            </span>
                        </div>
                    </t>
                    <div t-else="" class="rp-phu">không còn mốc nào phía trước</div>
                </div>
            </div>

            <div t-if="state.error" class="alert alert-danger m-3"
                 t-esc="state.error"/>
            <div t-if="state.empty and !state.loading" class="alert alert-info m-3">
                <t t-if="state.isProject">
                    Chưa hợp đồng nào của dự án này có lịch thi công. Vào
                    từng hợp đồng để import hoặc nhập lịch.
                </t>
                <t t-else="">
                    Hợp đồng này chưa có công việc nào. Import lịch thi công
                    (MS Project XML / Excel) hoặc chuột phải để thêm.
                </t>
            </div>
            <div t-if="state.loading" class="text-center text-muted p-5">
                <i class="fa fa-spinner fa-spin me-2"/>Đang tải Gantt…
            </div>

            <!-- Syncfusion EJ2 Gantt mount vào đây (tự có treegrid +
                 timeline + splitter + toolbar zoom + context menu) -->
            <div class="rp-gantt-ej2" t-ref="gantt"/>
        </div>
    </t>

</templates>
