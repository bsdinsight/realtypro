#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_contract_form
msgid ""
"<b>Số đơn vị đo khả dụng</b> là mẫu số, và\n"
"                                đây là chỗ sai im lặng nhất: ba mươi tua-bin\n"
"                                chạy một ngày là <b>720 giờ-máy</b>, không\n"
"                                phải 24. Để 0 nghĩa là coi cả nhà máy là một\n"
"                                đơn vị — chỉ đúng khi hợp đồng cam kết ở cấp\n"
"                                nhà máy. Nút máy tính chỉ <b>đếm thử</b> vị\n"
"                                trí con; không phải vị trí nào cũng là một\n"
"                                tổ máy nên người khai vẫn phải tự quyết."
msgstr ""
"<b>Availability units</b> is the denominator, and this is\n"
"                                the quietest place to get it wrong: thirty turbines\n"
"                                running for one day is <b>720 unit-hours</b>, not\n"
"                                24. 0 means the whole plant counts as one unit —\n"
"                                right only when the contract commits at plant level.\n"
"                                The calculator button only <b>counts</b> child\n"
"                                locations; not every location is a unit, so the\n"
"                                person declaring it still has to decide."

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_period_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        Kỳ này có dòng <b>chưa đo được</b>, hoặc có nhiều\n"
"                        <b>giờ dừng chưa quy trách nhiệm</b>. Con số khả\n"
"                        dụng có thể đang đẹp vì chưa ai phân loại chứ không\n"
"                        phải vì nhà thầu làm tốt — xem cột \"Chưa quy (%)\"\n"
"                        trước khi đem biên bản này đi ký."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        This period has rows that <b>could not be measured</b>, or a\n"
"                        great many <b>downtime hours with no responsibility\n"
"                        attributed</b>. The availability figure may be flattering\n"
"                        because nobody has classified them rather than because the\n"
"                        contractor did well — look at the \"Unattributed (%)\" column\n"
"                        before taking this certificate to be signed."

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_contract_type_form
msgid ""
"<i class=\"fa fa-external-link me-1\"/>\n"
"                        Loại này <b>đã có nơi quản lý riêng</b> nên không\n"
"                        chọn được khi lập hợp đồng O&amp;M. Nó vẫn nằm trong\n"
"                        danh mục để thấy đủ bức tranh hợp đồng của giai\n"
"                        đoạn vận hành — lập ở hai nơi thì cùng một hợp đồng\n"
"                        có hai bản và không bản nào là bản thật."
msgstr ""
"<i class=\"fa fa-external-link me-1\"/>\n"
"                        This type <b>already has a home of its own</b>, so it cannot\n"
"                        be chosen when raising an O&amp;M contract. It stays in the\n"
"                        catalogue so the whole contract picture of the operating\n"
"                        phase is visible — raise it in two places and the same\n"
"                        contract has two copies, neither of them the real one."

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_contract_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                        Đây là bảng hợp đồng <b>riêng của O&amp;M</b>, không\n"
"                        dùng chung với hợp đồng EPC. Hợp đồng EPC là hành\n"
"                        trình một chiều có cổng chặn; hợp đồng O&amp;M là\n"
"                        dịch vụ lặp lại, và thứ quyết định tiền là\n"
"                        <b>con số đo được trong kỳ</b>."
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                        This is a contract table <b>of O&amp;M's own</b>, not shared\n"
"                        with EPC contracts. An EPC contract is a one-way journey\n"
"                        with gates; an O&amp;M contract is a repeating service, and\n"
"                        what decides the money is <b>the figure measured in the\n"
"                        period</b>."

