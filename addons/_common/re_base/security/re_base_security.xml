<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_re_user" model="res.groups">
        <field name="name">Realty Sales / User</field>
        <field name="comment">Sales user - can view projects, units, create cart/booking</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_re_manager" model="res.groups">
        <field name="name">Realty Sales / Manager</field>
        <field name="comment">Sales manager - manages master data, approves discounts</field>
        <field name="implied_ids" eval="[(4, ref('group_re_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_re_admin" model="res.groups">
        <field name="name">Realty Sales / Administrator</field>
        <field name="comment">Full access including system configuration</field>
        <field name="implied_ids" eval="[(4, ref('group_re_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
