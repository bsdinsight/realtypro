<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_rp_progress_root"
              name="Nghiệm thu khối lượng"
              parent="rp_estimate.menu_construction"
              sequence="20"/>

    <menuitem id="menu_rp_progress_acceptance"
              name="BBN Nghiệm thu KL"
              parent="menu_rp_progress_root"
              action="action_rp_progress_acceptance"
              sequence="10"/>

    <!-- ĐVT (Xây dựng) là master data cấu hình 1 lần.
         Trước đây mount vào Realty Core > Configuration. Nhưng Realty
         Core là nhánh của sản phẩm BẤT ĐỘNG SẢN (toà nhà, tầng, căn
         hộ) — khách EPC không dùng và sẽ tắt cả nhánh đó. Tắt xong thì
         ĐVT (Xây dựng) biến mất theo, dù nó là thứ CHỈ ngành xây dựng
         mới cần. Nên chuyển về đúng nhà: EPCOne > Cấu hình. -->
    <menuitem id="menu_rp_progress_uom"
              name="Đơn vị tính (Xây dựng)"
              parent="rp_estimate.menu_rp_configuration"
              action="action_rp_progress_uom"
              sequence="10"/>

    <!-- Phường/Xã cũng vậy: bảng địa giới dùng cho địa chỉ, không phải
         thứ riêng của bất động sản. Nhân bản vào EPCOne để tắt nhánh
         Realty Core không làm mất đường vào.

         Dùng <record> chứ không <menuitem> vì menu này do re_core SỞ
         HỮU — khai lại bằng menuitem ở module khác sẽ tạo ra một menu
         THỨ HAI trùng tên, chứ không dời cái cũ. -->
    <record id="re_core.menu_re_core_admin_unit_ward" model="ir.ui.menu">
        <field name="parent_id" ref="rp_estimate.menu_rp_configuration"/>
        <field name="sequence">90</field>
    </record>

</odoo>
