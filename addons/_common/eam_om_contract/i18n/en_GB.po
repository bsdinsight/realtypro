#. module: eam_om_contract
#: model:ir.model.fields,help:eam_om_contract.field_eam_om_commitment__tran_phat_pct
msgid "Chặn trần theo phí kỳ của nhà máy. Để 0 là KHÔNG chặn — chỉ dùng khi hợp đồng thật sự không có trần, vì không trần thì một kỳ tệ ra khoản phạt lớn hơn cả phí."
msgstr "Capped against the plant's period fee. 0 means NO cap — use it only when the contract genuinely has none, because without a cap one bad period produces a penalty larger than the fee itself."

#. module: eam_om_contract
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_commitment__che_tai
msgid "Chế tài"
msgstr "Penalty regime"

#. module: eam_om_contract
#: model:ir.model.fields,help:eam_om_contract.field_eam_om_period__la_ky_phi
msgid "Chỉ kỳ theo chu kỳ của hợp đồng mới mang phí. Kỳ của chu kỳ khác chỉ để chấm điểm — tính phí cả hai là thu tiền hai lần cho cùng một quãng thời gian."
msgstr "Only a period on the contract's own cycle carries a fee. A period on another cycle is for assessment only — charging for both is charging twice for the same stretch of time."

#. module: eam_om_contract
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_commitment__plant_id
msgid "Chỉ áp cho nhà máy"
msgstr "Only for the plant"

#. module: eam_om_contract
#: model:ir.model.fields,help:eam_om_contract.field_eam_om_contract_type__quan_ly_o_dau
msgid "Chỉ đường khi loại này không quản lý ở module O&M."
msgstr "Says where to go when this type is not managed in the O&M module."

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_period_form
msgid "Chốt kỳ"
msgstr "Close the period"

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_period_form
msgid "Chốt kỳ sẽ đóng băng mức cam kết, số đo được và phí của kỳ này. Sửa hợp đồng sau đó không làm đổi biên bản kỳ này nữa."
msgstr "Closing the period freezes the committed levels, the measured figures and the fee for this period. Editing the contract afterwards no longer changes this period's certificate."

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_period_plant_search
msgid "Có bị phạt"
msgstr "Penalty applies"

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_period_search
msgid "Có cam kết không đạt"
msgstr "Some commitments were not met"

#. module: eam_om_contract
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_period__co_canh_bao
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_period_search
msgid "Có cảnh báo"
msgstr "Has a warning"

#. module: eam_om_contract
#: model:ir.model.fields,help:eam_om_contract.field_eam_om_period__co_canh_bao
msgid "Có dòng chưa đo được, hoặc giờ chưa quy trách nhiệm vượt ngưỡng. Con số ở kỳ này chưa nên đem đi ký."
msgstr "Some rows could not be measured, or the unattributed hours exceed the threshold. The figures for this period are not yet fit to sign."

#. module: eam_om_contract
#: model_terms:ir.ui.view,arch_db:eam_om_contract.view_eam_om_contract_type_search
msgid "Có trong phạm vi demo"
msgstr "Within the demo scope"

#. module: eam_om_contract
