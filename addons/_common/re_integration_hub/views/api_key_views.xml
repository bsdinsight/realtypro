<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_api_key_list" model="ir.ui.view">
        <field name="name">re.api.key.list</field>
        <field name="model">re.api.key</field>
        <field name="arch" type="xml">
            <list string="API Keys" decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="consumer"/>
                <field name="key_preview"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'revoked'"/>
                <field name="last_used"/>
                <field name="use_count"/>
                <field name="expires_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_re_api_key_form" model="ir.ui.view">
        <field name="name">re.api.key.form</field>
        <field name="model">re.api.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke"
                            type="object"
                            string="Revoke"
                            class="btn-danger"
                            invisible="state == 'revoked'"
                            confirm="Revoking is irreversible. Continue?"/>
                    <button name="action_rotate"
                            type="object"
                            string="Rotate Key"
                            class="btn-warning"
                            invisible="state == 'revoked'"
                            confirm="Rotation invalidates the old key immediately. The new key plaintext is shown only once. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g., Project → Sales handover"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="consumer" placeholder="project.capitaland_project"/>
                            <field name="key_preview"/>
                            <field name="expires_at"/>
                        </group>
                        <group>
                            <field name="last_used"/>
                            <field name="use_count"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_re_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">re.api.key</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
