<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        EPCOne suite root menu + Phase 2 v1.4.1 submenu containers.

        IMPORTANT: this file reuses `menu_realty_project_root` xmlid
        from the iter5 placeholder so Odoo treats it as an update of
        the existing record rather than creating a duplicate. This is
        the v1.4.1 fix for the "two EPCOne menus" bug seen on
        the dev DB.

        Phase 2 submenu containers:
        - menu_project_master   (master data, sequence 5)
        - menu_estimate_workflows  (cost plans, sequence 10)

        Iter5 placeholder modules (rp_construction, rp_boq, rp_handover)
        are uninstalled before this deploys; their submenus are removed
        from the DB by Odoo's standard uninstall behavior.
    -->

    <!-- Suite root — reuses iter5 xmlid to REPLACE not duplicate -->
    <menuitem id="menu_realty_project_root"
              name="EPCOne"
              web_icon="rp_estimate,static/description/icon.png"
              sequence="20"
              groups="re_base.group_re_user"/>

    <!-- Project Master submenu (master data — sequence 5) -->
    <menuitem id="menu_project_master"
              name="Project Master"
              parent="menu_realty_project_root"
              sequence="5"/>

    <!-- BỎ nhánh "Estimate" (cũ: sequence 10). "Khái toán" đã chuyển
         sang Tài chính nên nó thành nút rỗng trên thanh ứng dụng: không
         mục con, không action, bấm vào không ra gì. Xoá hẳn khai báo
         chứ không tắt bằng active — `<menuitem>` ghi đè active mỗi lượt
         `-u`, còn bỏ khai báo thì trình nạp tự dọn bản ghi mồ côi. -->

    <!-- ===== Tài chính (Finance) — container, sequence 12 =====
         Con đầu tiên (seq 5) là Dashboard Tài chính (module rp_finance)
         → nhấp "Tài chính" trên navbar mở thẳng dashboard.
         Các module con tự mount vào đây:
         - rp_estimate:        Khái toán (10)
         - rp_finance:         Dashboard (5), Dự toán BOQ (20),
                               Hoá đơn nhà thầu (40), Hồ sơ thanh toán (50),
                               Thanh toán (60)
         - rp_budget:          Ngân sách (25) — nhánh con, gom Mốc ngân
                               sách / Sổ rút dự phòng / Ngân sách theo tháng
         - rp_advance_payment: Tạm ứng (30)
         - rp_contract:        2 báo cáo → menu_finance_reports (90) -->
    <menuitem id="menu_finance"
              name="Tài chính"
              parent="menu_realty_project_root"
              sequence="12"/>

    <!-- Hai nhánh công nợ đặt đối xứng nhau trong Tài chính: tiền ra
         trước, tiền vào sau. Trước đây bốn màn phải trả nằm rải rác xen
         giữa các nhánh khác (Tạm ứng · Hoá đơn nhà thầu · Giải ngân qua
         khế ước · Công nợ phải trả), đọc menu không ra được đường tiền.
         Nhóm này khai ở rp_estimate vì cả ba module chứa bốn màn đó đều
         phụ thuộc nó — khai ở chỗ khác là sinh phụ thuộc chéo. -->
    <menuitem id="menu_finance_payable"
              name="Phải trả"
              parent="menu_finance"
              sequence="40"/>

    <menuitem id="menu_finance_reports"
              name="Báo cáo"
              parent="menu_finance"
              sequence="90"/>

    <!-- ===== Tiến độ — container, sequence 35 =====
         ĐỨNG GIỮA "Hợp đồng" và "Xây dựng": có hợp đồng rồi mới có
         lịch, có lịch rồi mới ra hiện trường.

         Tách khỏi "Xây dựng" vì các thứ về tiến độ vốn nằm rải ở bốn
         chỗ trong đó, mà dropdown ứng dụng bung HẾT mọi cấp nên "Xây
         dựng" bung ra ~25 dòng một lúc. Thêm tầng không làm ngắn lại;
         cách duy nhất để ngắn là tách nhánh gốc mới.

         Ranh giới chia: Tiến độ = THỜI GIAN (lịch, ràng buộc giữa các
         gói, cảnh báo trượt). Xây dựng = CÔNG VIỆC TẠI CHỖ và hồ sơ.

         Các module mount vào:
         - rp_schedule:       Lịch thi công (10)
         - rp_interface:      Ranh giới gói thầu (20)
         - rp_schedule_alert: Cảnh báo tiến độ (30) -->
    <menuitem id="menu_schedule"
              name="Tiến độ"
              parent="menu_realty_project_root"
              sequence="35"/>

    <!-- ===== Hợp đồng (Contracts) — container, sequence 30 =====
         ĐỨNG TRƯỚC "Xây dựng": hợp đồng là cái có trước, mọi thứ ở Xây
         dựng (lịch, nghiệm thu, hồ sơ, phát sinh) đều treo vào một hợp
         đồng — nên thứ tự menu đi theo thứ tự công việc thật.
         Các module mount vào:
         - rp_contract:           HĐ nhà thầu (10), Phụ lục HĐ (30),
                                  Chấm dứt / Thanh lý (40)
         - rp_owner_contract:     HĐ với Chủ đầu tư (20), BBNT với CĐT (25)
         - rp_contract_guarantee: Bảo lãnh HĐ nhà thầu (50) -->
    <menuitem id="menu_contracts"
              name="Hợp đồng"
              parent="menu_realty_project_root"
              sequence="30"/>

    <!-- ===== Xây dựng (Construction) — container, sequence 40 =====
         Nhấp "Xây dựng" mở Dashboard Xây dựng (con seq 5, module
         rp_construction). Các module mount vào:
         - rp_construction: Dashboard (5), Báo cáo (menu_construction_reports)
         - rp_progress:     Nghiệm thu khối lượng (20)
         - rp_site:         Hiện trường (30)
         - rp_rfi:          RFI & Trình duyệt (40)
         - rp_document:     Sổ hồ sơ kỹ thuật
         Lịch thi công / Ranh giới gói thầu / Cảnh báo tiến độ đã chuyển
         sang nhánh gốc "Tiến độ" (sequence 35). -->
    <menuitem id="menu_construction"
              name="Xây dựng"
              parent="menu_realty_project_root"
              sequence="40"/>

    <menuitem id="menu_construction_reports"
              name="Báo cáo"
              parent="menu_construction"
              sequence="90"/>

    <!-- ===== Cấu hình (EPCOne) — master data ít đụng =====
         Cost Categories + Danh mục chi phí chuẩn mount vào đây
         (menus.xml). Group manager — nhất quán Realty Core > Configuration. -->
    <menuitem id="menu_rp_configuration"
              name="Cấu hình"
              parent="menu_realty_project_root"
              sequence="95"
              groups="re_base.group_re_manager"/>

</odoo>
