msgstr "raw value × %s"

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "tên sheet nói ngày %(a)s, ô %(o)s nói ngày %(b)s. Thường là sheet được nhân bản mà quên sửa ô ngày — ghi theo ô thì đè lên dữ liệu của ngày cũ. Bỏ qua cả sheet."
msgstr "the sheet name says %(a)s while cell %(o)s says %(b)s. Usually a sheet copied without correcting the date cell — writing by the cell would overwrite the older day's data. The whole sheet is skipped."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "tệp bảng là chuỗi thời gian, nên đích phải là điểm đo. Dòng này trỏ tới %s."
msgstr "a table file is a time series, so the target has to be a measurement point. This line points at %s."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "tệp không có cột \"%(a)s\". Tệp có: %(b)s."
msgstr "the file has no column \"%(a)s\". It has: %(b)s."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "tệp không có sheet tên \"%s\" — tệp có: %s"
msgstr "the file has no sheet named \"%s\" — it has: %s"

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
