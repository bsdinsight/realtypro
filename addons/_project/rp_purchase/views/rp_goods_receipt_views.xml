<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rp_goods_receipt_list" model="ir.ui.view">
        <field name="name">rp.goods.receipt.list</field>
        <field name="model">rp.goods.receipt</field>
        <field name="arch" type="xml">
            <list string="Nhận hàng &amp; nghiệm thu"
                  decoration-danger="result == 'fail'"
                  decoration-warning="result == 'conditional'">
                <field name="name"/>
                <field name="date"/>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <field name="project_id" optional="show"/>
                <field name="receipt_type"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'pass'"
                       decoration-warning="result == 'conditional'"
                       decoration-danger="result == 'fail'"/>
                <field name="amount_accepted" width="190" sum="Σ nghiệm thu"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_goods_receipt_form" model="ir.ui.view">
        <field name="name">rp.goods.receipt.form</field>
        <field name="model">rp.goods.receipt</field>
        <field name="arch" type="xml">
            <form string="Biên bản giao nhận &amp; nghiệm thu">
                <header>
                    <button name="action_xac_nhan" type="object"
                            string="Xác nhận nghiệm thu" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_ve_nhap" type="object"
                            string="Về nháp" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="purchase_order_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="receipt_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="location"/>
                            <field name="inspector_id"/>
                            <field name="representative_supplier"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Kết luận kiểm tra">
                        <group>
                            <field name="result"/>
                        </group>
                        <group>
                            <field name="amount_accepted"/>
                        </group>
                    </group>
                    <field name="remark"
                           placeholder="Tồn tại cần khắc phục…"/>
                    <notebook>
                        <page string="Nội dung nghiệm thu" name="lines">
                            <!-- Tách SL nhận với SL nghiệm thu: nhận đủ mà
                                 kiểm tra không đạt là chuyện thường, và
                                 phần không đạt thì không được trả tiền. -->
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="po_line_id"
                                           column_invisible="1"/>
                                    <field name="quantity_ordered"/>
                                    <field name="quantity_received"/>
                                    <field name="quantity_accepted"/>
                                    <field name="quantity_rejected"/>
                                    <field name="price_unit"/>
                                    <field name="amount_accepted"
                                           width="190" sum="Σ"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_goods_receipt_search" model="ir.ui.view">
        <field name="name">rp.goods.receipt.search</field>
        <field name="model">rp.goods.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <filter name="f_fail" string="Không đạt / có điều kiện"
                        domain="[('result', '!=', 'pass')]"/>
                <filter name="f_draft" string="Chưa xác nhận"
                        domain="[('state', '=', 'draft')]"/>
                <searchpanel>
                    <field name="project_id" string="Dự án" icon="fa-folder"
                           enable_counters="1"/>
                    <field name="receipt_type" string="Loại" icon="fa-cube"
                           enable_counters="1" select="multi"/>
                    <field name="result" string="Kết luận" icon="fa-check"
                           enable_counters="1" select="multi"/>
                    <field name="partner_id" string="Nhà cung cấp"
                           icon="fa-truck" enable_counters="1"
                           select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_rp_goods_receipt" model="ir.actions.act_window">
        <field name="name">Nhận hàng &amp; nghiệm thu</field>
        <field name="res_model">rp.goods.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rp_goods_receipt_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có biên bản nghiệm thu nào
            </p>
            <p>
                Dùng chung cho cả HÀNG HOÁ lẫn DỊCH VỤ. Phần lớn thứ chủ
                đầu tư mua là dịch vụ — tư vấn, bảo hiểm, kiểm định —
                không nhập kho được nhưng vẫn phải nghiệm thu trước khi
                trả tiền.
            </p>
        </field>
    </record>

    <menuitem id="menu_rp_goods_receipt" name="Nhận hàng &amp; nghiệm thu"
              parent="menu_procurement" action="action_rp_goods_receipt"
              sequence="30"/>
</odoo>
