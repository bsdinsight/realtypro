<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart button + tab "Chứng thư BL" trên Facility form.

         Gate theo NHÓM MỤC ĐÍCH, không theo Loại hạn mức: loại
         "Hạn mức bảo lãnh" đã ngưng dùng (backlog 755), hạn mức bảo
         lãnh nay khai bằng Mục đích = "Bảo lãnh ngân hàng" trên loại
         Tuần hoàn / Có kỳ hạn. Gate cũ theo facility_type sẽ giấu mất
         chứng thư của mọi hạn mức bảo lãnh tạo sau bản 755 — trong
         khi chính chúng mới là hạn mức đang chiếm/khôi phục hạn mức
         bảo lãnh (xem _compute_amount_used ở re_guarantee). -->
    <record id="view_re_loan_facility_form_inherit_guarantee"
            model="ir.ui.view">
        <field name="name">re.loan.facility.form.guarantee</field>
        <field name="model">re.loan.facility</field>
        <field name="inherit_id" ref="re_loan.view_re_loan_facility_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="purpose_kind" invisible="1"/>
                <div class="oe_button_box" name="button_box_guarantee"
                     invisible="purpose_kind != 'guarantee'">
                    <button name="action_view_guarantees" type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                        <field name="guarantee_count" widget="statinfo"
                               string="Chứng thư BL"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//page[@name='note']" position="before">
                <page string="Chứng thư BL" name="guarantee"
                      invisible="purpose_kind != 'guarantee'">
                    <group>
                        <group>
                            <field name="guarantee_count"/>
                            <field name="guarantee_total_outstanding"/>
                        </group>
                    </group>
                    <field name="guarantee_ids">
                        <list decoration-success="state in ('issued','extended')"
                              decoration-muted="state in ('released','expired')"
                              decoration-danger="state == 'forfeited'">
                            <field name="name"/>
                            <field name="guarantee_type"/>
                            <field name="beneficiary_partner_id"/>
                            <field name="date_issue"/>
                            <field name="date_expiry"/>
                            <field name="days_remaining"/>
                            <field name="amount" width="185px" sum="Σ"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
