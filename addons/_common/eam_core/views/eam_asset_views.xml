<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eam_asset_list" model="ir.ui.view">
        <field name="name">eam.asset.list</field>
        <field name="model">eam.asset</field>
        <field name="arch" type="xml">
            <!-- KHÔNG `expand`: khi người dùng tự bật gom nhóm thì bung
                 sẵn là đổ cả 1.396 dòng ra, mất hẳn tác dụng gom. -->
            <list string="Tài sản"
                  decoration-muted="state == 'scrapped'"
                  decoration-danger="warranty_state == 'expired'"
                  decoration-warning="warranty_state == 'expiring'">
                <field name="code" width="130px"/>
                <field name="name" width="300px"/>
                <field name="serial_no" string="Sê-ri" width="160px"/>
                <field name="category_id" string="Loại" width="220px"/>
                <field name="child_count" string="Cấu phần trong"
                       optional="hide"/>
                <field name="asset_level" string="Cấp" optional="show"
                       width="130px"/>
                <field name="parent_id" string="Lắp trong" optional="hide"
                       width="200px"/>
                <field name="plant_id" string="Nhà máy" optional="hide"
                       width="190px"/>
                <field name="current_location_id" string="Đang lắp tại"
                       width="220px"/>
                <field name="is_rotable" string="Quay vòng"/>
                <field name="install_count" string="Số lần lắp"/>
                <field name="criticality" string="Mức QT" widget="badge"
                       optional="show"/>
                <field name="warranty_end" string="BH đến" optional="show"/>
                <field name="warranty_days_left" string="BH còn (ngày)"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'repair'"/>
                <field name="warranty_state" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_eam_asset_form" model="ir.ui.view">
        <field name="name">eam.asset.form</field>
        <field name="model">eam.asset</field>
        <field name="arch" type="xml">
            <form string="Tài sản">
                <header>
                    <button name="action_lap_dat" type="object"
                            string="Ghi lần lắp mới" class="btn-primary"
                            invisible="state == 'scrapped'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,scrapped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_xem_cay" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="not child_count and not parent_id">
                            <field name="child_count" widget="statinfo"
                                   string="Xem cây lắp ráp"/>
                        </button>
                        <button name="action_mo_lich_su" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="install_count" widget="statinfo"
                                   string="Lần lắp"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="code" class="oe_inline"
                                   placeholder="GBX-014"/>
                            <field name="name" class="oe_inline"
                                   placeholder="Hộp số"/>
                        </h1>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not is_installed">
                        Đang lắp tại
                        <field name="current_location_id" readonly="1"
                               nolabel="1" class="oe_inline"/>.
                        Muốn đổi chỗ thì ghi một lần lắp mới — không sửa
                        tay, vì sửa tay là mất lịch sử.
                    </div>
                    <group>
                        <group string="Định danh">
                            <field name="serial_no"/>
                            <field name="category_id"/>
                            <field name="manufacturer_id"/>
                            <field name="model_ref"/>
                        </group>
                        <group string="Tính chất">
                            <field name="is_rotable"/>
                            <field name="is_refurbished"/>
                            <field name="owner_partner_id"/>
                            <field name="criticality"/>
                        </group>
                        <group string="Cây lắp ráp" colspan="2">
                            <field name="parent_id"
                                   options="{'no_create': True}"/>
                            <field name="child_count"/>
                            <field name="child_ids" nolabel="1" colspan="2"
                                   invisible="not child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="serial_no"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <div class="text-muted" colspan="2">
                                <b>Cây lắp ráp đi THEO VẬT</b>, khác cây vị
                                trí chức năng vốn ở lại CHỖ. Tháo hộp số
                                đem đại tu thì ổ trục bên trong đi theo
                                nó. Hai cây trả lời hai câu khác nhau:
                                <i>"vị trí này hỏng hộp số mấy lần"</i>
                                (lỗi nền móng, dòng gió, lắp đặt) và
                                <i>"con hộp số này hỏng ở mấy vị trí"</i>
                                (lỗi lô hàng).
                            </div>
                        </group>
                        <group string="Vị trí">
                            <field name="is_installed"/>
                            <field name="current_location_id"/>
                            <field name="current_installation_id"
                                   invisible="not is_installed"/>
                        </group>
                        <group string="Mốc thời gian">
                            <field name="date_manufacture"/>
                            <field name="date_commissioned"/>
                            <field name="warranty_end"/>
                            <field name="warranty_state"/>
                            <field name="warranty_days_left"
                                   invisible="warranty_state == 'none'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử lắp đặt" name="ls">
                            <field name="installation_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="location_id" width="300px"/>
                                    <field name="date_install"/>
                                    <field name="date_remove"/>
                                    <field name="duration_days" string="Số ngày"/>
                                    <field name="reason_install"/>
                                    <field name="reason_remove"/>
                                    <field name="is_current" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bảo hành" name="bh">
                            <field name="warranty_note" nolabel="1"
                                   placeholder="Điều kiện, phạm vi, hạn gửi thông báo theo hợp đồng…"/>
                        </page>
                        <page string="Nguồn gốc &amp; ghi chú" name="ng">
                            <group>
                                <field name="origin"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_eam_asset_search" model="ir.ui.view">
        <field name="name">eam.asset.search</field>
        <field name="model">eam.asset</field>
        <field name="arch" type="xml">
            <search string="Tài sản">
                <field name="name"/>
                <field name="code"/>
                <field name="serial_no"/>
                <field name="category_id"/>
                <field name="plant_id"/>
                <field name="current_location_id"/>
                <!--
                    Pane lọc bên trái.

                    Ba điều đã học về `searchpanel` và đều phải né:

                    ① Chỉ nhận m2o / m2m / selection **của chính model**.
                       Trường related hoặc trường tính KHÔNG LƯU thì đưa
                       vào là vỡ — đó là lý do `plant_id` phải là trường
                       lưu trên chính tài sản, và vì sao không có ô "tình
                       trạng bảo hành" ở đây (nó phụ thuộc hôm nay nên
                       không được lưu).
                    ② KHÔNG dùng `groupby`: nó sinh lỗi `group_domain=None`.
                    ③ Pane CÓ co theo lựa chọn ở ô khác, nhưng chỉ khi
                       KHÔNG bật `expand`. Bật `expand` là mọi ô đều vẽ
                       ra kể cả ô bằng 0 — chọn Điện gió thì ô GỐC tên
                       "Bộ biến tần" (vốn là biến tần quang điện của
                       PV50) vẫn nằm đó với số 0, còn biến tần của
                       tua-bin thì nằm hai cấp dưới trong nhánh Tua-bin
                       gió. Người dùng đọc pane rồi kết luận nhà máy
                       không có biến tần — đã vấp đúng vậy.
                       Giữ `enable_counters` để thấy ngay số lượng.
                -->
                <searchpanel>
                    <!-- KHÔNG đặt `asset_level` vào pane. Màn mở sẵn bộ
                         lọc "Chỉ thiết bị chính" trên THANH TÌM KIẾM, mà
                         ô trong pane thì không bật sẵn được — nên pane sẽ
                         hiện ô "Thiết bị chính" CHƯA TICK trong khi danh
                         sách đang bị lọc đúng bằng trường ấy. Người dùng
                         nhìn pane, thấy không tick gì, kết luận là dữ
                         liệu thiếu. Đã vấp bốn lần liên tiếp.
                         Một khái niệm thì một chỗ điều khiển: giữ ở chip
                         trên thanh — nhìn thấy được, có dấu × để tắt. -->
                    <field name="plant_id" string="Nhà máy"
                           icon="fa-industry" enable_counters="1"/>
                    <!-- KHÔNG `expand` — xem ③. Không bung thì cây co
                         đúng theo nhà máy đang chọn: DG123 còn 51 ô thay
                         vì 79, hết sạch ô bằng 0, mà lõi vẫn tự thêm các
                         cấp cha nên cây không đứt đoạn.
                         Cũng đừng bật lại khi danh mục phình to: vượt 200
                         bản ghi là lõi trả error_msg và ô này vẽ ra RỖNG
                         mà không báo gì. -->
                    <field name="category_id" string="Loại cấu phần"
                           icon="fa-sitemap" enable_counters="1"/>
                    <field name="state" string="Vòng đời" select="multi"
                           icon="fa-heartbeat" enable_counters="1"/>
                    <field name="criticality" string="Mức quan trọng"
                           select="multi" icon="fa-exclamation-triangle"
                           enable_counters="1"/>
                </searchpanel>
                <!-- Lọc theo `asset_level`, KHÔNG theo `parent_id`.
                     `parent_id = False` nghĩa là "đứng đầu cây lắp ráp",
                     khác hẳn "là một thiết bị": hộp gom chuỗi lắp trong
                     dàn pin, biến tần tua-bin lắp trong cụm điện — đều
                     là thiết bị thật mà cách cũ giấu sạch. -->
                <filter name="f_chinh" string="Chỉ thiết bị chính"
                        domain="[('asset_level', '=', 'main')]"/>
                <filter name="f_cauphan" string="Chỉ cấu phần"
                        domain="[('asset_level', '=', 'component')]"/>
                <separator/>
                <filter name="f_lap" string="Đang lắp trên máy"
                        domain="[('is_installed', '=', True)]"/>
                <filter name="f_kho" string="Không lắp trên máy"
                        domain="[('is_installed', '=', False)]"/>
                <filter name="f_rot" string="Vật tư quay vòng"
                        domain="[('is_rotable', '=', True)]"/>
                <!-- Lọc theo NGÀY, không theo trạng thái tính sẵn:
                     warranty_state phụ thuộc hôm nay nên không được lưu,
                     mà không lưu thì không đưa vào domain được. Lưu nó
                     lại chính là cái bẫy "đếm ngày đứng im". -->
                <filter name="f_bh_sap" string="Bảo hành sắp hết (90 ngày)"
                        domain="[('warranty_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('warranty_end', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter name="f_bh_het" string="Bảo hành đã hết"
                        domain="[('warranty_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="g_cap" string="Cấp tài sản"
                        context="{'group_by': 'asset_level'}"/>
                <filter name="g_nm" string="Nhà máy"
                        context="{'group_by': 'plant_id'}"/>
                <filter name="g_cat" string="Loại cấu phần"
                        context="{'group_by': 'category_id'}"/>
                <filter name="g_loc" string="Vị trí đang lắp"
                        context="{'group_by': 'current_location_id'}"/>
                <filter name="g_state" string="Vòng đời"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
    <record id="action_eam_asset" model="ir.actions.act_window">
        <field name="name">Tài sản</field>
        <field name="res_model">eam.asset</field>
        <field name="view_mode">list,hierarchy,form</field>
        <!-- MỞ SẴN bộ lọc "Chỉ thiết bị chính". Anh Đại chốt 26/10/2026,
             sau khi đã thử cả ba cách — ĐỪNG đổi lại nếu không có quyết
             định mới, cả ba đều đã được cân nhắc:
             ① `search_default_f_chinh` (đang dùng) — 1.396 tài sản còn
                329 THIẾT BỊ. Bấm Bộ biến tần ra đúng 60 cái biến tần,
                Dàn pin quang điện ra đúng 16 dàn pin, Tua-bin gió ở
                DG123 ra đúng 12 trụ. Đây là thứ người vận hành mở sổ
                tài sản ra để tìm.
             ② Không đặt gì — danh sách phẳng 1.396 dòng, bấm Dàn pin
                quang điện ra 32 vì Odoo gộp cả nhánh con Khung giá đỡ.
                Người dùng không cần 16 cái khung ở màn ấy.
             ③ `search_default_g_cap` (gom nhóm theo cấp) — không giấu
                gì, nhưng MỌI đường lần xuống đều chết ở một dòng nhóm
                GẬP: bấm nhà máy, bấm loại, rồi vẫn phải bấm lần nữa.

             Bộ lọc này CHỈ an toàn vì `asset_level` nay đọc cờ
             `is_equipment` trên LOẠI. Hồi nó còn suy từ `parent_id`
             ("đứng đầu cây lắp ráp"), bật bộ lọc là ba nhóm thiết bị
             thật về 0 và biến khỏi cả pane: 192 hộp gom chuỗi, 48 hệ
             xoay theo mặt trời, 12 bộ biến tần của DG123. ĐỪNG đổi
             domain hai bộ lọc về `parent_id` — xem ghi chú ở chúng.

             PHẢI ghi đủ thẻ chứ không được xoá đi: nâng cấp module chỉ
             ghi những trường CÓ MẶT trong XML, bỏ thẻ ra là giá trị cũ
             nằm nguyên trong DB. -->
        <field name="context">{'search_default_f_chinh': 1}</field>
        <!-- Câu trống không được đổ tại bộ lọc nữa (nay không bật sẵn
             cái nào), mà phải chỉ sang hai nơi người dùng thực sự vừa
             bấm: thanh tìm kiếm và các ô ở khung bên trái. -->

        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Không có tài sản nào
               <b>khớp điều kiện đang lọc</b></p>
            <p>Màn này mở sẵn bộ lọc <b>“Chỉ thiết bị chính”</b> — hiện
               thiết bị, ẩn cấu phần nằm bên trong chúng (cánh quạt, khung
               giá đỡ, sứ xuyên, rơ-le…). Loại anh vừa chọn có thể toàn là
               cấu phần, nên danh sách trống.</p>
            <p><b>Bấm dấu × trên chip “Chỉ thiết bị chính”</b> ở thanh tìm
               kiếm là thấy đủ. Sau đó vẫn trống thì mới là chưa có dữ liệu —
               hãy xem lại các ô đã chọn ở khung bên trái.</p>
            <p>Một loại là thiết bị hay cấu phần do <b>chính anh quyết</b>:
               mở <i>Cấu hình ▸ Loại cấu phần</i>, tick ô <b>“Là thiết bị”</b>.
               Máy không tự suy điều đó.</p>
            <p>Tài sản là <b>vật</b>, mang theo lịch sử của chính nó qua mọi
               lần tháo ra và lắp lại. Vị trí nó đang nằm là thuộc tính tạm
               thời, suy ra từ lịch sử lắp đặt.</p>
        </field>
    </record>
</odoo>
