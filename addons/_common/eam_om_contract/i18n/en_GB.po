#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_contract_plant__company_id
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_period__company_id
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_period_line__company_id
#: model:ir.model.fields,field_description:eam_om_contract.field_eam_om_period_plant__company_id
msgid "Công ty"
msgstr "Company"

#. module: eam_om_contract
#: model:ir.model.fields,help:eam_om_contract.field_eam_om_commitment__do_duoc
msgid "Cơ sở này hệ đã đo được hay chưa. Chưa đo được thì kỳ vẫn ra dòng kết quả, nhưng ghi rõ lý do và KHÔNG tính phạt."
msgstr "Whether the system can measure this basis at all. If it cannot, the period still produces a result row stating the reason, and NO penalty is charged."

