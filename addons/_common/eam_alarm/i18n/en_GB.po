#. module: eam_alarm
#: code:addons/eam_alarm/models/eam_alarm.py:0
msgid "Cảnh báo này đã TÁI PHÁT lần thứ %(n)d sau khi đóng lệnh %(l)s ngày %(d)s. Lần sửa đó không giữ được — xem lại nguyên nhân gốc thay vì sửa lại y như cũ."
msgstr "This alarm has RECURRED for the %(n)d time since order %(l)s was closed on %(d)s. That repair did not hold — look again at the root cause instead of repeating it."

#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__repeat_window_days
msgid "Cảnh báo quay lại ngay sau khi vừa đóng lệnh nghĩa là lần sửa đó không giữ được. Đây là con số đáng xem nhất của cả sổ cảnh báo."
msgstr "An alarm coming straight back after an order is closed means that repair did not hold. This is the most worthwhile number in the whole alarm log."

#. module: eam_alarm
#: model:ir.model,name:eam_alarm.model_eam_alarm
