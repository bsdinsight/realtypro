#: model_terms:ir.ui.view,arch_db:eam_historian.view_eam_data_exclusion_form
msgid ""
"Khoảng loại trừ <b>khác hẳn</b> cờ chất lượng. Cờ\n"
"                        chất lượng nói <i>số đo này có thể SAI</i>. Khoảng\n"
"                        loại trừ nói <i>số đo hoàn toàn ĐÚNG, nhưng kỳ này\n"
"                        không tính vào KPI</i> — tua-bin đang bảo trì theo\n"
"                        kế hoạch thì sản lượng bằng 0 là đúng, tính vào hệ\n"
"                        số khả dụng là phạt nhà máy vì đã làm đúng việc\n"
"                        phải làm.<br/>\n"
"                        Số đo thô <b>không bị đụng tới</b>: việc loại trừ\n"
"                        chỉ áp lúc đọc, nên sửa lý do sau này là mọi chỉ số\n"
"                        tính lại đúng ngay."
msgstr ""
"An exclusion period is <b>quite different</b> from a quality\n"
"                        flag. A quality flag says <i>this reading may be WRONG</i>.\n"
"                        An exclusion period says <i>the reading is entirely RIGHT,\n"
"                        but this period does not count towards KPIs</i> — a turbine\n"
"                        under planned maintenance rightly produces zero energy, and\n"
"                        counting that in the availability factor penalises the\n"
"                        plant for doing exactly what it should.<br/>\n"
"                        The raw readings are <b>untouched</b>: the exclusion is\n"
"                        applied at read time, so correcting the reason later makes\n"
"                        every indicator recompute correctly at once."

