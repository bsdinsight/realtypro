<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tiến độ gom mọi hợp đồng của dự án.

         Đặt ngay trên form dự án vì đây là con số người quản lý dự án
         hỏi đầu tiên: bao giờ xong, trễ bao nhiêu so với kế hoạch gốc.
         Số của từng hợp đồng vẫn nằm ở form hợp đồng như cũ. -->
    <record id="view_re_project_form_schedule" model="ir.ui.view">
        <field name="name">re.project.form.schedule</field>
        <field name="model">re.project</field>
        <field name="inherit_id" ref="re_base.view_re_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="rp_schedule_rollup"
                       string="TIẾN ĐỘ TOÀN DỰ ÁN (mọi hợp đồng)"
                       invisible="not schedule_task_count">
                    <group>
                        <field name="schedule_task_count"/>
                        <field name="schedule_contract_count"/>
                        <field name="schedule_baseline_end"
                               options="{'format': 'dd/MM/yyyy'}"/>
                    </group>
                    <group>
                        <field name="schedule_forecast_end"
                               options="{'format': 'dd/MM/yyyy'}"/>
                        <!-- KHÔNG dùng decoration-* ở form: trình biên
                             dịch form của Odoo 19 ném lỗi và web client
                             chết ngay lúc mount — màn hình TRẮNG, không
                             có hộp báo lỗi nào. decoration-* chỉ hợp lệ
                             trong list/kanban. Muốn cảnh báo thì hiện
                             hẳn một dòng đỏ có điều kiện. -->
                        <field name="schedule_slip_days"/>
                        <field name="schedule_deadline"
                               options="{'format': 'dd/MM/yyyy'}"/>
                        <field name="schedule_deadline_task_id"
                               options="{'no_create': True}"/>
                        <field name="schedule_deadline_slip"
                               invisible="not schedule_deadline"/>
                        <div colspan="2" class="alert alert-danger py-1 mb-2"
                             role="alert"
                             invisible="schedule_deadline_slip &lt;= 0">
                            <i class="fa fa-exclamation-triangle me-1"
                               title="Trễ mốc"/>
                            Ngày về đích dự báo đang VƯỢT mốc phải xong
                            <field name="schedule_deadline_slip"
                                   class="fw-bold" nolabel="1"
                                   readonly="1"/> ngày.
                        </div>
                        <field name="schedule_link_count"/>
                        <field name="schedule_link_ss_count"/>
                        <field name="schedule_link_violated_count"/>
                        <!-- Đường găng tính trên một mạng phụ thuộc đang
                             tự mâu thuẫn thì không đáng tin. Nói rõ ra,
                             và cho đúng một nút để sửa cả loạt. -->
                        <div colspan="2" class="alert alert-warning py-1 mb-2"
                             role="alert"
                             invisible="schedule_link_violated_count == 0">
                            <i class="fa fa-exclamation-triangle me-1"
                               title="Mạng phụ thuộc tự mâu thuẫn"/>
                            Có
                            <field name="schedule_link_violated_count"
                                   class="fw-bold" nolabel="1" readonly="1"/>
                            quan hệ mà ngày đang lập vi phạm chính logic đã
                            khai — lịch chồng lấn nhưng vẫn ghi là
                            finish-to-start. Dư địa và đường găng chỉ đáng
                            tin sau khi sửa chỗ này.
                        </div>
                        <div colspan="2">
                            <button name="action_links_to_ss" type="object"
                                    class="btn-warning" icon="fa-compress"
                                    string="Chuyển quan hệ chồng lấn sang SS"
                                    invisible="schedule_link_violated_count == 0"/>
                            <button name="action_open_violated_links"
                                    type="object" class="btn-link"
                                    icon="fa-chain-broken"
                                    string="Xem quan hệ bị vi phạm"
                                    invisible="schedule_link_violated_count == 0"/>
                            <button name="action_open_schedule_links"
                                    type="object" class="btn-link"
                                    icon="fa-link"
                                    string="Mạng phụ thuộc"
                                    invisible="not schedule_link_count"/>
                        </div>
                        <div colspan="2">
                            <button name="action_open_project_gantt"
                                    type="object" class="btn-primary"
                                    icon="fa-tasks"
                                    string="Tiến độ dự án (Gantt)"/>
                            <button name="action_compute_project_cpm"
                                    type="object" class="btn-secondary"
                                    icon="fa-sitemap"
                                    string="Tính đường găng toàn dự án"/>
                            <button name="action_open_project_tasks"
                                    type="object" class="btn-link"
                                    icon="fa-list"
                                    string="Danh sách công việc"/>
                            <button name="action_fill_task_seq"
                                    type="object" class="btn-link"
                                    icon="fa-sort-numeric-asc"
                                    string="Cấp STT cho việc chưa có"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Danh sách công việc: thêm trục dự án và số liệu đường găng toàn
         dự án, để phân biệt với dư địa trong nội bộ một hợp đồng. -->
    <record id="view_project_task_list_project_cpm" model="ir.ui.view">
        <field name="name">project.task.list.project.cpm</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="rp_schedule.view_task_tree2_rp_schedule"/>
        <field name="arch" type="xml">
            <field name="total_float" position="after">
                <field name="project_float" optional="show"
                       string="Dư địa toàn DA"/>
                <field name="is_project_critical" optional="show"
                       string="Găng toàn DA" widget="boolean_toggle"
                       readonly="1"/>
                <field name="rp_project_id" optional="hide"/>
                <field name="rp_package_id" optional="hide"
                       string="Gói thầu"/>
            </field>
        </field>
    </record>

    <record id="view_project_task_search_project" model="ir.ui.view">
        <field name="name">project.task.search.project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="rp_schedule.view_task_search_rp_schedule"/>
        <field name="arch" type="xml">
            <filter name="rp_critical" position="after">
                <filter name="rp_project_critical" string="Găng TOÀN DỰ ÁN"
                        domain="[('is_project_critical', '=', True)]"/>
            </filter>
            <filter name="rp_group_critical" position="after">
                <filter string="Dự án" name="rp_group_project"
                        context="{'group_by': 'rp_project_id'}"/>
                <filter string="Gói thầu" name="rp_group_package"
                        context="{'group_by': 'rp_package_id'}"/>
                <filter string="Hợp đồng" name="rp_group_contract"
                        context="{'group_by': 'rp_contract_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
