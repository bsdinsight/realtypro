<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_floor_list" model="ir.ui.view">
        <field name="name">re.floor.list</field>
        <field name="model">re.floor</field>
        <field name="arch" type="xml">
            <list string="Floors">
                <field name="floor_number"/>
                <field name="code"/>
                <field name="name"/>
                <field name="building_id"/>
                <field name="project_id"/>
                <field name="unit_count"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_re_floor_form" model="ir.ui.view">
        <field name="name">re.floor.form</field>
        <field name="model">re.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object"
                                class="oe_stat_button" icon="fa-home">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <field name="layout_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Floor name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="floor_number"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="building_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="subzone_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_floor_search" model="ir.ui.view">
        <field name="name">re.floor.search</field>
        <field name="model">re.floor</field>
        <field name="arch" type="xml">
            <search string="Floors">
                <field name="name"/>
                <field name="code"/>
                <field name="building_id"/>
                <field name="project_id"/>
                <separator/>
                <filter string="Building" name="group_building" context="{'group_by': 'building_id'}"/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">re.floor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_re_floor_search"/>
    </record>

</odoo>
