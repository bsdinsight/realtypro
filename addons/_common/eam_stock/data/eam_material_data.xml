<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_eam_material_request" model="ir.sequence">
            <field name="name">Yêu cầu vật tư</field>
            <field name="code">eam.material.request</field>
            <field name="prefix">YCVT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Ba cấp duyệt theo giá trị. Ngưỡng là ví dụ ban đầu, mỗi
             chủ đầu tư chốt lại theo quy chế chi tiêu của mình. -->
        <record id="rule_duyet_thu_kho" model="eam.approval.rule">
            <field name="name">Thủ kho duyệt — từ 20 triệu</field>
            <field name="sequence">10</field>
            <field name="amount_from">20000000</field>
            <field name="group_id" ref="stock.group_stock_user"/>
            <field name="note">Mức thường ngày, thủ kho tự quyết.</field>
        </record>

        <record id="rule_duyet_quan_ly_kho" model="eam.approval.rule">
            <field name="name">Quản lý kho duyệt — từ 200 triệu</field>
            <field name="sequence">20</field>
            <field name="amount_from">200000000</field>
            <field name="group_id" ref="stock.group_stock_manager"/>
        </record>

        <record id="rule_duyet_quay_vong" model="eam.approval.rule">
            <field name="name">Vật tư quay vòng — luôn phải quản lý kho duyệt</field>
            <field name="sequence">30</field>
            <field name="rotable_only" eval="True"/>
            <field name="group_id" ref="stock.group_stock_manager"/>
            <field name="note">Hộp số, máy phát, cánh, bộ biến đổi — giá
                trị lớn và ảnh hưởng quyền bảo hành, nên không xét theo
                ngưỡng tiền mà luôn phải duyệt.</field>
        </record>
    </data>
</odoo>
