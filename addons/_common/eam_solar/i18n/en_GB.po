#. module: eam_solar
#: model_terms:ir.ui.view,arch_db:eam_solar.view_eam_solar_kpi_form
msgid ""
"<i class=\"fa fa-cloud me-1\"/>\n"
"                        Chưa có bản ghi <b>khí tượng</b> cùng ngày, nên thiếu\n"
"                        tổng xạ và nhiệt độ mô-đun — không tính được tỷ số\n"
"                        hiệu suất."
msgstr ""
"<i class=\"fa fa-cloud me-1\"/>\n"
"                        There is no <b>weather</b> record for the same day, so the\n"
"                        irradiation and module temperature are missing — the\n"
"                        performance ratio cannot be computed."

#. module: eam_solar
#: model_terms:ir.ui.view,arch_db:eam_solar.view_eam_location_form_solar
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                            Chưa chọn cảm biến bức xạ nào. Bức xạ là\n"
"                            <b>mẫu số của tỷ số hiệu suất</b> — thiếu nó thì\n"
"                            mọi con số KPI đều không tính được."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                            No irradiance sensor has been chosen. Irradiance is\n"
"                            the <b>denominator of the performance ratio</b> —\n"
"                            without it, none of the KPI figures can be computed."

#. module: eam_solar
#: model_terms:ir.ui.view,arch_db:eam_solar.view_eam_solar_kpi_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        Mẫu số ghi đè lệch"
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        The override denominator differs"

#. module: eam_solar
#: model_terms:ir.ui.view,arch_db:eam_solar.view_eam_solar_weather_form
msgid ""
"<i class=\"fa fa-pencil me-1\"/>\n"
"                        Bản ghi này <b>máy lấy từ số đo, rồi người sửa</b>.\n"
"                        Giữ dấu để sau còn biết con số nào đã bị can thiệp."
msgstr ""
"<i class=\"fa fa-pencil me-1\"/>\n"
"                        This record was <b>taken by the system from the readings,\n"
"                        then edited by a person</b>. The mark is kept so it is\n"
"                        still known which figure was touched."

