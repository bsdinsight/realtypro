<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_contract_change_list" model="ir.ui.view">
        <field name="name">rp.contract.change.list</field>
        <field name="model">rp.contract.change</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('rejected', 'cancelled')">
                <field name="code"/>
                <field name="name"/>
                <field name="contractor_id"/>
                <field name="contract_id" optional="hide"/>
                <field name="change_type"/>
                <field name="source" optional="show"/>
                <field name="date" optional="show"/>
                <field name="amount_estimate" width="185px" sum="Tổng ước tính"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amendment_count" string="Số PL"/>
                <field name="is_covered" string="Đã vào PL" widget="boolean_toggle" readonly="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_contract_change_form" model="ir.ui.view">
        <field name="name">rp.contract.change.form</field>
        <field name="model">rp.contract.change</field>
        <field name="arch" type="xml">
            <form string="Thay đổi (Change)">
                <header>
                    <button name="action_submit" string="Trình duyệt"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt chủ trương"
                            type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="re_base.group_re_manager"/>
                    <button name="action_reject" string="Từ chối"
                            type="object"
                            invisible="state != 'submitted'"
                            groups="re_base.group_re_manager"/>
                    <button name="action_reset_draft" string="Về Nháp"
                            type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" string="Huỷ" type="object"
                            invisible="state not in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                        <h2><field name="name"
                                   placeholder="Vd: Tăng công suất trạm biến áp 1600→2000kVA..."/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"
                                   options="{'no_create': True}"/>
                            <field name="contractor_id"/>
                            <field name="project_id"/>
                            <field name="structure_id"
                                   options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="change_type"/>
                            <field name="source"/>
                            <field name="amount_estimate"/>
                            <field name="is_covered"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Diễn giải">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Phụ lục chốt thay đổi này">
                        <field name="amendment_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="name"/>
                                <field name="amendment_type"/>
                                <field name="date_effective"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'applied'"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_contract_change_search" model="ir.ui.view">
        <field name="name">rp.contract.change.search</field>
        <field name="model">rp.contract.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="contract_id"/>
                <field name="contractor_id"/>
                <filter name="filter_pending" string="Chờ duyệt"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved_uncovered"
                        string="Đã duyệt — chưa vào phụ lục"
                        domain="[('state', '=', 'approved'),
                                 ('is_covered', '=', False)]"/>
                <separator/>
                <filter string="HĐ" name="group_contract"
                        context="{'group_by': 'contract_id'}"/>
                <filter string="Loại" name="group_type"
                        context="{'group_by': 'change_type'}"/>
                <filter string="Nguồn gốc" name="group_source"
                        context="{'group_by': 'source'}"/>
                <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_contract_change" model="ir.actions.act_window">
        <field name="name">Thay đổi (Change)</field>
        <field name="res_model">rp.contract.change</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
