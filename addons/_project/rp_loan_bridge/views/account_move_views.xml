<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Form inherit: partner_bank_id auto-fill + create flow ===== -->
    <record id="view_account_move_form_partner_bank"
            model="ir.ui.view">
        <field name="name">account.move.form.partner.bank</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']"
                   position="attributes">
                <attribute name="options">
                    {'no_quick_create': True, 'no_create_edit': False}
                </attribute>
                <attribute name="context">
                    {'default_partner_id': partner_id}
                </attribute>
            </xpath>

            <!-- Issue #10: cho phép tạo Thuế mới từ cột Thuế trong
                 tab "Chi tiết hóa đơn". Widget many2many_tax_tags của
                 Odoo chuẩn hardcode no_create=True → ẩn nút "Tạo mới".
                 Override options để hiện nút này. -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='tax_ids']"
                   position="attributes">
                <attribute name="options">
                    {'no_create': False, 'no_create_edit': False, 'no_quick_create': True}
                </attribute>
            </xpath>
        </field>
    </record>

    <!-- ===== List view: Hóa đơn HĐ nhà thầu (vendor bills có milestone) ===== -->
    <record id="view_account_move_contractor_invoice_list"
            model="ir.ui.view">
        <field name="name">account.move.contractor.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Hóa đơn HĐ nhà thầu"
                  decoration-info="state == 'draft'"
                  decoration-warning="payment_state == 'partial'"
                  decoration-success="payment_state in ('paid','in_payment')"
                  decoration-danger="state == 'posted' and payment_state == 'not_paid' and invoice_date_due and invoice_date_due &lt; current_date">
                <field name="invoice_date" string="Ngày HĐ"/>
                <field name="name" string="Số hóa đơn"/>
                <field name="partner_id" string="Nhà thầu"
                       optional="show"/>
                <field name="payment_milestone_id"
                       string="Mốc thanh toán"
                       optional="show"/>
                <field name="invoice_date_due" string="Ngày đến hạn"
                       optional="show"/>
                <field name="amount_untaxed_signed"
                       string="Trước thuế"
                       sum="Σ trước thuế" optional="hide"/>
                <field name="amount_total_signed"
                       string="Tổng" sum="Σ tổng"/>
                <field name="amount_residual_signed"
                       string="Còn phải trả"
                       sum="Σ còn lại" optional="show"
                       decoration-danger="amount_residual_signed &gt; 0"/>
                <field name="payment_state" widget="badge"
                       decoration-info="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state in ('paid','in_payment')"
                       string="Tình trạng TT"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancel'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===== Search view: filter + group ===== -->
    <record id="view_account_move_contractor_invoice_search"
            model="ir.ui.view">
        <field name="name">account.move.contractor.invoice.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Số HĐ"/>
                <field name="partner_id" string="Nhà thầu"/>
                <field name="payment_milestone_id"
                       string="Mốc thanh toán"/>
                <field name="invoice_date" string="Ngày HĐ"/>
                <separator/>
                <filter name="f_unpaid" string="Chưa thanh toán"
                        domain="[('state','=','posted'),
                                 ('payment_state','=','not_paid')]"/>
                <filter name="f_partial" string="Trả 1 phần"
                        domain="[('payment_state','=','partial')]"/>
                <filter name="f_paid" string="Đã thanh toán"
                        domain="[('payment_state','in',['paid','in_payment'])]"/>
                <filter name="f_overdue" string="Quá hạn"
                        domain="[('state','=','posted'),
                                 ('payment_state','=','not_paid'),
                                 ('invoice_date_due','&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_this_month" string="Tháng này"
                        domain="[('invoice_date','&gt;=',
                                   (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="g_partner" string="Nhà thầu"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="g_milestone" string="Mốc thanh toán"
                        context="{'group_by': 'payment_milestone_id'}"/>
                <filter name="g_payment_state" string="Tình trạng TT"
                        context="{'group_by': 'payment_state'}"/>
                <filter name="g_month" string="Tháng HĐ"
                        context="{'group_by': 'invoice_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ===== Action ===== -->
    <record id="action_account_move_contractor_invoice"
            model="ir.actions.act_window">
        <field name="name">Hóa đơn HĐ nhà thầu</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id"
               ref="view_account_move_contractor_invoice_list"/>
        <field name="search_view_id"
               ref="view_account_move_contractor_invoice_search"/>
        <field name="domain">[
            ('move_type','in',['in_invoice','in_refund']),
            ('payment_milestone_id','!=', False)
        ]</field>
        <field name="context">{
            'default_move_type': 'in_invoice',
            'search_default_f_unpaid': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có hóa đơn HĐ nhà thầu nào
            </p>
            <p>
                Hóa đơn được tạo từ <b>HĐ nhà thầu → tab Lịch thanh toán
                → nút "Tạo hóa đơn"</b> trên từng mốc. Màn này tổng hợp
                tất cả hóa đơn của mọi HĐ nhà thầu, cho phép tạo mới
                + theo dõi tình trạng thanh toán tổng quan.
            </p>
        </field>
    </record>

    <!-- ===== Menu dưới Quản lý Vay ===== -->
    <menuitem id="menu_account_move_contractor_invoice"
              name="Hóa đơn HĐ nhà thầu"
              parent="re_loan.menu_re_loan_root"
              action="action_account_move_contractor_invoice"
              sequence="38"/>

</odoo>
