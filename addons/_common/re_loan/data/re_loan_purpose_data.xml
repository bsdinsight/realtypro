        <field name="kind">loan</field>
        <field name="sequence">230</field>
    </record>

    <record id="purpose_reimbursement" model="re.loan.purpose">
        <field name="name">Khác · Bù đắp tài chính</field>
        <field name="code">reimbursement</field>
        <field name="kind">loan</field>
        <field name="sequence">240</field>
    </record>

    <record id="purpose_other" model="re.loan.purpose">
        <field name="name">Khác</field>
        <field name="code">other</field>
        <field name="kind">loan</field>
        <field name="sequence">250</field>
    </record>

</odoo>
