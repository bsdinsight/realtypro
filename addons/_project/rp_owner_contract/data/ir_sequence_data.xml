<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_rp_owner_acceptance" model="ir.sequence">
        <field name="name">BBNT với Chủ đầu tư</field>
        <field name="code">rp.owner.acceptance</field>
        <field name="prefix">OBBNT/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_rp_owner_ipc" model="ir.sequence">
        <field name="name">IPC — Chứng nhận thanh toán tạm thời</field>
        <field name="code">rp.owner.ipc</field>
        <field name="prefix">IPC/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_rp_owner_advance" model="ir.sequence">
        <field name="name">Tạm ứng CĐT</field>
        <field name="code">rp.owner.advance</field>
        <field name="prefix">TU-CDT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
