<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Advice List ===== -->
    <record id="view_re_loan_bank_advice_list" model="ir.ui.view">
        <field name="name">re.loan.bank.advice.list</field>
        <field name="model">re.loan.bank.advice</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-success="state == 'posted'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_advice"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="line_count"/>
                <field name="amount_total" width="185px" sum="Σ"/>
                <field name="state" widget="badge"/>
                <field name="allocation_state" widget="badge"
                       decoration-warning="allocation_state == 'over'"
                       decoration-success="allocation_state == 'done'"
                       optional="show"/>
                <field name="is_reallocation" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===== Advice Form ===== -->
    <record id="view_re_loan_bank_advice_form" model="ir.ui.view">
        <field name="name">re.loan.bank.advice.form</field>
        <field name="model">re.loan.bank.advice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object"
                            string="Xác nhận + Allocate"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Xác nhận giấy báo? Hệ thống sẽ tự allocate số tiền vào các kỳ lãi của KW theo thuật toán (lãi → gốc, cũ → mới)."/>
                    <button name="action_cancel" type="object"
                            string="Huỷ"
                            invisible="state == 'cancelled'"
                            confirm="Huỷ giấy báo? Toàn bộ repayments đã tạo từ giấy báo này sẽ bị xoá."/>
                    <button name="action_reset_draft" type="object"
                            string="Về Nháp"
                            invisible="state != 'cancelled'"/>
                    <!-- Chỉ hiện khi còn tiền treo VƯỢT ngưỡng net-off.
                         Trong ngưỡng thì dùng nút Net-off ở từng dòng,
                         không phải đẻ thêm một phiếu cho vài nghìn
                         đồng (backlog 988). -->
                    <button name="action_allocate_remainder" type="object"
                            string="Phân bổ tiếp"
                            class="btn-primary"
                            icon="fa-share"
                            invisible="allocation_state != 'over'"
                            confirm="Tạo một giấy báo NHÁP mới để rót tiếp phần tiền còn treo sang các kỳ khác? Số tiền này KHÔNG phải ngân hàng trích thêm — nó là phần chưa phân bổ của chính phiếu này."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_repayments"
                                type="object" class="oe_stat_button"
                                icon="fa-money"
                                invisible="state != 'posted'">
                            <field name="repayment_count"
                                   widget="statinfo"
                                   string="Repayments"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not is_reallocation">
                        <i class="fa fa-share" title="Phân bổ tiếp"/>
                        <b>Phiếu phân bổ tiếp.</b> Số tiền ở đây
                        <b>không phải</b> ngân hàng trích thêm — nó là
                        phần tiền còn treo của một giấy báo trước, nay
                        rót sang kỳ khác. Đừng cộng vào tổng tiền NH đã
                        trích.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"
                                   placeholder="Tự sinh khi save..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create': True}"/>
                            <field name="company_partner_id" invisible="1"/>
                            <field name="bank_account_id"
                                   options="{'no_create': True}"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="date_advice"/>
                            <!-- Ẩn theo backlog 1089: tổng đã hiện ngay ở
                                 dòng cộng dưới cột "Số tiền trích thu". -->
                            <field name="amount_total" readonly="1"
                                   invisible="1"/>
                            <field name="allocation_state" widget="badge"
                                   decoration-warning="allocation_state == 'over'"
                                   decoration-success="allocation_state == 'done'"/>
                            <field name="is_reallocation" invisible="1"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết KW trích thu"
                              name="lines">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="note_id"
                                           options="{'no_create': True}"/>
                                    <field name="credit_contract_id"
                                           readonly="1" optional="show"/>
                                    <field name="interest_line_id" width="185px"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="amount" width="185px" sum="Σ"/>
                                    <field name="description"/>
                                    <field name="repayment_count"
                                           readonly="1"
                                           optional="show"/>
                                    <field name="amount_allocated" width="185px"
                                           readonly="1"
                                           sum="Σ đã allocate"
                                           optional="show"/>
                                    <field name="amount_allocated_principal" width="185px"
                                           readonly="1"
                                           sum="Σ gốc"
                                           optional="show"/>
                                    <field name="amount_allocated_interest" width="185px"
                                           readonly="1"
                                           sum="Σ lãi"
                                           optional="show"/>
                                    <field name="amount_diff_period" width="185px"
                                           string="Chênh lệch cần net-off"
                                           readonly="1" optional="show"
                                           sum="Σ chênh lệch"
                                           decoration-warning="amount_diff_period > 0"/>
                                    <field name="amount_unallocated" width="185px"
                                           string="Chưa allocate"
                                           readonly="1" optional="show"
                                           sum="Σ chưa allocate"
                                           decoration-warning="amount_unallocated > 0"/>
                                    <field name="amount_carried_forward" width="185px"
                                           readonly="1" optional="hide"
                                           sum="Σ đã chuyển"/>
                                    <field name="source_line_id"
                                           readonly="1" optional="hide"/>
                                    <field name="net_off_allowed"
                                           column_invisible="1"/>
                                    <field name="net_off_kind"
                                           column_invisible="1"/>
                                    <button name="action_auto_net_off"
                                            type="object"
                                            string="Net-off"
                                            icon="fa-balance-scale"
                                            class="btn-link"
                                            invisible="state != 'posted' or not net_off_allowed"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="note_id"/>
                                            <field name="credit_contract_id"
                                                   readonly="1"/>
                                            <field name="interest_line_id"/>
                                        </group>
                                        <group>
                                            <field name="amount"/>
                                            <field name="description"/>
                                            <field name="amount_allocated"
                                                   readonly="1"/>
                                            <field name="amount_allocated_principal"
                                                   readonly="1"/>
                                            <field name="amount_allocated_interest"
                                                   readonly="1"/>
                                            <field name="amount_diff_period"
                                                   string="Chênh lệch cần net-off"
                                                   readonly="1"
                                                   decoration-warning="amount_diff_period > 0"/>
                                            <field name="amount_unallocated"
                                                   readonly="1"
                                                   decoration-warning="amount_unallocated > 0"/>
                                            <field name="amount_carried_forward"
                                                   readonly="1"
                                                   invisible="amount_carried_forward == 0"/>
                                            <field name="source_line_id"
                                                   readonly="1"
                                                   invisible="not source_line_id"/>
                                            <field name="net_off_allowed"
                                                   invisible="1"/>
                                            <field name="net_off_kind"
                                                   readonly="1"
                                                   invisible="not net_off_kind"/>
                                            <button name="action_auto_net_off"
                                                    type="object"
                                                    string="Tự net-off chênh lệch lẻ"
                                                    icon="fa-balance-scale"
                                                    class="btn-secondary"
                                                    invisible="state != 'posted' or not net_off_allowed"/>
                                        </group>
                                    </group>
                                    <separator string="Repayments đã allocate"/>
                                    <field name="repayment_ids" readonly="1">
                                        <list>
                                            <field name="date"/>
                                            <field name="interest_line_id" width="185px"/>
                                            <field name="amount_principal" width="185px" sum="Σ gốc"/>
                                            <field name="amount_interest" width="185px" sum="Σ lãi"/>
                                            <field name="amount_total" width="185px" sum="Σ"/>
                                            <field name="currency_id"
                                                   column_invisible="1"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page string="Diễn giải" name="description">
                            <field name="description"
                                   placeholder="Ghi chú..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===== Search ===== -->
    <record id="view_re_loan_bank_advice_search" model="ir.ui.view">
        <field name="name">re.loan.bank.advice.search</field>
        <field name="model">re.loan.bank.advice</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <!-- Lọc việc-phải-làm: phiếu đã đăng mà còn tiền treo
                     vượt ngưỡng net-off. Đây là lý do allocation_state
                     phải CÓ LƯU chứ không tính tại chỗ (backlog 988). -->
                <filter name="f_over" string="Còn phân bổ dư"
                        domain="[('allocation_state','=','over')]"/>
                <separator/>
                <filter name="f_draft" string="Nháp"
                        domain="[('state','=','draft')]"/>
                <filter name="f_posted" string="Đã xác nhận"
                        domain="[('state','=','posted')]"/>
                <separator/>
                <filter name="g_partner" string="NH"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="g_state" string="Trạng thái"
                        context="{'group_by': 'state'}"/>
                <filter name="g_month" string="Tháng"
                        context="{'group_by': 'date_advice:month'}"/>

                <!-- Panel lọc bên trái. Ba trục của người đối chiếu giấy
                     báo nợ: ngân hàng nào trích · giấy đã xác nhận chưa
                     · trích từ TÀI KHOẢN nào. Trục tài khoản là trục
                     riêng của màn này — cùng một ngân hàng có thể trích
                     từ nhiều tài khoản, mà đối chiếu sao kê thì phải
                     soi theo đúng tài khoản chứ không theo ngân hàng. -->
                <searchpanel>
                    <field name="partner_id" string="Ngân hàng"
                           select="multi" icon="fa-university"
                           enable_counters="1"/>
                    <field name="state" string="Trạng thái"
                           select="multi" icon="fa-tasks"
                           enable_counters="1"/>
                    <field name="bank_account_id"
                           string="Tài khoản bị trích"
                           select="multi" icon="fa-credit-card"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ===== Action + Menu ===== -->
    <record id="action_re_loan_bank_advice" model="ir.actions.act_window">
        <field name="name">Giấy báo nợ (Trích thu tự động)</field>
        <field name="res_model">re.loan.bank.advice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_re_loan_bank_advice_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo giấy báo nợ NH đầu tiên
            </p>
            <p>
                Khi NH trích thu tự động các KW đến hạn, import giấy
                báo (credit advice) tại đây để hệ thống auto-allocate
                vào lịch lãi/gốc của từng KW.
            </p>
        </field>
    </record>

    <menuitem id="menu_re_loan_bank_advice"
              name="Trích thu tự động (NH)"
              parent="menu_grp_payment"
              action="action_re_loan_bank_advice"
              sequence="10"/>

    <menuitem id="menu_re_loan_bank_advice_import"
              name="Import giấy báo nợ (Excel/CSV)"
              parent="menu_grp_payment"
              action="action_re_loan_bank_advice_import"
              sequence="20"/>

    <!-- ===== Interest line: thêm tab/nút xem các chứng từ đã trả ===== -->
    <record id="view_re_loan_note_interest_line_paid_list"
            model="ir.ui.view">
        <field name="name">re.loan.note.interest.line.paid.list</field>
        <field name="model">re.loan.note.interest.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="period_no"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="principal_due" width="185px" sum="Σ gốc"/>
                <field name="amount_principal_paid" width="185px" sum="Σ trả gốc"/>
                <field name="amount_principal_remaining" width="185px"
                       sum="Σ gốc còn"/>
                <field name="interest_amount" width="185px" sum="Σ lãi"/>
                <field name="amount_interest_paid" width="185px" sum="Σ trả lãi"/>
                <field name="amount_interest_remaining" width="185px"
                       sum="Σ lãi còn"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'partial_paid'"
                       decoration-success="state == 'paid'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

</odoo>
