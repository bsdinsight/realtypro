<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rp_goods_receipt_form_stock" model="ir.ui.view">
        <field name="name">rp.goods.receipt.form.stock</field>
        <field name="model">rp.goods.receipt</field>
        <field name="inherit_id"
               ref="rp_purchase.view_rp_goods_receipt_form"/>
        <field name="arch" type="xml">
            <field name="location" position="after">
                <!-- Để trống với dịch vụ: dịch vụ không nhập kho được
                     nhưng vẫn phải nghiệm thu mới trả tiền. -->
                <field name="picking_ids" widget="many2many_tags"
                       invisible="receipt_type == 'service'"
                       options="{'no_create': True}"/>
                <field name="picking_count" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_rp_goods_receipt_list_stock" model="ir.ui.view">
        <field name="name">rp.goods.receipt.list.stock</field>
        <field name="model">rp.goods.receipt</field>
        <field name="inherit_id"
               ref="rp_purchase.view_rp_goods_receipt_list"/>
        <field name="arch" type="xml">
            <field name="receipt_type" position="after">
                <field name="picking_count" string="Số phiếu nhập"
                       optional="show"/>
            </field>
        </field>
    </record>
</odoo>
