        <field name="kieu">so</field>
        <field name="nguon">avail</field>
        <field name="truong">luy_ke_thang</field>
        <field name="don_vi">%</field>
        <field name="so_le">2</field>
    </record>
    <record id="pl_wd_ebay" model="eam.daily.profile.line">
