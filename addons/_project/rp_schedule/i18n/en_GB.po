msgid ""
"quan hệ mà ngày đang lập vi phạm chính logic đã\n"
"                            khai — lịch chồng lấn nhưng vẫn ghi là\n"
"                            finish-to-start. Dư địa và đường găng chỉ đáng\n"
"                            tin sau khi sửa chỗ này."
msgstr ""
"links whose dates contradict the very logic declared —\n"
"                            the schedule overlaps while still recorded as\n"
"                            finish-to-start. Float and the critical path are only\n"
"                            trustworthy once this is fixed."

