<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_eam_stock_adjustment" model="ir.sequence">
            <field name="name">Phiếu điều chỉnh tồn</field>
            <field name="code">eam.stock.adjustment</field>
            <field name="prefix">DCT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_eam_disposal" model="ir.sequence">
            <field name="name">Phiếu thanh lý</field>
            <field name="code">eam.disposal</field>
            <field name="prefix">TL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
