<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_in_bao_cao_ngay" model="ir.actions.report">
        <field name="name">Báo cáo vận hành ngày</field>
        <field name="model">eam.daily.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eam_daily_report.bao_cao_ngay</field>
        <field name="report_file">eam_daily_report.bao_cao_ngay</field>
        <field name="binding_model_id" ref="model_eam_daily_report"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">
            'BCN_%s_%s' % (object.plant_id.code or '', object.date)
        </field>
    </record>

    <template id="bao_cao_ngay">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- CẢ HAI bố cục phải đi qua web.external_layout.
                     Bỏ qua nó thì tờ in ra VỠ DẤU TIẾNG VIỆT: thẻ khai
                     bộ mã vẫn còn nguyên trong HTML, nhưng Odoo cắt
                     phần đầu/chân trang trước khi đưa sang bộ dựng PDF,
                     và không có khung chuẩn thì phần thân đi một đường
                     khác rồi bị đọc như Latin-1. "Nhà máy" ra
                     "NhÃ mÃ¡y" — không có gì báo, và chỉ lộ khi nhìn
                     tờ giấy. -->
                <t t-if="o.profile_id.bo_cuc == 'luoi'"
                   t-call="web.external_layout">
                    <div class="page">
                        <t t-call="eam_daily_report.bao_cao_ngay_luoi"/>
                    </div>
                </t>
                <t t-else="" t-call="web.external_layout">
                    <div class="page">

                        <h3 class="text-center mb-0">
                            <span t-field="o.profile_id.tieu_de"/>
                        </h3>
                        <h5 class="text-center text-muted mt-0">
                            <span t-field="o.plant_id.name"/> ·
                            <span t-field="o.date"/>
                        </h5>

                        <!-- Bản thay thế phải nói ngay từ dòng đầu. Một
                             tờ bản 2 trông y hệt bản 1 là cách chắc
                             chắn để hai bản cùng lưu hành. -->
                        <div t-if="o.ban_so &gt; 1"
                             class="alert alert-warning py-1">
                            <b>Bản <span t-field="o.ban_so"/></b> — thay
                            cho bản <span t-esc="o.ban_so - 1"/>.
                            Lý do: <span t-field="o.ly_do_sua"/>
                        </div>
                        <div t-if="o.state == 'thay_the'"
                             class="alert alert-danger py-1">
                            <b>Bản này ĐÃ BỊ THAY THẾ.</b> Dùng bản
                            <span t-field="o.ban_sau_id.ban_so"/> thay cho nó.
                        </div>
                        <div t-if="o.state == 'nhap'"
                             class="alert alert-secondary py-1">
                            <b>NHÁP — chưa chốt.</b> Số liệu còn có thể đổi.
                        </div>

                        <t t-set="khoi_co"
                           t-value="o.line_ids.mapped('khoi')"/>
                        <t t-foreach="o._khoi_in()" t-as="k">
                            <t t-set="dong"
                               t-value="o.line_ids.filtered(lambda l: l.khoi == k['ma'] and (l.do_duoc or l.profile_line_id.in_khi_trong))"/>
                            <div t-if="dong" class="mt-3">
                                <h6 class="bg-light p-1 mb-1">
                                    <span t-esc="k['ten']"/>
                                </h6>
                                <!-- Dòng giá trị thường -->
                                <t t-set="thuong"
                                   t-value="dong.filtered(lambda l: l.nguon != 'khoi')"/>
                                <table t-if="thuong"
                                       class="table table-sm table-borderless mb-0">
                                    <tr t-foreach="thuong" t-as="l">
                                        <td style="width:52%" t-esc="l.name"/>
                                        <td style="width:20%"
                                            class="text-end fw-bold">
                                            <span t-esc="l.hien_thi"/>
                                        </td>
                                        <td style="width:28%"
                                            class="small text-muted">
                                            <span t-if="not l.do_duoc"
                                                  t-esc="l.ly_do_chua_do"/>
                                            <span t-elif="l.nguon == 'target'"
                                                  t-esc="l.nguon_ghi"/>
                                        </td>
                                    </tr>
                                </table>
                                <!-- Khối dựng sẵn: cả một mảng của tờ giấy -->
                                <t t-foreach="dong.filtered(lambda l: l.nguon == 'khoi')"
                                   t-as="kb">
                                    <t t-set="ma"
                                       t-value="kb.profile_line_id.khoi_dac_biet"/>
                                    <t t-if="ma == 'bang_to_may'"
                                       t-call="eam_daily_report.khoi_bang_to_may"/>
                                    <t t-if="ma == 'bang_inverter'"
                                       t-call="eam_daily_report.khoi_bang_inverter"/>
                                    <t t-if="ma == 'hoa_gio'"
                                       t-call="eam_daily_report.khoi_hoa_gio"/>
                                    <t t-if="ma == 'bieu_do_ngay'"
                                       t-call="eam_daily_report.khoi_bieu_do"/>
                                    <t t-if="ma == 'san_luong_gio'"
                                       t-call="eam_daily_report.khoi_san_luong_gio"/>
                                    <t t-if="ma == 'gio_nguyen_nhan'"
                                       t-call="eam_daily_report.khoi_gio_nguyen_nhan"/>
                                    <t t-if="ma == 'cong_to'">
                                        <p class="small text-muted mb-0">
                                            Khối công-tơ giao nhận (số đọc
                                            hôm qua / hôm nay / chênh) chưa
                                            dựng — xem C03 trong danh mục.
                                        </p>
                                    </t>
                                </t>
                            </div>
                        </t>

                        <div class="mt-3">
                            <h6 class="bg-light p-1 mb-1">Hoạt động</h6>
                            <table class="table table-sm table-bordered mb-0">
                                <tr>
                                    <td style="width:50%" class="align-top">
                                        <b>ĐÃ LÀM TRONG NGÀY</b>
                                        <div t-field="o.hoat_dong"/>
                                    </td>
                                    <td style="width:50%" class="align-top">
                                        <b>KẾ HOẠCH NGÀY MAI</b>
                                        <div t-field="o.ke_hoach_mai"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="align-top">
                                        <b>SỰ CỐ</b>
                                        <div t-field="o.su_co"/>
                                    </td>
                                    <td class="align-top">
                                        <b>GHI CHÚ</b>
                                        <div t-field="o.ghi_chu_bc"/>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div t-if="o.so_chua_do"
                             class="alert alert-warning py-1 mt-3 small">
                            <b><span t-field="o.so_chua_do"/> dòng chưa
                            có số đo</b> và được in là "—". Ô trống KHÔNG
                            phải là số không — lý do ghi ngay cạnh từng
                            dòng.
                        </div>

                        <table class="table table-sm table-borderless mt-4">
                            <tr>
                                <td class="text-center" style="width:50%">
                                    <b>NGƯỜI LẬP</b><br/>
                                    <span t-field="o.create_uid.name"/>
                                </td>
                                <td class="text-center" style="width:50%">
                                    <b>NGƯỜI CHỐT</b><br/>
                                    <span t-if="o.nguoi_chot_id"
                                          t-field="o.nguoi_chot_id.name"/>
                                    <span t-else="" class="text-muted">
                                        (chưa chốt)
                                    </span><br/>
                                    <span t-if="o.ngay_chot" class="small text-muted"
                                          t-field="o.ngay_chot"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
