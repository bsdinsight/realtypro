<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rp_schedule.RpGantt">
        <div class="rp-gantt-container">
            <div class="rp-gantt-toolbar">
                <span class="rp-gantt-title" t-esc="state.title"/>
                <span class="badge text-bg-secondary ms-2">
                    <t t-esc="state.count"/> công việc
                </span>
                <span class="text-muted small ms-3 d-none d-lg-inline">
                    Kéo thanh đổi ngày · Double-click mở chi tiết ·
                    Chuột phải thêm/xoá
                </span>
                <div class="btn-group btn-group-sm ms-auto" role="group">
                    <button t-foreach="['Day','Week','Month']" t-as="m" t-key="m"
                            type="button" class="btn"
                            t-att-class="state.viewMode === m ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setViewMode(m)">
                        <t t-if="m === 'Day'">Ngày</t>
                        <t t-elif="m === 'Week'">Tuần</t>
                        <t t-else="">Tháng</t>
                    </button>
                </div>
            </div>

            <div t-if="state.error" class="alert alert-danger m-3"
                 t-esc="state.error"/>
            <div t-if="state.empty and !state.loading" class="alert alert-info m-3">
                Hợp đồng này chưa có công việc nào. Import lịch thi công
                (MS Project XML / Excel) hoặc chuột phải để thêm.
            </div>
            <div t-if="state.loading" class="text-center text-muted p-5">
                <i class="fa fa-spinner fa-spin me-2"/>Đang tải Gantt…
            </div>

            <!-- Syncfusion EJ2 Gantt mount vào đây (tự có treegrid +
                 timeline + splitter + toolbar zoom + context menu) -->
            <div class="rp-gantt-ej2" t-ref="gantt"/>
        </div>
    </t>

</templates>
