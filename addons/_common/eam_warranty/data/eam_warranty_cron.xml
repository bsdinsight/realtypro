<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_eam_warranty" model="ir.cron">
        <field name="name">EAMOne: cảnh báo bảo hành sắp hết</field>
        <field name="model_id" ref="eam_core.model_eam_asset"/>
        <field name="state">code</field>
        <field name="code">model._cron_canh_bao_bao_hanh()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=8, minute=0, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
