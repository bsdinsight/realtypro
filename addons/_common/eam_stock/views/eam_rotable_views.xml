<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== RMA / bảo hành / hoàn lõi ===== -->
    <record id="view_eam_rma_list" model="ir.ui.view">
        <field name="name">eam.rma.list</field>
        <field name="model">eam.rma</field>
        <field name="arch" type="xml">
            <list string="Trả hàng / bảo hành / hoàn lõi"
                  decoration-danger="qua_han"
                  decoration-muted="state in ('closed','rejected')">
                <field name="name" string="Số phiếu"/>
                <field name="date" string="Ngày lập"/>
                <field name="rma_type" string="Loại" widget="badge"/>
                <field name="partner_id" string="Gửi cho" width="220px"/>
                <field name="product_id" string="Vật tư" width="240px"/>
                <field name="lot_id" string="Sê-ri"/>
                <field name="qty" string="SL"/>
                <field name="date_due" string="Hạn"/>
                <field name="qua_han" string="Quá hạn"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state in ('returned','closed')"
                       decoration-info="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_eam_rma_form" model="ir.ui.view">
        <field name="name">eam.rma.form</field>
        <field name="model">eam.rma</field>
        <field name="arch" type="xml">
            <form string="Phiếu RMA">
                <header>
                    <button name="action_gui" type="object" string="Gửi đi"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_chap_nhan" type="object"
                            string="Bên kia chấp nhận"
                            invisible="state != 'sent'"/>
                    <button name="action_tu_choi" type="object"
                            string="Bên kia từ chối"
                            invisible="state != 'sent'"/>
                    <button name="action_nhan_lai" type="object"
                            string="Đã nhận lại" class="oe_highlight"
                            invisible="state != 'accepted'"/>
                    <button name="action_dong" type="object" string="Đóng"
                            invisible="state not in ('returned','rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,accepted,returned,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-danger" role="status"
                         invisible="not qua_han">
                        <b>Quá hạn.</b> Trả lõi quá hạn thì bị tính thêm
                        tiền; đòi bảo hành quá hạn thì mất quyền.
                    </div>
                    <group>
                        <group string="Gửi cái gì, cho ai">
                            <field name="rma_type"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="asset_id" readonly="1"/>
                            <field name="qty"/>
                        </group>
                        <group string="Hạn &amp; tham chiếu">
                            <field name="date"/>
                            <field name="date_due"/>
                            <field name="qua_han" readonly="1"/>
                            <field name="location_id"
                                   options="{'no_create': True}"/>
                            <field name="ref_supplier"/>
                            <field name="work_order_id"/>
                        </group>
                    </group>
                    <separator string="Lý do / mô tả"/>
                    <field name="reason" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eam_rma_search" model="ir.ui.view">
        <field name="name">eam.rma.search</field>
        <field name="model">eam.rma</field>
        <field name="arch" type="xml">
            <search string="Tìm phiếu RMA">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lot_id"/>
                <filter name="f_d_date" string="Ngày lập" date="date"/>
                <separator/>
                <filter name="f_qua_han" string="Quá hạn"
                        domain="[('qua_han', '=', True)]"/>
                <filter name="f_dang_mo" string="Chưa đóng"
                        domain="[('state', 'not in', ('closed','rejected'))]"/>
                <separator/>
                <filter name="g_loai" string="Loại"
                        context="{'group_by': 'rma_type'}"/>
                <filter name="g_ben" string="Bên nhận"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_eam_rma" model="ir.actions.act_window">
        <field name="name">Trả hàng / bảo hành / hoàn lõi</field>
        <field name="res_model">eam.rma</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eam_rma_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phiếu nào</p>
            <p>Gộp bốn việc cùng hình dạng: <b>đòi bảo hành</b>,
               <b>gửi sửa/đại tu</b>, <b>trả lõi cũ</b> theo cam kết đổi
               lõi, và <b>trả hàng sai</b>. Cái nào cũng có hạn — và hạn
               là thứ duy nhất ngăn phiếu nằm quên.</p>
        </field>
    </record>

    <!-- ===== Điều chuyển giữa kho ===== -->
    <record id="view_eam_transfer_list" model="ir.ui.view">
        <field name="name">eam.stock.transfer.list</field>
        <field name="model">eam.stock.transfer</field>
        <field name="arch" type="xml">
            <list string="Điều chuyển giữa kho"
                  decoration-warning="state == 'in_transit'"
                  decoration-danger="con_thieu">
                <field name="name" string="Số phiếu"/>
                <field name="date" string="Ngày gửi"/>
                <field name="warehouse_from_id" string="Từ kho"/>
                <field name="warehouse_to_id" string="Đến kho"/>
                <field name="date_received" string="Ngày nhận"/>
                <field name="receiver_id" string="Người nhận"/>
                <field name="con_thieu" string="Nhận thiếu"/>
                <field name="state" string="Trạng thái" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_transit'"/>
            </list>
        </field>
    </record>

    <record id="view_eam_transfer_form" model="ir.ui.view">
        <field name="name">eam.stock.transfer.form</field>
        <field name="model">eam.stock.transfer</field>
        <field name="arch" type="xml">
            <form string="Điều chuyển giữa kho">
                <header>
                    <button name="action_gui" type="object" string="Gửi hàng"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_nhan" type="object"
                            string="Xác nhận đã nhận" class="oe_highlight"
                            invisible="state != 'in_transit'"/>
                    <button name="action_huy" type="object" string="Huỷ"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_transit,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="state != 'in_transit'">
                        <b>Hàng đang đi.</b> Đã rời kho gửi, chưa vào kho
                        nhận — đang nằm ở vị trí trung chuyển và vẫn thuộc
                        trách nhiệm bên gửi cho tới khi bên nhận ký.
                    </div>
                    <div class="alert alert-danger" role="status"
                         invisible="not con_thieu">
                        <b>Nhận thiếu.</b> Phần thiếu vẫn nằm ở vị trí
                        trung chuyển — phải tìm ra, nó không tự xoá.
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_from_id"
                                   options="{'no_create': True}"/>
                            <field name="warehouse_to_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="date_received" readonly="1"/>
                            <field name="receiver_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id" string="Vật tư" width="280px"/>
                            <field name="lot_id" string="Sê-ri / lô"
                                   options="{'no_create_edit': True}"/>
                            <field name="qty_sent" string="SL gửi"/>
                            <field name="qty_received" string="SL nhận"/>
                            <field name="chenh" string="Chênh lệch"/>
                            <field name="uom_id" string="ĐVT" optional="hide"/>
                        </list>
                    </field>
                    <separator string="Ghi chú"/>
                    <field name="note" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eam_transfer" model="ir.actions.act_window">
        <field name="name">Điều chuyển giữa kho</field>
        <field name="res_model">eam.stock.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có phiếu điều chuyển</p>
            <p>Chuyển hai nhịp qua vị trí trung chuyển. Giữa hai nhịp,
               hàng <b>đang đi</b> — đếm được, tra được, và thuộc trách
               nhiệm bên gửi cho tới khi bên nhận ký.</p>
        </field>
    </record>

    <!-- ===== Bảo hành trên lô ===== -->
    <record id="view_stock_lot_form_rotable" model="ir.ui.view">
        <field name="name">stock.lot.form.rotable</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="eam_stock.view_stock_lot_form_eam"/>
        <field name="arch" type="xml">
            <field name="eam_mfg_batch" position="after">
                <field name="eam_asset_id" readonly="1"
                       options="{'no_create': True}"/>
                <field name="eam_warranty_end"/>
                <field name="eam_core_due"/>
                <field name="eam_warranty_note"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_eam_transfer" name="Điều chuyển giữa kho"
              parent="menu_eam_store_io"
              action="action_eam_transfer" sequence="30"/>
    <menuitem id="menu_eam_rma" name="Trả hàng / bảo hành"
              parent="menu_eam_store_io"
              action="action_eam_rma" sequence="40"/>

</odoo>
