<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Hồ sơ điện gió. Khác điện mặt trời ở MỘT chỗ có hệ quả lớn: nhà
      máy gió trong hệ chưa có chuỗi bậc đo, nên sản lượng ngày dựng
      thẳng từ điểm đo của từng tua-bin.

      Mọi dòng lấy từ kho chuỗi thời gian đều gọi điểm đo theo MÃ CÓ SAO
      ("T*_E"), không theo bản ghi: cùng một hồ sơ phải chạy được cho
      nhà máy mười hai trụ lẫn nhà máy hai mươi trụ.

      Và mọi dòng khớp nhiều điểm đo đều KHAI cách gộp. Cộng sản lượng
      mười hai tua-bin ra sản lượng nhà máy thì đúng; "cộng" nhiệt độ
      môi trường thì vô nghĩa nên nó khai trung bình. Chưa khai mà mã
      khớp nhiều thì dòng đó báo thiếu khai báo chứ không tự chọn.

      Công suất đỉnh lấy theo TỪNG MỐC THỜI GIAN rồi mới lấy đỉnh —
      cộng đỉnh của mười hai tua-bin là cộng mười hai thời điểm khác
      nhau, ra một con số chưa từng tồn tại.
    -->
    <record id="profile_wind" model="eam.daily.profile">
        <field name="name">Báo cáo vận hành ngày — điện gió</field>
        <field name="code">WIND-DAILY</field>
        <field name="loai">wind</field>
        <field name="tieu_de">BÁO CÁO VẬN HÀNH NGÀY — NHÀ MÁY ĐIỆN GIÓ</field>
        <field name="note">Cần điểm đo đặt mã theo nếp: T&lt;số&gt;_E sản lượng, T&lt;số&gt;_P công suất, T&lt;số&gt;_WS tốc độ gió.
Mã khác nếp thì sửa mã điểm đo trên dòng cấu hình, không phải sửa mã.</field>
    </record>
    <record id="pl_wd_vtb" model="eam.daily.profile.line">
        <field name="profile_id" ref="profile_wind"/>
        <field name="sequence">10</field>
        <field name="khoi">khi_tuong</field>
        <field name="name">Tốc độ gió trung bình</field>
        <field name="kieu">so</field>
        <field name="nguon">historian</field>
        <field name="don_vi">m/s</field>
        <field name="so_le">2</field>
        <field name="tag_code">T*_WS</field>
        <field name="cach_lay">gop</field>
        <field name="gop_nhieu">tb</field>
    </record>
    <record id="pl_wd_vmx" model="eam.daily.profile.line">
