<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_rp_ppa" model="ir.sequence">
            <field name="name">Hợp đồng mua bán điện</field>
            <field name="code">rp.ppa</field>
            <field name="prefix">PPA/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_rp_energy_period" model="ir.sequence">
            <field name="name">Kỳ sản lượng điện</field>
            <field name="code">rp.energy.period</field>
            <field name="prefix">SL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
