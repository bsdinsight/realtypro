<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_tender_invite" model="mail.template">
        <field name="name">Thư mời thầu (Construction Network)</field>
        <field name="model_id" ref="model_cn_tender_invite"/>
        <field name="email_from">RealtyPro Construction Network &lt;no-reply@realtypro.vn&gt;</field>
        <field name="reply_to">{{ object.company_id.email or object.tender_id.gc_partner_id.email or '' }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="subject">Thư mời thầu: {{ object.tender_id.name }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:16px;font-family:Arial,Helvetica,sans-serif;color:#1a2b2e;">
    <p>Kính gửi <t t-out="object.partner_name or object.email"/>,</p>
    <p>
        <t t-out="object.tender_id.gc_partner_id.name or object.company_id.name"/>
        trân trọng kính mời Quý nhà thầu tham gia dự thầu gói:
    </p>
    <p style="font-size:16px;font-weight:bold;color:#0e5563;">
        <t t-out="object.tender_id.name"/>
    </p>
    <table style="font-size:13px;color:#46605f;border-collapse:collapse;">
        <tr><td style="padding:2px 12px 2px 0;">Chuyên môn:</td>
            <td><t t-out="object.tender_id.specialty or '—'"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Hạn nộp hồ sơ:</td>
            <td><t t-out="object.tender_id.deadline or 'liên hệ'"/></td></tr>
    </table>
    <p>
        Vui lòng bấm nút dưới đây để đăng nhập/đăng ký tài khoản nhà thầu,
        tải hồ sơ mời thầu và nộp báo giá cùng tài liệu yêu cầu:
    </p>
    <p style="text-align:center;margin:24px 0;">
        <a t-att-href="object.invite_url"
           style="background:#0e5563;color:#ffffff;text-decoration:none;padding:12px 28px;border-radius:6px;font-weight:bold;display:inline-block;">
            Xem gói thầu &amp; nộp hồ sơ
        </a>
    </p>
    <p style="font-size:12px;color:#6f8583;">
        Nếu nút không hoạt động, sao chép liên kết:
        <br/><t t-out="object.invite_url"/>
    </p>
    <p style="font-size:12px;color:#6f8583;">
        Trân trọng,<br/>Construction Network — RealtyPro
    </p>
</div>
        </field>
        <field name="lang">{{ object.partner_id.lang or 'vi_VN' }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- Báo bên mời thầu (CĐT/tổng thầu) khi nhà thầu nộp hồ sơ -->
    <record id="mail_template_bid_submitted" model="mail.template">
        <field name="name">Thông báo nộp hồ sơ dự thầu</field>
        <field name="model_id" ref="model_cn_bid"/>
        <field name="email_from">RealtyPro Construction Network &lt;no-reply@realtypro.vn&gt;</field>
        <field name="email_to">{{ object.tender_id.gc_partner_id.email or '' }}</field>
        <field name="subject">[Nộp HSDT] {{ object.contractor_id.name }} — {{ object.tender_id.name }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:16px;font-family:Arial,Helvetica,sans-serif;color:#1a2b2e;">
    <p>Kính gửi <t t-out="object.tender_id.gc_partner_id.name or 'Quý đơn vị'"/>,</p>
    <p>
        Nhà thầu <b><t t-out="object.contractor_id.name"/></b> vừa nộp hồ sơ
        dự thầu cho gói:
    </p>
    <p style="font-size:16px;font-weight:bold;color:#0e5563;">
        <t t-out="object.tender_id.name"/>
    </p>
    <table style="font-size:13px;color:#46605f;border-collapse:collapse;">
        <tr><td style="padding:2px 12px 2px 0;">Giá dự thầu:</td>
            <td><t t-out="object.price"/> <t t-out="object.currency_id.name or ''"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Số tài liệu nộp:</td>
            <td><t t-out="object.document_count"/></td></tr>
        <tr><td style="padding:2px 12px 2px 0;">Thời điểm nộp:</td>
            <td><t t-out="object.submitted_date"/></td></tr>
    </table>
    <p style="font-size:12px;color:#6f8583;">
        Đăng nhập hệ thống để xem chi tiết hồ sơ và đánh giá.<br/>
        Construction Network — RealtyPro
    </p>
</div>
        </field>
        <field name="lang">{{ object.tender_id.gc_partner_id.lang or 'vi_VN' }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- ===== Nhà thầu tự đăng ký: báo TỔNG THẦU có đơn mới ===== -->
    <record id="mail_template_apply_new" model="mail.template">
        <field name="name">Có nhà thầu đăng ký tham gia gói thầu</field>
        <field name="model_id" ref="model_cn_tender_invite"/>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="email_to">{{ object.tender_id.gc_partner_id.email or '' }}</field>
        <field name="subject">[Đăng ký tham gia] {{ object.partner_name }} — {{ object.tender_id.name }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;color:#12283A">
    <p>Kính gửi <t t-out="object.tender_id.gc_partner_id.name or 'Quý đơn vị'"/>,</p>
    <p>Một nhà thầu vừa <b>đăng ký tham gia</b> gói thầu
       <b><t t-out="object.tender_id.name or ''"/></b> trên Realty Pro Network:</p>
    <table style="border-collapse:collapse;margin:12px 0">
        <tr><td style="padding:4px 12px 4px 0;color:#4A6472">Nhà thầu</td>
            <td style="padding:4px 0"><b><t t-out="object.partner_name or ''"/></b></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#4A6472">Mã số thuế</td>
            <td style="padding:4px 0"><t t-out="object.partner_id.cn_tax_code or '—'"/></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#4A6472">Email</td>
            <td style="padding:4px 0"><t t-out="object.email or ''"/></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#4A6472">Hồ sơ năng lực</td>
            <td style="padding:4px 0"><t t-out="object.partner_id.cn_profile_progress or 0"/>% hoàn thiện</td></tr>
    </table>
    <p>Nhà thầu này <b>chưa xem được hồ sơ mời thầu</b> và <b>chưa nộp được hồ sơ dự thầu</b>
       cho tới khi Quý đơn vị duyệt.</p>
    <p style="color:#6C8792;font-size:12.5px">— Realty Pro Network</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- ===== Báo nhà thầu: ĐÃ DUYỆT ===== -->
    <record id="mail_template_apply_approved" model="mail.template">
        <field name="name">Đã duyệt tham gia gói thầu</field>
        <field name="model_id" ref="model_cn_tender_invite"/>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="subject">[Được duyệt] Bạn có thể dự thầu: {{ object.tender_id.name }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;color:#12283A">
    <p>Kính gửi <t t-out="object.partner_name or 'Quý nhà thầu'"/>,</p>
    <p><b><t t-out="object.tender_id.gc_partner_id.name or 'Bên mời thầu'"/></b> đã
       <b style="color:#0B7350">duyệt</b> cho Quý đơn vị tham gia gói thầu
       <b><t t-out="object.tender_id.name or ''"/></b>.</p>
    <p>Quý đơn vị đã có thể <b>tải hồ sơ mời thầu</b> và <b>nộp hồ sơ dự thầu</b>.</p>
    <p style="margin:18px 0">
        <a t-att-href="object.tender_id.get_base_url() + '/my/tenders/' + str(object.tender_id.id)"
           style="background:#0E8C99;color:#fff;font-weight:700;padding:11px 20px;border-radius:9px;text-decoration:none">
           Xem gói thầu &amp; nộp hồ sơ</a>
    </p>
    <p t-if="object.tender_id.deadline">
        <b>Hạn nộp hồ sơ:</b> <t t-out="object.tender_id.deadline.strftime('%d/%m/%Y')"/>
    </p>
    <p style="color:#6C8792;font-size:12.5px">— Realty Pro Network</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>

    <!-- ===== Báo nhà thầu: TỪ CHỐI ===== -->
    <record id="mail_template_apply_rejected" model="mail.template">
        <field name="name">Từ chối tham gia gói thầu</field>
        <field name="model_id" ref="model_cn_tender_invite"/>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="subject">Kết quả đăng ký tham gia: {{ object.tender_id.name }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;color:#12283A">
    <p>Kính gửi <t t-out="object.partner_name or 'Quý nhà thầu'"/>,</p>
    <p>Cảm ơn Quý đơn vị đã quan tâm gói thầu
       <b><t t-out="object.tender_id.name or ''"/></b>.</p>
    <p>Rất tiếc, lần này bên mời thầu <b>chưa chấp thuận</b> đăng ký tham gia của Quý đơn vị<t t-if="object.reject_reason">:
       <i><t t-out="object.reject_reason"/></i></t>.</p>
    <p>Quý đơn vị vẫn có thể theo dõi và đăng ký các gói thầu khác đang mở trên Network.
       Hồ sơ năng lực càng đầy đủ, cơ hội được duyệt càng cao.</p>
    <p style="color:#6C8792;font-size:12.5px">— Realty Pro Network</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>

</odoo>
