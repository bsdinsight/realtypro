<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rp_rfi_list" model="ir.ui.view">
        <field name="name">rp.rfi.list</field>
        <field name="model">rp.rfi</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="code"/>
                <field name="name"/>
                <field name="contractor_id"/>
                <field name="contract_id" optional="hide"/>
                <field name="recipient"/>
                <field name="submitted_date" optional="show"/>
                <field name="deadline"/>
                <field name="days_waiting"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="impact_schedule" optional="show"/>
                <field name="impact_cost" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'answered'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_rfi_form" model="ir.ui.view">
        <field name="name">rp.rfi.form</field>
        <field name="model">rp.rfi</field>
        <field name="arch" type="xml">
            <form string="RFI">
                <header>
                    <button name="action_submit" string="Gửi RFI"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_answer" string="Xác nhận trả lời"
                            type="object" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_close" string="Đóng (đã rõ)"
                            type="object" class="btn-primary"
                            invisible="state != 'answered'"/>
                    <button name="action_reopen" string="Hỏi lại"
                            type="object"
                            invisible="state not in ('answered', 'closed')"/>
                    <button name="action_cancel" string="Huỷ" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,answered,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                        <h2><field name="name"
                                   placeholder="Câu hỏi tóm tắt..."/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="structure_id" options="{'no_create': True}"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="recipient"/>
                            <field name="requested_by_id"
                                   widget="many2one_avatar_user"/>
                            <field name="deadline"/>
                            <field name="days_waiting"/>
                            <field name="is_overdue" invisible="not is_overdue"/>
                            <field name="impact_schedule"/>
                            <field name="impact_cost"/>
                        </group>
                    </group>
                    <group string="Câu hỏi">
                        <field name="question" nolabel="1" colspan="2"
                               placeholder="Nội dung cần làm rõ, tham chiếu bản vẽ/spec..."/>
                    </group>
                    <group string="Trả lời">
                        <field name="answer" nolabel="1" colspan="2"
                               placeholder="Nội dung trả lời của TVGS/Thiết kế/CĐT..."/>
                        <field name="answered_by_id"
                               invisible="not answered_by_id"/>
                        <field name="answered_date"
                               invisible="not answered_date"/>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_rfi_search" model="ir.ui.view">
        <field name="name">rp.rfi.search</field>
        <field name="model">rp.rfi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="contractor_id"/>
                <filter name="filter_open" string="Chờ trả lời"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_overdue" string="Quá hạn"
                        domain="[('state', '=', 'submitted'),
                                 ('deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_impact" string="Ảnh hưởng tiến độ"
                        domain="[('impact_schedule', '=', True)]"/>
                <separator/>
                <filter string="Nhà thầu" name="group_contractor"
                        context="{'group_by': 'contractor_id'}"/>
                <filter string="Gửi tới" name="group_recipient"
                        context="{'group_by': 'recipient'}"/>
                <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_rfi" model="ir.actions.act_window">
        <field name="name">RFI — Yêu cầu làm rõ</field>
        <field name="res_model">rp.rfi</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo RFI đầu tiên</p>
            <p>Vướng bản vẽ, xung đột thiết kế, thiếu thông tin — hỏi
               chính thức, có hạn trả lời và đồng hồ đếm ngày chờ.
               RFI trễ là căn cứ claim tiến độ.</p>
        </field>
    </record>
</odoo>
