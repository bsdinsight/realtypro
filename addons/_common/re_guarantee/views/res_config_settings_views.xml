<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Chèn khối Bảo lãnh vào chính màn hình cấu hình của phân hệ Vay:
      hai phân hệ dùng chung một trang, người dùng chỉ phải nhớ một chỗ.
      Menu bên dưới trỏ tới cùng action đó, để vào từ nhánh Bảo lãnh NH
      cũng ra đúng trang này.
    -->
    <record id="res_config_settings_view_form_re_guarantee"
            model="ir.ui.view">
        <field name="name">res.config.settings.form.re_guarantee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="re_loan.res_config_settings_view_form_re_loan"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='net_off']" position="after">
                <group name="guarantee_reminder"
                       string="Nhắc bảo lãnh sắp hết hạn">
                    <field name="re_guarantee_expiry_lead_days"/>
                    <field name="re_guarantee_expiry_repeat_days"/>
                </group>
                <group name="guarantee_accounting"
                       string="Kế toán thanh toán bảo lãnh">
                    <field name="re_guarantee_journal_id"
                           options="{'no_create': True}"/>
                    <field name="re_guarantee_fee_account_id"
                           options="{'no_create': True}"/>
                    <field name="re_guarantee_penalty_account_id"
                           options="{'no_create': True}"/>
                    <field name="re_guarantee_deposit_account_id"
                           options="{'no_create': True}"/>
                    <field name="re_guarantee_principal_account_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-warning" role="alert">
                    <h5><i class="fa fa-calculator"
                           title="Kế toán"/> Bốn tài khoản này bắt buộc
                    khai</h5>
                    <p style="margin-bottom: 0;">
                        Mỗi đợt thanh toán chứng thư BL sinh một
                        <b>phiếu chi thật</b>. Đối ứng phụ thuộc bản
                        chất khoản trả nên không đoán được:
                        <b>phí BL</b> và <b>phạt</b> là chi phí (642 /
                        811), <b>ký quỹ</b> là <b>tài sản</b> (244 — NH
                        trả lại khi giải toả, nên có nút
                        <b>Ghi nhận thu hoàn ký quỹ</b> trên chứng thư),
                        còn <b>tiền gốc</b> là khoản đi vay khi NH trả
                        thay cho beneficiary (3411).
                        Chưa khai thì đợt thanh toán vẫn ghi nhận được,
                        nhưng <b>chưa có phiếu chi</b> — hệ thống nhắc
                        trong nhật ký chứng thư.
                    </p>
                </div>
                <div class="alert alert-info" role="alert">
                    <h5><i class="fa fa-envelope-o"
                           title="Thư nhắc"/> Thư nhắc bảo lãnh</h5>
                    <p style="margin-bottom: 0;">
                        Mỗi sáng hệ thống rà các chứng thư sắp hết hạn và
                        gửi thư cho <b>Người phụ trách (PIC)</b> ghi trên
                        chứng thư. Chứng thư <b>chưa khai PIC thì không
                        được nhắc</b> — không biết gửi cho ai, mà gửi cả
                        nhóm thì thành thư rác.
                    </p>
                </div>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_re_guarantee_config_settings"
              name="Tham số Bảo lãnh"
              parent="menu_re_guarantee_root"
              action="re_loan.action_re_loan_config_settings"
              sequence="90"
              groups="re_loan.group_loan_manager"/>

</odoo>
