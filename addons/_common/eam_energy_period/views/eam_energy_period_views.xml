<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_period_list" model="ir.ui.view">
        <field name="name">eam.energy.period.list</field>
        <field name="model">eam.energy.period</field>
        <field name="arch" type="xml">
            <!-- CHỈ bày thước đo CỘNG ĐƯỢC. Màn này ghim ở bậc NGÀY và
                 người dùng sẽ gom nhóm theo tuần / tháng / năm ngay trên
                 lưới, nên mọi cột phải chịu được phép cộng.

                 Hệ số công suất, Khả dụng %, Đạt so với P50 ĐÃ BỊ GỠ
                 khỏi đây: chúng là TỶ SỐ CỦA TỔNG, gom 30 ngày rồi lấy
                 trung bình ra số khác sự thật. Chúng vẫn còn trên bản
                 ghi và còn ở các màn tính sẵn theo kỳ — đừng kéo lại
                 vào đây chỉ vì "cho tiện xem". -->
            <list string="Sản lượng" create="false"
                  decoration-warning="not du_lieu_day">
                <field name="tu_ngay" string="Ngày" width="130px"/>
                <field name="plant_id" string="Nhà máy" width="240px"/>
                <field name="san_luong" sum="Tổng sản lượng"/>
                <field name="sl_mat" string="Mất (kWh)" sum="Tổng mất"/>
                <field name="p50" optional="show" sum="Tổng P50"/>
                <field name="doanh_thu" optional="hide" sum="Tổng doanh thu"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="du_lieu_day" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_period_form" model="ir.ui.view">
        <field name="name">eam.energy.period.form</field>
        <field name="model">eam.energy.period</field>
        <field name="arch" type="xml">
            <form string="Sản lượng theo kỳ">
                <header>
                    <button name="action_xem_to_may" type="object"
                            string="Xem bảng tổ máy của kỳ này"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning py-1" role="status"
                         invisible="du_lieu_day">
                        <b>Kỳ này thiếu
                        <field name="so_ngay_thieu" class="oe_inline"/>
                        ngày dữ liệu.</b> Hệ KHÔNG cộng ngày thiếu thành 0,
                        nên con số dưới đây <b>nhỏ hơn thật</b> — đừng
                        đem so với một kỳ đủ ngày mà chưa trừ phần này.
                    </div>
                    <div class="alert alert-secondary py-1" role="status"
                         invisible="co_muc_tieu">
                        <b>Chưa so được với mục tiêu:</b>
                        <field name="ly_do_khong_so" class="oe_inline"
                               readonly="1"/>.
                        Để trống chứ không ghi 0% — "đạt 0% kế hoạch" và
                        "chưa ai khai kế hoạch" là hai chuyện khác hẳn.
                    </div>
                    <group>
                        <group string="Kỳ">
                            <field name="plant_id" readonly="1"/>
                            <field name="loai_ky" readonly="1"/>
                            <field name="tu_ngay" readonly="1"/>
                            <field name="den_ngay" readonly="1"/>
                            <field name="so_ngay" readonly="1"/>
                            <field name="so_ngay_co_so" readonly="1"/>
                            <field name="so_ngay_thieu" readonly="1"/>
                            <field name="du_lieu_day" invisible="1"/>
                        </group>
                        <group string="Sản lượng">
                            <field name="san_luong" readonly="1"/>
                            <field name="cong_suat_dat_kw" readonly="1"/>
                            <field name="he_so_cong_suat" readonly="1"/>
                            <field name="sl_mat" readonly="1"/>
                            <field name="kd_san_luong" readonly="1"/>
                            <field name="doanh_thu" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="So với mục tiêu" invisible="not co_muc_tieu">
                        <group>
                            <field name="p50" readonly="1"/>
                            <field name="p75" readonly="1"/>
                            <field name="p90" readonly="1"/>
                        </group>
                        <group>
                            <field name="ty_le_p50" readonly="1"/>
                            <field name="dat_muc" readonly="1" widget="badge"/>
                            <field name="co_muc_tieu" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_period_search" model="ir.ui.view">
        <field name="name">eam.energy.period.search</field>
        <field name="model">eam.energy.period</field>
        <field name="arch" type="xml">
            <search string="Tìm">
                <field name="plant_id"/>
                <!-- KHÔNG còn bộ lọc "Theo ngày / tuần / tháng / năm".
                     Độ mịn thời gian nay là chuyện của phép GOM NHÓM —
                     bấm lên đầu cột trong pivot — chứ không phải chuyện
                     chọn dòng. Action đã ghim `loai_ky = ngay` bằng
                     DOMAIN, nên bốn bậc không thể cộng chồng nữa: đó là
                     ràng buộc cấu trúc, không phải lời nhắc người dùng
                     phải nhớ. -->
                <!-- YTD — luỹ kế từ 01/01 tới HÔM NAY.
                     Pivot không làm được vế này: cột "Năm" của pivot là
                     TRỌN NĂM, nên tháng 10 mà xem cột 2026 là đang so
                     mười tháng đã chạy với mười hai tháng của năm trước.
                     Lệch hai tháng mà không có gì trên màn hình nói ra.

                     Chặn theo `tu_ngay` cả hai đầu, KHÔNG chặn bằng
                     `den_ngay`. Chặn `den_ngay <= hôm nay` nghe hợp lý
                     mà sai nghĩa: nó chỉ lấy kỳ ĐÃ KẾT THÚC, nên đang
                     ngày 24 tháng 10 thì cả tháng 10 bị loại — luỹ kế
                     hụt mất tới một tháng mà màn hình không nói gì. YTD
                     là "tất cả tới hôm nay", phải gồm cả kỳ đang dở;
                     con số của kỳ dở vốn đã chỉ gồm những ngày đã trôi
                     qua, vì nó cộng từ bảng tổ máy.

                     CÒN MỘT CHỖ LỆCH KHÔNG CHỮA ĐƯỢC BẰNG BỘ LỌC: ở bậc
                     tháng, tháng đang chạy của năm nay là tháng DỞ còn
                     tháng ấy của năm trước là tháng ĐỦ. So ở bậc NGÀY
                     thì hai bên cùng số ngày, mới là phép so chặt. -->
                <filter name="f_ytd" string="Từ đầu năm tới nay"
                        domain="[('tu_ngay', '&gt;=', context_today().strftime('%Y-01-01')),
                                 ('tu_ngay', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_ytd_truoc" string="Cùng kỳ năm trước"
                        domain="[('tu_ngay', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-01-01')),
                                 ('tu_ngay', '&lt;=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <!-- Bỏ "DƯỚI P90", "Thiếu ngày dữ liệu", "Chưa khai mục
                     tiêu": ba thứ ấy đi với các cột TỶ LỆ vừa gỡ khỏi
                     màn này, và chúng chỉ có nghĩa ở kỳ tính sẵn —
                     "dưới P90 trong một NGÀY" gần như vô nghĩa với điện
                     gió. Chúng ở lại các màn Khả dụng theo ngày, Chất
                     lượng dữ liệu và Mục tiêu sản lượng. -->
                <filter name="g_nm" string="Nhà máy"
                        context="{'group_by': 'plant_id'}"/>
                <filter name="g_ngay" string="Ngày"
                        context="{'group_by': 'tu_ngay:day'}"/>
                <filter name="g_tuan" string="Tuần"
                        context="{'group_by': 'tu_ngay:week'}"/>
                <filter name="g_thang" string="Tháng"
                        context="{'group_by': 'tu_ngay:month'}"/>
                <filter name="g_nam" string="Năm"
                        context="{'group_by': 'tu_ngay:year'}"/>
            </search>
        </field>
    </record>

    <!-- Cộng gộp hay để cạnh nhau: pivot cho cả hai. Bỏ nhà máy khỏi
         hàng là cộng gộp nhiều nhà máy; để lại là đặt cạnh nhau. Đó
         chính là vế "tùy chọn theo 1 hoặc nhiều nhà máy".

         Trước đây pivot phải để LOẠI KỲ làm hàng ngoài cùng, như một
         cái chặn: bảng lưu cùng một lượng điện thành bốn bộ dòng, nên
         gỡ bộ lọc bậc ra là cộng gấp bốn (đo trên DG123: 12.322.992 →
         49.172.508 kWh). Nay action GHIM `loai_ky = ngay` bằng domain
         nên chuyện ấy không xảy ra được nữa, và cái chặn đã gỡ —
         ràng buộc cấu trúc bao giờ cũng hơn lời nhắc. -->

    <record id="view_period_pivot" model="ir.ui.view">
        <field name="name">eam.energy.period.pivot</field>
        <field name="model">eam.energy.period</field>
        <field name="arch" type="xml">
            <pivot string="Sản lượng">
                <field name="plant_id" type="row"/>
                <!-- Cột là NGÀY, và người dùng bấm lên đầu cột để đổi
                     sang Tuần / Tháng / Quý / Năm. Đó mới là thao tác
                     ai cũng biết; trước đây phải mở menu xổ đi tìm một
                     bộ lọc tên "Theo tháng". -->
                <field name="tu_ngay" interval="month" type="col"/>
                <field name="san_luong" type="measure"/>
                <field name="sl_mat" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_period_graph" model="ir.ui.view">
        <field name="name">eam.energy.period.graph</field>
        <field name="model">eam.energy.period</field>
        <field name="arch" type="xml">
            <graph string="Sản lượng" type="bar" stacked="0">
                <field name="tu_ngay" interval="month"/>
                <field name="plant_id"/>
                <field name="san_luong" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_period" model="ir.actions.act_window">
        <field name="name">Sản lượng nhà máy</field>
        <field name="res_model">eam.energy.period</field>
        <!-- PIVOT đứng trước: đây là màn để XOAY, không phải để đọc
             từng dòng. Danh sách vẫn còn, cho ai muốn soi ngày cụ thể. -->
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="view_id" ref="view_period_pivot"/>
        <field name="search_view_id" ref="view_period_search"/>
        <!-- GHIM bậc NGÀY bằng DOMAIN chứ không bằng bộ lọc mặc định.
             Khác nhau một trời: bộ lọc thì người dùng tắt được, và tắt
             là cộng cùng một lượng điện bốn lần; domain thì không tắt
             được, nên lỗi ấy hết đường xảy ra.

             Bậc ngày cũng là bậc DUY NHẤT gom nhóm lại được mà vẫn
             đúng: cộng các ngày ra tuần, ra tháng, ra năm đều đúng, còn
             cộng các tháng với các năm thì không có nghĩa gì. -->
        <field name="domain">[('loai_ky', '=', 'ngay')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có ngày nào có
            số</p>
            <p>Màn này mở sẵn ở dạng <b>bảng xoay</b>. Đổi độ mịn thời
            gian bằng cách bấm lên <b>đầu cột</b> rồi chọn Ngày / Tuần /
            Tháng / Quý / Năm — không phải đi tìm bộ lọc.</p>
            <p>Bỏ <b>Nhà máy</b> khỏi hàng là <b>cộng gộp</b> nhiều nhà
            máy; để lại là <b>đặt cạnh nhau</b>. Muốn luỹ kế từ đầu năm
            thì bật <b>Từ đầu năm tới nay</b>, thêm <b>Cùng kỳ năm
            trước</b> để so hai năm.</p>
            <p>Ở đây chỉ có những con số <b>cộng được</b> — sản lượng,
            sản lượng mất, doanh thu. Hệ số công suất, khả dụng % và
            mức đạt so với P50 là <b>tỷ số</b>, cộng hay lấy trung bình
            đều sai, nên chúng ở màn <i>Khả dụng theo ngày</i> và
            <i>Mục tiêu sản lượng</i>.</p>
        </field>
    </record>

    <menuitem id="menu_period" name="Sản lượng nhà máy"
              parent="eam_core.menu_eam_perf"
              action="action_period" sequence="20"/>

</odoo>
