#. module: eam_solar
#: model:ir.model.fields,help:eam_solar.field_eam_location__pv_tk_pmpp
msgid "Hệ số nhiệt của điểm công suất cực đại — thông số của tấm pin, thường âm (ví dụ −0,004 nghĩa là mất 0,4% công suất cho mỗi độ nóng thêm)."
msgstr "The temperature coefficient at the maximum power point — a module specification, usually negative (−0.004 means 0.4% of the power is lost per degree of extra heat)."

