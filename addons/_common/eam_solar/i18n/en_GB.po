"Hằng số điện mặt trời chỉ khai ở vị trí cấp\n"
"                        <b>Nhà máy</b>."
msgstr ""
"Solar constants are declared only on a\n"
"                        <b>Plant</b>-level location."

#. module: eam_solar
#: model_terms:ir.ui.view,arch_db:eam_solar.view_eam_solar_kpi_form
msgid ""
"Hằng số được <b>chụp lại</b> khi tạo bản ghi, không\n"
"                            tham chiếu sống. Sửa hằng số của nhà máy hôm nay\n"
"                            không được làm đổi KPI đã tính của tháng trước."
msgstr ""
"The constants are <b>captured</b> when the record is created;\n"
"                            they are not a live reference. Editing the plant's\n"
"                            constants today must not change a KPI already computed\n"
"                            for last month."

