<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Outbound queue ===== -->
    <record id="view_re_webhook_outbound_list" model="ir.ui.view">
        <field name="name">re.webhook.outbound.list</field>
        <field name="model">re.webhook.outbound</field>
        <field name="arch" type="xml">
            <list string="Outbound Webhooks"
                  decoration-info="state == 'pending'"
                  decoration-warning="state == 'failed'"
                  decoration-danger="state == 'dead'"
                  decoration-success="state == 'sent'">
                <field name="create_date"/>
                <field name="event_name"/>
                <field name="event_id"/>
                <field name="target_url"/>
                <field name="state" widget="badge"/>
                <field name="attempts"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="last_response_code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_re_webhook_outbound_form" model="ir.ui.view">
        <field name="name">re.webhook.outbound.form</field>
        <field name="model">re.webhook.outbound</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry_now"
                            type="object"
                            string="Retry Now"
                            class="btn-primary"
                            invisible="state == 'sent'"/>
                    <button name="action_mark_dead"
                            type="object"
                            string="Mark Dead"
                            class="btn-secondary"
                            invisible="state in ('sent', 'dead')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,sent"/>
                </header>
                <sheet>
                    <group>
                        <group string="Event">
                            <field name="event_name"/>
                            <field name="event_id"/>
                            <field name="target_url"/>
                            <field name="api_key_id"/>
                        </group>
                        <group string="Delivery">
                            <field name="attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="last_attempt_at"/>
                            <field name="last_response_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" widget="text"/>
                        </page>
                        <page string="Last Error" invisible="not last_error">
                            <field name="last_error" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_re_webhook_outbound_search" model="ir.ui.view">
        <field name="name">re.webhook.outbound.search</field>
        <field name="model">re.webhook.outbound</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_name"/>
                <field name="target_url"/>
                <field name="event_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Retrying" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Dead Letter" name="dead" domain="[('state', '=', 'dead')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <separator/>
                <filter string="Event" name="group_event"
                        context="{'group_by': 'event_name'}"/>
                <filter string="State" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_webhook_outbound" model="ir.actions.act_window">
        <field name="name">Outbound Webhooks</field>
        <field name="res_model">re.webhook.outbound</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1, 'search_default_failed': 1, 'search_default_dead': 1}</field>
    </record>

    <!-- ===== Inbound log ===== -->
    <record id="view_re_webhook_log_list" model="ir.ui.view">
        <field name="name">re.webhook.log.list</field>
        <field name="model">re.webhook.log</field>
        <field name="arch" type="xml">
            <list string="Inbound Webhooks"
                  decoration-success="state == 'handled'"
                  decoration-warning="state == 'received'"
                  decoration-danger="state in ('rejected', 'error')"
                  decoration-muted="state == 'duplicate'">
                <field name="received_at"/>
                <field name="event_name"/>
                <field name="event_id"/>
                <field name="api_key_id"/>
                <field name="remote_addr"/>
                <field name="state" widget="badge"/>
                <field name="handler_name" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_re_webhook_log_form" model="ir.ui.view">
        <field name="name">re.webhook.log.form</field>
        <field name="model">re.webhook.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="event_name"/>
                            <field name="event_id"/>
                            <field name="received_at"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="api_key_id"/>
                            <field name="remote_addr"/>
                            <field name="handler_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload"><field name="payload_json" widget="text"/></page>
                        <page string="Headers"><field name="headers_json" widget="text"/></page>
                        <page string="Error" invisible="not error">
                            <field name="error" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_webhook_log" model="ir.actions.act_window">
        <field name="name">Inbound Webhook Log</field>
        <field name="res_model">re.webhook.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
