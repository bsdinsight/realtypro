<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_budget_phase_list" model="ir.ui.view">
        <field name="name">rp.budget.phase.list</field>
        <field name="model">rp.budget.phase</field>
        <field name="arch" type="xml">
            <list string="Ngân sách theo tháng" create="0" edit="0"
                  default_order="period, package_id">
                <field name="period"/>
                <field name="project_id" optional="hide"/>
                <field name="package_id"/>
                <field name="amount" width="200" sum="Tổng"/>
                <field name="amount_cumulative" width="200"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_rp_budget_phase_search" model="ir.ui.view">
        <field name="name">rp.budget.phase.search</field>
        <field name="model">rp.budget.phase</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="package_id"/>
                <filter name="group_period" string="Tháng"
                        context="{'group_by': 'period:month'}"/>
                <filter name="group_package" string="Gói thầu"
                        context="{'group_by': 'package_id'}"/>
                <filter name="group_project" string="Dự án"
                        context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_budget_phase" model="ir.actions.act_window">
        <field name="name">Ngân sách theo tháng</field>
        <field name="res_model">rp.budget.phase</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_rp_budget_phase_search"/>
        <field name="context">{'search_default_group_period': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa rải ngân sách theo lịch
            </p>
            <p>
                Bấm "Rải ngân sách theo lịch" trên form Dự án. Ngân sách
                mỗi gói thầu được rải lên chính công việc của hợp đồng
                thuộc gói, nên đường cong kế hoạch là hệ quả của lịch
                thật chứ không phải một chữ S vẽ sẵn.
            </p>
        </field>
    </record>

    <menuitem id="menu_rp_budget_phase"
              name="Ngân sách theo tháng"
              parent="menu_finance_budget"
              action="action_rp_budget_phase"
              sequence="30"/>

</odoo>
