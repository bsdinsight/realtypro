<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rp_progress.BSDGanttView">
        <div class="o_action_manager bsd_gantt_root">
            <div class="bsd_gantt_toolbar p-2 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0">
                        <i class="fa fa-bar-chart me-2"/>
                        Gantt — <t t-esc="state.projectName"/>
                    </h4>
                    <small class="text-muted" t-if="!state.error">
                        <t t-esc="state.taskCount"/> hạng mục
                    </small>
                </div>
                <div class="btn-group" t-if="!state.loading and !state.error">
                    <button t-foreach="['Day','Week','Month','Year']"
                            t-as="mode" t-key="mode"
                            t-on-click="() => this.setViewMode(mode)"
                            class="btn btn-sm"
                            t-att-class="state.viewMode === mode ? 'btn-primary' : 'btn-light'">
                        <t t-esc="mode"/>
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="d-flex justify-content-center p-5">
                <div class="spinner-border text-primary"/>
                <span class="ms-3">Đang tải...</span>
            </div>

            <div t-if="state.error" class="alert alert-warning m-3" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <span t-esc="state.error"/>
            </div>

            <div class="bsd_gantt_split"
                 t-att-style="state.error or state.loading ? 'display:none' : ''">

                <div class="bsd_gantt_panel" t-ref="panel">
                    <div class="bsd_gantt_panel_header">
                        <div class="col_seq">#</div>
                        <div class="col_name">Hạng mục</div>
                        <div class="col_date">BĐ KH</div>
                        <div class="col_date">KT KH</div>
                        <div class="col_pct">%</div>
                    </div>
                    <div class="bsd_gantt_panel_body">
                        <div t-foreach="state.rows" t-as="row" t-key="row.id"
                             class="bsd_gantt_panel_row"
                             t-att-class="'lvl_' + row.level + (row.is_delayed ? ' is_delayed' : '') + (row.hasDates ? '' : ' no_dates')"
                             t-on-click="() => this._openStructure(row.id)">
                            <div class="col_seq" t-esc="row.seq"/>
                            <div class="col_name"
                                 t-att-style="'padding-left:' + (8 + row.depth * 16) + 'px'">
                                <span class="lvl_dot"
                                      t-att-class="'dot_' + row.statusClass"/>
                                <span t-if="row.code" class="code">[<t t-esc="row.code"/>]</span>
                                <span t-esc="row.name"/>
                            </div>
                            <div class="col_date" t-esc="row.startStr"/>
                            <div class="col_date" t-esc="row.endStr"/>
                            <div class="col_pct">
                                <div class="pct_bar">
                                    <div class="pct_fill"
                                         t-att-style="'width:' + row.progress + '%'"/>
                                </div>
                                <span class="pct_text" t-esc="row.progress + '%'"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div t-if="state.noDates" class="bsd_gantt_empty">
                    <div class="bsd_gantt_empty_inner">
                        <i class="fa fa-calendar-o fa-3x text-muted mb-3"/>
                        <h5>Chưa có hạng mục nào có ngày kế hoạch</h5>
                        <p class="text-muted">
                            Click vào tên hạng mục bên trái để mở form
                            và nhập <b>Ngày BĐ KH</b> + <b>Ngày KT KH</b>.
                        </p>
                    </div>
                </div>
                <div t-else="" class="bsd_gantt_container" t-ref="gantt"/>
            </div>
        </div>
    </t>

</templates>
