<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit form KW: thêm tab "Phân bổ công trình" -->
    <record id="view_re_loan_note_form_inherit_bridge" model="ir.ui.view">
        <field name="name">re.loan.note.form.bridge</field>
        <field name="model">re.loan.note</field>
        <field name="inherit_id" ref="re_loan.view_re_loan_note_form"/>
        <field name="arch" type="xml">
            <!-- Nút đếm nhanh: KW này đã giải ngân cho bao nhiêu hoá
                 đơn/tạm ứng, bấm vào ra danh sách phiếu chi.

                 Vào hộp nút DÙNG CHUNG khai ở re_loan. Trước đây khai
                 hộp riêng tên "bridge_button_box" — trình dựng form
                 chỉ nhận hộp có đúng name="button_box", nên nút dựng
                 ra thành div trơn và KHÔNG BAO GIỜ hiện, cũng không
                 báo lỗi (backlog 744).

                 KHÔNG ẩn khi đếm = 0: người dùng cần phân biệt "khế
                 ước này chưa giải ngân cho hoá đơn nào" với "phần mềm
                 không có tính năng đó" — ẩn đi thì hai thứ giống hệt
                 nhau, và đó chính là chỗ team báo lỗi. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dossier_payments"
                        type="object" class="oe_stat_button"
                        icon="fa-file-text-o">
                    <!-- Nhãn "Phiếu thanh toán" (backlog 1085) thì con
                         số cũng phải đếm PHIẾU, không đếm hoá đơn/tạm
                         ứng — hai số lệch nhau đúng lúc có chứng từ
                         chưa sinh phiếu, và nhãn mới sẽ nói sai. -->
                    <field name="dossier_payment_count" widget="statinfo"
                           string="Phiếu thanh toán"/>
                </button>
            </xpath>

            <!-- Disbursement list: thêm cost_category, contract, structure -->
            <xpath expr="//page[@name='disbursement']//field[@name='description']"
                   position="after">
                <field name="cost_category_id" optional="show"/>
                <field name="contract_id" optional="show"/>
                <field name="structure_id" optional="hide"/>
            </xpath>
            <xpath expr="//page[@name='purpose']" position="before">
                <page string="Phân bổ công trình" name="allocation">
                    <group>
                        <group>
                            <field name="allocation_total_principal"/>
                            <field name="allocation_total_interest"/>
                        </group>
                    </group>
                    <field name="allocation_ids"
                           context="{'default_note_id': id}">
                        <list editable="bottom">
                            <field name="project_id"/>
                            <field name="structure_id"/>
                            <field name="cost_category_id" optional="show"/>
                            <field name="contract_id" optional="show"/>
                            <field name="tender_package_id" optional="hide"/>
                            <field name="base"/>
                            <field name="method"/>
                            <field name="percent"/>
                            <field name="amount" width="185px"/>
                            <field name="amount_allocated" width="185px" sum="Σ"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
