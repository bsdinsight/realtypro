<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chạy TRƯỚC cron sinh lệnh bảo trì phòng ngừa (06:00): cảnh báo
         nổ trong đêm thì sáng ra đã có lệnh, không phải chờ thêm một
         ngày. -->
    <record id="cron_eam_alarm_quet" model="ir.cron">
        <field name="name">EAMOne: quét luật cảnh báo thiết bị</field>
        <field name="model_id" ref="model_eam_alarm_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_quet()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=5, minute=30, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
