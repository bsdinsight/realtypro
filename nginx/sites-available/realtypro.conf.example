# Realty Project — nginx reverse proxy template.
#
# Copy to /etc/nginx/sites-available/realtypro.conf and customize:
#   - server_name → your domain
#   - ssl_certificate paths (run certbot to get them)
#
# Symlink to enable:
#   ln -s /etc/nginx/sites-available/realtypro.conf \
#         /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name realtypro.your-domain.com;

    # Let certbot answer ACME challenges; redirect everything else
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name realtypro.your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/realtypro.your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/realtypro.your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Pass real client info to Odoo (proxy_mode=True in odoo.conf
    # respects these).
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # Longpoll / WebSocket (Odoo chat, OWL reactivity).
    location /websocket {
        proxy_pass http://odoo_chat;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "Upgrade";
    }
    location /longpolling {
        proxy_pass http://odoo_chat;
    }

    # All other requests → main Odoo HTTP.
    location / {
        proxy_pass http://odoo;
        proxy_redirect off;
    }
}
