<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_rp_purchase_request" model="ir.sequence">
            <field name="name">Yêu cầu mua sắm</field>
            <field name="code">rp.purchase.request</field>
            <field name="prefix">YCM/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_rp_goods_receipt" model="ir.sequence">
            <field name="name">Biên bản giao nhận &amp; nghiệm thu</field>
            <field name="code">rp.goods.receipt</field>
            <field name="prefix">BBNT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_rp_payment_request" model="ir.sequence">
            <field name="name">Giấy đề nghị thanh toán</field>
            <field name="code">rp.payment.request</field>
            <field name="prefix">DNTT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
