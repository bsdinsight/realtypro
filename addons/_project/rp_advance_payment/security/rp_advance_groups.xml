<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 19: res.groups bỏ field `category_id` (đổi sang cơ chế
             privilege). Pattern đơn giản nhất (theo rp_progress đã chạy
             OK trên 19): group phẳng, không gán category. -->

        <!-- Group: User — tạo Tạm ứng + cấn trừ -->
        <record id="group_advance_user" model="res.groups">
            <field name="name">Tạm ứng / User</field>
            <field name="comment">
                User: tạo Tạm ứng, submit duyệt, cấn trừ vào hóa đơn.
                KHÔNG được tự phê duyệt Tạm ứng.
            </field>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Group: Manager — phê duyệt + audit -->
        <record id="group_advance_manager" model="res.groups">
            <field name="name">Tạm ứng / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_advance_user'))]"/>
            <field name="comment">
                Manager: phê duyệt Tạm ứng + full quyền user.
            </field>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
