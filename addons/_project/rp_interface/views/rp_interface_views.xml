<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_interface_list" model="ir.ui.view">
        <field name="name">rp.interface.list</field>
        <field name="model">rp.interface</field>
        <field name="arch" type="xml">
            <!-- Đỏ = lịch đang mâu thuẫn (bên nhận cần trước khi bên
                 giao xong). Mờ = đã đóng. -->
            <list decoration-danger="is_conflict and state not in ['delivered','closed','cancelled']"
                  decoration-muted="state in ['closed','cancelled']"
                  decoration-warning="state == 'disputed'">
                <field name="code" width="110px"/>
                <field name="name"/>
                <field name="from_partner_id" string="Bên giao"
                       optional="show"/>
                <field name="to_partner_id" string="Bên nhận"
                       optional="show"/>
                <field name="from_contract_id" optional="hide"/>
                <field name="to_contract_id" optional="hide"/>
                <field name="interface_type" optional="show"/>
                <field name="schedule_ready_date" string="Sẵn sàng (lịch)"
                       optional="show"/>
                <field name="schedule_need_date" string="Cần (lịch)"
                       optional="show"/>
                <field name="gap_days" string="Dư địa" optional="show"
                       width="110px"/>
                <field name="date_required" optional="hide"/>
                <field name="date_promised" optional="hide"/>
                <field name="date_actual" optional="hide"/>
                <field name="linked_in_schedule" optional="hide"
                       widget="boolean_toggle" readonly="1"/>
                <field name="criticality" optional="show"
                       widget="badge"
                       decoration-danger="criticality == 'critical'"
                       decoration-warning="criticality == 'high'"/>
                <field name="state" widget="badge"
                       decoration-success="state in ['delivered','closed']"
                       decoration-danger="state == 'disputed'"/>
                <field name="is_conflict" column_invisible="1"/>
                <field name="project_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rp_interface_kanban" model="ir.ui.view">
        <field name="name">rp.interface.kanban</field>
        <field name="model">rp.interface</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="is_conflict"/>
                <field name="criticality"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_top mb-0">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="text-muted small">
                                <field name="code"/> ·
                                <field name="interface_type"/>
                            </div>
                            <div class="mt-1">
                                <i class="fa fa-truck me-1" title="Bên giao"/>
                                <field name="from_partner_id"/>
                                <i class="fa fa-long-arrow-right mx-1"
                                   title="bàn giao cho"/>
                                <field name="to_partner_id"/>
                            </div>
                            <div class="mt-1">
                                <span t-if="record.is_conflict.raw_value"
                                      class="badge text-bg-danger">
                                    Lịch mâu thuẫn
                                    <field name="gap_days"/> ngày
                                </span>
                                <span t-if="record.criticality.raw_value == 'critical'"
                                      class="badge text-bg-dark ms-1">
                                    Chịu lực
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom mt-1">
                                <span class="text-muted small">
                                    Cần: <field name="schedule_need_date"/>
                                </span>
                                <field name="owner_to_user_id"
                                       widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rp_interface_form" model="ir.ui.view">
        <field name="name">rp.interface.form</field>
        <field name="model">rp.interface</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_agree" type="object"
                            string="Hai bên chốt" class="btn-primary"
                            invisible="state != 'identified'"/>
                    <button name="action_start" type="object"
                            string="Bắt đầu thực hiện"
                            invisible="state != 'agreed'"/>
                    <button name="action_deliver" type="object"
                            string="Đã bàn giao" class="btn-primary"
                            invisible="state not in ['agreed','in_progress','disputed']"/>
                    <button name="action_close" type="object"
                            string="Đóng điểm bàn giao"
                            invisible="state != 'delivered'"/>
                    <button name="action_dispute" type="object"
                            string="Ghi tranh chấp"
                            invisible="state in ['closed','cancelled','disputed']"/>
                    <button name="action_reset" type="object"
                            string="Mở lại"
                            invisible="state in ['identified','cancelled']"/>
                    <button name="action_link_schedule" type="object"
                            string="Nối vào lịch" icon="fa-link"
                            invisible="linked_in_schedule or not from_task_id or not to_task_id"
                            help="Khai việc bên giao là công việc trước của việc bên nhận, để đường găng chạy qua điểm này."/>
                    <button name="action_pull_dates" type="object"
                            string="Lấy ngày theo lịch" icon="fa-calendar"
                            invisible="not from_task_id or not to_task_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="identified,agreed,in_progress,delivered,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="not is_conflict or state in ['delivered','closed','cancelled']">
                        <i class="fa fa-exclamation-triangle me-1"
                           title="Mâu thuẫn"/>
                        Lịch hiện hành đang mâu thuẫn: bên nhận cần vào
                        <field name="schedule_need_date" readonly="1"
                               nolabel="1" class="fw-bold"/>
                        nhưng bên giao chỉ sẵn sàng
                        <field name="schedule_ready_date" readonly="1"
                               nolabel="1" class="fw-bold"/>.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Bàn giao gì, cho ai?"/></h1>
                        <h3 class="text-muted"><field name="code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Hai bên">
                            <field name="project_id"
                                   options="{'no_create': True}"/>
                            <field name="from_contract_id"
                                   domain="[('project_id','=',project_id)]"
                                   options="{'no_create': True}"/>
                            <field name="to_contract_id"
                                   domain="[('project_id','=',project_id),('id','!=',from_contract_id)]"
                                   options="{'no_create': True}"/>
                            <field name="interface_type"/>
                            <field name="criticality"/>
                        </group>
                        <group string="Người phụ trách">
                            <field name="owner_from_user_id"
                                   options="{'no_create': True}"/>
                            <field name="owner_to_user_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cam kết hai bên">
                            <field name="date_required"/>
                            <field name="date_promised"/>
                            <field name="commitment_gap"/>
                            <field name="date_actual"/>
                        </group>
                        <group string="Theo lịch thi công hiện hành">
                            <field name="from_task_id"
                                   domain="[('rp_contract_id','=',from_contract_id)]"
                                   options="{'no_create': True}"/>
                            <field name="to_task_id"
                                   domain="[('rp_contract_id','=',to_contract_id)]"
                                   options="{'no_create': True}"/>
                            <field name="schedule_ready_date"/>
                            <field name="schedule_need_date"/>
                            <field name="gap_days"/>
                            <field name="linked_in_schedule"/>
                            <field name="is_conflict" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Phạm vi &amp; nghiệm thu"
                              name="scope">
                            <field name="description"
                                   placeholder="Bàn giao thế nào thì coi là xong: tiêu chí, dung sai, hồ sơ kèm theo, ai ký biên bản."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_interface_search" model="ir.ui.view">
        <field name="name">rp.interface.search</field>
        <field name="model">rp.interface</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="from_partner_id"/>
                <field name="to_partner_id"/>
                <filter name="f_conflict" string="Lịch mâu thuẫn"
                        domain="[('is_conflict','=',True),
                                 ('state','not in',['delivered','closed','cancelled'])]"/>
                <filter name="f_open" string="Chưa đóng"
                        domain="[('state','not in',['delivered','closed','cancelled'])]"/>
                <filter name="f_critical" string="Chịu lực"
                        domain="[('criticality','=','critical')]"/>
                <filter name="f_unlinked" string="Chưa nối vào lịch"
                        domain="[('linked_in_schedule','=',False)]"/>
                <separator/>
                <filter name="g_state" string="Trạng thái"
                        context="{'group_by': 'state'}"/>
                <filter name="g_from" string="Bên giao"
                        context="{'group_by': 'from_contract_id'}"/>
                <filter name="g_to" string="Bên nhận"
                        context="{'group_by': 'to_contract_id'}"/>
                <filter name="g_type" string="Loại ranh giới"
                        context="{'group_by': 'interface_type'}"/>
                <searchpanel>
                    <field name="project_id" string="Dự án"
                           icon="fa-folder-open" color="#0F2C3F"
                           enable_counters="1"/>
                    <field name="state" select="multi" string="Trạng thái"
                           icon="fa-tasks" color="#0E8C99"
                           enable_counters="1"/>
                    <field name="interface_type" select="multi"
                           string="Loại ranh giới" icon="fa-exchange"
                           enable_counters="1"/>
                    <field name="from_contract_id" select="multi"
                           string="Bên giao" icon="fa-truck"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_rp_interface" model="ir.actions.act_window">
        <field name="name">Ranh giới gói thầu</field>
        <field name="res_model">rp.interface</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_rp_interface_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có điểm bàn giao nào</p>
            <p>Mỗi điểm bàn giao là một lần hợp đồng này phải bàn giao cho hợp
            đồng kia: mặt bằng, móng, bản vẽ, thiết bị, đấu nối. Mở form
            dự án và bấm "Quét điểm bàn giao từ lịch" để dựng sổ từ chính lịch
            thi công đang có.</p>
        </field>
    </record>

    <record id="action_rp_interface_conflict" model="ir.actions.act_window">
        <field name="name">Điểm bàn giao lịch mâu thuẫn</field>
        <field name="res_model">rp.interface</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_rp_interface_search"/>
        <field name="domain">[('is_conflict','=',True),('state','not in',['delivered','closed','cancelled'])]</field>
    </record>

</odoo>
