<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eam_loss_type_list" model="ir.ui.view">
        <field name="name">eam.loss.type.list</field>
        <field name="model">eam.loss.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="nhom"/>
                <field name="cach_do"/>
                <field name="group_id"/>
                <field name="node_code"/>
                <field name="la_tu_dung"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_eam_loss_day_list" model="ir.ui.view">
        <field name="name">eam.loss.day.list</field>
        <field name="model">eam.loss.day</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="plant_id"/>
                <field name="muc_ke_hoach" sum="Tổng" optional="show"/>
                <field name="muc_tai_nguyen" sum="Tổng"/>
                <field name="chenh_tai_nguyen" sum="Tổng" optional="show"/>
                <field name="thuc_te" sum="Tổng"/>
                <field name="tong_mat" sum="Tổng"/>
                <field name="tong_tu_dung" sum="Tổng" optional="hide"/>
                <field name="du" sum="Tổng"
                       decoration-warning="du_dang_ke"/>
                <field name="du_dang_ke" column_invisible="1"/>
                <field name="du_pct" optional="show"
                       decoration-warning="du_dang_ke"/>
            </list>
        </field>
    </record>

    <record id="view_eam_loss_day_form" model="ir.ui.view">
        <field name="name">eam.loss.day.form</field>
        <field name="model">eam.loss.day</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_dung_lai" type="object"
                            string="Dựng lại" class="btn-primary"/>
                </header>
                <sheet>
                    <h1><field name="display_name" readonly="1"/></h1>
                    <group>
                        <group string="Ba mốc">
                            <field name="muc_ke_hoach"/>
                            <field name="ly_do_kh" invisible="do_duoc_kh"
                                   readonly="1"/>
                            <field name="muc_tai_nguyen"/>
                            <field name="ly_do_tn" readonly="1"
                                   invisible="not ly_do_tn"/>
                            <field name="thuc_te"/>
                            <field name="do_duoc_kh" invisible="1"/>
                            <field name="do_duoc_tn" invisible="1"/>
                        </group>
                        <group string="Phân rã">
                            <field name="tong_mat"/>
                            <field name="tong_tu_dung"/>
                            <field name="du"/>
                            <field name="du_pct"/>
                            <field name="du_dang_ke"/>
                            <field name="chenh_tai_nguyen"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not du_dang_ke">
                        <b>Phần dư <field name="du_pct" nolabel="1"
                           readonly="1"/>% của mốc tài nguyên.</b>
                        Mô hình chưa giải thích được phần này — KHÔNG chia
                        nó vào các cột để biểu đồ cộng khít. Dư lớn thường
                        do một trong ba: sổ dừng máy ghi thiếu, đường cong
                        công suất không còn đúng với máy đã xuống cấp, hoặc
                        gió đo tại vỏ máy lệch so với gió tới cánh.
                    </div>
                    <field name="thac_nuoc" readonly="1"/>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="loss_type_id"/>
                            <field name="nhom"/>
                            <field name="kwh" sum="Tổng"/>
                            <field name="ty_le"/>
                            <field name="tien" sum="Tổng" optional="show"/>
                            <field name="nguon" optional="show"/>
                            <field name="do_duoc" optional="hide"/>
                            <field name="ly_do" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eam_loss_line_pivot" model="ir.ui.view">
        <field name="name">eam.loss.day.line.pivot</field>
        <field name="model">eam.loss.day.line</field>
        <field name="arch" type="xml">
            <pivot string="Phân rã tổn thất">
                <field name="loss_type_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="kwh" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================== PANE LỌC ==================
         Hai câu hỏi khác nhau nên hai pane khác nhau:

         * Bản hạch toán NGÀY: người đọc đi theo NHÀ MÁY, rồi lọc ra
           ngày nào đáng xem. Pane bên trái là nhà máy.
         * Phân rã: người đọc đi theo LOẠI TỔN THẤT — "bụi bẩn tháng
           này bao nhiêu". Pane bên trái là nhóm và loại.

         Bộ đếm bật sẵn: con số cạnh mỗi mục cho biết có đáng bấm vào
         không, đỡ phải bấm thử rồi quay ra. -->

    <record id="view_eam_loss_day_search" model="ir.ui.view">
        <field name="name">eam.loss.day.search</field>
        <field name="model">eam.loss.day</field>
        <field name="arch" type="xml">
            <search>
                <field name="plant_id"/>
                <field name="date"/>
                <filter name="f_hnay" string="Hôm nay"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_7" string="7 ngày gần nhất"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="f_thang" string="Tháng này"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <!-- Lọc đáng giá nhất: ngày nào mô hình chưa giải thích
                     được, và đủ lớn để không phải nhiễu của ngày lặng gió. -->
                <filter name="f_du" string="Phần dư đáng xem"
                        domain="[('du_dang_ke', '=', True)]"/>
                <filter name="f_duoi_kh" string="Dưới mốc kế hoạch"
                        domain="[('duoi_ke_hoach', '=', True)]"/>
                <separator/>
                <filter name="f_thieu_tn" string="Chưa có mốc tài nguyên"
                        domain="[('do_duoc_tn', '=', False)]"/>
                <filter name="f_thieu_kh" string="Chưa khai mục tiêu"
                        domain="[('do_duoc_kh', '=', False)]"/>
                <separator/>
                    <filter name="g_nm" string="Nhà máy"
                            context="{'group_by': 'plant_id'}"/>
                    <filter name="g_thang" string="Tháng"
                            context="{'group_by': 'date:month'}"/>                <searchpanel view_types="list,kanban,pivot,graph">
                    <field name="plant_id" select="one" icon="fa-industry"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_eam_loss_line_search" model="ir.ui.view">
        <field name="name">eam.loss.day.line.search</field>
        <field name="model">eam.loss.day.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="loss_type_id"/>
                <field name="plant_id"/>
                <field name="date"/>
                <filter name="f_7" string="7 ngày gần nhất"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="f_thang" string="Tháng này"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_co" string="Đã quy được"
                        domain="[('do_duoc', '=', True), ('kwh', '!=', 0)]"/>
                <!-- Danh sách CHƯA QUY ĐƯỢC là thứ đem ra bàn lắp thêm
                     đo — nên nó phải lọc ra được bằng một cú bấm. -->
                <filter name="f_chua" string="Chưa quy được"
                        domain="[('do_duoc', '=', False)]"/>
                <separator/>
                <filter name="f_mat" string="Là tổn thất"
                        domain="[('la_tu_dung', '=', False)]"/>
                <filter name="f_tudung" string="Tiêu thụ có chủ đích"
                        domain="[('la_tu_dung', '=', True)]"/>
                <separator/>
                    <filter name="g_loai" string="Loại tổn thất"
                            context="{'group_by': 'loss_type_id'}"/>
                    <filter name="g_nhom" string="Nhóm"
                            context="{'group_by': 'nhom'}"/>
                    <filter name="g_nm" string="Nhà máy"
                            context="{'group_by': 'plant_id'}"/>
                    <filter name="g_ngay" string="Ngày"
                            context="{'group_by': 'date'}"/>
                    <filter name="g_cach" string="Cách lấy số"
                            context="{'group_by': 'cach_do'}"/>                <searchpanel view_types="list,kanban,pivot,graph">
                    <field name="plant_id" select="one" icon="fa-industry"
                           enable_counters="1"/>
                    <field name="nhom" select="multi" icon="fa-tags"
                           enable_counters="1"/>
                    <field name="loss_type_id" select="multi"
                           icon="fa-list-ul" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_eam_loss_type_search" model="ir.ui.view">
        <field name="name">eam.loss.type.search</field>
        <field name="model">eam.loss.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="f_tudung" string="Tiêu thụ có chủ đích"
                        domain="[('la_tu_dung', '=', True)]"/>
                <filter name="f_tay" string="Chờ người nhập"
                        domain="[('cach_do', '=', 'tay')]"/>
                <separator/>
                    <filter name="g_nhom" string="Nhóm"
                            context="{'group_by': 'nhom'}"/>
                    <filter name="g_cach" string="Cách lấy số"
                            context="{'group_by': 'cach_do'}"/>            </search>
        </field>
    </record>

    <record id="action_eam_loss_day" model="ir.actions.act_window">
        <field name="name">Hạch toán tổn thất</field>
        <field name="res_model">eam.loss.day</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eam_loss_day_search"/>
        <field name="context">{'search_default_f_thang': 1}</field>
    </record>
    <record id="action_eam_loss_line" model="ir.actions.act_window">
        <field name="name">Phân rã tổn thất</field>
        <field name="res_model">eam.loss.day.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="view_eam_loss_line_search"/>
        <field name="context">{'search_default_f_thang': 1,
                               'search_default_g_loai': 1}</field>
    </record>
    <record id="action_eam_loss_type" model="ir.actions.act_window">
        <field name="name">Loại tổn thất</field>
        <field name="res_model">eam.loss.type</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_eam_loss_type_search"/>
    </record>

    <menuitem id="menu_eam_loss_day" name="Hạch toán tổn thất"
              parent="eam_core.menu_eam_perf"
              action="action_eam_loss_day" sequence="30"/>
    <menuitem id="menu_eam_loss_line" name="Phân rã tổn thất"
              parent="eam_core.menu_eam_perf"
              action="action_eam_loss_line" sequence="31"/>
    <menuitem id="menu_eam_loss_type" name="Loại tổn thất"
              parent="eam_core.menu_eam_config"
              action="action_eam_loss_type" sequence="30"/>

</odoo>
