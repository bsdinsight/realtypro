<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_obligation_list" model="ir.ui.view">
        <field name="name">rp.obligation.list</field>
        <field name="model">rp.obligation</field>
        <field name="arch" type="xml">
            <list string="Nghĩa vụ hợp đồng"
                  decoration-danger="trang_thai == 'qua_han'"
                  decoration-warning="trang_thai == 'sap_den'"
                  decoration-muted="trang_thai == 'xong'">
                <field name="code" optional="show"/>
                <field name="contract_id" optional="show"/>
                <field name="name"/>
                <field name="ben"/>
                <field name="loai"/>
                <field name="clause_number" string="Điều" optional="show"/>
                <field name="han"/>
                <field name="so_ngay_con" string="Còn (ngày)"
                       optional="show"/>
                <field name="trang_thai" widget="badge"
                       decoration-danger="trang_thai == 'qua_han'"
                       decoration-warning="trang_thai == 'sap_den'"
                       decoration-success="trang_thai == 'xong'"/>
                <field name="nguon" optional="hide"/>
                <field name="so_hieu" optional="hide"/>
                <field name="ben_thu_ba_id" optional="hide"/>
                <field name="hieu_luc_den" string="Hết hiệu lực"
                       optional="hide"/>
                <field name="la_dinh_ky" column_invisible="True"/>
                <field name="so_ky_qua_han" column_invisible="True"/>
                <field name="nguoi_phu_trach_id" optional="hide"
                       widget="many2one_avatar_user"/>
                <field name="project_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rp_obligation_form" model="ir.ui.view">
        <field name="name">rp.obligation.form</field>
        <field name="model">rp.obligation</field>
        <field name="arch" type="xml">
            <form string="Nghĩa vụ hợp đồng">
                <header>
                    <button name="action_mo_ban_ghi_goc" type="object"
                            string="Mở sổ gốc" class="btn-primary"
                            invisible="nguon != 'so_rieng'"/>
                    <button name="action_sinh_ky" type="object"
                            string="Sinh các kỳ" class="btn-primary"
                            icon="fa-calendar-plus-o"
                            invisible="not la_dinh_ky"/>
                    <field name="trang_thai" widget="statusbar"
                           statusbar_visible="con_han,sap_den,qua_han,xong"
                           invisible="la_dinh_ky"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_xem_ky" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="not la_dinh_ky">
                            <field name="so_ky" widget="statinfo"
                                   string="Kỳ"/>
                        </button>
                        <button name="action_xem_ky" type="object"
                                class="oe_stat_button text-danger"
                                icon="fa-exclamation-triangle"
                                invisible="not so_ky_qua_han">
                            <field name="so_ky_qua_han" widget="statinfo"
                                   string="Kỳ quá hạn"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nghĩa vụ gì"/></h1>
                        <h3><field name="code" readonly="1"/></h3>
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="nguon != 'so_rieng'">
                        <i class="fa fa-link me-1"/>
                        Dòng này là <b>chỉ mục</b> của một bản ghi ở sổ
                        chuyên. Hạn và tình trạng đọc thẳng từ sổ gốc —
                        muốn sửa hạn thì sửa ở đó, để một việc chỉ có một
                        chỗ ghi.
                    </div>

                    <group>
                        <group string="Hợp đồng">
                            <field name="contract_id"
                                   options="{'no_create': True}"/>
                            <field name="project_id" readonly="1"/>
                            <field name="contractor_id" readonly="1"/>
                            <field name="clause_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Phân loại">
                            <field name="ben"/>
                            <field name="loai"/>
                            <field name="vai"/>
                            <field name="nguoi_phu_trach_id"
                                   widget="many2one_avatar_user"/>
                        </group>
                    </group>

                    <group>
                        <group string="Hạn">
                            <field name="han" readonly="1"/>
                            <field name="ngay_xong" readonly="1"/>
                            <field name="so_ngay_con" readonly="1"/>
                        </group>
                        <group string="Tự quản"
                               invisible="nguon == 'so_rieng'">
                            <field name="han_tu_quan"/>
                            <field name="ngay_xong_tu_quan"/>
                        </group>
                        <group string="Sổ gốc"
                               invisible="nguon != 'so_rieng'">
                            <field name="nguon" readonly="1"/>
                            <field name="document_id" readonly="1"
                                   invisible="not document_id"/>
                            <field name="variation_id" readonly="1"
                                   invisible="not variation_id"/>
                            <field name="claim_id" readonly="1"
                                   invisible="not claim_id"/>
                            <field name="guarantee_id" readonly="1"
                                   invisible="not guarantee_id"/>
                            <field name="milestone_id" readonly="1"
                                   invisible="not milestone_id"/>
                        </group>
                    </group>

                    <group string="Giấy tờ bên thứ ba cấp"
                           invisible="loai not in ('bao_hiem', 'bao_hanh',
                                                   'giay_phep')">
                        <group>
                            <field name="ben_thu_ba_id"/>
                            <field name="so_hieu"/>
                        </group>
                        <group>
                            <field name="hieu_luc_tu"/>
                            <field name="hieu_luc_den"/>
                            <field name="gia_tri"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Lịch định kỳ">
                        <group>
                            <field name="la_dinh_ky"
                                   widget="boolean_toggle"
                                   invisible="parent_id or nguon == 'so_rieng'"/>
                            <field name="parent_id" readonly="1"
                                   invisible="not parent_id"/>
                            <field name="ky_bat_dau" readonly="1"
                                   invisible="not parent_id"/>
                        </group>
                        <group invisible="not la_dinh_ky">
                            <field name="chu_ky"
                                   required="la_dinh_ky"/>
                            <field name="ky_tu" required="la_dinh_ky"/>
                            <field name="ky_den"/>
                            <field name="han_sau_ky"/>
                        </group>
                    </group>

                    <notebook invisible="not la_dinh_ky">
                        <page string="Các kỳ" name="ky">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-1"/>
                                Mỗi kỳ là một dòng riêng có hạn riêng, nên
                                <b>tháng nào đã nộp, tháng nào chưa</b> là
                                câu trả lời được. Bản thân cái lịch không
                                có hạn — một cái lịch thì không quá hạn.
                                Sinh kỳ chạy lại <b>không đẻ thêm</b>.
                            </div>
                            <field name="child_ids" nolabel="1" readonly="1">
                                <list decoration-danger="trang_thai == 'qua_han'"
                                      decoration-warning="trang_thai == 'sap_den'"
                                      decoration-muted="trang_thai == 'xong'">
                                    <field name="name"/>
                                    <field name="han_tu_quan" string="Hạn"/>
                                    <field name="ngay_xong_tu_quan"
                                           string="Đã nộp"/>
                                    <field name="so_ngay_con"
                                           string="Còn (ngày)"/>
                                    <field name="trang_thai" widget="badge"
                                           decoration-danger="trang_thai == 'qua_han'"
                                           decoration-warning="trang_thai == 'sap_den'"
                                           decoration-success="trang_thai == 'xong'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group string="Ghi chú">
                        <field name="ghi_chu" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_obligation_search" model="ir.ui.view">
        <field name="name">rp.obligation.search</field>
        <field name="model">rp.obligation</field>
        <field name="arch" type="xml">
            <search string="Nghĩa vụ hợp đồng">
                <field name="name"/>
                <field name="code"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="clause_number" string="Số điều"/>

                <filter name="f_qua_han" string="Quá hạn"
                        domain="[('trang_thai', '=', 'qua_han')]"/>
                <filter name="f_sap_den" string="Sắp đến hạn"
                        domain="[('trang_thai', '=', 'sap_den')]"/>
                <filter name="f_chua_xong" string="Chưa xong"
                        domain="[('trang_thai', '!=', 'xong')]"/>
                <separator/>
                <filter name="f_nha_thau" string="Nhà thầu gánh"
                        domain="[('ben', '=', 'nha_thau')]"/>
                <filter name="f_chu_dau_tu" string="Chúng ta gánh"
                        domain="[('ben', '=', 'chu_dau_tu')]"/>
                <separator/>
                <filter name="f_chua_neo" string="Chưa neo điều khoản"
                        domain="[('clause_id', '=', False)]"/>
                <separator/>
                <filter name="f_giay_to" string="Bảo hiểm / bảo hành / giấy phép"
                        domain="[('loai', 'in',
                                  ['bao_hiem', 'bao_hanh', 'giay_phep'])]"/>
                <filter name="f_lich" string="Lịch định kỳ"
                        domain="[('la_dinh_ky', '=', True)]"/>
                <filter name="f_an_ky" string="Ẩn các kỳ con"
                        domain="[('parent_id', '=', False)]"/>

                <separator/>
                <filter name="group_loai" string="Loại nghĩa vụ"
                        context="{'group_by': 'loai'}"/>
                <filter name="group_ben" string="Bên gánh"
                        context="{'group_by': 'ben'}"/>
                <filter name="group_trang_thai" string="Tình trạng"
                        context="{'group_by': 'trang_thai'}"/>
                <filter name="group_contract" string="Hợp đồng"
                        context="{'group_by': 'contract_id'}"/>
                <filter name="group_han" string="Hạn (tháng)"
                        context="{'group_by': 'han:month'}"/>

                <!-- Pane lọc: bốn trục người dùng thật sự cắt lát sổ này.
                     Hợp đồng để "one" vì gần như luôn xem một hợp đồng
                     một lúc; ba trục còn lại để "multi" vì hay phải gộp
                     (ví dụ: quá hạn CỘNG sắp đến hạn). -->
                <searchpanel>
                    <field name="contract_id" string="Hợp đồng"
                           icon="fa-file-text-o" enable_counters="1" expand="1"/>
                    <field name="trang_thai" string="Tình trạng"
                           select="multi" icon="fa-clock-o"
                           enable_counters="1" expand="1"/>
                    <field name="loai" string="Loại nghĩa vụ"
                           select="multi" icon="fa-tags"
                           enable_counters="1" expand="1"/>
                    <field name="ben" string="Bên gánh"
                           select="multi" icon="fa-balance-scale"
                           enable_counters="1" expand="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_rp_obligation" model="ir.actions.act_window">
        <field name="name">Sổ nghĩa vụ hợp đồng</field>
        <field name="res_model">rp.obligation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_chua_xong': 1,
                               'search_default_group_loai': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sổ còn trống</p>
            <p>Mở một hợp đồng và bấm <b>Đồng bộ nghĩa vụ</b> để dựng sổ
               từ các sổ chuyên đã có — hồ sơ phải trình, phát sinh,
               khiếu nại, bảo lãnh, mốc thanh toán.</p>
        </field>
    </record>

</odoo>
