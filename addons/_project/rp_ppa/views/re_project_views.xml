<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_project_form_ppa" model="ir.ui.view">
        <field name="name">re.project.form.ppa</field>
        <field name="model">re.project</field>
        <field name="inherit_id" ref="rp_evm.view_re_project_form_evm"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mo_ppa" type="object"
                        class="oe_stat_button" icon="fa-handshake-o"
                        invisible="ppa_count == 0">
                    <field name="ppa_count" widget="statinfo"
                           string="HĐ bán điện"/>
                </button>
                <button name="action_mo_san_luong" type="object"
                        class="oe_stat_button" icon="fa-bolt"
                        invisible="energy_period_count == 0">
                    <field name="energy_period_count" widget="statinfo"
                           string="Kỳ sản lượng"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='evm_control']" position="after">
                <group string="Bán điện" invisible="energy_period_count == 0">
                    <group>
                        <field name="energy_net_total"/>
                        <field name="energy_curtailed_total"/>
                    </group>
                    <group>
                        <field name="energy_revenue_total"/>
                        <field name="energy_shortfall_total"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
