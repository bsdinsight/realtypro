<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
  /dang-ky — đăng ký nhà thầu bằng MST. Thiết kế: Claude Design (bundle
  "RealtyPro Landing Page-handoff", dang-ky.html), re-tone sang brand thật
  (navy #0F2C3F / teal #0E8C99 / mint #46D6C0) + bổ sung ô TICK VAI TRÒ.
  Mấu chốt nghiệp vụ: 1 MST = 1 công ty = 1 tài khoản gốc → MST trùng thì
  KHÔNG cho tạo mới mà chỉ đường liên hệ quản trị viên công ty.
-->
<template id="signup" name="Realty Pro Network — Đăng ký nhà thầu">
  <t t-call="web.layout">
    <t t-set="html_data" t-value="{'lang': 'vi'}"/>
    <t t-set="title">Đăng ký nhà thầu — Realty Pro Network</t>
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --rpn-font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
  --rpn-ink:#12283A;--rpn-ink-2:#4A6472;--rpn-ink-3:#6C8792;
  --rpn-navy:#0F2C3F;--rpn-teal:#0E8C99;--rpn-mint:#46D6C0;
  --rpn-amber:#F59E0B;--rpn-amber-d:#D97F06;
  --rpn-line:#DDE7EA;--rpn-bg:#FFFFFF;--rpn-bg-2:#F3F8F9;--rpn-bg-3:#E3F1F2;
  --rpn-err:#C0392B;--rpn-ok:#0B7350;
}
body{font-family:var(--rpn-font);color:var(--rpn-ink);background:var(--rpn-bg-2);line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
svg{display:block}
.rpn-wrap{max-width:1060px;margin:0 auto;padding:0 20px}
/* header */
.rpn-header{background:var(--rpn-navy);color:#fff}
.rpn-nav{display:flex;align-items:center;gap:14px;height:60px}
.rpn-logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px}
.rpn-logo-mark{width:34px;height:34px;border-radius:8px;background:linear-gradient(150deg,var(--rpn-mint),var(--rpn-teal));display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rpn-logo span{color:var(--rpn-mint)}
.rpn-nav-right{margin-left:auto;font-size:14.5px;font-weight:600}
/* layout */
.rpn-main{padding:40px 0 70px}
.rpn-grid{display:grid;grid-template-columns:1fr;gap:28px}
@media(min-width:940px){.rpn-grid{grid-template-columns:1.35fr .85fr;gap:40px;align-items:start}}
.rpn-h1{font-size:27px;font-weight:800;letter-spacing:-.02em;margin-bottom:6px}
.rpn-sub{color:var(--rpn-ink-2);font-size:15.5px;margin-bottom:22px}
.rpn-card{background:#fff;border:1px solid var(--rpn-line);border-radius:16px;padding:26px;box-shadow:0 20px 46px -34px rgba(15,44,63,.4)}
/* fields */
.rpn-field{margin-bottom:16px}
.rpn-field label{display:block;font-size:13.5px;font-weight:700;margin-bottom:6px}
.rpn-req{color:var(--rpn-err)}
.rpn-input{width:100%;font-family:inherit;font-size:15.5px;padding:11px 13px;border:1.5px solid var(--rpn-line);border-radius:10px;background:#fff;color:var(--rpn-ink);transition:border-color .15s,box-shadow .15s}
.rpn-input:focus{outline:none;border-color:var(--rpn-teal);box-shadow:0 0 0 3px rgba(14,140,153,.14)}
.rpn-input.err{border-color:var(--rpn-err)}
.rpn-hint{font-size:12.5px;color:var(--rpn-ink-3);margin-top:5px}
.rpn-err-msg{font-size:12.5px;color:var(--rpn-err);margin-top:5px;font-weight:600}
.rpn-row{display:grid;grid-template-columns:1fr;gap:0}
@media(min-width:620px){.rpn-row{grid-template-columns:1fr 1fr;gap:14px}}
/* vai trò */
.rpn-roles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:9px;margin-top:4px}
.rpn-role{display:flex;align-items:flex-start;gap:9px;border:1.5px solid var(--rpn-line);border-radius:11px;padding:11px 12px;cursor:pointer;transition:border-color .15s,background .15s}
.rpn-role:hover{border-color:var(--rpn-mint)}
.rpn-role input{margin-top:2px;width:17px;height:17px;accent-color:var(--rpn-teal);flex-shrink:0;cursor:pointer}
.rpn-role b{display:block;font-size:14.5px;font-weight:700}
.rpn-role small{display:block;font-size:12px;color:var(--rpn-ink-3);line-height:1.35}
.rpn-role:has(input:checked){border-color:var(--rpn-teal);background:var(--rpn-bg-3)}
/* MST trùng — điểm mấu chốt */
.rpn-dup{border:1.5px solid var(--rpn-teal);background:var(--rpn-bg-3);border-radius:13px;padding:18px;margin-bottom:16px}
.rpn-dup-head{display:flex;gap:12px;align-items:flex-start;margin-bottom:12px}
.rpn-dup-ic{width:38px;height:38px;border-radius:10px;background:#fff;border:1px solid var(--rpn-line);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rpn-dup h3{font-size:15.5px;font-weight:800;margin-bottom:4px}
.rpn-dup p{font-size:13.5px;color:var(--rpn-ink-2)}
.rpn-dup-co{display:flex;align-items:center;gap:9px;background:#fff;border:1px solid var(--rpn-line);border-radius:10px;padding:10px 12px;font-size:14px;font-weight:700;margin-bottom:12px}
.rpn-mst-badge{margin-left:auto;font-size:12px;font-weight:700;color:var(--rpn-teal);background:var(--rpn-bg-3);padding:4px 10px;border-radius:999px}
.rpn-dup-actions{display:flex;flex-wrap:wrap;gap:9px}
.rpn-dup-btn{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:700;padding:10px 15px;border-radius:9px;border:1.5px solid var(--rpn-line);background:#fff;cursor:pointer;font-family:inherit}
.rpn-dup-btn.primary{background:var(--rpn-teal);border-color:var(--rpn-teal);color:#fff}
/* submit */
.rpn-check-line{display:flex;gap:9px;align-items:flex-start;font-size:13.5px;color:var(--rpn-ink-2);margin:16px 0}
.rpn-check-line input{margin-top:3px;width:16px;height:16px;accent-color:var(--rpn-teal);flex-shrink:0}
.rpn-check-line a{color:var(--rpn-teal);font-weight:700}
.rpn-submit{width:100%;font-family:inherit;font-size:16px;font-weight:800;padding:14px;border:none;border-radius:11px;background:var(--rpn-amber);color:#241A00;cursor:pointer;box-shadow:0 8px 22px -8px rgba(245,158,11,.7)}
.rpn-submit:hover{background:var(--rpn-amber-d)}
.rpn-login-hint{text-align:center;font-size:13.5px;color:var(--rpn-ink-2);margin-top:13px}
.rpn-login-hint a{color:var(--rpn-teal);font-weight:700}
.rpn-global-err{background:#FDECEA;border:1px solid #F5C6C0;color:var(--rpn-err);font-size:13.5px;font-weight:600;padding:11px 13px;border-radius:10px;margin-bottom:16px}
/* aside */
.rpn-aside{background:var(--rpn-navy);color:#fff;border-radius:16px;padding:26px}
.rpn-aside h3{font-size:16.5px;font-weight:800;margin-bottom:14px}
.rpn-benefit{display:flex;gap:11px;align-items:flex-start;margin-bottom:15px}
.rpn-benefit svg{flex-shrink:0;margin-top:2px}
.rpn-benefit b{display:block;font-size:14px;font-weight:700}
.rpn-benefit small{font-size:13px;color:#A9C2CC;line-height:1.45}
.rpn-aside-note{border-top:1px solid rgba(255,255,255,.14);margin-top:18px;padding-top:16px;font-size:13px;color:#A9C2CC}
.rpn-aside-note b{color:var(--rpn-mint)}
/* done */
.rpn-suc-ic{width:62px;height:62px;border-radius:50%;background:#E4F7EF;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.rpn-done{text-align:center;max-width:560px;margin:0 auto}
.rpn-done h2{font-size:24px;font-weight:800;margin-bottom:8px}
.rpn-done p{color:var(--rpn-ink-2);font-size:15px;margin-bottom:22px}
.rpn-prog-top{display:flex;justify-content:space-between;font-size:13.5px;margin-bottom:7px}
.rpn-prog-bar{height:9px;background:var(--rpn-bg-3);border-radius:999px;overflow:hidden;margin-bottom:18px}
.rpn-prog-fill{height:100%;background:linear-gradient(90deg,var(--rpn-teal),var(--rpn-mint));border-radius:999px}
      </style>
    </t>

    <header class="rpn-header">
      <div class="rpn-wrap rpn-nav">
        <a class="rpn-logo" href="/">
          <span class="rpn-logo-mark"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F2C3F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V9l7-5 7 5v12"/><path d="M9 21v-6h6v6"/></svg></span>
          <b>Realty Pro <span>Network</span></b>
        </a>
        <div class="rpn-nav-right"><a href="/web/login">Đã có tài khoản? Đăng nhập</a></div>
      </div>
    </header>

    <main class="rpn-main">
      <div class="rpn-wrap rpn-grid">
        <div>
          <h1 class="rpn-h1">Đăng ký tài khoản nhà thầu</h1>
          <p class="rpn-sub">Miễn phí. Mỗi công ty một tài khoản, xác thực bằng Mã số thuế.</p>

          <div class="rpn-card">
            <div class="rpn-global-err" t-if="errors.get('global')" t-esc="errors['global']"/>

            <!-- ===== MST TRÙNG: không cho tạo mới, chỉ đường liên hệ admin ===== -->
            <div class="rpn-dup" t-if="dup_company">
              <div class="rpn-dup-head">
                <span class="rpn-dup-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0E8C99" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg></span>
                <div>
                  <h3>Công ty này đã có tài khoản trên Realty Pro Network</h3>
                  <p>Mỗi công ty chỉ có một tài khoản gốc. Vui lòng liên hệ quản trị viên tài khoản công ty để được mời tham gia — không cần tạo tài khoản mới.</p>
                </div>
              </div>
              <div class="rpn-dup-co">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#4A6472" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 21V7h6v14M12 11h6v10"/></svg>
                <span t-esc="dup_company"/>
                <span class="rpn-mst-badge" t-esc="dup_mst"/>
              </div>
              <div class="rpn-dup-actions">
                <a class="rpn-dup-btn primary" href="/web/login">Tôi là quản trị viên — Đăng nhập</a>
                <a class="rpn-dup-btn" href="/dang-ky">Nhập mã số thuế khác</a>
              </div>
            </div>

            <form method="post" action="/dang-ky">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

              <div class="rpn-field">
                <label for="company">Tên công ty <span class="rpn-req">*</span></label>
                <input class="rpn-input" t-attf-class="rpn-input #{errors.get('company') and 'err' or ''}"
                       id="company" name="company" type="text" t-att-value="company"
                       placeholder="Công ty TNHH Xây dựng ..."/>
                <div class="rpn-err-msg" t-if="errors.get('company')" t-esc="errors['company']"/>
              </div>

              <div class="rpn-field">
                <label for="mst">Mã số thuế (MST) <span class="rpn-req">*</span></label>
                <input t-attf-class="rpn-input #{errors.get('mst') and 'err' or ''}"
                       id="mst" name="mst" type="text" inputmode="numeric" t-att-value="mst"
                       placeholder="0312345678 hoặc 0312345678-001" autocomplete="off"/>
                <div class="rpn-hint">Đây là mã định danh công ty của bạn: 10 chữ số, hoặc 13 ký tự dạng <b>xxxxxxxxxx-xxx</b> (chi nhánh).</div>
                <div class="rpn-err-msg" t-if="errors.get('mst')" t-esc="errors['mst']"/>
                <div class="rpn-err-msg" id="mstLive" style="display:none"></div>
              </div>

              <!-- ===== VAI TRÒ: Network là MỘT sàn → chọn nhiều vai ===== -->
              <div class="rpn-field">
                <label>Công ty bạn cung cấp gì? <span class="rpn-req">*</span></label>
                <div class="rpn-hint" style="margin-top:0;margin-bottom:8px">Chọn tất cả những gì đúng — nhiều đơn vị vừa bán vật tư vừa nhận thi công.</div>
                <div class="rpn-roles">
                  <t t-foreach="all_roles" t-as="r">
                    <label class="rpn-role">
                      <input type="checkbox" name="roles" t-att-value="r.code"
                             t-att-checked="r.code in roles and 'checked' or None"/>
                      <span>
                        <b t-esc="r.name"/>
                        <small t-esc="r.description or ''"/>
                      </span>
                    </label>
                  </t>
                </div>
                <div class="rpn-err-msg" t-if="errors.get('roles')" t-esc="errors['roles']"/>
              </div>

              <div class="rpn-field">
                <label for="contact">Người liên hệ <span class="rpn-req">*</span></label>
                <input t-attf-class="rpn-input #{errors.get('contact') and 'err' or ''}"
                       id="contact" name="contact" type="text" t-att-value="contact" placeholder="Họ và tên"/>
                <div class="rpn-hint">Người đăng ký đầu tiên của công ty sẽ là <b>quản trị viên tài khoản</b>.</div>
                <div class="rpn-err-msg" t-if="errors.get('contact')" t-esc="errors['contact']"/>
              </div>

              <div class="rpn-row">
                <div class="rpn-field">
                  <label for="email">Email <span class="rpn-req">*</span></label>
                  <input t-attf-class="rpn-input #{errors.get('email') and 'err' or ''}"
                         id="email" name="email" type="email" t-att-value="email"
                         placeholder="email@congty.vn" autocomplete="email"/>
                  <div class="rpn-hint">Email này dùng để đăng nhập.</div>
                  <div class="rpn-err-msg" t-if="errors.get('email')" t-esc="errors['email']"/>
                </div>
                <div class="rpn-field">
                  <label for="phone">Điện thoại <span class="rpn-req">*</span></label>
                  <input t-attf-class="rpn-input #{errors.get('phone') and 'err' or ''}"
                         id="phone" name="phone" type="tel" inputmode="tel" t-att-value="phone"
                         placeholder="09xx xxx xxx" autocomplete="tel"/>
                  <div class="rpn-err-msg" t-if="errors.get('phone')" t-esc="errors['phone']"/>
                </div>
              </div>

              <div class="rpn-row">
                <div class="rpn-field">
                  <label for="password">Mật khẩu <span class="rpn-req">*</span></label>
                  <input t-attf-class="rpn-input #{errors.get('password') and 'err' or ''}"
                         id="password" name="password" type="password"
                         placeholder="Tối thiểu 8 ký tự" autocomplete="new-password"/>
                  <div class="rpn-err-msg" t-if="errors.get('password')" t-esc="errors['password']"/>
                </div>
                <div class="rpn-field">
                  <label for="password2">Xác nhận mật khẩu <span class="rpn-req">*</span></label>
                  <input t-attf-class="rpn-input #{errors.get('password2') and 'err' or ''}"
                         id="password2" name="password2" type="password"
                         placeholder="Nhập lại mật khẩu" autocomplete="new-password"/>
                  <div class="rpn-err-msg" t-if="errors.get('password2')" t-esc="errors['password2']"/>
                </div>
              </div>

              <label class="rpn-check-line">
                <input type="checkbox" name="agree" value="1" t-att-checked="agree and 'checked' or None"/>
                <span>Tôi đồng ý với <a href="/dieu-khoan">Điều khoản sử dụng</a> và <a href="/bao-mat">Chính sách bảo mật</a> của Realty Pro Network.</span>
              </label>
              <div class="rpn-err-msg" t-if="errors.get('agree')" t-esc="errors['agree']" style="margin-top:-8px;margin-bottom:12px"/>

              <button type="submit" class="rpn-submit">Tạo tài khoản nhà thầu</button>
              <p class="rpn-login-hint">Đã có tài khoản? <a href="/web/login">Đăng nhập</a></p>
            </form>
          </div>
        </div>

        <aside class="rpn-aside">
          <h3>Vì sao đăng ký?</h3>
          <div class="rpn-benefit">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#46D6C0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <span><b>Tiếp cận gói thầu thật</b><small>Gói thầu do các tổng thầu trên Network công bố.</small></span>
          </div>
          <div class="rpn-benefit">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#46D6C0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <span><b>Khai hồ sơ một lần</b><small>Hồ sơ năng lực dùng lại cho mọi gói — không làm lại mỗi lần dự thầu.</small></span>
          </div>
          <div class="rpn-benefit">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#46D6C0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <span><b>Nộp online, có biên nhận</b><small>Không giấy tờ, không chạy đi nộp, không lỡ hạn.</small></span>
          </div>
          <div class="rpn-aside-note">
            <b>Mỗi công ty một tài khoản.</b> Mã số thuế là mã định danh công ty trên Network. Người đăng ký đầu tiên là quản trị viên và mời thêm đồng nghiệp sau.
          </div>
        </aside>
      </div>
    </main>

    <script type="text/javascript">
// Kiểm MST ngay khi rời ô — để báo "công ty đã có" sớm, không bắt điền hết form.
// Server vẫn kiểm lại khi submit (không tin trình duyệt).
(function () {
  var mst = document.getElementById('mst');
  var live = document.getElementById('mstLive');
  if (!mst || !live) { return; }
  var RE = /^\d{10}(-\d{3})?$/;
  mst.addEventListener('blur', function () {
    var v = (mst.value || '').replace(/[^\d-]/g, '');
    live.style.display = 'none';
    if (!v || !RE.test(v)) { return; }
    fetch('/dang-ky/kiem-tra-mst', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { mst: v } })
    }).then(function (r) { return r.json(); }).then(function (res) {
      var d = res &amp;&amp; res.result;
      if (d &amp;&amp; d.exists) {
        live.textContent = 'Công ty "' + d.company + '" đã có tài khoản với MST này — hãy liên hệ quản trị viên công ty để được mời.';
        live.style.display = 'block';
      }
    }).catch(function () {});
  });
})();
    </script>
  </t>
</template>

<!-- ===== Đăng ký xong ===== -->
<template id="signup_done" name="Realty Pro Network — Đăng ký thành công">
  <t t-call="web.layout">
    <t t-set="html_data" t-value="{'lang': 'vi'}"/>
    <t t-set="title">Đã tạo tài khoản — Realty Pro Network</t>
    <t t-set="head">
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <style>
