<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_loan_facility_list" model="ir.ui.view">
        <field name="name">re.loan.facility.list</field>
        <field name="model">re.loan.facility</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <!-- HĐTD và Dự án hiện ngay trên lưới vì lưới này cũng
                     là màn hình CHỌN mục đích khi khai khế ước: chỉ
                     nhìn tên hạn mức thì không biết nó thuộc hợp đồng
                     nào, mà tên hạn mức giữa các HĐTD hay trùng nhau. -->
                <field name="credit_contract_id"/>
                <field name="project_names" optional="show"
                       string="Dự án được phân bổ"/>
                <field name="purpose"/>
                <field name="facility_type"/>
                <field name="amount_limit" width="185px" sum="Tổng hạn mức"/>
                <field name="flexible_limits" widget="boolean_toggle"
                       optional="show"/>
                <field name="amount_used" width="185px" sum="Tổng đã dùng"/>
                <field name="amount_pending_bank" width="185px"
                       optional="hide" sum="Tổng đang chờ NH"/>
                <field name="interest_rate_weighted" optional="show"/>
                <field name="amount_available" width="185px" sum="Tổng còn lại"/>
                <field name="interest_rate_default" width="185px"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_re_loan_facility_form" model="ir.ui.view">
        <field name="name">re.loan.facility.form</field>
        <field name="model">re.loan.facility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Hộp nút thống kê dùng chung — BẮT BUỘC mang
                         name="button_box", xem chú thích ở form Khế
                         ước (backlog 744). -->
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tên hạn mức"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not purpose_restricted">
                        <field name="purpose_restricted" invisible="1"/>
                        <b>Mục đích thuộc nhóm hạn chế.</b> Điều 8 khoản 8/9/10
                        Thông tư 39/2016/TT-NHNN cấm nhóm nhu cầu vốn này,
                        nhưng <b>đang ngưng hiệu lực từ 01/9/2023</b> theo
                        Thông tư 10/2023/TT-NHNN. Kiểm tra trạng thái quy định
                        hiện hành trước khi cấp.
                    </div>
                    <group>
                        <group>
                            <field name="credit_contract_id"/>
                            <field name="purpose"/>
                            <field name="facility_type"/>
                            <field name="amount_limit"/>
                            <!-- Bản sao VÔ ĐIỀU KIỆN của currency_id. Trường hiển thị bên
                         dưới bị khoá theo nhóm Đa tiền tệ; người dùng không ở
                         nhóm đó thì currency_id KHÔNG có trong form, widget
                         monetary mất tiền tệ và rơi về định dạng float mặc
                         định — 2 số lẻ, dù VND khai 0 số lẻ. Đó là lý do
                         "5.500.000.000.000" hiện ra thành
                         "5.500.000.000.000,01". -->
                    <field name="currency_id" invisible="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="interest_rate_default"/>
                            <field name="interest_method"/>
                            <field name="day_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="Sử dụng hạn mức">
                            <field name="amount_used"/>
                            <field name="interest_rate_weighted"/>
                            <field name="amount_available"/>
                            <field name="amount_pending_bank"/>
                            <div colspan="2" class="alert alert-warning small"
                                 role="alert"
                                 style="margin-top:4px; padding:6px 10px;"
                                 invisible="amount_pending_bank &lt;= amount_available">
                                <i class="fa fa-hourglass-half"/>
                                Hồ sơ <b>đang chờ NH duyệt</b> đã vượt phần
                                <b>còn lại</b> của hạn mức. Gửi NH chưa chiếm
                                hạn mức — nhưng đến lúc kích hoạt, phần vượt
                                sẽ không đủ chỗ.
                            </div>
                            <div colspan="2" class="text-muted small"
                                 style="margin-top:4px;"
                                 invisible="amount_pending_bank &lt;= 0">
                                <i class="fa fa-info-circle"/>
                                KW <b>Đã gửi NH</b> chưa chiếm hạn mức. Hạn
                                mức chỉ bị chiếm khi KW được <b>kích hoạt</b>.
                            </div>
                            <div colspan="2" class="alert alert-success small"
                                 role="alert"
                                 style="margin-top:4px; padding:6px 10px;"
                                 invisible="facility_type not in ('revolving','overdraft')">
                                <i class="fa fa-refresh" title="Tuần hoàn"/>
                                <b>Tuần hoàn:</b> hạn mức được <b>KHÔI PHỤC
                                tự động</b> khi KW trả gốc. Vd KW vay 2 tỷ,
                                trả gốc 1 tỷ → "Đã sử dụng" giảm còn 1 tỷ,
                                "Còn lại" tăng thêm 1 tỷ.
                            </div>
                            <div colspan="2" class="text-muted small"
                                 style="margin-top:4px;"
                                 invisible="facility_type in ('revolving','overdraft')">
                                <i class="fa fa-info-circle"/>
                                Loại này <b>KHÔNG khôi phục</b> hạn mức khi
                                trả gốc — đã rút là chiếm hạn mức đến hết kỳ.
                            </div>
                        </group>
                        <group string="Liên thông">
                            <field name="flexible_limits"
                                   widget="boolean_toggle"/>
                            <div colspan="2" class="text-muted small"
                                 style="margin-top:4px;">
                                <i class="fa fa-info-circle"/>
                                Tick <b>Hạn mức liên thông</b> để chia
                                sẻ phần thừa hạn mức với các facility KHÁC
                                cùng tick liên thông (vd: Vay đầu tư còn
                                200 tỷ liên thông với Bảo lãnh còn 100 tỷ
                                → pool 300 tỷ dùng chung). Σ limit luôn ≤
                                tổng HĐTD — liên thông KHÔNG bypass total.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Phân bổ dự án" name="project_allocation">
                            <group>
                                <group>
                                    <field name="amount_allocated_to_projects"/>
                                    <field name="amount_unallocated"/>
                                </group>
                            </group>
                            <field name="project_allocation_ids"
                                   context="{'default_facility_id': id}">
                                <list editable="bottom">
                                    <field name="project_id"/>
                                    <field name="amount" width="185px" sum="Σ phân bổ"/>
                                    <field name="description"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="TSBĐ riêng Facility" name="pledge">
                            <div class="alert alert-info small" role="alert">
                                <i class="fa fa-info-circle"/>
                                Chỉ thêm pledge ở đây khi TSBĐ chỉ bảo
                                đảm RIÊNG Facility này (vd dự án X là
                                TSBĐ của riêng Facility "Vay đầu tư DA X").
                                Phần lớn TSBĐ nên gắn ở cấp HĐTD.
                            </div>
                            <field name="pledge_ids"
                                   context="{'default_facility_id': id,
                                             'default_pledge_target': 'facility'}">
                                <list editable="bottom"
                                      decoration-muted="state == 'released'">
                                    <field name="name"/>
                                    <field name="collateral_id"/>
                                    <field name="date_pledge"/>
                                    <field name="secured_amount" width="185px" sum="Tổng đảm bảo"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'active'"
                                           decoration-muted="state == 'released'"/>
                                    <button name="action_release" type="object"
                                            string="Giải chấp" icon="fa-unlock"
                                            invisible="state != 'active'"/>
                                    <field name="pledge_target"
                                           column_invisible="1"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note" placeholder="Ghi chú..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- Màn này trước đây KHÔNG có search view nào (action không khai
         search_view_id) — nên vừa thêm panel lọc vừa bổ sung luôn ô tìm
         kiếm và nhóm cơ bản. -->
    <record id="view_re_loan_facility_search" model="ir.ui.view">
        <field name="name">re.loan.facility.search</field>
        <field name="model">re.loan.facility</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="credit_contract_id"/>
                <field name="partner_id"/>
                <field name="purpose"/>
                <!-- Lọc theo NHÓM MỤC ĐÍCH: loại "Hạn mức bảo lãnh" đã
                     ngưng dùng (backlog 755) nên lọc theo nó sẽ ra
                     rỗng đúng vào lúc hạn mức bảo lãnh nhiều nhất. -->
                <filter name="f_guarantee" string="Hạn mức bảo lãnh"
                        domain="[('purpose_kind','=','guarantee')]"/>
                <filter name="f_revolving" string="Tuần hoàn"
                        domain="[('facility_type','=','revolving')]"/>
                <separator/>
                <filter name="g_contract" string="HĐTD"
                        context="{'group_by': 'credit_contract_id'}"/>
                <filter name="g_type" string="Loại hạn mức"
                        context="{'group_by': 'facility_type'}"/>
                <filter name="g_purpose" string="Mục đích vay"
                        context="{'group_by': 'purpose'}"/>

                <!-- Panel lọc bên trái — anh Đại chốt 2026-08-11:
                     trục panel phải là DANH MỤC CÓ BIÊN, không phải tập
                     chứng từ tăng dần. HĐTD tích luỹ theo năm nên panel
                     sẽ phình vô hạn; để ở ô tìm kiếm và nhóm là đủ.

                     Ba trục dưới đây đều có biên cố định: số ngân hàng
                     tài trợ gần như không đổi, còn mục đích vay và loại
                     hạn mức là danh mục khai sẵn. -->
                <searchpanel>
                    <field name="partner_id" string="Ngân hàng"
                           select="multi" icon="fa-university"
                           enable_counters="1"/>
                    <field name="purpose" string="Mục đích vay"
                           select="multi" icon="fa-bullseye"
                           enable_counters="1"/>
                    <field name="facility_type" string="Loại hạn mức"
                           select="multi" icon="fa-sliders"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_re_loan_facility" model="ir.actions.act_window">
        <field name="name">Hạn mức tín dụng</field>
        <field name="res_model">re.loan.facility</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_re_loan_facility_search"/>
    </record>


    <!-- Danh mục mục đích sử dụng vốn — GỒM CẢ 25 mục dựng sẵn -->
    <record id="view_re_loan_purpose_list" model="ir.ui.view">
        <field name="name">re.loan.purpose.list</field>
        <field name="model">re.loan.purpose</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <!-- Mã do hệ thống tự sinh từ tên khi lưu (backlog
                     1084) — người dùng không khai, không sửa. Hạn mức
                     tham chiếu mục đích theo mã này. -->
                <field name="code" readonly="1" required="0"
                       placeholder="Tự sinh khi lưu"/>
                <field name="kind" readonly="code == 'bank_guarantee'"/>
                <field name="facility_count" string="Hạn mức đang dùng"
                       optional="show"/>
                <field name="is_builtin" string="Dựng sẵn"
                       widget="boolean_toggle" readonly="1"
                       optional="show"/>
                <field name="note" optional="show"/>
                <field name="active" widget="boolean_toggle"
                       string="Đang dùng" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_re_loan_purpose_search" model="ir.ui.view">
        <field name="name">re.loan.purpose.search</field>
        <field name="model">re.loan.purpose</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="f_loan" string="Nhóm Vay"
                        domain="[('kind', '=', 'loan')]"/>
                <filter name="f_guarantee" string="Nhóm Bảo lãnh"
                        domain="[('kind', '=', 'guarantee')]"/>
                <separator/>
                <filter name="f_builtin" string="Dựng sẵn"
                        domain="[('is_builtin', '=', True)]"/>
                <filter name="f_custom" string="Tự khai thêm"
                        domain="[('is_builtin', '=', False)]"/>
                <separator/>
                <filter name="f_inactive" string="Đã ẩn"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="g_kind" string="Phân loại"
                        context="{'group_by': 'kind'}"/>
            </search>
        </field>
    </record>

    <record id="action_re_loan_purpose" model="ir.actions.act_window">
        <field name="name">Mục đích sử dụng vốn</field>
        <field name="res_model">re.loan.purpose</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_re_loan_purpose_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">
                Danh mục mục đích sử dụng vốn
            </p>
            <p>
                Màn hình này liệt kê <b>toàn bộ</b> mục đích đang có —
                gồm 25 mục <b>dựng sẵn</b> phủ nghiệp vụ tổng thầu và
                các mục do đơn vị tự khai thêm. Sửa được <b>tên</b> của
                mọi mục; riêng <b>mã</b> của mục dựng sẵn thì khoá, vì
                dữ liệu cũ tham chiếu theo mã.
            </p>
            <p>
                Nhớ chọn đúng <b>Phân loại</b>: khế ước nhận nợ chỉ chọn
                được hạn mức thuộc nhóm <b>Vay</b>. Không dùng mục nào
                nữa thì bỏ tick <b>Đang dùng</b> để ẩn khỏi ô chọn —
                đừng xoá, hạn mức cũ còn tham chiếu tới.
            </p>
        </field>
    </record>

    <menuitem id="menu_re_loan_purpose"
              name="Mục đích sử dụng vốn"
              parent="menu_re_loan_config"
              action="action_re_loan_purpose"
              sequence="25"/>

</odoo>
