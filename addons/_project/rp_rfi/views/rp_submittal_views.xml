<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rp_submittal_list" model="ir.ui.view">
        <field name="name">rp.submittal.list</field>
        <field name="model">rp.submittal</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue"
                  decoration-muted="state == 'cancelled'">
                <field name="code"/>
                <field name="name"/>
                <field name="submittal_type"/>
                <field name="contractor_id"/>
                <field name="contract_id" optional="hide"/>
                <field name="submitted_date" optional="show"/>
                <field name="deadline"/>
                <field name="revision"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'approved_cond')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_submittal_form" model="ir.ui.view">
        <field name="name">rp.submittal.form</field>
        <field name="model">rp.submittal</field>
        <field name="arch" type="xml">
            <form string="Trình duyệt">
                <header>
                    <button name="action_submit" string="Trình duyệt"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt"
                            type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="re_base.group_re_manager"/>
                    <button name="action_approve_cond"
                            string="Duyệt có điều kiện" type="object"
                            invisible="state != 'submitted'"
                            groups="re_base.group_re_manager"/>
                    <button name="action_reject" string="Từ chối"
                            type="object"
                            invisible="state != 'submitted'"
                            groups="re_base.group_re_manager"/>
                    <button name="action_resubmit" string="Trình lại"
                            type="object" class="btn-primary"
                            invisible="state != 'rejected'"/>
                    <button name="action_cancel" string="Huỷ" type="object"
                            invisible="state in ('approved', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/></h1>
                        <h2><field name="name"
                                   placeholder="Vd: Mẫu gạch ốp kháng khuẩn khu điều trị..."/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="submittal_type"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="structure_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="submitted_by_id"
                                   widget="many2one_avatar_user"/>
                            <field name="submitted_date"
                                   invisible="not submitted_date"/>
                            <field name="deadline"/>
                            <field name="revision"/>
                            <field name="is_overdue" invisible="not is_overdue"/>
                            <field name="reviewed_by_id"
                                   invisible="not reviewed_by_id"/>
                            <field name="reviewed_date"
                                   invisible="not reviewed_date"/>
                        </group>
                    </group>
                    <group string="Mô tả">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Ý kiến duyệt">
                        <field name="review_note" nolabel="1" colspan="2"
                               placeholder="Điều kiện kèm theo hoặc lý do từ chối..."/>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rp_submittal_search" model="ir.ui.view">
        <field name="name">rp.submittal.search</field>
        <field name="model">rp.submittal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="contractor_id"/>
                <filter name="filter_pending" string="Chờ duyệt"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_rejected" string="Từ chối — chờ trình lại"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Nhà thầu" name="group_contractor"
                        context="{'group_by': 'contractor_id'}"/>
                <filter string="Loại" name="group_type"
                        context="{'group_by': 'submittal_type'}"/>
                <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_submittal" model="ir.actions.act_window">
        <field name="name">Trình duyệt (Submittal)</field>
        <field name="res_model">rp.submittal</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
