<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rp_progress.BSDGanttView">
        <div class="o_action_manager bsd_gantt_root">
            <div class="bsd_gantt_toolbar p-2 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0">
                        <i class="fa fa-bar-chart me-2"/>
                        Gantt — <t t-esc="state.projectName"/>
                    </h4>
                    <small class="text-muted" t-if="!state.error">
                        <t t-esc="state.taskCount"/> hạng mục
                    </small>
                </div>
                <div class="btn-group" t-if="!state.loading and !state.error">
                    <button t-foreach="['Day','Week','Month','Year']"
                            t-as="mode" t-key="mode"
                            t-on-click="() => this.setViewMode(mode)"
                            class="btn btn-sm"
                            t-att-class="state.viewMode === mode ? 'btn-primary' : 'btn-light'">
                        <t t-esc="mode"/>
                    </button>
                </div>
            </div>

            <div t-if="state.error" class="alert alert-warning m-3" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <span t-esc="state.error"/>
                <div t-if="state.licenseError" class="mt-2">
                    <button class="btn btn-sm btn-warning"
                            t-on-click="() => this.retry()">
                        <i class="fa fa-refresh me-1"/>
                        Thử lại
                    </button>
                </div>
            </div>

            <div t-if="state.noDates and !state.error" class="bsd_gantt_empty">
                <div class="bsd_gantt_empty_inner">
                    <i class="fa fa-calendar-o fa-3x text-muted mb-3"/>
                    <h5>Chưa có hạng mục nào có ngày kế hoạch</h5>
                    <p class="text-muted">
                        Vào form hạng mục và nhập <b>Ngày BĐ KH</b> + <b>Ngày KT KH</b>.
                    </p>
                </div>
            </div>

            <!-- Syncfusion Gantt mount point — LUÔN render để ganttRef.el
                 available cho adapter.render(). Loading state show
                 overlay spinner trên cùng (z-index). -->
            <div t-if="!state.error and !state.noDates"
                 class="bsd_gantt_container" t-ref="gantt">
                <div t-if="state.loading"
                     class="bsd_gantt_loading_overlay d-flex justify-content-center align-items-center">
                    <div class="spinner-border text-primary"/>
                    <span class="ms-3">Đang tải...</span>
                </div>
            </div>
        </div>
    </t>

</templates>
