#. module: eam_wind
#: model_terms:ir.ui.view,arch_db:eam_wind.view_eam_category_form_wind
msgid ""
"Hai trục xếp hạng <b>khác nhau</b>: cụm hỏng\n"
"                            nhiều nhất không phải cụm gây dừng lâu nhất.\n"
"                            Đây là <b>giá trị tham chiếu</b> — mức quan\n"
"                            trọng thật phải suy ra từ lịch sử của chính\n"
"                            đội máy này."
msgstr ""
"Two <b>different</b> rankings: the assembly that\n"
"                            fails most often is not the assembly that causes\n"
"                            the longest downtime. These are <b>reference\n"
"                            figures</b> — the real criticality has to be\n"
"                            derived from the history of this fleet itself."

#. module: eam_wind
#: model:ir.model.fields,help:eam_wind.field_eam_asset_category__rank_downtime
msgid "Hai trục xếp hạng KHÁC NHAU: cụm hỏng nhiều nhất không phải cụm gây dừng lâu nhất. Nguyên nhân là độ phức tạp của việc sửa, không phải tần suất hỏng."
msgstr "Two DIFFERENT rankings: the assembly that fails most often is not the assembly that causes the longest downtime. The reason is how complex the repair is, not how often it fails."

