#. module: eam_pm
#: code:addons/eam_pm/models/eam_season.py:0
msgid " Lưu ý đây là ĐẨY LÙI: không tìm được ngày sớm hơn nào ra khỏi mùa, nên thiết bị sẽ chạy thêm %d ngày quá chu kỳ thiết kế."
msgstr " Note that this is a PUSH BACK: no earlier date outside the season could be found, so the equipment will run %d days beyond its design cycle."

#. module: eam_pm
#: model:ir.model.fields,help:eam_pm.field_eam_pm_plan__anchor
msgid "\"Từ lần làm xong\" là mặc định đúng cho bảo dưỡng: trễ thì lần sau dời theo. \"Mốc cố định\" dành cho kiểm định bắt buộc — hạn do pháp luật đặt, làm sớm hay muộn thì hạn sau vẫn là ngày đó."
msgstr "\"From the last completion\" is the right default for servicing: run late once and the next one moves with it. \"Fixed anchor\" is for mandatory statutory inspections — the deadline is set by law, so doing it early or late leaves the next date unchanged."

#. module: eam_pm
#: model_terms:ir.ui.view,arch_db:eam_pm.view_eam_maint_kpi_list
msgid "% bắt sớm"
msgstr "% caught early"

#. module: eam_pm
#: model:ir.model.fields,field_description:eam_pm.field_eam_reliability__detect_early_pct
