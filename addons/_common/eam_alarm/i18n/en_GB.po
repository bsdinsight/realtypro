#. module: eam_alarm
#: model:ir.model.fields,help:eam_alarm.field_eam_alarm_rule__auto_wo
msgid ""
"\"Tạo lệnh ngay\" chỉ nên dùng cho mức nghiêm trọng. Một đầu đo bị nhiễu nổ 500 cảnh báo một đêm sẽ thành 500 lệnh rác, và sau đó không ai đọc danh sách lệnh nữa.\n"
"\n"
"\"Mở YÊU CẦU\" là lựa chọn đúng cho cảnh báo mức thấp: nó vào sổ yêu cầu để người điều độ xem có đáng mở lệnh không, thay vì vào thẳng danh sách việc phải làm."
msgstr ""
"\"Create order now\" should be reserved for critical severity. One noisy sensor raising 500 alarms in a night becomes 500 junk orders, after which nobody reads the order list any more.\n"
"\n"
"\"Open a REQUEST\" is the right choice for low-level alarms: it goes into the request log for the dispatcher to judge whether an order is warranted, instead of straight onto the list of work to be done."

#. module: eam_alarm
#: code:addons/eam_alarm/models/eam_alarm_rule.py:0
msgid "%(nhan)s đang %(tri).2f %(dv)s, %(huong)s ngưỡng %(ng).2f."
msgstr "%(nhan)s is at %(tri).2f %(dv)s, %(huong)s the %(ng).2f threshold."

#. module: eam_alarm
#: code:addons/eam_alarm/models/canh_bao_diem_do.py:0
msgid "%(ten)s ngừng gửi số đã %(gio).1f giờ (mốc cuối %(c)s). Trong lúc nó im, mọi luật ngưỡng canh trên chính điểm đo này cũng im theo — kiểm ĐƯỜNG TRUYỀN trước khi cử người ra trụ."
msgstr "%(ten)s has not sent a reading for %(gio).1f hours (last at %(c)s). While it is silent, every threshold rule watching this same tag is silent too — check the LINK before sending anyone up the tower."

#. module: eam_alarm
#: code:addons/eam_alarm/models/canh_bao_diem_do.py:0
msgid "%(ten)s đang %(v).3f %(dv)s — %(nhan)s %(dai)s, liên tục %(p)d phút (%(n)d số đo, không có mốc nào ngược lại)."
msgstr "%(ten)s is at %(v).3f %(dv)s — %(nhan)s %(dai)s, sustained for %(p)d minutes (%(n)d readings, none of them to the contrary)."

#. module: eam_alarm
#: code:addons/eam_alarm/models/canh_bao_diem_do.py:0
msgid "%(ten)s đứng im ở %(v).3f suốt %(n)d phút — số vẫn về đều nên KHÔNG phải mất tín hiệu, mà là giá trị không đổi. Hai chuyện ấy sửa ở hai nơi khác nhau."
msgstr "%(ten)s has been frozen at %(v).3f for %(n)d minutes — readings keep arriving, so this is NOT a lost signal but a value that will not move. The two are fixed in different places."

#. module: eam_alarm
#: code:addons/eam_alarm/models/canh_bao_diem_do.py:0
msgid "%s chưa có số đo nào."
msgstr "%s has no readings yet."

#. module: eam_alarm
#: model_terms:ir.ui.view,arch_db:eam_alarm.view_alarm_form_a12
msgid ""
").\n"
"                    Tới hạn hệ <b>tự bật lại</b> và ghi vào trao đổi —\n"
"                    người hoãn không phải nhớ."
msgstr ""
").\n"
"                    At the deadline the system <b>reopens it</b> and writes a note —\n"
"                    whoever snoozed it does not have to remember."

#. module: eam_alarm
#: model_terms:ir.ui.view,arch_db:eam_alarm.view_alarm_form_a12
msgid ". Xử lý ở cảnh báo gốc."
msgstr ". Handle it on the root alarm."

#. module: eam_alarm
#: model_terms:ir.ui.view,arch_db:eam_alarm.view_eam_alarm_rule_form
msgid ""
"<b>Mất số đọc</b> là đường truyền chết, không\n"
"                                phải máy chết. Việc phải làm là kiểm tra kết\n"
"                                nối — đừng cử người leo trụ."
msgstr ""
"<b>No readings</b> means the link is dead, not the\n"
"                                machine. The thing to do is check the\n"
"                                connection — do not send anyone up the tower."

#. module: eam_alarm
#: model_terms:ir.ui.view,arch_db:eam_alarm.view_eam_alarm_rule_form
msgid ""
"<b>Tạo ngay</b> chỉ nên dùng cho mức nghiêm\n"
"                            trọng. Một đầu đo bị nhiễu nổ 500 cảnh báo một\n"
"                            đêm sẽ thành 500 lệnh rác, và sau đó không ai\n"
"                            đọc danh sách lệnh nữa — kể cả lệnh thật."
msgstr ""
"<b>Create at once</b> should be reserved for critical\n"
"                            severity. One noisy sensor raising 500 alarms in a\n"
"                            night becomes 500 junk orders, after which nobody\n"
"                            reads the order list any more — real ones included."

#. module: eam_alarm
#: model_terms:ir.ui.view,arch_db:eam_alarm.view_eam_alarm_rule_form
msgid ""
"<b>Đồng hồ đứng im</b> là số đọc vẫn về đều\n"
"                                mà giờ chạy không tăng: máy dừng thật. Khác\n"
"                                hẳn mất số đọc — lẫn hai cái là chạy nhầm\n"
"                                hướng."
msgstr ""
"<b>Meter stalled</b> means readings keep arriving\n"
"                                while the running hours do not increase: the\n"
"                                machine really is down. Quite different from\n"
"                                no readings — confusing the two sends you the\n"
"                                wrong way."

