<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_progress_uom_list" model="ir.ui.view">
        <field name="name">rp.progress.uom.list</field>
        <field name="model">rp.progress.uom</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_rp_progress_uom" model="ir.actions.act_window">
        <field name="name">Đơn vị tính (Xây dựng)</field>
        <field name="res_model">rp.progress.uom</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
