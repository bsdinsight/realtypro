<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eam_availability_day_list" model="ir.ui.view">
        <field name="name">eam.availability.day.list</field>
        <field name="model">eam.availability.day</field>
        <field name="arch" type="xml">
            <list string="Khả dụng theo ngày"
                  decoration-warning="so_khoang_chua_tinh &gt; 0"
                  decoration-muted="not do_duoc_sl">
                <field name="date"/>
                <field name="plant_id"/>
                <field name="kd_thoi_gian"/>
                <field name="kd_san_luong"/>
                <field name="luy_ke_thang"/>
                <field name="luy_ke_nam" optional="show"/>
                <field name="so_may_kha_dung"/>
                <field name="so_don_vi" optional="hide"/>
                <field name="mau_so_doan" optional="show"/>
                <field name="gio_dung" sum="Giờ dừng"/>
                <field name="gio_chua_quy" sum="Chưa quy" optional="show"/>
                <field name="sl_that" sum="Thực"/>
                <field name="sl_mat" sum="Mất"/>
                <field name="sl_dang_le" sum="Đáng lẽ" optional="hide"/>
                <field name="so_khoang_chua_tinh" optional="show"/>
                <field name="nguon_sl" optional="hide"/>
                <field name="ly_do_chua_do"/>
                <field name="dai_kd" optional="hide"/>
                <field name="can_cu" optional="hide"/>
                <field name="do_duoc_sl" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_eam_availability_day_form" model="ir.ui.view">
        <field name="name">eam.availability.day.form</field>
        <field name="model">eam.availability.day</field>
        <field name="arch" type="xml">
            <form string="Khả dụng ngày">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Theo thời gian">
                            <field name="kd_thoi_gian"/>
                            <field name="so_don_vi"/>
                            <field name="mau_so_doan"/>
                            <field name="gio_ky"/>
                            <field name="gio_dung"/>
                            <field name="gio_chua_quy"/>
                            <field name="so_may_kha_dung"/>
                        </group>
                        <group string="Theo sản lượng">
                            <field name="do_duoc_sl" invisible="1"/>
                            <field name="kd_san_luong"
                                   invisible="not do_duoc_sl"/>
                            <field name="sl_that" invisible="not do_duoc_sl"/>
                            <field name="sl_mat" invisible="not do_duoc_sl"/>
                            <field name="sl_dang_le"
                                   invisible="not do_duoc_sl"/>
                            <field name="nguon_sl" invisible="not do_duoc_sl"/>
                            <field name="ly_do_chua_do"
                                   invisible="do_duoc_sl"/>
                            <field name="so_khoang_chua_tinh"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="so_khoang_chua_tinh == 0">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Ngày này có <field name="so_khoang_chua_tinh"
                        readonly="1" class="oe_inline"/> khoảng dừng chưa
                        tính được sản lượng mất. Mẫu số thiếu đúng phần
                        đó, nên <b>khả dụng đang cao hơn sự thật</b>.
                    </div>
                    <group string="Luỹ kế — cộng tử số rồi chia tổng mẫu số,
                                   KHÔNG trung bình phần trăm các ngày">
                        <field name="luy_ke_thang"/>
                        <field name="luy_ke_nam"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eam_availability_day_search" model="ir.ui.view">
        <field name="name">eam.availability.day.search</field>
        <field name="model">eam.availability.day</field>
        <field name="arch" type="xml">
            <search string="Khả dụng theo ngày">
                <field name="plant_id"/>
                <field name="date"/>
                <filter name="f_d_date" string="Ngày" date="date"/>
                <separator/>
                <filter name="f_chua_do" string="Chưa đo được sản lượng"
                        domain="[('do_duoc_sl', '=', False)]"/>
                <filter name="f_thieu" string="Còn khoảng chưa tính kWh"
                        domain="[('so_khoang_chua_tinh', '>', 0)]"/>
                <separator/>
                <filter name="g_nm" string="Nhà máy"
                        context="{'group_by': 'plant_id'}"/>
                <filter name="g_thang" string="Tháng"
                        context="{'group_by': 'date:month'}"/>
                <!-- Pane lọc. Ba ô này chọn bằng cách ĐẾM trên 63 ngày
                     thật, không chọn theo cảm giác:

                       nhà máy       DG123 32 · PV50 29 · SAVA1 2
                       dải khả dụng  ≥98% 58 · 95–98% 3 · 90–95% 2
                       căn cứ        đủ 56 · chưa quy 5 · thiếu SL 2

                     Bị loại, kèm lý do:
                       mẫu số hệ đoán       63/63 cùng một giá trị
                       khoảng chưa tính kWh 63/63 cùng một giá trị
                       nguồn sản lượng      là Char. Pane chỉ nhận
                                            many2one / many2many /
                                            selection; nhét Char vào
                                            thì MỌI màn dùng chung view
                                            tìm kiếm này chết lúc mở,
                                            không phải lúc nạp module.
                       công ty              một công ty

                     KHÔNG khai `expand` ở ô nhà máy: `expand` bắt liệt
                     kê mọi bản ghi eam.location (1.335 vị trí), vượt
                     hạn mức 200 và pane vẽ ra một ô RỖNG mà không báo
                     gì — đã dính đúng vậy ở Sản lượng theo bậc đo. -->
                <searchpanel view_types="list,kanban,pivot,graph">
                    <field name="plant_id" string="Nhà máy"
                           icon="fa-industry" enable_counters="1"/>
                    <field name="dai_kd" string="Dải khả dụng"
                           select="multi" icon="fa-tachometer"
                           enable_counters="1"/>
                    <field name="can_cu" string="Căn cứ con số"
                           select="multi" icon="fa-check-square-o"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_eam_availability_day" model="ir.actions.act_window">
        <field name="name">Khả dụng theo ngày</field>
        <field name="res_model">eam.availability.day</field>
        <field name="view_mode">list,form</field>
        <!-- Ghim view tìm kiếm: không ghim thì Odoo chọn "mặc định"
             theo `priority,name,id`, cùng priority là so TÊN — một
             module sau thêm search view tên đứng trước là màn này mất
             sạch pane lẫn bộ lọc. Đã dính đúng bẫy đó ở Lệnh công việc. -->
        <field name="search_view_id" ref="view_eam_availability_day_search"/>
        <field name="context">{'search_default_g_nm': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa dựng ngày nào</p>
            <p>Hai con số song song: khả dụng theo <b>thời gian</b> và
            theo <b>sản lượng</b>. Chúng khác nhau, và khác nhiều — một
            tua-bin dừng giữa mùa lặng gió mất gần như không gì, dừng
            giữa mùa gió mạnh mất cả chục nghìn kWh.</p>
        </field>
    </record>

    <menuitem id="menu_eam_availability_day" name="Khả dụng theo ngày"
              parent="eam_core.menu_eam_perf"
              action="action_eam_availability_day" sequence="6"/>

</odoo>
