<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vau_ward_list" model="ir.ui.view">
        <field name="name">vau.ward.list</field>
        <field name="model">vau.ward</field>
        <field name="arch" type="xml">
            <list string="Wards / Communes">
                <field name="code"/>
                <field name="full_name"/>
                <field name="state_id"/>
                <field name="full_name_en" optional="hide"/>
                <field name="code_name" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vau_ward_search" model="ir.ui.view">
        <field name="name">vau.ward.search</field>
        <field name="model">vau.ward</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="full_name"/>
                <field name="state_id"/>
                <field name="code"/>
                <filter string="Province" name="group_state"
                        context="{'group_by': 'state_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_vau_ward" model="ir.actions.act_window">
        <field name="name">Vietnamese Wards</field>
        <field name="res_model">vau.ward</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vau_ward_search"/>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

</odoo>
