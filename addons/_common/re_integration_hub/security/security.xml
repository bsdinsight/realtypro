<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="group_integration_user" model="res.groups">
        <field name="name">Integration User</field>
        <field name="comment">Read access to webhook logs and outbound queue.</field>
    </record>

    <record id="group_integration_admin" model="res.groups">
        <field name="name">Integration Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_integration_user'))]"/>
        <field name="comment">Issue and revoke API keys, retry dead webhooks.</field>
    </record>

</odoo>
