<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Master data: 20 NHTM lớn của Việt Nam (theo danh sách NHNN).
        Mỗi NH có:
          - res.partner (is_bank=True, is_company=True) → dùng cho
            "Ngân hàng / Bên cho vay" trên HĐTD.
          - res.bank (linked partner_id) → dùng cho "Chi nhánh / Mã NH"
            trên HĐTD; có thể tạo thêm record res.bank cho từng chi nhánh.
        noupdate="1" để không ghi đè khi user edit (tên/địa chỉ chi nhánh).
    -->

    <!-- =================== NHTM Nhà nước / Big 4 =================== -->
    <record id="bank_partner_vcb" model="res.partner">
        <field name="name">Ngân hàng TMCP Ngoại thương Việt Nam (Vietcombank)</field>
        <field name="is_company" eval="True"/>
        <field name="is_bank" eval="True"/>
    </record>
    <record id="bank_vcb" model="res.bank">
        <field name="name">Vietcombank</field>
        <field name="bic">BFTVVNVX</field>
        <field name="partner_id" ref="bank_partner_vcb"/>
    </record>

