<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eam_time_category_list" model="ir.ui.view">
        <field name="name">eam.time.category.list</field>
        <field name="model">eam.time.category</field>
        <field name="arch" type="xml">
            <list string="Loại thời gian" expand="1"
                  decoration-danger="counts_as_downtime"
                  decoration-muted="not is_mandatory">
                <field name="code" width="130px"/>
                <field name="complete_name" string="Loại" width="420px"/>
                <field name="priority" string="Ưu tiên" width="100px"/>
                <field name="counts_as_downtime" string="Tính là dừng"/>
                <field name="is_mandatory" string="Bắt buộc"/>
                <field name="is_data_gap" string="Mất dữ liệu" optional="show"/>
                <field name="attributable_to" string="Thường quy cho"
                       optional="show"/>
                <field name="standard_ref" string="Viện dẫn" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_eam_time_category_form" model="ir.ui.view">
        <field name="name">eam.time.category.form</field>
        <field name="model">eam.time.category</field>
        <field name="arch" type="xml">
            <form string="Loại thời gian">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" class="oe_inline"/>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="complete_name"/>
                            <field name="standard_ref"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="counts_as_downtime"/>
                            <field name="is_mandatory"/>
                            <field name="is_data_gap"/>
                            <field name="attributable_to"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="status"
                         invisible="counts_as_downtime">
                        Loại này <b>không</b> tính là thời gian dừng. Ví dụ
                        điển hình: cắt giảm do ràng buộc lưới — máy vẫn
                        đang hoạt động, chỉ phát một phần.
                    </div>
                    <group string="Ghi chú"><field name="note" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_eam_time_category" model="ir.actions.act_window">
        <field name="name">Loại thời gian</field>
        <field name="res_model">eam.time.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
