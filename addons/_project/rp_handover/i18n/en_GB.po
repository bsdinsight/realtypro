#. module: rp_handover
#: model_terms:ir.ui.view,arch_db:rp_handover.view_re_project_form_handover
msgid ""
"Có vị trí <b>đã qua cổng nghiệm thu mà chưa bàn\n"
"                        giao</b>. Mỗi trụ như vậy là một đồng hồ bảo hành\n"
"                        chưa ai bấm bắt đầu — và bảo hành chỉ đếm từ lúc\n"
"                        có người ghi nhận."
msgstr ""
"Some locations have <b>passed the acceptance gate but not been\n"
"                        handed over</b>. Each one is a warranty clock nobody has\n"
"                        started — and warranty only counts from the moment someone\n"
"                        records it."

