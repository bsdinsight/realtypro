msgid "Cam kết"
msgstr "Commitment"

#. module: eam_om_contract
#. odoo-python
#: code:addons/eam_om_contract/models/eam_om_commitment.py:0
msgid "Cam kết \"%(n)s\" trỏ tới nhà máy \"%(p)s\" không nằm trong phạm vi hợp đồng. Thêm nhà máy đó vào phạm vi trước, nếu không cam kết sẽ không bao giờ sinh dòng kết quả nào."
msgstr "Commitment \"%(n)s\" points at plant \"%(p)s\", which is not within the contract scope. Add that plant to the scope first, otherwise the commitment will never produce a result row."

#. module: eam_om_contract
#. odoo-python
#: code:addons/eam_om_contract/models/eam_om_commitment.py:0
msgid "Cam kết \"%(n)s\" đo bằng phần trăm nên mức phải nằm trong 0–100, đang nhận %(m)s."
msgstr "Commitment \"%(n)s\" is measured as a percentage, so the level has to lie between 0 and 100; it is %(m)s."

#. module: eam_om_contract
#. odoo-python
#: code:addons/eam_om_contract/models/eam_om_commitment.py:0
msgid "Cam kết \"%s\" có mức âm."
msgstr "Commitment \"%s\" has a negative level."

#. module: eam_om_contract
#. odoo-python
#: code:addons/eam_om_contract/models/eam_om_commitment.py:0
msgid "Cam kết \"%s\" khai có chế tài nhưng mức phạt bằng 0 — mọi kỳ không đạt sẽ ra khoản phạt bằng 0 mà không có gì báo. Để \"Không phạt\" nếu hợp đồng không có chế tài."
msgstr "Commitment \"%s\" declares a penalty regime but the rate is 0 — every period that fails produces a penalty of 0 with nothing to say so. Set \"No penalty\" if the contract has no regime."

