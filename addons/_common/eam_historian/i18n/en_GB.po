#. module: eam_historian
#: model_terms:ir.ui.view,arch_db:eam_historian.view_eam_tag_form
msgid ""
"<b>Cách gộp có thể đang sai.</b> Điện năng luỹ kế\n"
"                        gộp bằng trung bình ra một con số vô nghĩa; hướng\n"
"                        gió gộp bằng trung bình số học ra NGƯỢC hướng thật\n"
"                        (trung bình của 350° và 10° là 180°); trạng thái\n"
"                        0/1 lấy trung bình thì không có nghĩa gì. Đây là\n"
"                        chỗ sai <b>im lặng</b> nhất — biểu đồ vẫn mượt."
msgstr ""
"<b>The aggregation may be wrong.</b> Averaging a\n"
"                        cumulative energy counter gives a meaningless number;\n"
"                        averaging wind direction arithmetically points the\n"
"                        OPPOSITE way (the mean of 350° and 10° is 180°); averaging\n"
"                        a 0/1 state means nothing at all. This is the\n"
"                        <b>quietest</b> mistake of all — the chart still looks\n"
"                        smooth."

#. module: eam_historian
#: model_terms:ir.ui.view,arch_db:eam_historian.view_eam_power_curve_form
msgid ""
"<b>Kiểu điều khiển quyết định hiệu chỉnh CÁI GÌ.</b>\n"
"                        Tua-bin <i>pitch</i> thì chuẩn hoá <b>tốc độ gió</b>\n"
"                        theo căn bậc ba của tỷ số mật độ; tua-bin\n"
"                        <i>stall</i> thì chuẩn hoá <b>công suất</b>. Làm\n"
"                        ngược chiều là sai cả đường cong."
msgstr ""
"<b>The control type decides WHAT is corrected.</b>\n"
"                        A <i>pitch</i> turbine normalises <b>wind speed</b> by the\n"
"                        cube root of the density ratio; a <i>stall</i> turbine\n"
"                        normalises <b>power</b>. Do it the other way round and the\n"
"                        whole curve is wrong."

