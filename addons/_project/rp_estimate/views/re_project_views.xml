<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_project_form_tender" model="ir.ui.view">
        <field name="name">re.project.form.tender</field>
        <field name="model">re.project</field>
        <field name="inherit_id" ref="re_base.view_re_project_form"/>
        <field name="arch" type="xml">
            <!-- Nút để KHÔNG ẩn khi bằng 0: dự án chưa có gói thầu nào
                 mới là lúc cần nút nhất. Ẩn đi thì người dùng phải biết
                 trước là có menu Gói thầu ở đâu đó rồi tự lọc. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mo_goi_thau" type="object"
                        class="oe_stat_button" icon="fa-gavel">
                    <field name="tender_package_count" widget="statinfo"
                           string="Gói thầu"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
