<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_rp" model="ir.ui.view">
        <field name="name">purchase.order.form.rp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rp_project_id"/>
                <field name="rp_request_id" readonly="1"
                       invisible="not rp_request_id"/>
            </field>
            <div name="button_box" position="inside">
                <button name="action_rp_mo_nghiem_thu" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        invisible="rp_receipt_count == 0">
                    <field name="rp_receipt_count" widget="statinfo"
                           string="Nghiệm thu"/>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']"
                   position="before">
                <field name="rp_project_id" column_invisible="1"/>
                <field name="rp_cost_category_id" optional="show"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_list_rp" model="ir.ui.view">
        <field name="name">purchase.order.list.rp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rp_project_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Danh sách riêng cho Đơn mua của chủ đầu tư: danh sách lõi của
         Odoo không khai expand, mà action này mở sẵn ở chế độ gom theo
         Dự án — nên vào màn chỉ thấy dòng tiêu đề nhóm. -->
    <record id="view_purchase_order_list_procure" model="ir.ui.view">
        <field name="name">purchase.order.list.procure</field>
        <field name="model">purchase.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Đơn mua" expand="1" default_order="date_order desc">
                <field name="name" string="Số đơn"/>
                <field name="date_order" string="Ngày đặt"/>
                <field name="rp_project_id" string="Dự án" optional="hide"/>
                <field name="rp_request_id" string="Yêu cầu" optional="show"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="date_planned" string="Dự kiến nhận"
                       optional="show"/>
                <field name="amount_untaxed" width="190"
                       string="Trước thuế" sum="Σ"/>
                <field name="amount_total" width="190" string="Tổng" sum="Σ"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="rp_receipt_count" string="Nghiệm thu"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'sent')"
                       decoration-success="state in ('purchase', 'done')"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="action_rp_purchase_order" model="ir.actions.act_window">
        <field name="name">Đơn mua (chủ đầu tư)</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rp_project_id', '!=', False)]</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="search_view_id"
               ref="view_purchase_order_search_procure"/>
        <field name="view_id" ref="view_purchase_order_list_procure"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có đơn mua nào gắn dự án
            </p>
            <p>
                Chủ đầu tư nhà máy điện không mua vật tư — nhà thầu mua.
                Màn này dành cho phần chủ đầu tư TỰ mua: tư vấn giám sát
                độc lập, bảo hiểm công trình, kiểm định, chi phí ban quản
                lý dự án.
            </p>
        </field>
    </record>

    <record id="view_purchase_order_search_rp" model="ir.ui.view">
        <field name="name">purchase.order.search.rp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rp_project_id"/>
            </field>
            <!-- Neo vào `my_purchases` — bộ lọc chắc chắn có trong view
                 gốc của Odoo; `draft` thì không tồn tại (tên thật là
                 `draft_rfqs`). -->
            <filter name="my_purchases" position="before">
                <filter name="group_project" string="Dự án"
                        context="{'group_by': 'rp_project_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Chuyển từ Tài chính sang nhánh gốc "Mua sắm": để trong Tài
         chính thì người dùng tưởng phân hệ này nhỏ, mà quy mô thật của
         nó nằm ở 25 năm vận hành chứ không ở hai năm xây dựng. -->
    <menuitem id="menu_rp_purchase_order" name="Đơn mua"
              parent="menu_procurement"
              action="action_rp_purchase_order" sequence="20"/>
</odoo>
