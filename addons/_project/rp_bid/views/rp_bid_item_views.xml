<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rp_bid_item_list" model="ir.ui.view">
        <field name="name">rp.bid.item.list</field>
        <field name="model">rp.bid.item</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  decoration-bf="is_section"
                  decoration-muted="is_section"
                  decoration-warning="structure_count == 0 and not is_section">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="uom_text"/>
                <field name="quantity_client"/>
                <field name="takeoff_quantity" optional="show"
                       readonly="1"/>
                <field name="is_section" optional="hide"/>
                <field name="structure_count" optional="show" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cost_direct" width="185px" optional="hide"
                       readonly="1"/>
                <field name="cost_spread" width="185px" optional="show"
                       readonly="1"/>
                <field name="cost_total" width="185px" optional="hide"
                       readonly="1"/>
                <field name="cost_share" optional="hide" readonly="1"/>
                <field name="unit_price_offer" width="185px" readonly="1"/>
                <field name="amount_offer" sum="Σ" width="200px" readonly="1"/>
                <field name="client_supplied_cost" width="185px"
                       optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_rp_bid_item_form" model="ir.ui.view">
        <field name="name">rp.bid.item.form</field>
        <field name="model">rp.bid.item</field>
        <field name="arch" type="xml">
            <form string="Dòng chào giá">
                <sheet>
                    <group>
                        <group string="Theo file mời thầu (giữ nguyên)">
                            <field name="bid_id" options="{'no_create': True}"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="uom_text"/>
                            <field name="quantity_client"/>
                            <field name="is_section"/>
                        </group>
                        <group string="Giá chào" invisible="is_section">
                            <field name="currency_id" invisible="1"/>
                            <field name="cost_direct"/>
                            <field name="cost_spread"/>
                            <field name="cost_total"/>
                            <field name="cost_share"/>
                            <field name="amount_offer"/>
                            <field name="unit_price_offer"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="client_supplied_cost"/>
                            <field name="takeoff_quantity"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="is_section or structure_count &gt; 0">
                        Chưa có hạng mục nào cuộn vào dòng này nên
                        <b>đơn giá chào đang bằng 0</b>. Mở tab Hạng mục của
                        hồ sơ và đặt cột <b>Dòng chào giá</b> cho các hạng mục
                        thuộc phần việc này.
                    </div>
                    <notebook>
                        <page string="Hạng mục cuộn vào" name="structs">
                            <field name="structure_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="direct_cost" sum="Σ" width="185px"/>
                                    <field name="client_supplied_cost"
                                           sum="Σ" width="185px"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ghi chú" name="note">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rp_bid_item_search" model="ir.ui.view">
        <field name="name">rp.bid.item.search</field>
        <field name="model">rp.bid.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="bid_id"/>
                <filter name="f_nostruct" string="Chưa có hạng mục cuộn vào"
                        domain="[('structure_count', '=', 0), ('is_section', '=', False)]"/>
                <filter name="f_real" string="Bỏ dòng tiêu đề"
                        domain="[('is_section', '=', False)]"/>
                <group>
                    <filter name="g_bid" string="Hồ sơ dự thầu"
                            context="{'group_by': 'bid_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rp_bid_item" model="ir.actions.act_window">
        <field name="name">Bảng giá chào</field>
        <field name="res_model">rp.bid.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_bid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có dòng chào giá nào</p>
            <p>Mở hồ sơ dự thầu và bấm <b>Nhập BoQ mời thầu</b> để đọc thẳng
               file Excel khách gửi. Đây là bảng phải gửi lại khách, nên giữ
               nguyên mã, nội dung và đơn vị của họ.</p>
        </field>
    </record>

    <!-- ===== Wizard nhập Excel ===== -->
    <record id="action_rp_bid_import" model="ir.actions.act_window">
        <field name="name">Nhập BoQ mời thầu từ Excel</field>
        <field name="res_model">rp.bid.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_rp_bid_import_form" model="ir.ui.view">
        <field name="name">rp.bid.import.form</field>
        <field name="model">rp.bid.import</field>
        <field name="arch" type="xml">
            <form string="Nhập BoQ mời thầu">
                <group invisible="state != 'upload'">
                    <field name="state" invisible="1"/>
                    <field name="bid_id" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="sheet_name"
                           placeholder="Bỏ trống = sheet đầu tiên"/>
                    <field name="header_row"/>
                    <field name="replace_existing"/>
                </group>
                <div class="alert alert-info small" role="alert"
                     invisible="state != 'upload'">
                    Đọc file <b>.xlsx / .xlsm</b> của bên mời thầu. Hệ thống tự
                    dò dòng tiêu đề theo các cột <b>Nội dung · Đơn vị · Khối
                    lượng</b>; dò sai thì điền số dòng tiêu đề rồi xem trước
                    lại. Dòng tiêu đề nhóm (A, B, C…) vẫn được giữ vì hồ sơ
                    nộp lại phải đúng bộ khung của khách.
                </div>
                <group invisible="state != 'preview'">
                    <field name="preview" nolabel="1" widget="text"
                           readonly="1" style="font-family: monospace;"/>
                </group>
                <footer>
                    <button name="action_preview" type="object"
                            string="Xem trước" class="btn-primary"
                            invisible="state == 'preview'"/>
                    <button name="action_preview" type="object"
                            string="Dò lại" class="btn-secondary"
                            invisible="state != 'preview'"/>
                    <button name="action_import" type="object"
                            string="Nhập vào hồ sơ" class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button special="cancel" string="Huỷ"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
