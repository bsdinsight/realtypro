#. module: eam_daily_report
#: model_terms:ir.ui.view,arch_db:eam_daily_report.view_report_form
msgid ""
"Còn ô <b>bắt buộc</b> để trống — chốt sẽ bị chặn\n"
"                        và nói rõ ô nào. Những ô ấy được đánh dấu bắt\n"
"                        buộc vì để trống thì tờ báo cáo mất nghĩa."
msgstr ""
"A <b>mandatory</b> field is still empty — closing will be\n"
"                        blocked, and will say which one. Those fields are marked\n"
"                        mandatory because leaving them empty makes the report\n"
"                        meaningless."

