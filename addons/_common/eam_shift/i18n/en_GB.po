#: model:ir.model.fields,help:eam_shift.field_eam_shift_pattern__gio_bat_dau
msgid "Giờ trong ngày, ví dụ 6.0 là 6h00, 14.5 là 14h30."
msgstr "The hour of the day: 6.0 is 06:00, 14.5 is 14:30."

#. module: eam_shift
#: model_terms:ir.actions.act_window,help:eam_shift.action_eam_shift
msgid ""
"Khai <b>mẫu ca</b> trước, rồi sinh ca cho một dải ngày. Mở\n"
"            ca là hệ chụp trạng thái nhà máy và kéo việc dở của ca trước\n"
"            sang — <b>không có gì rơi giữa hai ca</b>."
msgstr ""
"Declare the <b>shift pattern</b> first, then generate shifts for a range\n"
"            of days. Opening a shift makes the system capture the plant's state and\n"
"            pull the previous shift's unfinished work across — <b>nothing falls\n"
"            between two shifts</b>."

#. module: eam_shift
#: model_terms:ir.actions.act_window,help:eam_shift.action_eam_shift_pattern
