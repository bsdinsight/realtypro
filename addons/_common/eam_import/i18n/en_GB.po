msgid "; × hệ số %s"
msgstr "; × factor %s"

#. module: eam_import
#: model_terms:ir.ui.view,arch_db:eam_import.view_eam_import_template_form
msgid ""
"<b>Hệ số</b> — tờ báo cáo ghi MWh, bảng của\n"
"                                ta lưu kWh, nên hệ số là 1000. Thiếu nó thì\n"
"                                255 MWh thành 255 kWh: một phần nghìn, mà\n"
"                                con số vẫn dương và trông hợp lý.\n"
"                                <br/><b>Chỉ đối chiếu</b> — dòng mang kết\n"
"                                quả nhà máy tự tính (PR, mẫu số, hệ số\n"
"                                nhiệt). Đọc lên, so với số hệ tính ra, ghi\n"
"                                khoảng lệch vào nhật ký, <b>không ghi vào\n"
"                                dữ liệu</b>. Mỗi lượt nạp là một lần công\n"
"                                thức của ta được kiểm bằng số của chính họ."
msgstr ""
"<b>Factor</b> — the report is in MWh while our\n"
"                                table stores kWh, so the factor is 1000.\n"
"                                Without it, 255 MWh becomes 255 kWh: a\n"
"                                thousandth, while the figure stays positive\n"
"                                and looks plausible.\n"
"                                <br/><b>Cross-check only</b> — a line\n"
"                                carrying the plant's own results (PR,\n"
"                                denominator, temperature factor). Read it,\n"
"                                compare it with the system's figure, record\n"
"                                the difference in the log, <b>do not write it\n"
"                                into the data</b>. Every import is an occasion\n"
"                                on which our formula is checked against their\n"
"                                own figures."

#. module: eam_import
#: model_terms:ir.ui.view,arch_db:eam_import.view_eam_import_run_form
msgid ""
"<i class=\"fa fa-flask me-1\"/>\n"
"                        Đây là kết quả <b>chạy thử</b>: mọi phép ghi đã được\n"
"                        thực hiện rồi cuộn lại, nên nhật ký bên dưới đúng\n"
"                        bằng những gì lượt nạp thật sẽ làm — kể cả phần đối\n"
"                        chiếu. <b>Chưa có gì vào cơ sở dữ liệu.</b>"
msgstr ""
"<i class=\"fa fa-flask me-1\"/>\n"
"                        These are the results of a <b>dry run</b>: every write was\n"
"                        performed and then rolled back, so the log below is exactly\n"
"                        what a real import would do — the cross-check included.\n"
"                        <b>Nothing has reached the database.</b>"

#. module: eam_import
#: model_terms:ir.ui.view,arch_db:eam_import.view_eam_import_template_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                        Trong tờ biểu, <b>cột chứa số đổi theo dòng</b> vì\n"
"                        vùng trộn của nhãn dài ngắn khác nhau. Ở tờ báo cáo\n"
"                        thật, khối khí tượng có giá trị ở cột <b>P</b> còn\n"
"                        khối tổn thất ngay bên dưới lại ở cột <b>O</b>. Nên\n"
"                        mỗi dòng phải khai <b>đúng ô</b>, đừng suy theo\n"
"                        \"giá trị luôn ở cột bên phải\".\n"
"                        <br/>Khai nhầm vào giữa một vùng trộn thì Excel trả\n"
"                        về rỗng mà <b>không báo gì</b> — nhật ký nạp sẽ nói\n"
"                        giá trị thật nằm ở ô nào."
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                        In a form sheet, <b>the column holding the figure changes\n"
"                        from row to row</b>, because the merged regions of long and\n"
"                        short labels differ. In a real report the weather block has\n"
"                        its values in column <b>P</b> while the loss block just\n"
"                        below has them in column <b>O</b>. So every line has to\n"
"                        declare <b>the exact cell</b>; do not assume \"the value is\n"
"                        always in the column to the right\".\n"
"                        <br/>Point at the middle of a merged region and Excel\n"
"                        returns empty <b>with nothing to say so</b> — the import log\n"
"                        will tell you which cell actually holds the value."

#. module: eam_import
