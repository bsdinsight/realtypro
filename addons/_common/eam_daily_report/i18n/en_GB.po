#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" khai nguồn công thức thì phải viết công thức."
msgstr "Line \"%s\" declares a formula source, so a formula has to be written."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" là khối dựng sẵn thì phải chọn khối nào."
msgstr "Line \"%s\" is a built-in block, so a block has to be chosen."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy hằng số nhà máy thì phải khai tên trường trên hồ sơ nhà máy."
msgstr "Line \"%s\" takes a plant constant, so a field name on the plant record is required."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy mục tiêu thì phải chọn mức P50, P75 hay P90 — \"mục tiêu\" không kèm mức là câu nói dở."
msgstr "Line \"%s\" takes a target, so P50, P75 or P90 has to be chosen — \"target\" without a level is only half a sentence."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy số từ một bảng có sẵn thì phải khai tên trường."
msgstr "Line \"%s\" takes its figure from an existing table, so a field name is required."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy theo kỳ thì phải khai CẢ kỳ lẫn tên trường — \"doanh thu\" không kèm kỳ là câu nói dở."
msgstr "Line \"%s\" takes a figure by period, so BOTH the period and the field name are required — \"revenue\" without a period is only half a sentence."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy từ bảng tổ máy thì phải khai lấy ô nào của dòng TỔNG."
msgstr "Line \"%s\" takes from the unit table, so it has to say which field of the TOTAL row to use."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy từ chuỗi bậc đo thì phải khai tên trường. Mã bậc để trống nghĩa là cộng mọi bậc sản lượng."
msgstr "Line \"%s\" takes from the metering chain, so a field name is required. An empty stage code means summing every energy stage."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy từ kho chuỗi thời gian thì phải khai mã điểm đo."
msgstr "Line \"%s\" takes from the time-series store, so a tag code is required."

#. module: eam_daily_report
#. odoo-python
#: code:addons/eam_daily_report/models/eam_daily_profile.py:0
msgid "Dòng \"%s\" lấy từ một công-tơ thì phải khai mã vị trí đặt công-tơ ấy."
msgstr "Line \"%s\" takes from a single meter, so the code of the location holding that meter is required."

#. module: eam_daily_report
#: model_terms:ir.ui.view,arch_db:eam_daily_report.khoi_bang_to_may
msgid ""
"Dòng TỔNG cộng tử số và mẫu số rồi mới chia, không phải trung\n"
"            bình các phần trăm — <b>trừ cột của hãng</b>: đó là số hãng\n"
"            gửi sang, không kèm tử/mẫu để cộng, nên TỔNG của nó là trung\n"
"            bình các phần trăm và KHÔNG so trực tiếp được với hai cột\n"
"            bên trái."
msgstr ""
"The TOTAL row sums numerators and denominators before dividing, rather than\n"
"            averaging percentages — <b>except the vendor column</b>: that figure comes\n"
"            from the vendor with no numerator or denominator to sum, so its TOTAL is an\n"
"            average of percentages and is NOT directly comparable with the two columns\n"
"            to its left."

