msgid "MTBF (giờ chạy)"
msgstr "MTBF (running hours)"

#. module: eam_pm
#: model_terms:ir.actions.act_window,help:eam_pm.action_eam_reliability
msgid ""
"MTBF chia cho <b>giờ máy chạy</b>, không phải giờ theo\n"
"            lịch: máy ít chạy mà hay hỏng thì lấy giờ lịch sẽ trông bền\n"
"            hơn máy chạy khoẻ. Không có đồng hồ giờ chạy thì để\n"
"            <b>trống</b>, không thay bằng giờ lịch."
msgstr ""
"MTBF divides by <b>running hours</b>, not calendar hours: a machine\n"
"            that runs little and fails often looks more reliable on calendar hours\n"
"            than one working hard. Without a running-hour meter, leave it\n"
"            <b>empty</b> rather than substituting calendar hours."

#. module: eam_pm
#: model:ir.model.fields,field_description:eam_pm.field_eam_reliability__mttr_hours
#: model_terms:ir.ui.view,arch_db:eam_pm.view_eam_maint_kpi_list
#: model_terms:ir.ui.view,arch_db:eam_pm.view_eam_reliability_list
msgid "MTTR (giờ sửa)"
msgstr "MTTR (repair hours)"

#. module: eam_pm
#: model_terms:ir.actions.act_window,help:eam_pm.action_eam_maint_kpi
msgid ""
"MTTR <b>không</b> tính giờ chờ cẩu, chờ vật tư, chờ lặng\n"
"            gió — phần đó nằm ở MDT. Khoảng cách giữa hai số là\n"
"            <b>chi phí hậu cần</b>, không phải tay nghề thợ; gộp vào là\n"
"            đổ lỗi nhầm người."
msgstr ""
"MTTR does <b>not</b> count hours waiting for a crane, for materials,\n"
"            for the wind to drop — that part sits in MDT. The gap between the two is\n"
"            the <b>cost of logistics</b>, not of the fitters' skill; merging them\n"
"            blames the wrong people."

