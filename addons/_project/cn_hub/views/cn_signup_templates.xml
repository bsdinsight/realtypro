.rpn-logo-mark{width:34px;height:34px;border-radius:8px;background:linear-gradient(150deg,var(--rpn-mint),var(--rpn-teal));display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rpn-logo span{color:var(--rpn-mint)}
.rpn-back{margin-left:auto;font-size:14px;font-weight:600;opacity:.9}
.rpn-main{padding:32px 0 70px}
.rpn-grid{display:grid;grid-template-columns:1fr;gap:26px}
@media(min-width:940px){.rpn-grid{grid-template-columns:1.35fr .85fr;gap:36px;align-items:start}}
