<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Gói thầu ===== -->
    <record id="view_cn_tender_list" model="ir.ui.view">
        <field name="name">cn.tender.list</field>
        <field name="model">cn.tender</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('closed','cancelled')"
                  decoration-success="state == 'awarded'">
                <field name="name"/>
                <field name="gc_partner_id"/>
                <field name="specialty" optional="show"/>
                <field name="budget" optional="show"/>
                <field name="deadline"/>
                <field name="bid_count" string="Dự thầu"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'awarded'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cn_tender_form" model="ir.ui.view">
        <field name="name">cn.tender.form</field>
        <field name="model">cn.tender</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object"
                            string="Mở mời thầu" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_add_default_reqs" type="object"
                            string="Nạp checklist mặc định"
                            invisible="doc_req_ids != []"/>
                    <button name="action_send_all_invites" type="object"
                            string="Gửi tất cả thư mời" class="btn-primary"
                            invisible="state == 'draft'"
                            confirm="Gửi thư mời cho tất cả nhà thầu chưa gửi?"/>
                    <button name="action_close" type="object"
                            string="Đóng thầu"
                            invisible="state != 'open'"/>
                    <button name="action_evaluate" type="object"
                            string="Chấm thầu / Xếp hạng" class="btn-primary"
                            invisible="state not in ('open','closed')"/>
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="state in ('awarded','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bids" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="bid_count" widget="statinfo"
                                   string="Dự thầu"/>
                        </button>
                        <button name="action_view_invites" type="object"
                                class="oe_stat_button" icon="fa-envelope">
                            <field name="invite_count" widget="statinfo"
                                   string="Thư mời"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên gói thầu..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="gc_partner_id"/>
                            <field name="specialty"/>
                            <field name="budget"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_open"/>
                            <field name="deadline"/>
                            <field name="ref"/>
                            <field name="gc_source" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Mô tả / phạm vi..."/>
                    <notebook>
                        <page string="Hồ sơ mời thầu" name="dossier">
                            <p class="text-muted">Tài liệu cung cấp cho nhà thầu tải về (BOQ, bản vẽ, chỉ dẫn kỹ thuật, điều kiện HĐ...).</p>
                            <field name="dossier_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="attachment" filename="filename"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tài liệu yêu cầu nộp" name="doc_req">
                            <p class="text-muted">Danh mục tài liệu nhà thầu phải nộp cùng báo giá.</p>
                            <field name="doc_req_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="required"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Thư mời thầu" name="invites">
                            <field name="invite_ids">
                                <list editable="bottom"
                                      decoration-success="state in ('registered','viewed','submitted')"
                                      decoration-muted="state == 'declined'">
                                    <field name="partner_name"/>
                                    <field name="email"/>
                                    <field name="partner_id" readonly="1" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                    <field name="invited_date" readonly="1" optional="show"/>
                                    <field name="invite_url" widget="CopyClipboardChar"
                                           readonly="1" optional="show"/>
                                    <button name="action_send_invite" type="object"
                                            string="Gửi mời" icon="fa-paper-plane"
                                            class="btn-link"
                                            invisible="state != 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Chấm thầu (cấu hình)" name="eval_config">
                            <group>
                                <group>
                                    <field name="eval_method"/>
                                    <field name="tech_threshold"/>
                                    <field name="tech_weight"
                                           invisible="eval_method != 'tech_combined'"/>
                                    <field name="price_weight"
                                           invisible="eval_method != 'tech_combined'"/>
                                </group>
                                <group>
                                    <field name="criteria_template"/>
                                    <button name="action_load_tech_criteria" type="object"
                                            string="Nạp bộ tiêu chí" icon="fa-download"
                                            class="btn-link"/>
                                </group>
                            </group>
                            <field name="tech_criterion_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weight" sum="Σ"/>
                                    <field name="min_pct"/>
                                </list>
                            </field>
                        </page>
                        <page string="Hồ sơ dự thầu / Xếp hạng" name="bids">
                            <field name="bid_ids"
                                   default_order="rank, evaluated_price, price">
                                <list decoration-success="eval_state == 'ranked1'"
                                      decoration-info="rank == 1"
                                      decoration-muted="eval_state == 'failed'">
                                    <field name="rank"/>
                                    <field name="contractor_id"/>
                                    <field name="price" sum="Σ"/>
                                    <field name="evaluated_price" optional="show"/>
                                    <field name="tech_score_pct" optional="show"/>
                                    <field name="tech_passed" optional="show"/>
                                    <field name="total_score"
                                           optional="hide"/>
                                    <field name="document_count" string="TL"/>
                                    <field name="eval_state" widget="badge"/>
                                    <field name="state" widget="badge" optional="hide"/>
                                    <button name="action_award" type="object"
                                            string="Trao thầu" icon="fa-trophy"
                                            class="btn-link"
                                            invisible="state == 'awarded'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cn_tender_search" model="ir.ui.view">
        <field name="name">cn.tender.search</field>
        <field name="model">cn.tender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="gc_partner_id"/>
                <field name="specialty"/>
                <filter name="f_open" string="Đang mời thầu"
                        domain="[('state','=','open')]"/>
                <filter name="f_awarded" string="Đã trao thầu"
                        domain="[('state','=','awarded')]"/>
                <group>
                    <filter name="g_state" string="Trạng thái"
                            context="{'group_by':'state'}"/>
                    <filter name="g_gc" string="Tổng thầu"
                            context="{'group_by':'gc_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cn_tender" model="ir.actions.act_window">
        <field name="name">Gói thầu</field>
        <field name="res_model">cn.tender</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cn_tender_search"/>
    </record>

    <!-- ===== Hồ sơ dự thầu ===== -->
    <record id="view_cn_bid_list" model="ir.ui.view">
        <field name="name">cn.bid.list</field>
        <field name="model">cn.bid</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'awarded'"
                  decoration-muted="state == 'rejected'">
                <field name="tender_id"/>
                <field name="contractor_id"/>
                <field name="price" sum="Σ"/>
                <field name="date_submit"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cn_bid_form" model="ir.ui.view">
        <field name="name">cn.bid.form</field>
        <field name="model">cn.bid</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_shortlist" type="object"
                            string="Vào danh sách ngắn"
                            invisible="state != 'submitted'"/>
                    <button name="action_award" type="object"
                            string="Trao thầu" class="btn-primary"
                            invisible="state == 'awarded'"/>
                    <button name="action_reject" type="object"
                            string="Loại"
                            invisible="state in ('awarded','rejected')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tender_id"/>
                            <field name="contractor_id"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_submitted"/>
                            <field name="submitted_date"
                                   invisible="not is_submitted"/>
                            <field name="date_submit"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Thuyết minh dự thầu..."/>
                    <notebook>
                        <page string="Tài liệu nộp" name="documents">
                            <field name="document_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="req_id" optional="hide"/>
                                    <field name="attachment" filename="filename"/>
                                    <field name="filename" column_invisible="1"/>
                                    <field name="upload_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Kế hoạch thi công" name="schedule">
                            <field name="schedule_task_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="wbs_code"/>
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="progress_percent"/>
                                    <field name="is_milestone"/>
                                    <field name="predecessors" optional="hide"/>
                                    <field name="external_uid" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Đánh giá / Chấm điểm" name="evaluation">
                            <group>
                                <group string="Cửa Đạt / Không đạt">
                                    <field name="eligible"/>
                                    <field name="capacity_passed"/>
                                    <field name="tech_score_pct" readonly="1"/>
                                    <field name="tech_passed" readonly="1"/>
                                </group>
                                <group string="Tài chính (giá đánh giá)">
                                    <field name="price_corrected"/>
                                    <field name="deviation_missing"/>
                                    <field name="deviation_surplus"/>
                                    <field name="evaluated_price" readonly="1"/>
                                    <field name="price_over_limit" readonly="1"/>
                                </group>
                            </group>
                            <group string="Kết quả">
                                <group>
                                    <field name="price_score" readonly="1"/>
                                    <field name="total_score" readonly="1"/>
                                </group>
                                <group>
                                    <field name="rank" readonly="1"/>
                                    <field name="eval_state" readonly="1"/>
                                </group>
                            </group>
                            <button name="action_prepare_scores" type="object"
                                    string="Nạp tiêu chí chấm điểm" class="btn-link"
                                    icon="fa-refresh"/>
                            <field name="tech_score_ids">
                                <list editable="bottom">
                                    <field name="criterion_id"/>
                                    <field name="weight"/>
                                    <field name="min_pct"/>
                                    <field name="score"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== Thư mời thầu ===== -->
    <record id="view_cn_invite_list" model="ir.ui.view">
        <field name="name">cn.tender.invite.list</field>
        <field name="model">cn.tender.invite</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('registered','viewed','submitted')"
                  decoration-muted="state == 'declined'"
                  editable="bottom">
                <field name="tender_id"/>
                <field name="partner_name"/>
                <field name="email"/>
                <field name="state" widget="badge"/>
                <field name="invited_date" readonly="1"/>
                <field name="invite_url" widget="CopyClipboardChar" readonly="1"/>
                <button name="action_send_invite" type="object"
                        string="Gửi mời" icon="fa-paper-plane" class="btn-link"
                        invisible="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_cn_invite_form" model="ir.ui.view">
        <field name="name">cn.tender.invite.form</field>
        <field name="model">cn.tender.invite</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_invite" type="object"
                            string="Gửi thư mời" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_tender" type="object"
                            string="Mở gói thầu"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tender_id"/>
                            <field name="partner_name"/>
                            <field name="email"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invited_date" readonly="1"/>
                            <field name="invite_url" widget="CopyClipboardChar"
                                   readonly="1"/>
                        </group>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cn_bid" model="ir.actions.act_window">
        <field name="name">Hồ sơ dự thầu</field>
        <field name="res_model">cn.bid</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
