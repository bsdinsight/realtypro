<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Realty Project suite root menu + Phase 2 v1.4.1 submenu containers.

        IMPORTANT: this file reuses `menu_realty_project_root` xmlid
        from the iter5 placeholder so Odoo treats it as an update of
        the existing record rather than creating a duplicate. This is
        the v1.4.1 fix for the "two Realty Project menus" bug seen on
        the dev DB.

        Phase 2 submenu containers:
        - menu_project_master   (master data, sequence 5)
        - menu_estimate_workflows  (cost plans, sequence 10)

        Iter5 placeholder modules (rp_construction, rp_boq, rp_handover)
        are uninstalled before this deploys; their submenus are removed
        from the DB by Odoo's standard uninstall behavior.
    -->

    <!-- Suite root — reuses iter5 xmlid to REPLACE not duplicate -->
    <menuitem id="menu_realty_project_root"
              name="Realty Project"
              web_icon="rp_estimate,static/description/icon.png"
              sequence="20"
              groups="re_base.group_re_user"/>

    <!-- Project Master submenu (master data — sequence 5) -->
    <menuitem id="menu_project_master"
              name="Project Master"
              parent="menu_realty_project_root"
              sequence="5"/>

    <!-- Estimate submenu (cost plan workflows — sequence 10) -->
    <menuitem id="menu_estimate_workflows"
              name="Estimate"
              parent="menu_realty_project_root"
              sequence="10"/>

    <!-- ===== Tài chính (Finance) — container, sequence 12 =====
         Con đầu tiên (seq 5) là Dashboard Tài chính (module rp_finance)
         → nhấp "Tài chính" trên navbar mở thẳng dashboard.
         Các module con tự mount vào đây:
         - rp_estimate:        Khái toán (10)
         - rp_finance:         Dashboard (5), Dự toán BOQ (20),
                               Hoá đơn nhà thầu (40), Hồ sơ thanh toán (50),
                               Thanh toán (60)
         - rp_advance_payment: Tạm ứng (30)
         - rp_contract:        2 báo cáo → menu_finance_reports (90) -->
    <menuitem id="menu_finance"
              name="Tài chính"
              parent="menu_realty_project_root"
              sequence="12"/>

    <menuitem id="menu_finance_reports"
              name="Báo cáo"
              parent="menu_finance"
              sequence="90"/>

    <!-- ===== Xây dựng (Construction) — container, sequence 30 =====
         Nhấp "Xây dựng" mở Dashboard Xây dựng (con seq 5, module
         rp_construction). Các module mount vào:
         - rp_construction: Dashboard (5), Báo cáo (menu_construction_reports)
         - rp_schedule:     Lịch thi công (10)
         - rp_progress:     Tiến độ (20)
         - rp_site:         Hiện trường (30)
         - rp_rfi:          RFI & Trình duyệt (40) -->
    <menuitem id="menu_construction"
              name="Xây dựng"
              parent="menu_realty_project_root"
              sequence="30"/>

    <menuitem id="menu_construction_reports"
              name="Báo cáo"
              parent="menu_construction"
              sequence="90"/>

    <!-- ===== Cấu hình (Realty Project) — master data ít đụng =====
         Cost Categories + Danh mục chi phí chuẩn mount vào đây
         (menus.xml). Group manager — nhất quán Realty Core > Configuration. -->
    <menuitem id="menu_rp_configuration"
              name="Cấu hình"
              parent="menu_realty_project_root"
              sequence="95"
              groups="re_base.group_re_manager"/>

</odoo>
