<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thẻ trên trang /my của nhà thầu -->
    <template id="portal_my_home_cn" inherit_id="portal.portal_my_home"
              name="Portal My Home: Construction Network">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Gói thầu đang mời</t>
                <t t-set="url" t-value="'/my/tenders'"/>
                <t t-set="text">Xem gói thầu mở &amp; nộp hồ sơ dự thầu</t>
                <t t-set="config_card" t-value="True"/>
                <t t-set="count" t-value="cn_tender_count"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Hồ sơ dự thầu của tôi</t>
                <t t-set="url" t-value="'/my/bids'"/>
                <t t-set="text">Theo dõi hồ sơ dự thầu đã nộp</t>
                <t t-set="config_card" t-value="True"/>
                <t t-set="count" t-value="cn_bid_count"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Hồ sơ năng lực nhà thầu</t>
                <t t-set="url" t-value="'/my/contractor'"/>
                <t t-set="text">Khai năng lực (nhân sự, thiết bị, kinh nghiệm, tài chính)</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- Danh sách gói thầu đang mở -->
    <template id="portal_my_tenders" name="Gói thầu đang mời">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3 class="mb-3">Gói thầu đang mời thầu</h3>
                <t t-if="not tenders">
                    <p class="text-muted">Hiện chưa có gói thầu nào đang mở.</p>
                </t>
                <table t-if="tenders" class="table table-hover">
                    <thead>
                        <tr>
                            <th>Gói thầu</th>
                            <th>Tổng thầu</th>
                            <th>Chuyên môn</th>
                            <th>Hạn nộp</th>
                            <th class="text-end">Dự toán</th>
                            <th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="tenders" t-as="t">
                            <td><a t-attf-href="/my/tenders/{{t.id}}"
                                   t-esc="t.name"/></td>
                            <td t-esc="t.gc_partner_id.name or '—'"/>
                            <td t-esc="t.specialty or '—'"/>
                            <td t-field="t.deadline"/>
                            <td class="text-end">
                                <span t-field="t.budget"
                                      t-options="{'widget': 'monetary', 'display_currency': t.currency_id}"/>
                            </td>
                            <td class="text-end">
                                <a t-attf-href="/my/tenders/{{t.id}}"
                                   class="btn btn-sm btn-primary">Dự thầu</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Chi tiết gói thầu + hồ sơ mời thầu + form dự thầu -->
    <template id="portal_tender_detail" name="Chi tiết gói thầu">
        <t t-call="portal.portal_layout">
            <div class="o_portal_my_doc">
                <t t-if="request.params.get('submitted')">
                    <div class="alert alert-success">
                        <i class="fa fa-check-circle"/> Đã nộp hồ sơ dự thầu chính thức. Đã thông báo cho bên mời thầu.
                    </div>
                </t>
                <t t-if="request.params.get('sched')">
                    <div class="alert alert-info">Đã nạp kế hoạch thi công.</div>
                </t>
                <t t-if="request.params.get('err')">
                    <div class="alert alert-danger" style="white-space:pre-line"
                         t-esc="request.params.get('err')"/>
                </t>
                <h3 t-esc="tender.name"/>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><b>Bên mời thầu:</b>
                           <span t-esc="tender.gc_partner_id.name or '—'"/></p>
                        <p><b>Chuyên môn:</b>
                           <span t-esc="tender.specialty or '—'"/></p>
                        <p><b>Hạn nộp:</b>
                           <span t-field="tender.deadline"/></p>
                    </div>
                    <div class="col-md-6">
                        <p><b>Dự toán:</b>
                           <span t-field="tender.budget"
                                 t-options="{'widget': 'monetary', 'display_currency': tender.currency_id}"/></p>
                        <p><b>Trạng thái:</b>
                           <span t-field="tender.state"/></p>
                    </div>
                </div>
                <div class="mb-3" t-if="tender.description">
                    <b>Mô tả / phạm vi:</b>
                    <p t-esc="tender.description"/>
                </div>

                <!-- Hồ sơ mời thầu (tải về) -->
                <div class="card mb-3" t-if="tender.dossier_ids">
                    <div class="card-header"><b>Hồ sơ mời thầu</b> (tải về)</div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center"
                            t-foreach="tender.dossier_ids" t-as="doc">
                            <span>
                                <i class="fa fa-file-o me-2"/>
                                <span t-esc="doc.name"/>
                                <small class="text-muted ms-2" t-esc="dict(doc._fields['category'].selection).get(doc.category)"/>
                            </span>
                            <a t-attf-href="/my/tenders/{{tender.id}}/dossier/{{doc.id}}"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="fa fa-download"/> Tải
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Form nộp hồ sơ dự thầu -->
                <div class="card" t-if="tender.state == 'open'">
                    <div class="card-header">
                        <b><t t-if="existing_bid">Cập nhật hồ sơ dự thầu</t><t t-else="">Nộp hồ sơ dự thầu</t></b>
                    </div>
                    <div class="card-body">
                        <form t-attf-action="/my/tenders/{{tender.id}}/bid"
                              method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label class="form-label"><b>Giá dự thầu</b> <span t-field="tender.currency_id.symbol"/></label>
                                <input type="number" step="any" name="price"
                                       class="form-control"
                                       t-att-value="existing_bid.price if existing_bid else ''"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Thuyết minh</label>
                                <textarea name="note" class="form-control"
                                          rows="3"
                                          t-esc="existing_bid.note if existing_bid else ''"/>
                            </div>

                            <t t-if="tender.doc_req_ids">
                                <h6 class="mt-3">Tài liệu yêu cầu</h6>
                                <div class="mb-3" t-foreach="tender.doc_req_ids" t-as="req">
                                    <label class="form-label">
                                        <span t-esc="req.name"/>
                                        <span t-if="req.required" class="badge bg-danger ms-1">bắt buộc</span>
                                        <t t-set="done" t-value="submitted_docs.get(req.id)"/>
                                        <span t-if="done" class="badge bg-success ms-1">
                                            <i class="fa fa-check"/> <span t-esc="done.filename"/>
                                        </span>
                                    </label>
                                    <small t-if="req.note" class="text-muted d-block" t-esc="req.note"/>
                                    <input type="file" t-attf-name="req_{{req.id}}"
                                           class="form-control"/>
                                </div>
                            </t>

                            <div class="mb-3">
                                <label class="form-label">Tài liệu bổ sung (có thể chọn nhiều)</label>
                                <input type="file" name="extra_files" multiple="multiple"
                                       class="form-control"/>
                            </div>

                            <button type="submit" class="btn btn-outline-primary">
                                <i class="fa fa-save"/> Lưu nháp
                            </button>
                        </form>
                    </div>
                </div>
                <div t-else="" class="alert alert-info">
                    Gói thầu này không còn nhận hồ sơ dự thầu.
                </div>

                <!-- Kế hoạch thi công -->
                <div class="card mt-3" t-if="tender.state == 'open'">
                    <div class="card-header"><b>Kế hoạch thi công</b></div>
                    <div class="card-body">
                        <p class="text-muted mb-2">
                            Nạp từ MS Project (xuất XML) hoặc tải template Excel,
                            điền rồi upload. Có thể sửa lại sau khi nạp.
                        </p>
                        <a t-attf-href="/my/tenders/{{tender.id}}/schedule/template"
                           class="btn btn-sm btn-outline-secondary mb-2">
                            <i class="fa fa-download"/> Tải template Excel
                        </a>
                        <form t-attf-action="/my/tenders/{{tender.id}}/schedule/import"
                              method="post" enctype="multipart/form-data" class="d-flex gap-2">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="file" name="schedule_file"
                                   accept=".xml,.xlsx" class="form-control form-control-sm"/>
                            <button type="submit" class="btn btn-sm btn-secondary">Nạp kế hoạch</button>
                        </form>
                        <t t-if="existing_bid and existing_bid.schedule_task_ids">
                            <table class="table table-sm mt-3">
                                <thead><tr><th>WBS</th><th>Công việc</th><th>Bắt đầu</th><th>Kết thúc</th><th>%</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="existing_bid.schedule_task_ids" t-as="tk">
                                        <td t-esc="tk.wbs_code or ''"/>
                                        <td><t t-if="tk.is_milestone"><i class="fa fa-flag text-warning me-1"/></t><t t-esc="tk.name"/></td>
                                        <td t-field="tk.date_start"/>
                                        <td t-field="tk.date_end"/>
                                        <td><t t-esc="int(tk.progress_percent)"/>%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>

                <!-- Nộp hồ sơ chính thức -->
                <div class="card mt-3 border-primary"
                     t-if="existing_bid and tender.state == 'open'">
                    <div class="card-body text-center">
                        <t t-if="existing_bid.is_submitted">
                            <span class="badge bg-success fs-6">
                                <i class="fa fa-check"/> Đã nộp hồ sơ chính thức
                                (<span t-field="existing_bid.submitted_date"/>)
                            </span>
                            <p class="text-muted mt-2 mb-0">Bạn vẫn có thể cập nhật &amp; nộp lại trước hạn.</p>
                        </t>
                        <form t-attf-action="/my/tenders/{{tender.id}}/submit" method="post">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-primary btn-lg mt-2">
                                <i class="fa fa-paper-plane"/> Nộp hồ sơ dự thầu chính thức
                            </button>
                        </form>
                        <p class="text-muted mt-2 mb-0" style="font-size:12px">
                            Hệ thống kiểm tra đủ tài liệu bắt buộc rồi thông báo cho bên mời thầu.
                        </p>
                    </div>
                </div>

                <!-- Tài liệu đã nộp -->
                <div class="card mt-3" t-if="existing_bid and existing_bid.document_ids">
                    <div class="card-header"><b>Tài liệu đã nộp</b></div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item" t-foreach="existing_bid.document_ids" t-as="d">
                            <i class="fa fa-file-o me-2"/>
                            <span t-esc="d.name"/>
                            <small class="text-muted ms-2" t-esc="dict(d._fields['doc_type'].selection).get(d.doc_type)"/>
                        </li>
                    </ul>
                </div>
            </div>
        </t>
    </template>

    <!-- Hồ sơ dự thầu của tôi -->
    <template id="portal_my_bids" name="Hồ sơ dự thầu của tôi">
        <t t-call="portal.portal_layout">
            <div class="o_portal_my_doc_table">
                <h3 class="mb-3">Hồ sơ dự thầu của tôi</h3>
                <t t-if="not bids">
                    <p class="text-muted">Bạn chưa nộp hồ sơ dự thầu nào.</p>
                </t>
                <table t-if="bids" class="table">
                    <thead>
                        <tr>
                            <th>Gói thầu</th>
                            <th class="text-end">Giá dự thầu</th>
                            <th>Ngày nộp</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="bids" t-as="b">
                            <td><a t-attf-href="/my/tenders/{{b.tender_id.id}}"
                                   t-esc="b.tender_id.name"/></td>
                            <td class="text-end">
                                <span t-field="b.price"
                                      t-options="{'widget': 'monetary', 'display_currency': b.currency_id}"/>
                            </td>
                            <td t-field="b.date_submit"/>
                            <td><span t-field="b.state"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Hồ sơ năng lực nhà thầu: profile + PoQ (Excel round-trip) -->
    <template id="portal_contractor" name="Hồ sơ năng lực nhà thầu">
        <t t-call="portal.portal_layout">
            <div class="o_portal_my_doc">
                <t t-if="request.params.get('saved')">
                    <div class="alert alert-success">Đã lưu hồ sơ năng lực.</div>
                </t>
                <t t-if="request.params.get('imported')">
                    <div class="alert alert-success">
                        Đã nạp <t t-esc="request.params.get('imported')"/> dòng từ file PoQ.
                    </div>
                </t>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Hồ sơ năng lực nhà thầu</h3>
                    <span class="badge bg-info">Hoàn thiện <t t-esc="partner.cn_profile_progress"/>%</span>
                </div>

                <!-- Profile -->
                <form action="/my/contractor/save" method="post" class="card mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="card-header"><b>Thông tin &amp; năng lực tài chính</b></div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-2"><label>Mã số thuế</label>
                                <input name="cn_tax_code" class="form-control" t-att-value="partner.cn_tax_code or ''"/></div>
                            <div class="col-md-6 mb-2"><label>Số ĐKKD</label>
                                <input name="cn_reg_number" class="form-control" t-att-value="partner.cn_reg_number or ''"/></div>
                            <div class="col-md-6 mb-2"><label>Người đại diện pháp luật</label>
                                <input name="cn_legal_rep" class="form-control" t-att-value="partner.cn_legal_rep or ''"/></div>
                            <div class="col-md-6 mb-2"><label>Chức danh</label>
                                <input name="cn_legal_rep_title" class="form-control" t-att-value="partner.cn_legal_rep_title or ''"/></div>
                            <div class="col-md-6 mb-2"><label>Năm thành lập</label>
                                <input type="number" name="cn_founded_year" class="form-control" t-att-value="partner.cn_founded_year or ''"/></div>
                            <div class="col-md-6 mb-2"><label>Loại hình DN</label>
                                <select name="cn_company_type" class="form-select">
                                    <option value="">—</option>
                                    <t t-foreach="partner._fields['cn_company_type'].selection" t-as="opt">
                                        <option t-att-value="opt[0]" t-att-selected="'selected' if partner.cn_company_type == opt[0] else None" t-esc="opt[1]"/>
                                    </t>
                                </select></div>
                            <div class="col-md-4 mb-2"><label>Doanh thu XD bình quân/năm</label>
                                <input type="number" step="any" name="cn_avg_revenue" class="form-control" t-att-value="partner.cn_avg_revenue or ''"/></div>
                            <div class="col-md-4 mb-2"><label>Nguồn lực tài chính</label>
                                <input type="number" step="any" name="cn_financial_resource" class="form-control" t-att-value="partner.cn_financial_resource or ''"/></div>
                            <div class="col-md-4 mb-2"><label>Tài sản ròng</label>
                                <input type="number" step="any" name="cn_net_asset" class="form-control" t-att-value="partner.cn_net_asset or ''"/></div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-3"><div class="form-check"><input type="checkbox" class="form-check-input" name="cn_independent_accounting" t-att-checked="'checked' if partner.cn_independent_accounting else None"/><label class="form-check-label">Hạch toán độc lập</label></div></div>
                            <div class="col-md-3"><div class="form-check"><input type="checkbox" class="form-check-input" name="cn_not_banned" t-att-checked="'checked' if partner.cn_not_banned else None"/><label class="form-check-label">Không bị cấm thầu</label></div></div>
                            <div class="col-md-3"><div class="form-check"><input type="checkbox" class="form-check-input" name="cn_not_bankrupt" t-att-checked="'checked' if partner.cn_not_bankrupt else None"/><label class="form-check-label">Không phá sản</label></div></div>
                            <div class="col-md-3"><div class="form-check"><input type="checkbox" class="form-check-input" name="cn_registered_egp" t-att-checked="'checked' if partner.cn_registered_egp else None"/><label class="form-check-label">Đã ĐK mạng đấu thầu</label></div></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Lưu hồ sơ</button>
                    </div>
                </form>

                <!-- PoQ Excel round-trip -->
                <div class="card mb-3">
                    <div class="card-header"><b>Bảng năng lực (PoQ)</b> — nhân sự · thiết bị · kinh nghiệm · doanh thu</div>
                    <div class="card-body">
                        <p class="text-muted">Tải template Excel (đã có sẵn dữ liệu hiện tại) → điền/sửa → upload để cập nhật.</p>
                        <a href="/my/contractor/poq/template" class="btn btn-outline-secondary btn-sm mb-2">
                            <i class="fa fa-download"/> Tải template PoQ (.xlsx)
                        </a>
                        <form action="/my/contractor/poq/import" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="file" name="poq_file" accept=".xlsx" class="form-control form-control-sm"/>
                            <button type="submit" class="btn btn-secondary btn-sm">Nạp PoQ</button>
                        </form>
                        <div class="row mt-3 text-center">
                            <div class="col"><h4 t-esc="len(partner.cn_personnel_ids)"/><small class="text-muted">Nhân sự</small></div>
                            <div class="col"><h4 t-esc="len(partner.cn_equipment_ids)"/><small class="text-muted">Thiết bị</small></div>
                            <div class="col"><h4 t-esc="len(partner.cn_experience_ids)"/><small class="text-muted">HĐ tương tự</small></div>
                            <div class="col"><h4 t-esc="len(partner.cn_revenue_year_ids)"/><small class="text-muted">Năm doanh thu</small></div>
                            <div class="col"><h4 t-esc="len(partner.cn_certificate_ids)"/><small class="text-muted">Chứng chỉ</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
