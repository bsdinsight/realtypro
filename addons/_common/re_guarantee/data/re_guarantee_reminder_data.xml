<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Số ngày nhắc trước và khoảng lặp lại — sửa ở Cấu hình →
             Tham số hệ thống, không phải sửa mã. -->
        <record id="param_expiry_lead_days" model="ir.config_parameter">
            <field name="key">re_guarantee.expiry_lead_days</field>
            <field name="value">30</field>
        </record>
        <record id="param_expiry_repeat_days" model="ir.config_parameter">
            <field name="key">re_guarantee.expiry_repeat_days</field>
            <field name="value">7</field>
        </record>

        <record id="mail_template_guarantee_expiry" model="mail.template">
            <field name="name">Bảo lãnh sắp hết hạn</field>
            <field name="model_id" ref="model_re_bank_guarantee"/>
            <field name="subject">[Bảo lãnh] {{ object.name }} hết hạn ngày {{ object.date_expiry }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.pic_user_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;font-size:14px">
                    <p>Chào <t t-out="object.pic_user_id.name or ''"></t>,</p>
                    <p>Chứng thư bảo lãnh dưới đây sắp hết hạn:</p>
                    <table style="border-collapse:collapse">
                        <tr><td style="padding:3px 12px 3px 0">Số chứng thư</td>
                            <td><b t-out="object.name or ''"></b></td></tr>
                        <tr><td style="padding:3px 12px 3px 0">Ngân hàng phát hành</td>
                            <td t-out="object.issuing_bank_partner_id.name or ''"></td></tr>
                        <tr><td style="padding:3px 12px 3px 0">Bên thụ hưởng</td>
                            <td t-out="object.beneficiary_partner_id.name or ''"></td></tr>
                        <tr><td style="padding:3px 12px 3px 0">Giá trị</td>
                            <td t-out="format_amount(object.amount, object.currency_id)"></td></tr>
                        <tr><td style="padding:3px 12px 3px 0">Ngày hết hạn</td>
                            <td><b t-out="object.date_expiry"></b></td></tr>
                    </table>
                    <p>Nếu cần gia hạn, lập phụ lục trên chứng thư trước ngày hết hạn.</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="cron_guarantee_expiry_reminder" model="ir.cron">
            <field name="name">Bảo lãnh: nhắc sắp hết hạn</field>
            <field name="model_id" ref="model_re_bank_guarantee"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
