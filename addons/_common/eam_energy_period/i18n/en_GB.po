msgstr "EAMOne: build the energy periods"

#. module: eam_energy_period
#: model_terms:ir.ui.view,arch_db:eam_energy_period.view_period_form
msgid ""
"Hệ KHÔNG cộng ngày thiếu thành 0,\n"
"                        nên con số dưới đây <b>nhỏ hơn thật</b> — đừng\n"
"                        đem so với một kỳ đủ ngày mà chưa trừ phần này."
msgstr ""
"The system does NOT add the missing days as 0,\n"
"                        so the figure below is <b>lower than reality</b> — do not\n"
"                        compare it with a complete period without allowing for\n"
"                        this."

