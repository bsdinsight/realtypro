<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search -->
    <record id="view_rp_tender_package_search" model="ir.ui.view">
        <field name="name">rp.tender.package.search</field>
        <field name="model">rp.tender.package</field>
        <field name="arch" type="xml">
            <search string="Gói thầu">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="scope_summary" string="Phạm vi"/>
                <separator/>
                <filter name="draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Đã duyệt KH"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="inviting" string="Đang mời thầu"
                        domain="[('state', '=', 'inviting')]"/>
                <filter name="evaluating" string="Đang đánh giá"
                        domain="[('state', 'in', ['bid_closed','evaluating','negotiating'])]"/>
                <filter name="awarded" string="Đã có KQ / đang ký HĐ"
                        domain="[('state', 'in', ['awarded','contracted'])]"/>
                <filter name="closed" string="Đã đóng"
                        domain="[('state', '=', 'closed')]"/>
                <filter name="cancelled" string="Đã hủy"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="overdue" string="Quá hạn ký HĐ"
                        domain="[('is_deadline_overdue', '=', True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Dự án" name="group_project"
                        context="{'group_by': 'project_id'}"/>
                <filter string="Hình thức" name="group_method"
                        context="{'group_by': 'selection_method'}"/>
                <filter string="Nhà thầu" name="group_contractor"
                        context="{'group_by': 'contractor_id'}"/>
                <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- List -->
    <record id="view_rp_tender_package_list" model="ir.ui.view">
        <field name="name">rp.tender.package.list</field>
        <field name="model">rp.tender.package</field>
        <field name="arch" type="xml">
            <list string="Gói thầu" sample="1"
                  decoration-muted="state in ('closed','cancelled') or not active"
                  decoration-success="state == 'contracted'"
                  decoration-warning="state in ('inviting','bid_closed','evaluating','negotiating')"
                  decoration-info="state == 'awarded'"
                  decoration-danger="is_deadline_overdue and state not in ('contracted','closed','cancelled')">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="selection_method" optional="show"/>
                <field name="deadline_contract" optional="show"/>
                <field name="days_to_deadline" optional="hide"/>
                <field name="is_deadline_overdue" column_invisible="1"/>
                <field name="subzone_coverage" string="Khu vực" optional="hide"/>
                <field name="contractor_id" optional="show"/>
                <field name="line_count" string="Hạng mục" optional="hide"/>
                <field name="max_approved_price" widget="monetary" optional="show"/>
                <field name="award_amount" widget="monetary" optional="show"/>
                <field name="contract_amount" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_rp_tender_package_form" model="ir.ui.view">
        <field name="name">rp.tender.package.form</field>
        <field name="model">rp.tender.package</field>
        <field name="arch" type="xml">
            <form string="Gói thầu">
                <header>
                    <button name="action_approve_plan" string="Duyệt KH"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_invite" string="Phát hành HSMT"
                            type="object" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_close_bid" string="Đóng thầu"
                            type="object" class="btn-primary"
                            invisible="state != 'inviting'"
                            confirm="Đóng thầu? Sau bước này không nhận thêm HSDT."/>
                    <button name="action_evaluate" string="Mở thầu + Đánh giá"
                            type="object" class="btn-primary"
                            invisible="state != 'bid_closed'"/>
                    <button name="action_negotiate" string="Thương thảo"
                            type="object" class="btn-primary"
                            invisible="state != 'evaluating'"/>
                    <button name="action_award" string="Có KQ trúng thầu"
                            type="object" class="btn-primary"
                            invisible="state != 'negotiating'"
                            confirm="Chốt nhà thầu trúng?"/>
                    <button name="action_contract" string="Ký HĐ"
                            type="object" class="btn-primary"
                            invisible="state != 'awarded'"/>
                    <button name="action_close" string="Đóng gói thầu"
                            type="object" class="btn-warning"
                            invisible="state != 'contracted'"
                            confirm="Đóng gói thầu — đã hoàn tất?"/>
                    <button name="action_cancel" string="Hủy gói thầu"
                            type="object" class="btn-danger"
                            invisible="state in ('closed','cancelled')"
                            confirm="Hủy gói thầu? Hành động này phải có lý do trong audit log."/>
                    <button name="action_reset_to_draft" string="Reset → Draft"
                            type="object"
                            invisible="state == 'draft'"
                            groups="re_base.group_re_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,inviting,bid_closed,evaluating,negotiating,awarded,contracted,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_open_bidders"
                                icon="fa-users"
                                invisible="bidder_count == 0">
                            <field name="bidder_count" widget="statinfo"
                                   string="Nhà thầu"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_bidders"
                                icon="fa-trophy"
                                invisible="not awarded_bidder_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Trúng thầu</span>
                                <field name="awarded_bidder_id"
                                       readonly="1"/>
                            </div>
                        </button>
                        <field name="awarded_bidder_id" invisible="1"/>
                        <button class="oe_stat_button" type="object"
                                name="action_open_eval_criteria"
                                icon="fa-list-alt"
                                invisible="eval_criterion_count == 0">
                            <field name="eval_criterion_count"
                                   widget="statinfo"
                                   string="Tiêu chí"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Gói thầu MEP - Tower S1+S2"/>
                        </h1>
                        <div>
                            <label for="code" class="oe_edit_only"/>
                            <field name="code" placeholder="e.g. PKG-MEP-001"/>
                        </div>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="not is_deadline_overdue or state in ('contracted','closed','cancelled')">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <b>Quá hạn ký HĐ</b> — PTDA giao deadline <field name="deadline_contract" readonly="1" class="d-inline"/>, đã trễ <field name="days_to_deadline" readonly="1" class="d-inline"/> ngày.
                    </div>

                    <group>
                        <group string="Thông tin chung">
                            <field name="project_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="subzone_filter_id"
                                   options="{'no_create': True}"
                                   help="UX filter cho việc add lines - không restrict gói thầu."/>
                            <!-- KHÔNG required tĩnh theo state: record cũ/import thiếu data
                                 sẽ đỏ ngay khi mở form. Validate đã nằm ở _require_fields
                                 trong các action chuyển trạng thái. -->
                            <field name="selection_method"/>
                            <field name="deadline_contract"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Tài chính">
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                            <field name="estimated_amount" widget="monetary"/>
                            <field name="max_approved_price" widget="monetary"/>
                            <field name="award_amount" widget="monetary"
                                   invisible="state in ('draft','approved','inviting','bid_closed')"/>
                            <field name="contract_amount" widget="monetary"
                                   invisible="state in ('draft','approved','inviting','bid_closed','evaluating','negotiating')"/>
                            <field name="bidder_partner_ids" invisible="1"/>
                            <field name="contractor_id"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   invisible="state in ('draft','approved','inviting','bid_closed','evaluating','negotiating')"/>
                            <field name="line_count" readonly="1"/>
                            <field name="subzone_coverage" readonly="1"/>
                            <field name="days_to_deadline" invisible="1"/>
                            <field name="is_deadline_overdue" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Kế hoạch lựa chọn NT" name="plan">
                            <group>
                                <group string="Mốc thời gian KH">
                                    <field name="date_rfp_issue"/>
                                    <field name="date_bid_close"/>
                                    <field name="date_bid_open"/>
                                </group>
                                <group string="Đánh giá &amp; ký HĐ">
                                    <field name="date_eval_done"/>
                                    <field name="date_negotiation_done"/>
                                    <field name="date_award_signed"/>
                                </group>
                            </group>
                            <div class="text-muted mt-2">
                                <i class="fa fa-info-circle me-2"/>
                                Các mốc thời gian theo thứ tự: phát hành HSMT
                                → đóng thầu → mở thầu → đánh giá → thương thảo
                                → phê duyệt + ký HĐ. Ngày ký HĐ phải &lt;= hạn
                                PTDA giao.
                            </div>
                        </page>
                        <page string="Yêu cầu kỹ thuật" name="tech_req">
                            <group>
                                <field name="technical_requirements_html"
                                       nolabel="1"
                                       placeholder="Mô tả phạm vi công việc, khối lượng, bản vẽ thiết kế, yêu cầu chất lượng vật liệu, tiến độ thi công, v.v..."/>
                            </group>
                            <separator string="Chỉ dẫn nhà thầu"/>
                            <field name="instructions_html" nolabel="1"
                                   placeholder="Hướng dẫn chung về thủ tục, điều kiện tham gia, tư cách hợp lệ của nhà thầu..."/>
                        </page>
                        <page string="Tiêu chuẩn đánh giá HSDT"
                              name="eval_criteria">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">
                                    <i class="fa fa-info-circle me-2"/>
                                    3 nhóm theo Luật Đấu thầu VN: Năng lực &amp;
                                    kinh nghiệm / Kỹ thuật / Giá.
                                </span>
                                <button name="action_seed_default_criteria"
                                        type="object"
                                        string="Tạo bộ tiêu chí mẫu"
                                        class="btn btn-sm btn-secondary"
                                        invisible="eval_criterion_count != 0"
                                        confirm="Tạo bộ tiêu chí mẫu theo Luật Đấu thầu VN? Bạn có thể chỉnh sửa sau."/>
                            </div>
                            <field name="eval_criterion_ids"
                                   context="{'default_package_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind" widget="badge"/>
                                    <field name="name"/>
                                    <field name="weight" sum="Tổng trọng số"/>
                                    <field name="is_mandatory"
                                           widget="boolean_toggle"/>
                                    <field name="description"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tài liệu HSMT" name="hsmt_docs">
                            <div class="text-muted mb-2">
                                <i class="fa fa-info-circle me-2"/>
                                Upload bản vẽ thiết kế, biểu mẫu HSDT, HSMT
                                document, etc. Nhà thầu sẽ download các tài
                                liệu này khi mua/nhận HSMT.
                            </div>
                            <field name="hsmt_attachment_ids"
                                   widget="many2many_binary"/>
                        </page>
                        <page string="Danh sách nhà thầu" name="bidders"
                              invisible="state == 'draft'">
                            <div class="alert alert-info" role="alert"
                                 invisible="bidder_count != 0">
                                <i class="fa fa-info-circle me-2"/>
                                Chưa có nhà thầu nào nộp HSDT. Khi nhà thầu
                                nộp hồ sơ, click "Thêm" để ghi nhận.
                            </div>
                            <field name="bidder_ids"
                                   context="{'default_package_id': id}">
                                <list editable="bottom"
                                      decoration-success="status == 'awarded'"
                                      decoration-danger="status == 'disqualified'"
                                      decoration-info="status == 'qualified'"
                                      decoration-muted="status == 'submitted'">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="ranking" string="#"
                                           readonly="1" width="40"/>
                                    <field name="contractor_id"
                                           options="{'no_create': True}"/>
                                    <field name="submitted_date"/>
                                    <field name="technical_score"
                                           widget="float"/>
                                    <field name="technical_pass"
                                           widget="boolean_toggle" readonly="1"
                                           optional="show"/>
                                    <field name="price_offered"
                                           widget="monetary" sum="Tổng giá dự thầu"/>
                                    <field name="status" widget="badge"/>
                                    <field name="disqualification_reason"
                                           optional="hide"/>
                                    <button name="action_qualify" type="object"
                                            string="Đạt KT" icon="fa-check"
                                            invisible="status in ('qualified','awarded','disqualified')"/>
                                    <button name="action_select_as_winner"
                                            type="object" string="Chọn trúng"
                                            class="btn-link"
                                            icon="fa-trophy"
                                            invisible="status in ('disqualified','awarded')"
                                            confirm="Chọn nhà thầu này trúng thầu? Hành động này sẽ cập nhật Nhà thầu trúng + Giá trúng trên gói thầu."/>
                                    <button name="action_disqualify"
                                            type="object" string="Loại"
                                            icon="fa-ban"
                                            invisible="status in ('disqualified','awarded')"
                                            confirm="Loại bidder này? Cần nhập lý do trước."/>
                                </list>
                                <form>
                                    <sheet>
                                        <field name="currency_id" invisible="1"/>
                                        <group>
                                            <group string="Nhà thầu">
                                                <field name="contractor_id"
                                                       options="{'no_create': True}"/>
                                                <field name="partner_id" readonly="1"/>
                                                <field name="submitted_date"/>
                                            </group>
                                            <group string="Đánh giá &amp; giá">
                                                <field name="technical_score"/>
                                                <field name="technical_pass" readonly="1"/>
                                                <field name="price_offered" widget="monetary"/>
                                                <field name="ranking" readonly="1"/>
                                                <field name="status" widget="badge"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="disqualification_reason"
                                                   placeholder="Lý do loại — bắt buộc nếu status = Bị loại"/>
                                            <field name="notes"/>
                                        </group>
                                    </sheet>
                                    <chatter/>
                                </form>
                            </field>
                            <div class="text-muted mt-2"
                                 invisible="bidder_count == 0">
                                <i class="fa fa-info-circle me-2"/>
                                <b>Hạng giá</b>: tự động xếp hạng theo giá thấp
                                nhất trong nhóm chưa bị loại. <b>Điểm KT pass</b>:
                                ngưỡng 70/100. <b>Chọn trúng</b>: đồng bộ ngay
                                Nhà thầu trúng + Giá trúng lên header gói thầu.
                            </div>
                        </page>
                        <page string="Hạng mục" name="lines">
                            <field name="line_ids"
                                   context="{'default_package_id': id,
                                             'default_currency_id': currency_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="project_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <!-- '=?': khi chưa chọn "Lọc theo khu vực" thì KHÔNG lọc
                                         (dự án gắn khu vực cho mọi hạng mục sẽ không bị rỗng) -->
                                    <field name="structure_id"
                                           domain="[('project_id', '=', parent.project_id),
                                                    '|',
                                                    ('subzone_id', '=?', parent.subzone_filter_id),
                                                    ('subzone_id', '=', False)]"
                                           options="{'no_create': True}"/>
                                    <field name="subzone_id" readonly="1" optional="show"/>
                                    <field name="structure_type" readonly="1" optional="hide"/>
                                    <field name="name" string="Mô tả (override)"/>
                                    <field name="estimated_amount" widget="monetary" sum="Total"/>
                                </list>
                                <form>
                                    <sheet>
                                        <field name="project_id" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <group>
                                            <group>
                                                <field name="structure_id"
                                                       domain="[('project_id', '=', project_id)]"
                                                       options="{'no_create': True}"/>
                                                <field name="subzone_id" readonly="1"/>
                                                <field name="structure_type" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="estimated_amount" widget="monetary"/>
                                                <field name="sequence"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="name"/>
                                        </group>
                                        <notebook>
                                            <page string="Ghi chú phạm vi" name="scope">
                                                <field name="scope_note"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Phạm vi gói thầu" name="scope">
                            <field name="scope_summary"
                                   placeholder="Mô tả chi tiết gói thầu (dùng cho RFP/RFQ)..."/>
                        </page>
                        <page string="Mô tả" name="desc">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rp_tender_package" model="ir.actions.act_window">
        <field name="name">Gói thầu</field>
        <field name="res_model">rp.tender.package</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rp_tender_package_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo gói thầu đầu tiên cho dự án.
            </p>
            <p>
                Gói thầu tổng hợp nhiều Hạng mục dự án cho mục đích đấu thầu /
                chỉ định thầu. Mỗi Hạng mục chỉ có thể nằm trong 1 line của
                gói. Có thể chọn lọc theo Khu vực để dễ thêm Hạng mục.
            </p>
            <p>
                Phase 5 sẽ mở rộng: bidding workflow, multiple bidders,
                award + contract linkage, budget rollup.
            </p>
        </field>
    </record>

</odoo>
