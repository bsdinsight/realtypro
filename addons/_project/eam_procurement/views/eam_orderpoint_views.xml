<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_orderpoint_list_eam" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.eam</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <field name="product_max_qty" position="after">
                <field name="eam_request_id" string="Yêu cầu mua"
                       readonly="1" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_orderpoint_tao_yeu_cau" model="ir.actions.server">
        <field name="name">Lập yêu cầu mua (Realty)</field>
        <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_model_id" ref="stock.model_stock_warehouse_orderpoint"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_tao_yeu_cau_mua()</field>
    </record>
</odoo>
