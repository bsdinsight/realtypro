<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit vendor bill form: thêm tab Cấn trừ tạm ứng + field
         amount_residual_after_advance -->
    <record id="view_account_move_form_inherit_advance"
            model="ir.ui.view">
        <field name="name">account.move.form.inherit.advance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_advance_settlements" type="object"
                        class="oe_stat_button" icon="fa-balance-scale"
                        invisible="move_type not in ('in_invoice', 'in_refund')
                                   or advance_settlement_count == 0">
                    <field name="advance_settlement_count" widget="statinfo"
                           string="Cấn trừ Tạm ứng"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Cấn trừ Tạm ứng" name="advance_settlements"
                      invisible="move_type not in ('in_invoice', 'in_refund')">
                    <group>
                        <group>
                            <field name="amount_advance_settled" readonly="1"/>
                            <field name="amount_residual_after_advance"
                                   readonly="1"
                                   decoration-warning="amount_residual_after_advance > 0"
                                   decoration-success="amount_residual_after_advance == 0 and amount_advance_settled > 0"/>
                        </group>
                    </group>
                    <field name="advance_settlement_ids"
                           readonly="state != 'posted'">
                        <list editable="bottom">
                            <field name="advance_id"
                                   domain="[('partner_id', '=', parent.partner_id)]"
                                   options="{'no_create': True}"/>
                            <field name="advance_amount_remaining" width="185px"
                                   string="TƯ còn lại"/>
                            <field name="amount" width="185px" sum="Σ cấn trừ"/>
                            <field name="date"/>
                            <field name="note"/>
                            <field name="user_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
