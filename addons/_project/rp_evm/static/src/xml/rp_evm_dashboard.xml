<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rp_evm.Dashboard">
        <div class="rp-evm">

            <!-- Header -->
            <div class="rp-evm-header">
                <div class="rp-evm-title">
                    <span class="rp-evm-eyebrow">BẢNG ĐIỀU KHIỂN DỰ ÁN · EVM</span>
                    <h2 t-esc="state.data and state.data.project ? state.data.project.name : 'Đang tải…'"/>
                </div>
                <div class="rp-evm-tools">
                    <select class="form-select form-select-sm rp-evm-proj"
                            t-on-change="onSelectProject"
                            t-if="state.data and state.data.projects">
                        <t t-foreach="state.data.projects" t-as="p" t-key="p.id">
                            <option t-att-value="p.id"
                                    t-att-selected="p.id === state.projectId"
                                    t-esc="p.name"/>
                        </t>
                    </select>
                    <span class="rp-evm-today" t-if="state.data and state.data.project">
                        Cập nhật: <b t-esc="state.data.project.today"/>
                    </span>
                    <button class="btn btn-sm btn-outline-secondary"
                            t-on-click="onRefresh" title="Tải lại">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <!-- Loading / error -->
            <div t-if="state.loading" class="rp-evm-loading">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <div>Đang tổng hợp số liệu EVM…</div>
            </div>
            <div t-elif="state.error" class="rp-evm-empty">
                <i class="fa fa-info-circle fa-2x"/>
                <div t-esc="state.error"/>
            </div>

            <!-- Body -->
            <t t-elif="state.data and state.data.ok">

                <!-- Thanh tab: hai câu hỏi khác nhau, không thay nhau được.
                     "Tổng quan" trả lời làm ra bao nhiêu so với chi bao
                     nhiêu; "Tiền" trả lời tháng sau có tiền trả nhà thầu
                     không. -->
                <div class="rp-evm-tabs">
                    <button class="rp-evm-tab" t-att-class="tabClass('tong-quan')"
                            t-on-click="() => this.onTab('tong-quan')">
                        Tổng quan · Chi phí &amp; Tiến độ
                    </button>
                    <button class="rp-evm-tab" t-att-class="tabClass('tien')"
                            t-on-click="() => this.onTab('tien')">
                        Tiền · Tài trợ &amp; Giải ngân
                        <span class="rp-evm-tab-dot" t-if="mk.alert"/>
                    </button>
                    <button class="rp-evm-tab" t-att-class="tabClass('lich')"
                            t-on-click="() => this.onTab('lich')">
                        Đường găng · Tiến độ tới COD
                        <span class="rp-evm-tab-dot"
                              t-if="sk.deadline_slip > 0 or sk.violated_severe"/>
                    </button>
                </div>

                <t t-if="state.tab === 'tong-quan'">

                <!-- KPI cards -->
                <div class="rp-evm-kpis">
                    <div class="rp-evm-card rp-evm-hero" t-att-class="healthClass(k.health)">
                        <div class="rp-evm-card-label">Sức khỏe dự án</div>
                        <div class="rp-evm-card-value">
                            <t t-esc="k.health"/><span class="u">/100</span>
                        </div>
                        <div class="rp-evm-card-sub">
                            CPI <t t-esc="k.cpi.toFixed(2)"/> · SPI <t t-esc="k.spi.toFixed(2)"/>
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Giá trị hợp đồng (BAC)</div>
                        <div class="rp-evm-card-value" t-esc="fmt(k.bac)"/>
                        <div class="rp-evm-card-sub"><t t-esc="k.contract_count"/> gói thầu</div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">% Hoàn thành (EV/BAC)</div>
                        <div class="rp-evm-card-value" t-esc="pct(k.progress_pct)"/>
                        <div class="rp-evm-card-sub">EV <t t-esc="fmt(k.ev)"/></div>
                    </div>
                    <div class="rp-evm-card" t-att-class="cpiClass(k.cpi)">
                        <div class="rp-evm-card-label">CPI — Hiệu quả chi phí</div>
                        <div class="rp-evm-card-value" t-esc="k.cpi.toFixed(2)"/>
                        <div class="rp-evm-card-sub">
                            CV <t t-esc="fmt(k.cv)"/>
                        </div>
                    </div>
                    <div class="rp-evm-card" t-att-class="cpiClass(k.spi)">
                        <div class="rp-evm-card-label">SPI — Hiệu quả tiến độ</div>
                        <div class="rp-evm-card-value" t-esc="k.spi.toFixed(2)"/>
                        <div class="rp-evm-card-sub">SV <t t-esc="fmt(k.sv)"/></div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Đã chi / Ngân sách</div>
                        <div class="rp-evm-card-value" t-esc="pct(k.budget_used_pct)"/>
                        <div class="rp-evm-card-sub">AC <t t-esc="fmt(k.ac)"/></div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Dự báo chi phí cuối (EAC)</div>
                        <div class="rp-evm-card-value" t-esc="fmt(k.eac)"/>
                        <div class="rp-evm-card-sub">theo CPI hiện tại</div>
                    </div>
                    <div class="rp-evm-card" t-att-class="k.vac >= 0 ? 'is-good' : 'is-bad'">
                        <div class="rp-evm-card-label">Chênh lệch dự báo (VAC)</div>
                        <div class="rp-evm-card-value">
                            <t t-if="k.vac >= 0">+</t><t t-esc="fmt(k.vac)"/>
                        </div>
                        <div class="rp-evm-card-sub">
                            <t t-if="k.vac >= 0">dưới ngân sách</t>
                            <t t-else="">vượt ngân sách</t>
                        </div>
                    </div>
                </div>

                <!-- Row: S-curve + Donut -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide">
                        <div class="rp-evm-panel-head">
                            <h3>Đường cong S — Kế hoạch vs Thực tế (lũy kế)</h3>
                            <span class="rp-evm-panel-note">
                                PV kế hoạch · EV giá trị làm ra · AC chi phí thực — dừng ở tháng hiện tại
                            </span>
                        </div>
                        <div class="rp-evm-chart" t-ref="scurve"/>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Cơ cấu giá trị hợp đồng</h3>
                            <span class="rp-evm-panel-note">Theo gói thầu</span>
                        </div>
                        <div class="rp-evm-chart" t-ref="donut"/>
                    </div>
                </div>

                <!-- Row: Cashflow + Progress by package -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide">
                        <div class="rp-evm-panel-head">
                            <h3>Dòng tiền theo tháng</h3>
                            <span class="rp-evm-panel-note">
                                Thu từ CĐT (hóa đơn phát hành) vs Chi cho nhà thầu · ròng lũy kế
                            </span>
                        </div>
                        <div class="rp-evm-chart" t-ref="cash"/>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Tiến độ theo gói thầu</h3>
                            <span class="rp-evm-panel-note">% nghiệm thu / giá trị HĐ</span>
                        </div>
                        <div class="rp-evm-bars">
                            <t t-foreach="state.data.packages" t-as="pk" t-key="pk_index">
                                <div class="rp-evm-bar-row">
                                    <div class="rp-evm-bar-top">
                                        <span class="rp-evm-bar-name" t-esc="pk.name"/>
                                        <span class="rp-evm-bar-val" t-esc="fmt(pk.value)"/>
                                    </div>
                                    <div class="rp-evm-bar-track">
                                        <div class="rp-evm-bar-fill"
                                             t-att-style="'width:' + Math.min(Math.max(pk.percent, 1.5), 100) + '%'"/>
                                    </div>
                                    <div class="rp-evm-bar-pct" t-esc="pct(pk.percent)"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Register table -->
                <div class="rp-evm-panel">
                    <div class="rp-evm-panel-head">
                        <h3>Danh mục gói thầu</h3>
                    </div>
                    <table class="rp-evm-table">
                        <thead>
                            <tr>
                                <th>Gói thầu</th>
                                <th>Nhà thầu</th>
                                <th class="num">Giá trị HĐ</th>
                                <th class="num">% Nghiệm thu</th>
                                <th class="c">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data.packages" t-as="pk" t-key="pk_index">
                                <tr>
                                    <td t-esc="pk.name"/>
                                    <td class="muted" t-esc="pk.contractor or '—'"/>
                                    <td class="num" t-esc="fmt(pk.value)"/>
                                    <td class="num" t-esc="pct(pk.percent)"/>
                                    <td class="c">
                                        <span class="rp-evm-chip" t-esc="pk.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- ============ BƯỚC 2: Rủi ro · An toàn · Chất lượng ============ -->
                <div class="rp-evm-divider">
                    <span>An toàn · Chất lượng · Rủi ro — kiểm soát dự án</span>
                </div>

                <!-- Mini KPI hàng 2 -->
                <div class="rp-evm-kpis rp-evm-kpis-4">
                    <div class="rp-evm-card" t-att-class="state.data.risk.high_count ? 'is-bad' : ''">
                        <div class="rp-evm-card-label">Rủi ro đang mở</div>
                        <div class="rp-evm-card-value" t-esc="state.data.risk.open_count"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="state.data.risk.high_count"/> rủi ro cao/nghiêm trọng
                        </div>
                    </div>
                    <div class="rp-evm-card" t-att-class="state.data.safety.days_without_lti >= 30 ? 'is-good' : 'is-warn'">
                        <div class="rp-evm-card-label">Ngày an toàn LĐ (không LTI)</div>
                        <div class="rp-evm-card-value" t-esc="state.data.safety.days_without_lti"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="state.data.safety.toolbox_count"/> toolbox ·
                            <t t-esc="state.data.safety.incident_count"/> sự cố
                        </div>
                    </div>
                    <div class="rp-evm-card" t-att-class="state.data.qaqc.critical_open ? 'is-warn' : 'is-good'">
                        <div class="rp-evm-card-label">Chất lượng QA/QC</div>
                        <div class="rp-evm-card-value" t-esc="pct(state.data.qaqc.quality_pct)"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="state.data.qaqc.open"/> lỗi mở ·
                            <t t-esc="state.data.qaqc.overdue"/> quá hạn
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Nhân lực (TB/ngày)</div>
                        <div class="rp-evm-card-value" t-esc="state.data.manpower.avg"/>
                        <div class="rp-evm-card-sub">
                            đỉnh <t t-esc="state.data.manpower.peak"/> người
                        </div>
                    </div>
                </div>

                <!-- Heat map + Top risks -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Ma trận rủi ro (Risk heat map)</h3>
                            <span class="rp-evm-panel-note">
                                Khả năng (dọc) × Mức ảnh hưởng (ngang) — số = số rủi ro
                            </span>
                        </div>
                        <div class="rp-evm-heat">
                            <div class="rp-evm-heat-corner"/>
                            <t t-foreach="[1,2,3,4,5]" t-as="ix" t-key="ix">
                                <div class="rp-evm-heat-xh" t-esc="ix"/>
                            </t>
                            <t t-foreach="state.data.risk.matrix" t-as="row" t-key="row_index">
                                <div class="rp-evm-heat-yh" t-esc="5 - row_index"/>
                                <t t-foreach="row" t-as="cell" t-key="cell_index">
                                    <div class="rp-evm-heat-cell"
                                         t-att-class="heatClass(cell.score) + (cell.count ? '' : ' is-empty')">
                                        <t t-if="cell.count" t-esc="cell.count"/>
                                    </div>
                                </t>
                            </t>
                        </div>
                        <div class="rp-evm-heat-axis">
                            <span>← Khả năng cao</span>
                            <span>Mức ảnh hưởng →</span>
                        </div>
                        <div class="rp-evm-heat-legend">
                            <span class="lv-low">Thấp</span>
                            <span class="lv-medium">Trung bình</span>
                            <span class="lv-high">Cao</span>
                            <span class="lv-critical">Nghiêm trọng</span>
                        </div>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Rủi ro trọng yếu</h3>
                            <span class="rp-evm-panel-note">Top theo điểm rủi ro</span>
                        </div>
                        <table class="rp-evm-table rp-evm-table-sm">
                            <thead>
                                <tr><th>Rủi ro</th><th class="c">Ảnh hưởng</th><th class="c">Mức</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.data.risk.top" t-as="rk" t-key="rk_index">
                                    <tr>
                                        <td>
                                            <div class="rp-evm-risk-name" t-esc="rk.name"/>
                                            <div class="rp-evm-risk-cat" t-esc="rk.category"/>
                                        </td>
                                        <td class="c muted" t-esc="rk.impact_note or '—'"/>
                                        <td class="c">
                                            <span class="rp-evm-lv" t-att-class="heatClass(rk.score)"
                                                  t-esc="levelLabel(rk.level)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Manpower + QA/QC donut -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide">
                        <div class="rp-evm-panel-head">
                            <h3>Nhân lực huy động</h3>
                            <span class="rp-evm-panel-note">Theo nhật ký thi công (người/ngày)</span>
                        </div>
                        <div class="rp-evm-chart" t-ref="manpower"/>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Lỗi chất lượng đang mở</h3>
                            <span class="rp-evm-panel-note">Theo mức độ</span>
                        </div>
                        <div class="rp-evm-chart" t-ref="qa"/>
                    </div>
                </div>

                <!-- Decision insights -->
                <div class="rp-evm-panel">
                    <div class="rp-evm-panel-head">
                        <h3>Cảnh báo &amp; khuyến nghị</h3>
                        <span class="rp-evm-panel-note">Tự động theo ngưỡng CPI/SPI · rủi ro · an toàn · chất lượng</span>
                    </div>
                    <div class="rp-evm-insights">
                        <t t-foreach="state.data.insights" t-as="it" t-key="it_index">
                            <div class="rp-evm-insight" t-att-class="'is-' + it.type">
                                <div class="rp-evm-insight-icon" t-esc="it.icon"/>
                                <div class="rp-evm-insight-body">
                                    <div class="rp-evm-insight-title" t-esc="it.title"/>
                                    <div class="rp-evm-insight-text" t-esc="it.text"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Milestones -->
                <div class="rp-evm-panel">
                    <div class="rp-evm-panel-head">
                        <h3>Mốc tiến độ (Milestones)</h3>
                    </div>
                    <table class="rp-evm-table">
                        <thead>
                            <tr>
                                <th>Mốc</th>
                                <th class="c">Kế hoạch</th>
                                <th class="num">% Hoàn thành</th>
                                <th class="c">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data.milestones" t-as="mi" t-key="mi_index">
                                <tr>
                                    <td t-esc="mi.name"/>
                                    <td class="c" t-esc="mi.date"/>
                                    <td class="num" t-esc="pct(mi.percent)"/>
                                    <td class="c">
                                        <span class="rp-evm-ms" t-att-class="'ms-' + mi.status"
                                              t-esc="msLabel(mi.status)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                </t><!-- /tab Tổng quan -->

                <!-- ==================== TAB TIỀN ==================== -->
                <t t-if="state.tab === 'tien'">

                <div class="rp-evm-kpis">
                    <div class="rp-evm-card rp-evm-hero"
                         t-att-class="mk.alert ? 'is-bad' : 'is-good'">
                        <div class="rp-evm-card-label">
                            <t t-if="mk.alert">Thiếu tiền</t>
                            <t t-else="">Đủ tiền trong tầm nhìn</t>
                        </div>
                        <div class="rp-evm-card-value">
                            <t t-if="mk.alert" t-esc="fmt(mk.gap)"/>
                            <t t-else="">+<t t-esc="fmt(mk.surplus)"/></t>
                        </div>
                        <div class="rp-evm-card-sub">
                            nhìn trước <t t-esc="mk.horizon_months"/> tháng ·
                            chỉ tính hạn mức tín dụng
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Cần chi (tầm nhìn)</div>
                        <div class="rp-evm-card-value" t-esc="fmt(mk.need)"/>
                        <div class="rp-evm-card-sub"
                             t-att-class="mk.overdue ? 'is-bad-text' : ''">
                            trong đó quá hạn <t t-esc="fmt(mk.overdue)"/>
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Nguồn còn rút được</div>
                        <div class="rp-evm-card-value" t-esc="fmt(mk.available)"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="mk.facility_count"/> hạn mức tín dụng
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Đã giải ngân / Kế hoạch</div>
                        <div class="rp-evm-card-value"
                             t-esc="pct(mk.plan_total ? mk.actual_total / mk.plan_total * 100 : 0)"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="fmt(mk.actual_total)"/> /
                            <t t-esc="fmt(mk.plan_total)"/>
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Tạm ứng chưa hoàn</div>
                        <div class="rp-evm-card-value"
                             t-esc="fmt(mk.advance_outstanding)"/>
                        <div class="rp-evm-card-sub">thu hồi dần theo đợt</div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Giữ lại theo hợp đồng</div>
                        <div class="rp-evm-card-value" t-esc="fmt(mk.retention)"/>
                        <div class="rp-evm-card-sub">trả khi hết bảo hành</div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Bảo lãnh đang giữ</div>
                        <div class="rp-evm-card-value"
                             t-esc="fmt(mk.guarantee_total)"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="m.guarantees.length"/> thư từ nhà thầu
                        </div>
                    </div>
                </div>

                <!-- Đường cong giải ngân + Lịch phải trả -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide">
                        <div class="rp-evm-panel-head">
                            <h3>Giải ngân — Kế hoạch vs Thực chi</h3>
                            <span class="rp-evm-panel-note">
                                Kế hoạch lấy từ đợt thanh toán hợp đồng và tạm
                                ứng · thực chi dừng ở tháng hiện tại
                            </span>
                        </div>
                        <div class="rp-evm-chart" t-ref="disb"/>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Phải trả 12 kỳ tới</h3>
                            <span class="rp-evm-panel-note">
                                Đợt đến hạn chưa trả, theo tháng
                            </span>
                        </div>
                        <div class="rp-evm-chart" t-ref="payable"/>
                    </div>
                </div>

                <!-- Quá hạn -->
                <div class="rp-evm-panel" t-if="m.overdue_rows.length">
                    <div class="rp-evm-panel-head">
                        <h3>Đợt thanh toán đã quá hạn chưa trả</h3>
                        <span class="rp-evm-panel-note">
                            Chậm trả là rủi ro nhà thầu dừng việc — và là căn cứ
                            để họ đòi gia hạn tiến độ
                        </span>
                    </div>
                    <table class="rp-evm-table">
                        <thead>
                            <tr>
                                <th>Hợp đồng</th>
                                <th>Đợt</th>
                                <th class="c">Đến hạn</th>
                                <th class="num">Trễ (ngày)</th>
                                <th class="num">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="m.overdue_rows" t-as="r" t-key="r_index">
                                <tr>
                                    <td t-esc="r.contract"/>
                                    <td class="muted" t-esc="r.name"/>
                                    <td class="c" t-esc="r.due_date"/>
                                    <td class="num">
                                        <span class="rp-evm-lv"
                                              t-att-class="r.days >= 60 ? 'lv-critical' : r.days >= 30 ? 'lv-high' : 'lv-medium'"
                                              t-esc="r.days"/>
                                    </td>
                                    <td class="num" t-esc="fmt(r.amount)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Hạn mức + Bảo lãnh -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide">
                        <div class="rp-evm-panel-head">
                            <h3>Hạn mức tín dụng</h3>
                            <span class="rp-evm-panel-note">
                                Giữ cả số gốc theo loại tiền đã ký và số đã quy
                                đổi về <t t-esc="cur.name"/>
                            </span>
                        </div>
                        <table class="rp-evm-table">
                            <thead>
                                <tr>
                                    <th>Hạn mức</th>
                                    <th class="num">Hạn mức (gốc)</th>
                                    <th class="num">Còn rút (gốc)</th>
                                    <th class="num">Còn rút (<t t-esc="cur.name"/>)</th>
                                    <th class="num">Đã dùng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="m.facilities" t-as="f" t-key="f_index">
                                    <tr>
                                        <td>
                                            <t t-esc="f.name"/>
                                            <span class="rp-evm-chip" t-if="f.pooled">liên thông</span>
                                        </td>
                                        <td class="num muted">
                                            <t t-esc="f.limit_raw.toLocaleString('vi-VN')"/>
                                            <span class="u" t-esc="f.currency"/>
                                        </td>
                                        <td class="num muted">
                                            <t t-esc="f.available_raw.toLocaleString('vi-VN')"/>
                                        </td>
                                        <td class="num" t-esc="fmt(f.available)"/>
                                        <td class="num">
                                            <div class="rp-evm-bar-track rp-evm-bar-inline">
                                                <div class="rp-evm-bar-fill"
                                                     t-att-style="'width:' + Math.min(Math.max(f.used_pct, 1), 100) + '%'"/>
                                            </div>
                                            <t t-esc="pct(f.used_pct)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Bảo lãnh nhận từ nhà thầu</h3>
                            <span class="rp-evm-panel-note">Sắp hết hạn lên trước</span>
                        </div>
                        <table class="rp-evm-table rp-evm-table-sm">
                            <thead>
                                <tr>
                                    <th>Thư bảo lãnh</th>
                                    <th class="num">Giá trị</th>
                                    <th class="c">Hết hạn</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="m.guarantees" t-as="g" t-key="g_index">
                                    <tr>
                                        <td t-esc="g.name"/>
                                        <td class="num" t-esc="fmt(g.amount)"/>
                                        <td class="c">
                                            <t t-esc="g.expiry or '—'"/>
                                            <span class="rp-evm-lv"
                                                  t-if="g.days_left !== null and g.days_left &lt; 60"
                                                  t-att-class="g.days_left &lt; 30 ? 'lv-critical' : 'lv-high'">
                                                còn <t t-esc="g.days_left"/>n
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="rp-evm-panel rp-evm-note-panel">
                    <p>
                        <b>Phạm vi con số "còn rút được":</b> chỉ gồm hạn mức
                        tín dụng còn khả dụng đã phân bổ cho dự án này. Không
                        gồm vốn chủ sở hữu sẽ góp, tiền mặt đang có, hay tiền
                        thu về từ bán điện. Đây là <b>khoảng hở tài trợ</b>,
                        không phải dự báo ngân quỹ — nói rõ phạm vi quan trọng
                        hơn là làm con số trông toàn diện.
                    </p>
                </div>

                </t><!-- /tab Tiền -->

                <!-- ================= TAB ĐƯỜNG GĂNG ================= -->
                <t t-if="state.tab === 'lich'">

                <!-- Mạng lịch hỏng thì MỌI số dưới đây đều không đọc
                     được — nói trước, đặt trên cùng. -->
                <div class="rp-evm-banner is-bad" t-if="!sk.float_reliable">
                    <div class="rp-evm-banner-icon">‼</div>
                    <div>
                        <b>Mạng lịch còn <t t-esc="sk.violated_severe"/> quan hệ
                        ngược chiều</b> — việc sau được xếp bắt đầu trước khi
                        việc trước kết thúc hàng trăm ngày. Đó không phải chậm
                        tiến độ mà là khai sai chiều phụ thuộc, và nó kéo lượt
                        tính lùi của CPM đi theo.<br/>
                        <b>Dư địa và đường găng bên dưới chưa đọc được</b>
                        (dư địa đang là <t t-esc="sk.critical_float"/> ngày).
                        Sửa các quan hệ ở bảng “Mạng lịch bị vi phạm” rồi chạy
                        lại đường găng.
                    </div>
                </div>

                <div class="rp-evm-kpis">
                    <div class="rp-evm-card rp-evm-hero"
                         t-att-class="sk.deadline_slip > 0 ? 'is-bad' : 'is-good'">
                        <div class="rp-evm-card-label">
                            <t t-esc="sk.deadline_name or 'Hạn hoàn thành'"/> —
                            dự báo so với hạn
                        </div>
                        <div class="rp-evm-card-value">
                            <t t-if="sk.deadline_slip > 0">trễ <t t-esc="sk.deadline_slip"/> ngày</t>
                            <t t-else="">đúng hạn</t>
                        </div>
                        <div class="rp-evm-card-sub">
                            hạn <t t-esc="sk.deadline"/> · dự báo
                            <t t-esc="sk.forecast"/>
                        </div>
                    </div>
                    <div class="rp-evm-card"
                         t-att-class="sk.violated_severe ? 'is-bad' : sk.violated ? 'is-warn' : 'is-good'">
                        <div class="rp-evm-card-label">Mạng lịch bị vi phạm</div>
                        <div class="rp-evm-card-value" t-esc="sk.violated"/>
                        <div class="rp-evm-card-sub">
                            <t t-if="sk.violated_severe">
                                <t t-esc="sk.violated_severe"/> quan hệ ngược chiều
                            </t>
                            <t t-else="">chỉ lệch nhỏ, đọc được đường găng</t>
                        </div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Việc trên đường găng</div>
                        <div class="rp-evm-card-value" t-esc="sk.critical_count"/>
                        <div class="rp-evm-card-sub">
                            trên tổng <t t-esc="sk.task_count"/> việc
                        </div>
                    </div>
                    <div class="rp-evm-card"
                         t-att-class="sk.alert_critical ? 'is-bad' : sk.alert_count ? 'is-warn' : 'is-good'">
                        <div class="rp-evm-card-label">Cảnh báo trượt đang mở</div>
                        <div class="rp-evm-card-value" t-esc="sk.alert_count"/>
                        <div class="rp-evm-card-sub">
                            <t t-esc="sk.alert_critical"/> mức nghiêm trọng
                        </div>
                    </div>
                    <div class="rp-evm-card"
                         t-att-class="sk.gate_count ? 'is-warn' : 'is-good'">
                        <div class="rp-evm-card-label">Hồ sơ chặn khởi công</div>
                        <div class="rp-evm-card-value" t-esc="sk.gate_count"/>
                        <div class="rp-evm-card-sub">việc chưa đủ cổng hồ sơ</div>
                    </div>
                    <div class="rp-evm-card">
                        <div class="rp-evm-card-label">Trượt so mốc chuẩn</div>
                        <div class="rp-evm-card-value" t-esc="sk.slip_count"/>
                        <div class="rp-evm-card-sub">
                            trượt nhiều nhất <t t-esc="sk.slip_max"/> ngày
                        </div>
                    </div>
                </div>

                <!-- Mạng lịch bị vi phạm — đặt TRƯỚC đường găng -->
                <div class="rp-evm-panel" t-if="s.violations.length">
                    <div class="rp-evm-panel-head">
                        <h3>Mạng lịch bị vi phạm</h3>
                        <span class="rp-evm-panel-note">
                            Hở thực &lt; lag đã khai · hở âm lớn là khai sai
                            chiều phụ thuộc, không phải chậm tiến độ
                        </span>
                    </div>
                    <table class="rp-evm-table">
                        <thead>
                            <tr>
                                <th>Việc trước</th>
                                <th>Việc sau</th>
                                <th class="c">Loại</th>
                                <th class="num">Lag khai</th>
                                <th class="num">Hở thực</th>
                                <th class="c">Nguồn</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="s.violations" t-as="v" t-key="v_index">
                                <tr t-att-class="v.severe ? 'is-severe' : ''">
                                    <td t-esc="v.pred"/>
                                    <td t-esc="v.succ"/>
                                    <td class="c">
                                        <span class="rp-evm-chip" t-esc="v.type"/>
                                        <span class="rp-evm-chip" t-if="v.cross">liên HĐ</span>
                                    </td>
                                    <td class="num" t-esc="v.lag"/>
                                    <td class="num">
                                        <span class="rp-evm-lv"
                                              t-att-class="v.severe ? 'lv-critical' : 'lv-medium'"
                                              t-esc="v.gap"/>
                                    </td>
                                    <td class="c muted" t-esc="v.source"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Chuỗi găng -->
                <div class="rp-evm-panel">
                    <div class="rp-evm-panel-head">
                        <h3>Chuỗi găng cấp dự án — xuyên hợp đồng</h3>
                        <span class="rp-evm-panel-note">
                            Theo thứ tự thời gian · chậm một việc ở đây là chậm
                            <t t-esc="sk.deadline_name or 'ngày hoàn thành'"/>
                        </span>
                    </div>
                    <table class="rp-evm-table">
                        <thead>
                            <tr>
                                <th>Công việc</th>
                                <th>Hợp đồng</th>
                                <th class="c">Bắt đầu</th>
                                <th class="c">Kết thúc</th>
                                <th class="num">Dư địa</th>
                                <th class="c">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="s.chain" t-as="cp" t-key="cp_index">
                                <tr>
                                    <td>
                                        <t t-esc="cp.name"/>
                                        <span class="rp-evm-chip" t-if="cp.milestone">mốc</span>
                                    </td>
                                    <td class="muted" t-esc="cp.contract or '—'"/>
                                    <td class="c" t-esc="cp.start"/>
                                    <td class="c" t-esc="cp.end"/>
                                    <td class="num">
                                        <t t-if="sk.float_reliable" t-esc="cp.float"/>
                                        <span class="muted" t-else="">—</span>
                                    </td>
                                    <td class="c">
                                        <span class="rp-evm-ms"
                                              t-att-class="'ms-' + (cp.status === 'done' ? 'done' : cp.status === 'late' ? 'overdue' : 'ontrack')"
                                              t-esc="execLabel(cp.status)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Khối lượng + trạng thái -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide">
                        <div class="rp-evm-panel-head">
                            <h3>Khối lượng việc đến hạn — 12 tháng tới</h3>
                            <span class="rp-evm-panel-note">
                                Không tính mốc · thấy trước chỗ dồn việc
                            </span>
                        </div>
                        <div class="rp-evm-chart" t-ref="workload"/>
                    </div>
                    <div class="rp-evm-panel">
                        <div class="rp-evm-panel-head">
                            <h3>Trạng thái thực hiện</h3>
                            <span class="rp-evm-panel-note">Toàn dự án</span>
                        </div>
                        <div class="rp-evm-chart" t-ref="status"/>
                    </div>
                </div>

                <!-- Cảnh báo + điểm bàn giao -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel rp-evm-panel-wide"
                         t-if="s.alerts.length">
                        <div class="rp-evm-panel-head">
                            <h3>Cảnh báo trượt tiến độ đang mở</h3>
                            <span class="rp-evm-panel-note">
                                Nghiêm trọng trước · trong mỗi mức thì cũ trước
                            </span>
                        </div>
                        <table class="rp-evm-table">
                            <thead>
                                <tr>
                                    <th>Cảnh báo</th>
                                    <th class="c">Mức</th>
                                    <th class="num">Giá trị</th>
                                    <th class="num">Ngưỡng</th>
                                    <th class="num">Tuổi (ngày)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="s.alerts" t-as="a" t-key="a_index">
                                    <tr>
                                        <td t-esc="a.name"/>
                                        <td class="c">
                                            <span class="rp-evm-lv"
                                                  t-att-class="a.severity === 'critical' ? 'lv-critical' : 'lv-high'"
                                                  t-esc="sevLabel(a.severity)"/>
                                        </td>
                                        <td class="num" t-esc="a.value"/>
                                        <td class="num muted" t-esc="a.threshold"/>
                                        <td class="num" t-esc="a.age"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="rp-evm-panel" t-if="s.interfaces.length">
                        <div class="rp-evm-panel-head">
                            <h3>Điểm bàn giao giữa hai hợp đồng</h3>
                            <span class="rp-evm-panel-note">Hở nhỏ nhất lên trước</span>
                        </div>
                        <table class="rp-evm-table rp-evm-table-sm">
                            <thead>
                                <tr>
                                    <th>Điểm bàn giao</th>
                                    <th class="num">Hở (ngày)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="s.interfaces" t-as="itf" t-key="itf_index">
                                    <tr>
                                        <td>
                                            <t t-esc="itf.name"/>
                                            <span class="rp-evm-chip" t-if="itf.conflict">mâu thuẫn</span>
                                        </td>
                                        <td class="num">
                                            <span class="rp-evm-lv"
                                                  t-att-class="itf.gap &lt;= 0 ? 'lv-critical' : itf.gap &lt;= 7 ? 'lv-high' : 'lv-low'"
                                                  t-esc="itf.gap"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Cổng hồ sơ + trượt baseline -->
                <div class="rp-evm-row">
                    <div class="rp-evm-panel" t-if="s.gates.length">
                        <div class="rp-evm-panel-head">
                            <h3>Hồ sơ đang chặn khởi công</h3>
                            <span class="rp-evm-panel-note">
                                Việc không được phép bắt đầu khi chưa đủ hồ sơ
                            </span>
                        </div>
                        <table class="rp-evm-table rp-evm-table-sm">
                            <thead>
                                <tr>
                                    <th>Công việc</th>
                                    <th class="c">Kế hoạch bắt đầu</th>
                                    <th class="num">Chặn (ngày)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="s.gates" t-as="g" t-key="g_index">
                                    <tr>
                                        <td t-esc="g.name"/>
                                        <td class="c" t-esc="g.start"/>
                                        <td class="num">
                                            <span class="rp-evm-lv lv-high" t-esc="g.slip"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="rp-evm-panel rp-evm-panel-wide" t-if="s.slips.length">
                        <div class="rp-evm-panel-head">
                            <h3>Trượt so với mốc chuẩn (baseline)</h3>
                            <span class="rp-evm-panel-note">
                                So ngày kết thúc hiện hành với mốc chuẩn đã đóng băng
                            </span>
                        </div>
                        <table class="rp-evm-table rp-evm-table-sm">
                            <thead>
                                <tr>
                                    <th>Công việc</th>
                                    <th class="c">Mốc chuẩn</th>
                                    <th class="c">Hiện hành</th>
                                    <th class="num">Trượt</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="s.slips" t-as="sl" t-key="sl_index">
                                    <tr>
                                        <td t-esc="sl.name"/>
                                        <td class="c muted" t-esc="sl.baseline_end"/>
                                        <td class="c" t-esc="sl.end"/>
                                        <td class="num" t-esc="sl.days"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                </t><!-- /tab Đường găng -->

            </t>
        </div>
    </t>

</templates>
