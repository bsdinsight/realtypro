#. module: rp_schedule_alert
#: model:ir.ui.menu,name:rp_schedule_alert.menu_rp_schedule_alert
msgid "Cảnh báo tiến độ"
msgstr "Schedule alerts"

#. module: rp_schedule_alert
#: model_terms:ir.ui.view,arch_db:rp_schedule_alert.view_re_project_form_alert
msgid "<i class=\"fa fa-bell me-1\" title=\"Cảnh báo\"/>"
msgstr "<i class=\"fa fa-bell me-1\" title=\"Alerts\"/>"

#. module: rp_schedule_alert
#: model:ir.model.fields,help:rp_schedule_alert.field_re_project__alert_slip_days
msgid "Báo khi công việc chưa xong mà đã kết thúc muộn hơn kế hoạch gốc từng này ngày trở lên."
msgstr "Alert when unfinished work has already run this many days past its original planned finish."

#. module: rp_schedule_alert
#: model:ir.model.fields,help:rp_schedule_alert.field_re_project__alert_float_days
msgid "Báo khi công việc còn dư địa toàn dự án ÍT HƠN hoặc bằng số ngày này. Dư địa âm luôn là mức nghiêm trọng."
msgstr "Alert when work has this many days of total project float left, or fewer. Negative float is always critical."

#. module: rp_schedule_alert
#: model:ir.model.fields,help:rp_schedule_alert.field_re_project__alert_interface_days
msgid "Báo khi điểm bàn giao còn dư địa ÍT HƠN hoặc bằng số ngày này. Để 0 nghĩa là chỉ báo khi đã mâu thuẫn."
msgstr "Alert when an interface point has this many days of float left, or fewer. 0 means alerting only once it is already in conflict."

#. module: rp_schedule_alert
#: model:ir.model.fields,field_description:rp_schedule_alert.field_rp_schedule_alert__task_id
msgid "Công việc"
msgstr "Tasks"

#. module: rp_schedule_alert
