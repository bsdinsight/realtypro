<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cột Nguồn chi trả trên list Hồ sơ thanh toán -->
    <record id="view_rp_contract_milestone_list_funding" model="ir.ui.view">
        <field name="name">rp.contract.payment.milestone.list.funding</field>
        <field name="model">rp.contract.payment.milestone</field>
        <field name="inherit_id"
               ref="rp_contract.view_rp_contract_milestone_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="funding_source" optional="show"/>
                <field name="owner_advance_id" optional="show"/>
                <field name="loan_note_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Sổ hồ sơ giải ngân đứng riêng cho menu Tài chính
         (form dialog đã có sẵn — view_rp_loan_disbursement_dossier_form) -->
    <record id="view_rp_loan_disbursement_dossier_list" model="ir.ui.view">
        <field name="name">rp.loan.disbursement.dossier.list</field>
        <field name="model">rp.loan.disbursement.dossier</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="disbursement_id"/>
                <field name="contractor_id"/>
                <field name="contract_id" optional="show"/>
                <field name="acceptance_id" optional="show"/>
                <field name="invoice_id" optional="show"/>
                <field name="amount" width="185px" sum="Tổng giải ngân"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'disbursed'"
                       decoration-warning="state in ('submitted', 'approved')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_rp_loan_disbursement_dossier_search" model="ir.ui.view">
        <field name="name">rp.loan.disbursement.dossier.search</field>
        <field name="model">rp.loan.disbursement.dossier</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="contractor_id"/>
                <field name="invoice_id"/>
                <filter string="Nhà thầu" name="group_contractor"
                        context="{'group_by': 'contractor_id'}"/>
                <filter string="HĐ" name="group_contract"
                        context="{'group_by': 'contract_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_rp_loan_disbursement_dossier"
            model="ir.actions.act_window">
        <field name="name">Giải ngân qua khế ước</field>
        <field name="res_model">rp.loan.disbursement.dossier</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'list',
                              'view_id': ref('view_rp_loan_disbursement_dossier_list')}),
                      (0, 0, {'view_mode': 'form',
                              'view_id': ref('view_rp_loan_disbursement_dossier_form')})]"/>
    </record>


    <!-- Chia MỘT mốc cho NHIỀU nguồn (vd: một phần tạm ứng CĐT,
         phần còn lại giải ngân từ khế ước vay) -->
    <record id="view_rp_milestone_form_split" model="ir.ui.view">
        <field name="name">rp.contract.payment.milestone.form.split</field>
        <field name="model">rp.contract.payment.milestone</field>
        <field name="arch" type="xml">
            <form string="Mốc thanh toán">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="name"/>
                            <field name="percent"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="state"/>
                            <field name="funding_source"
                                   readonly="is_split_funding"/>
                            <field name="owner_advance_id"
                                   invisible="funding_source != 'owner_advance' or is_split_funding"
                                   options="{'no_create': True}"/>
                            <field name="loan_note_id"
                                   invisible="funding_source != 'loan' or is_split_funding"
                                   options="{'no_create': True}"/>
                            <field name="is_split_funding" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chia nhiều nguồn" name="split">
                            <div class="alert alert-info small" role="status">
                                Mốc trả bằng <b>một nguồn</b> thì khai ở ô
                                "Nguồn chi trả" bên trên, để trống bảng này.
                                Trả bằng <b>nhiều nguồn</b> thì thêm dòng ở
                                đây — khi đó <b>bảng này thắng</b>, và
                                "Chưa gán nguồn" phải về 0.
                            </div>
                            <field name="funding_line_ids">
                                <list editable="bottom">
                                    <field name="source"/>
                                    <field name="owner_advance_id"
                                           invisible="source != 'owner_advance'"
                                           options="{'no_create': True}"/>
                                    <field name="loan_note_id"
                                           invisible="source != 'loan'"
                                           options="{'no_create': True}"/>
                                    <field name="amount" width="185px"
                                           sum="Σ"/>
                                    <field name="note"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="funding_split_total"/>
                                    <field name="funding_unallocated"
                                           decoration-danger="funding_unallocated != 0"
                                           decoration-bf="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>