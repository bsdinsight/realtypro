<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Bảng từng tổ máy ============ -->
    <template id="khoi_bang_to_may">
        <t t-set="b" t-value="o.bang_to_may()"/>
        <p t-if="not b['dong']" class="small text-muted mb-0">
            Chưa dựng bảng tổ máy cho ngày này. Mở <b>Vận hành → Hiệu
            suất tổ máy</b> và dựng, hoặc chờ cron chạy lúc 0h10.
        </p>
        <table t-if="b['dong']" class="table table-sm table-bordered mb-0"
               style="font-size:9px">
            <thead class="bg-light">
                <tr>
                    <th>MFG</th>
                    <th class="text-end">Avg [m/s]</th>
                    <th class="text-end">Production Today (kWh)</th>
                    <th class="text-end">Cumulative of the month (kWh)</th>
                    <th class="text-end">Capacity factor</th>
                    <th class="text-end">Energy Based Availability</th>
                    <th class="text-end">Manufacturer Availability</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="b['dong']" t-as="d">
                    <td t-esc="d.location_code"/>
                    <td class="text-end">
                        <span t-if="d.gio_tb" t-esc="'{:.1f}'.format(d.gio_tb)"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end">
                        <span t-if="d.do_duoc_sl"
                              t-esc="'{:,.0f}'.format(d.san_luong)"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end"
                        t-esc="'{:,.0f}'.format(d.luy_ke_thang)"/>
                    <td class="text-end">
                        <span t-if="d.do_duoc_hs"
                              t-esc="'{:.2f}%'.format(d.he_so_cong_suat)"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <!-- Hai cột khả dụng cố ý KHÔNG gộp: cột của ta tính
                         hết mọi nguyên nhân, cột của hãng loại trừ phần
                         ngoài trách nhiệm họ. -->
                    <td class="text-end">
                        <span t-if="d.do_duoc_kd"
                              t-esc="'{:.2f}%'.format(d.kd_san_luong)"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end">
                        <span t-if="d.kd_nha_san_xuat"
                              t-esc="'{:.2f}%'.format(d.kd_nha_san_xuat)"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                </tr>
                <!-- Dòng TRUNG BÌNH chỉ có ở cột sản lượng. Ba cột
                     phần trăm cố ý để trống: trung bình của các phần
                     trăm KHÁC với phần trăm của tổng, và dòng TOTAL
                     ngay dưới đã là con số đúng. In cả hai cạnh nhau
                     là mời người đọc lấy nhầm. -->
                <tr class="bg-light">
                    <td>Avg / unit</td>
                    <td class="text-end">
                        <span t-if="b['tong'].get('gio_tb')"
                              t-esc="'{:.1f}'.format(b['tong']['gio_tb'])"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end">
                        <span t-if="b['tong'].get('tb_san_luong')"
                              t-esc="'{:,.0f}'.format(b['tong']['tb_san_luong'])"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end text-muted">—</td>
                    <td class="text-end text-muted">—</td>
                    <td class="text-end text-muted">—</td>
                    <td class="text-end text-muted">—</td>
                </tr>
                <tr class="fw-bold bg-light">
                    <td>TOTAL</td>
                    <td class="text-end">
                        <span t-if="b['tong'].get('gio_tb')"
                              t-esc="'{:.1f}'.format(b['tong']['gio_tb'])"/>
                        <span t-else="">—</span>
                    </td>
                    <td class="text-end"
                        t-esc="'{:,.0f}'.format(b['tong']['san_luong'])"/>
                    <td class="text-end"
                        t-esc="'{:,.0f}'.format(b['tong']['luy_ke_thang'])"/>
                    <td class="text-end">
                        <span t-if="b['tong']['he_so_cong_suat']"
                              t-esc="'{:.2f}%'.format(b['tong']['he_so_cong_suat'])"/>
                        <span t-else="">—</span>
                    </td>
                    <td class="text-end">
                        <span t-if="b['tong']['kd_san_luong']"
                              t-esc="'{:.2f}%'.format(b['tong']['kd_san_luong'])"/>
                        <span t-else="">—</span>
                    </td>
                    <td class="text-end">
                        <span t-if="b['tong']['kd_nha_san_xuat']"
                              t-esc="'{:.2f}%'.format(b['tong']['kd_nha_san_xuat'])"/>
                        <span t-else="">—</span>
                    </td>
                </tr>
            </tbody>
        </table>
        <p t-if="b['tong'] and b['tong'].get('so_chua_co_sl')"
           class="small text-muted mb-0 mt-1">
            <b><span t-esc="b['tong']['so_chua_co_sl']"/> tổ máy chưa có
            số sản lượng</b> và được in là "—". Dòng TỔNG cộng tử số và
            mẫu số rồi mới chia, không phải trung bình các phần trăm.
        </p>
    </template>

    <!-- ============ Hoa gió ============ -->
    <template id="khoi_hoa_gio">
        <t t-set="h" t-value="o.hoa_gio()"/>
        <p t-if="not h['do_duoc']" class="small text-muted mb-0">
            <span t-esc="h['ly_do']"/>
        </p>
        <div t-if="h['do_duoc']" class="d-flex align-items-center">
            <svg width="190" height="190" viewBox="-100 -100 200 200">
                <!-- Ba vòng thước, và nhãn hướng ở ngoài cùng -->
                <circle cx="0" cy="0" r="80" fill="none"
                        stroke="#ccc" stroke-width="0.5"/>
                <circle cx="0" cy="0" r="53" fill="none"
                        stroke="#ccc" stroke-width="0.5"/>
                <circle cx="0" cy="0" r="27" fill="none"
                        stroke="#ccc" stroke-width="0.5"/>
                <t t-foreach="h['canh']" t-as="c">
                    <!-- Cánh vẽ theo TẦN SUẤT, tô đậm nhạt theo TỐC ĐỘ:
                         một bông hoa chỉ vẽ tần suất thì không cho biết
                         hướng nào mang năng lượng. -->
                    <g t-att-transform="'rotate(%f)' % c['goc']">
                        <rect x="-7" t-att-y="-80 * c['ty']" width="14"
                              t-att-height="80 * c['ty']"
                              t-att-fill="'#0E8C99'"
                              t-att-fill-opacity="0.35 + 0.65 * min(c['toc'] / 12.0, 1.0)"
                              stroke="#0F2C3F" stroke-width="0.3"/>
                    </g>
                    <text t-att-x="c['nx']" t-att-y="c['ny']"
                          text-anchor="middle" font-size="7"
                          fill="#0F2C3F" t-esc="c['ten']"/>
                </t>
            </svg>
            <div class="ms-3 small">
                <div><b>Hướng trội:</b>
                    <span t-esc="h['troi_nhat']['ten']"/>
                    (<span t-esc="'{:.1f}%'.format(h['troi_nhat']['tan_suat'])"/>,
                    <span t-esc="'{:.1f} m/s'.format(h['troi_nhat']['toc'])"/>)
                </div>
                <div class="text-muted">
                    Dựng từ <span t-esc="'{:,}'.format(h['so_moc'])"/> mốc
                    đo. Chiều dài cánh là <b>tần suất</b>; độ đậm là
                    <b>tốc độ trung bình</b> của hướng đó.
                </div>
                <div class="text-muted mt-1">
                    Hướng gió lấy trung bình <b>vectơ</b> — trung bình số
                    học của 350° và 10° ra 180°, tức ngược hẳn hướng thật.
                </div>
            </div>
        </div>
    </template>

    <!-- ============ Biểu đồ công suất trong ngày ============ -->
    <template id="khoi_bieu_do">
        <t t-set="g" t-value="o.bieu_do_ngay()"/>
        <p t-if="not g['do_duoc']" class="small text-muted mb-0">
            <span t-esc="g['ly_do']"/>
        </p>
        <div t-if="g['do_duoc']">
            <svg width="100%" height="150" viewBox="0 0 700 150"
                 preserveAspectRatio="none">
                <line x1="0" y1="140" x2="700" y2="140"
                      stroke="#999" stroke-width="1"/>
                <t t-set="n" t-value="len(g['diem'])"/>
                <polyline fill="none" stroke="#0E8C99" stroke-width="1.6"
                          t-att-points="' '.join('%f,%f' % (
                              700.0 * i / max(n - 1, 1),
                              140 - 125.0 * d['cs'] / g['cs_max'])
                              for i, d in enumerate(g['diem']))"/>
                <polyline t-if="g['co_gio']" fill="none" stroke="#C86428"
                          stroke-width="1" stroke-dasharray="3,2"
                          t-att-points="' '.join('%f,%f' % (
                              700.0 * i / max(n - 1, 1),
                              140 - 125.0 * d['ws'] / g['ws_max'])
                              for i, d in enumerate(g['diem']))"/>
                <polyline t-if="g.get('co_may')" fill="none" stroke="#1a9850"
                          stroke-width="1" stroke-dasharray="1,2"
                          t-att-points="' '.join('%f,%f' % (
                              700.0 * i / max(n - 1, 1),
                              140 - 125.0 * (d.get('may') or 0) / g['may_max'])
                              for i, d in enumerate(g['diem']))"/>
                <t t-foreach="[0, n // 4, n // 2, 3 * n // 4, n - 1]" t-as="i">
                    <!-- Nhãn đầu neo trái, nhãn cuối neo phải: neo giữa
                         thì hai đầu bị cắt mất nửa chữ. -->
                    <text t-att-x="700.0 * i / max(n - 1, 1)" y="149"
                          font-size="8" fill="#666"
                          t-att-text-anchor="'start' if i == 0 else ('end' if i == n - 1 else 'middle')"
                          t-esc="g['diem'][i]['gio']"/>
                </t>
            </svg>
            <div class="small text-muted">
                <span style="color:#0E8C99">━</span> Công suất toàn trại
                (đỉnh <span t-esc="'{:,.0f} kW'.format(g['cs_max'])"/>)
                &amp;nbsp;·&amp;nbsp;
                <span t-if="g.get('co_may')" style="color:#1a9850">┈</span>
                <span t-if="g.get('co_may')">Số tổ máy đang phát (đỉnh
                <span t-esc="g['may_max']"/>)</span>
                &amp;nbsp;·&amp;nbsp;
                <span t-if="g['co_gio']" style="color:#C86428">╌</span>
                <t t-if="g['co_gio']">Tốc độ gió (đỉnh
                    <span t-esc="'{:.1f} m/s'.format(g['ws_max'])"/>)</t>
                — mỗi điểm là <b>trung bình các tổng theo mốc</b>, không
                phải tổng cộng dồn.
            </div>
        </div>
    </template>

    <!-- ============ Điện năng từng giờ trong ngày ============ -->
    <template id="khoi_san_luong_gio">
        <t t-set="s" t-value="o.san_luong_gio(6, 18)"/>
        <p t-if="not s['do_duoc']" class="small text-muted mb-0">
            <span t-esc="s['ly_do']"/>
        </p>
        <div t-if="s['do_duoc']">
            <svg width="100%" height="130" viewBox="0 0 700 130"
                 preserveAspectRatio="none">
                <line x1="0" y1="118" x2="700" y2="118"
                      stroke="#999" stroke-width="1"/>
                <t t-set="n" t-value="len(s['dong'])"/>
                <t t-set="w" t-value="700.0 / max(n, 1)"/>
                <t t-foreach="s['dong']" t-as="d">
                    <rect t-att-x="w * d_index + w * 0.15"
                          t-att-y="118 - 104.0 * d['kwh'] / s['dinh']"
                          t-att-width="w * 0.70"
                          t-att-height="104.0 * d['kwh'] / s['dinh']"
                          fill="#0E8C99"/>
                    <text t-att-x="w * d_index + w * 0.5" y="128"
                          font-size="8" fill="#666" text-anchor="middle"
                          t-esc="d['gio'][:2]"/>
                </t>
            </svg>
            <table class="table table-sm table-borderless mb-0"
                   style="font-size:9px">
                <tr>
                    <td style="width:12%"><b>Giờ</b></td>
                    <t t-foreach="s['dong']" t-as="d">
                        <td class="text-end" t-esc="d['gio'][:2]"/>
                    </t>
                    <td class="text-end"><b>Tổng</b></td>
                </tr>
                <tr>
                    <td><b>kWh</b></td>
                    <t t-foreach="s['dong']" t-as="d">
                        <td class="text-end"
                            t-esc="'{:,.0f}'.format(d['kwh'])"/>
                    </t>
                    <td class="text-end">
                        <b t-esc="'{:,.0f}'.format(s['tong'])"/>
                    </td>
                </tr>
            </table>
            <div class="small text-muted">
                Khung <span t-esc="s['khung']"/> giờ tại nhà máy.
                Mỗi cột là TRUNG BÌNH công suất trong giờ nhân một giờ —
                cộng dồn số đo thì ra con số gấp mấy lần mà vẫn mang đơn
                vị kWh.
                <t t-if="s['ngoai_khung']">
                    <span t-esc="s['ngoai_khung']"/> giờ ngoài khung
                    không in, nên tổng ở đây nhỏ hơn sản lượng cả ngày.
                </t>
            </div>
        </div>
    </template>

    <!-- ============ Giờ dừng tách theo nguyên nhân ============ -->
    <template id="khoi_gio_nguyen_nhan">
        <t t-set="k" t-value="o.gio_nguyen_nhan()"/>
        <p t-if="not k['dong']" class="small text-muted mb-0">
            Không có khoảng dừng nào trong ngày.
        </p>
        <table t-if="k['dong']" class="table table-sm mb-0"
               style="font-size:10px">
            <thead>
                <tr>
                    <th>Nguyên nhân</th>
                    <th class="text-end">Số lần</th>
                    <th class="text-end">Giờ</th>
                    <th class="text-end">Sản lượng mất (kWh)</th>
                    <th t-if="k['co_tien']" class="text-end">Doanh thu mất</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="k['dong']" t-as="d">
                    <td t-esc="d['ten']"/>
                    <td class="text-end" t-esc="d['so']"/>
                    <td class="text-end" t-esc="'{:,.2f}'.format(d['gio'])"/>
                    <td class="text-end" t-esc="'{:,.1f}'.format(d['kwh'])"/>
                    <td t-if="k['co_tien']" class="text-end"
                        t-esc="'{:,.0f}'.format(d['tien'])"/>
                </tr>
                <tr style="border-top:1.5px solid #0F2C3F">
                    <td><b>Tổng</b></td>
                    <td class="text-end"><b t-esc="k['tong_so']"/></td>
                    <td class="text-end">
                        <b t-esc="'{:,.2f}'.format(k['tong_gio'])"/>
                    </td>
                    <td class="text-end">
                        <b t-esc="'{:,.1f}'.format(k['tong_kwh'])"/>
                    </td>
                    <td t-if="k['co_tien']"/>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- ====== Bảng tổ máy xoay ngang (tờ điện mặt trời) ====== -->
    <template id="khoi_bang_inverter">
        <t t-set="v" t-value="o.bang_inverter()"/>
        <p t-if="not v['do_duoc']" class="small text-muted mb-0">
            <span t-esc="v['ly_do']"/>
        </p>
        <div t-if="v['do_duoc']">
            <table class="table table-sm table-bordered mb-0"
                   style="font-size:7.5px">
                <thead class="bg-light">
                    <tr>
                        <th style="width:21%">Inverter</th>
                        <th class="text-end">Avg</th>
                        <th class="text-end" t-foreach="v['cot']" t-as="c"
                            t-esc="c"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="v['hang']" t-as="h">
                        <td t-esc="h['ten']"/>
                        <td class="text-end fw-bold" t-esc="h['tb']"/>
                        <t t-foreach="h['o']" t-as="x">
                            <td class="text-end">
                                <span t-if="x != '—'" t-esc="x"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
            <p class="small text-muted mb-0 mt-1">
                Cột <b>Avg</b> tính trên những bộ CÓ SỐ của chính chỉ tiêu
                đó, không trên tổng số bộ.
                <t t-if="v['thieu_dc']">
                    <b><span t-esc="v['thieu_dc']"/>/<span t-esc="v['so_may']"/>
                    bộ chưa có số phía một chiều</b> nên hai hàng DC và
                    hiệu suất để "—"<t t-if="v['ly_do_dc']">:
                    <span t-esc="v['ly_do_dc']"/></t>.
                </t>
            </p>
        </div>
    </template>

    <!-- ====== Công-tơ giao nhận: hôm qua · hôm nay · chênh ====== -->
    <template id="khoi_cong_to">
        <t t-set="k" t-value="o.cong_to_giao_nhan()"/>
        <p t-if="not k['do_duoc']" class="small text-muted mb-0">
            <span t-esc="k['ly_do']"/>
        </p>
        <table t-if="k['do_duoc']" class="table table-sm table-bordered mb-0"
               style="font-size:8px">
            <thead class="bg-light">
                <tr>
                    <th>Metering</th>
                    <th class="text-center">Unit</th>
                    <th class="text-end">Readings Yesterday</th>
                    <th class="text-end">Readings Today</th>
                    <th class="text-end">Output Today</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="k['dong']" t-as="d">
                    <td t-esc="d['ten']"/>
                    <td class="text-center" t-esc="d['dv']"/>
                    <td class="text-end">
                        <span t-if="d['hq'] is not None"
                              t-esc="'{:,.3f}'.format(d['hq'])"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end">
                        <span t-if="d['hn'] is not None"
                              t-esc="'{:,.3f}'.format(d['hn'])"/>
                        <span t-else="" class="text-muted">—</span>
                    </td>
                    <td class="text-end fw-bold">
                        <span t-if="d['ra'] is not None"
                              t-esc="'{:,.0f}'.format(d['ra'])"/>
                        <span t-else="" class="text-danger"
                              style="font-weight:normal" t-esc="d['vi']"/>
                    </td>
                </tr>
            </tbody>
        </table>
        <p t-if="k['do_duoc'] and k['so_thieu']"
           class="small text-muted mb-0 mt-1">
            <b><span t-esc="k['so_thieu']"/> công-tơ chưa tính được chênh</b>
            và để trống. Lấy số đọc gần nhất thay cho số đọc hôm qua là
            âm thầm cộng sản lượng nhiều ngày vào một ngày.
        </p>
    </template>

    <!-- ====== Cột sản lượng từng trụ + luỹ kế + tốc độ gió ====== -->
    <template id="khoi_bieu_do_to_may">
        <t t-set="v" t-value="o.bieu_do_to_may()"/>
        <p t-if="not v['do_duoc']" class="small text-muted mb-0">
            <span t-esc="v['ly_do']"/>
        </p>
        <div t-if="v['do_duoc']">
            <svg width="100%" height="140" viewBox="0 0 560 140"
                 preserveAspectRatio="none">
                <line x1="0" y1="124" x2="560" y2="124"
                      stroke="#999" stroke-width="1"/>
                <t t-set="n" t-value="len(v['cot'])"/>
                <t t-set="w" t-value="560.0 / max(n, 1)"/>
                <t t-foreach="v['cot']" t-as="c">
                    <rect t-if="c['sl'] is not None"
                          t-att-x="w * c_index + w * 0.18"
                          t-att-y="124 - 108.0 * c['sl'] / v['dinh_sl']"
                          t-att-width="w * 0.64"
                          t-att-height="108.0 * c['sl'] / v['dinh_sl']"
                          fill="#C0392B"/>
                    <text t-att-x="w * c_index + w * 0.5" y="135"
                          font-size="6" fill="#666" text-anchor="middle"
                          t-esc="c['ma']"/>
                </t>
                <polyline fill="none" stroke="#1F3864" stroke-width="1.4"
                          t-att-points="' '.join('%f,%f' % (
                              w * i + w * 0.5,
                              124 - 108.0 * c['lk'] / v['dinh_lk'])
                              for i, c in enumerate(v['cot']))"/>
                <polyline t-if="v['co_gio']" fill="none" stroke="#0E8C99"
                          stroke-width="1" stroke-dasharray="3,2"
                          t-att-points="' '.join('%f,%f' % (
                              w * i + w * 0.5,
                              124 - 108.0 * (c['gio'] or 0) / v['dinh_gio'])
                              for i, c in enumerate(v['cot']))"/>
            </svg>
            <div style="font-size:6.5px" class="text-muted">
                <span style="color:#C0392B">▮</span> Sản lượng hôm nay ·
                <span style="color:#1F3864">━</span> Luỹ kế tháng ·
                <span t-if="v['co_gio']" style="color:#0E8C99">╌</span>
                <span t-if="v['co_gio']">Tốc độ gió</span>
                — ba đơn vị khác nhau, mỗi đường chuẩn hoá theo đỉnh của
                CHÍNH NÓ. Đọc được HÌNH DÁNG (trụ nào thấp hơn đàn),
                không đọc được giá trị.
            </div>
        </div>
    </template>

    <!-- ====== Sản lượng trong tháng so với P50/P75/P90 ====== -->
    <template id="khoi_bieu_do_thang">
        <t t-set="m" t-value="o.bieu_do_thang()"/>
        <p t-if="not m['do_duoc']" class="small text-muted mb-0">
            <span t-esc="m['ly_do']"/>
        </p>
        <div t-if="m['do_duoc']">
            <svg width="100%" height="140" viewBox="0 0 560 140"
                 preserveAspectRatio="none">
                <line x1="0" y1="124" x2="560" y2="124"
                      stroke="#999" stroke-width="1"/>
                <t t-set="n" t-value="len(m['diem'])"/>
                <t t-set="w" t-value="560.0 / max(m['so_ngay'], 1)"/>
                <t t-foreach="m['diem']" t-as="d">
                    <rect t-att-x="w * d_index + w * 0.15"
                          t-att-y="124 - 108.0 * d['sl'] / m['dinh']"
                          t-att-width="w * 0.70"
                          t-att-height="108.0 * d['sl'] / m['dinh']"
                          fill="#C0392B"/>
                </t>
                <polyline fill="none" stroke="#1F3864" stroke-width="1.5"
                          t-att-points="' '.join('%f,%f' % (
                              w * i + w * 0.5,
                              124 - 108.0 * d['lk'] / m['dinh_lk'])
                              for i, d in enumerate(m['diem']))"/>
                <t t-foreach="[('p50','#1a9850'),('p75','#fd8d3c'),
                               ('p90','#999999')]" t-as="mk">
                    <polyline t-if="m['muc'].get(mk[0])" fill="none"
                              t-att-stroke="mk[1]" stroke-width="0.9"
                              stroke-dasharray="4,2"
                              t-att-points="' '.join('%f,%f' % (
                                  w * i + w * 0.5, 124 - 108.0 * y / m['dinh_lk'])
                                  for i, y in enumerate(m['muc'][mk[0]]))"/>
                </t>
                <t t-foreach="[1, m['so_ngay'] // 2, m['so_ngay']]" t-as="i">
                    <text t-att-x="w * (i - 0.5)" y="135" font-size="6"
                          fill="#666" text-anchor="middle" t-esc="i"/>
                </t>
            </svg>
            <div style="font-size:6.5px" class="text-muted">
                <span style="color:#C0392B">▮</span> Sản lượng ngày ·
                <span style="color:#1F3864">━</span> Luỹ kế ·
                <span style="color:#1a9850">╌</span> P50 ·
                <span style="color:#fd8d3c">╌</span> P75 ·
                <span style="color:#999">╌</span> P90.
                Mục tiêu vẽ thành đường luỹ kế CHIA ĐỀU theo ngày — so
                luỹ kế tới hôm nay với mục tiêu cả tháng thì tháng nào
                cũng trông như sắp trượt.
                <t t-if="m['thieu']"> <b><span t-esc="m['thieu']"/> ngày
                chưa có số</b> và vẽ bằng không.</t>
                <t t-if="m['ly_do_muc']"> Không vẽ được mục tiêu:
                <span t-esc="m['ly_do_muc']"/>.</t>
            </div>
        </div>
    </template>

</odoo>
