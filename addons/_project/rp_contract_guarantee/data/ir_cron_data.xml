<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_guarantee_expiry_alert" model="ir.cron">
        <field name="name">Bảo lãnh HĐ: cảnh báo sắp hết hạn</field>
        <field name="model_id" ref="model_rp_contract_guarantee"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall"
               eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
