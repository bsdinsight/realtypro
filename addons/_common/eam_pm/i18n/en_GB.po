#. module: eam_pm
#: code:addons/eam_pm/models/eam_pm_schedule.py:0
msgid "%s đã có lệnh đang mở (%s). Sinh thêm là có hai lệnh cùng một việc, và lần nào làm xong cũng không biết nên đóng cái nào."
msgstr "%s already has an open order (%s). Raising another means two orders for the same job, and whichever is finished, nobody knows which one to close."

#. module: eam_pm
#: model_terms:ir.ui.view,arch_db:eam_pm.view_eam_reliability_form
msgid ""
".\n"
"                        Để trống là <b>chưa đủ căn cứ</b>, không phải bằng 0."
msgstr ""
".\n"
"                        Empty means <b>not enough evidence</b>, not zero."

#. module: eam_pm
#: model_terms:ir.actions.act_window,help:eam_pm.action_eam_maint_kpi
msgid ""
"<b>KPI bảo trì</b> là câu hỏi về <b>bộ phận bảo trì</b>:\n"
"            sửa nhanh không (<b>MTTR</b>), máy nằm bao lâu\n"
"            (<b>MDT</b>), bao nhiêu phần của giờ nằm là <b>ngồi chờ</b>,\n"
"            và công việc là chủ động hay chạy theo sự cố\n"
"            (<b>% phòng ngừa</b>, <b>% bắt sớm</b>)."
msgstr ""
"<b>Maintenance KPIs</b> are a question about <b>the maintenance\n"
"            department</b>: is the repair quick (<b>MTTR</b>), how long is the\n"
"            machine down (<b>MDT</b>), what share of the downtime is\n"
"            <b>sitting waiting</b>, and is the work proactive or reactive\n"
"            (<b>% preventive</b>, <b>% caught early</b>)."

#. module: eam_pm
#: model_terms:ir.ui.view,arch_db:eam_pm.view_eam_season_form
msgid ""
"<b>Kiểm định bắt buộc</b> được báo xung đột\n"
"                                nhưng <b>không bao giờ bị dời</b>: hạn do\n"
"                                pháp luật đặt, quá hạn là phải dừng thiết\n"
"                                bị. Việc phải làm là chuẩn bị khác, không\n"
"                                phải hoãn.<br/>\n"
"                                <b>\"Nên làm trong mùa này\"</b> không gây dời\n"
"                                ngày — nếu cho nó quyền đó thì hệ thống sẽ\n"
"                                sẵn sàng đẩy việc lùi ba tuần để rơi vào mùa\n"
"                                đẹp, tức đúng hướng nguy hiểm."
msgstr ""
"A <b>mandatory statutory inspection</b> is reported as a\n"
"                                clash but is <b>never shifted</b>: its deadline\n"
"                                is set by law, and overrunning it means stopping\n"
"                                the equipment. The answer is different\n"
"                                preparation, not postponement.<br/>\n"
"                                <b>\"Best done in this season\"</b> never causes a\n"
"                                shift — give it that power and the system would\n"
"                                happily push work back three weeks to land in a\n"
"                                nicer season, which is exactly the dangerous\n"
"                                direction."

#. module: eam_pm
#: model_terms:ir.ui.view,arch_db:eam_pm.view_eam_reliability_form
msgid ""
"<b>MTBF</b> chia cho <b>giờ máy chạy</b>, không phải\n"
"                        giờ theo lịch — tua-bin đứng yên phần lớn thời gian,\n"
"                        lấy giờ lịch thì máy ít chạy trông lại bền hơn.<br/>\n"
"                        <b>MTTR</b> KHÔNG gồm giờ chờ cẩu, chờ vật tư, chờ\n"
"                        lặng gió; phần đó nằm ở <b>MDT</b>. Khoảng cách giữa\n"
"                        hai số là chi phí hậu cần, không phải tay nghề thợ."
msgstr ""
"<b>MTBF</b> divides by <b>running hours</b>, not calendar\n"
"                        hours — a turbine stands still most of the time, and on\n"
"                        calendar hours the one that runs least looks the most\n"
"                        reliable.<br/>\n"
"                        <b>MTTR</b> does NOT include hours waiting for a crane,\n"
"                        for materials, for the wind to drop; that part sits in\n"
"                        <b>MDT</b>. The gap between the two is the cost of\n"
"                        logistics, not of the fitters' skill."

#. module: eam_pm
#: model_terms:ir.actions.act_window,help:eam_pm.action_eam_reliability
msgid ""
"<b>Độ tin cậy</b> là câu hỏi về <b>cái máy</b>: trong kỳ\n"
"            này nó chạy bao nhiêu giờ, hỏng mấy lần, và trung bình chạy\n"
"            được bao lâu thì hỏng một lần (<b>MTBF</b>)."
msgstr ""
"<b>Reliability</b> is a question about <b>the machine</b>: how many\n"
"            hours it ran in the period, how many times it failed, and how long on\n"
"            average it runs between failures (<b>MTBF</b>)."

