<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Gói thầu ===== -->
    <record id="view_cn_tender_list" model="ir.ui.view">
        <field name="name">cn.tender.list</field>
        <field name="model">cn.tender</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('closed','cancelled')"
                  decoration-success="state == 'awarded'">
                <field name="name"/>
                <field name="gc_partner_id"/>
                <field name="specialty" optional="show"/>
                <field name="budget" optional="show"/>
                <field name="deadline"/>
                <field name="bid_count" string="Dự thầu"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'awarded'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cn_tender_form" model="ir.ui.view">
        <field name="name">cn.tender.form</field>
        <field name="model">cn.tender</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object"
                            string="Mở mời thầu" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Đóng thầu"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" type="object"
                            string="Hủy"
                            invisible="state in ('awarded','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,closed,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bids" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="bid_count" widget="statinfo"
                                   string="Dự thầu"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên gói thầu..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="gc_partner_id"/>
                            <field name="specialty"/>
                            <field name="budget"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_open"/>
                            <field name="deadline"/>
                            <field name="ref"/>
                            <field name="gc_source" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Mô tả / phạm vi..."/>
                    <notebook>
                        <page string="Hồ sơ dự thầu" name="bids">
                            <field name="bid_ids">
                                <list decoration-success="state == 'awarded'"
                                      decoration-muted="state == 'rejected'">
                                    <field name="contractor_id"/>
                                    <field name="price" sum="Σ"/>
                                    <field name="date_submit"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_award" type="object"
                                            string="Trao thầu" icon="fa-trophy"
                                            class="btn-link"
                                            invisible="state == 'awarded'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cn_tender_search" model="ir.ui.view">
        <field name="name">cn.tender.search</field>
        <field name="model">cn.tender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="gc_partner_id"/>
                <field name="specialty"/>
                <filter name="f_open" string="Đang mời thầu"
                        domain="[('state','=','open')]"/>
                <filter name="f_awarded" string="Đã trao thầu"
                        domain="[('state','=','awarded')]"/>
                <group>
                    <filter name="g_state" string="Trạng thái"
                            context="{'group_by':'state'}"/>
                    <filter name="g_gc" string="Tổng thầu"
                            context="{'group_by':'gc_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cn_tender" model="ir.actions.act_window">
        <field name="name">Gói thầu</field>
        <field name="res_model">cn.tender</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cn_tender_search"/>
    </record>

    <!-- ===== Hồ sơ dự thầu ===== -->
    <record id="view_cn_bid_list" model="ir.ui.view">
        <field name="name">cn.bid.list</field>
        <field name="model">cn.bid</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'awarded'"
                  decoration-muted="state == 'rejected'">
                <field name="tender_id"/>
                <field name="contractor_id"/>
                <field name="price" sum="Σ"/>
                <field name="date_submit"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_cn_bid_form" model="ir.ui.view">
        <field name="name">cn.bid.form</field>
        <field name="model">cn.bid</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_shortlist" type="object"
                            string="Vào danh sách ngắn"
                            invisible="state != 'submitted'"/>
                    <button name="action_award" type="object"
                            string="Trao thầu" class="btn-primary"
                            invisible="state == 'awarded'"/>
                    <button name="action_reject" type="object"
                            string="Loại"
                            invisible="state in ('awarded','rejected')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tender_id"/>
                            <field name="contractor_id"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_submit"/>
                            <field name="doc" filename="doc_filename"/>
                            <field name="doc_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Thuyết minh dự thầu..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cn_bid" model="ir.actions.act_window">
        <field name="name">Hồ sơ dự thầu</field>
        <field name="res_model">cn.bid</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
