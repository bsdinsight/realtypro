<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_eam_asset_tree" model="ir.actions.client">
        <field name="name">Sổ tài sản (lưới cây)</field>
        <field name="tag">eam_tree.asset_tree</field>
    </record>

    <record id="view_eam_asset_form_tree" model="ir.ui.view">
        <field name="name">eam.asset.form.treegrid</field>
        <field name="model">eam.asset</field>
        <field name="inherit_id" ref="eam_core.view_eam_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mo_luoi_cay" type="object"
                        class="oe_stat_button" icon="fa-table"
                        string="Lưới cây"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_eam_asset_tree" name="Sổ tài sản (lưới cây)"
              parent="eam_core.menu_eam_asset_group"
              action="action_eam_asset_tree" sequence="25"/>

</odoo>
