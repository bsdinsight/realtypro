<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Default Vietnamese construction specialties.
        noupdate="1": after initial install, user edits are preserved.

        Codes follow ASCII convention for stable references.
    -->

    <record id="specialty_mong" model="rp.contractor.specialty">
        <field name="code">MONG</field>
        <field name="name">Móng - Cọc</field>
        <field name="sequence">10</field>
        <field name="description">Cọc khoan nhồi, cọc ép, móng bê tông cốt thép.</field>
    </record>

    <record id="specialty_kct" model="rp.contractor.specialty">
