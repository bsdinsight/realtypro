<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit rp.structure form: thêm tab "Vay phân bổ" -->
    <record id="view_rp_structure_form_inherit_bridge" model="ir.ui.view">
        <field name="name">rp.structure.form.bridge</field>
        <field name="model">rp.structure</field>
        <field name="inherit_id" ref="rp_cost_base.view_rp_structure_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Vay phân bổ" name="loan_allocation">
                    <group>
                        <group>
                            <field name="loan_allocated_amount"/>
                            <field name="loan_allocation_count"/>
                        </group>
                    </group>
                    <field name="loan_allocation_ids" readonly="1">
                        <list>
                            <field name="note_id"/>
                            <field name="cost_category_id"/>
                            <field name="contract_id"/>
                            <field name="base"/>
                            <field name="method"/>
                            <field name="percent"/>
                            <field name="amount_allocated" sum="Σ"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
