<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view dossier (dialog) -->
    <record id="view_rp_loan_disbursement_dossier_form"
            model="ir.ui.view">
        <field name="name">rp.loan.disbursement.dossier.form</field>
        <field name="model">rp.loan.disbursement.dossier</field>
        <field name="arch" type="xml">
            <form string="Hồ sơ giải ngân">
                <sheet>
                    <group>
                        <group>
                            <field name="acceptance_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="contractor_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="amount"/>
                            <field name="description"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <separator string="Tài liệu đính kèm"/>
                    <field name="attachment_ids" widget="many2many_binary"
                           options="{'no_create_edit': True}"/>
                    <field name="disbursement_id" invisible="1"/>
                    <field name="state" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherit disbursement form: thêm tab Hồ sơ giải ngân -->
    <record id="view_re_loan_note_disbursement_form_inherit_dossier"
            model="ir.ui.view">
        <field name="name">re.loan.note.disbursement.form.dossier</field>
        <field name="model">re.loan.note.disbursement</field>
        <field name="inherit_id"
               ref="re_loan.view_re_loan_note_disbursement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Hồ sơ giải ngân" name="dossier">
                        <div class="alert alert-warning small" role="alert">
                            <i class="fa fa-exclamation-circle"
                               title="Bắt buộc"/>
                            <b>Để gửi NH duyệt</b>: mỗi hồ sơ cần Hóa đơn
                            (KTT đã post). BBNT là tùy chọn — có thể
                            gắn sau từ lịch thanh toán HĐ nhà thầu.
                            Σ giá trị hồ sơ phải = số tiền giải ngân.
                        </div>
                        <field name="dossier_line_ids"
                               readonly="state not in ('draft','submitted')">
                            <list>
                                <field name="acceptance_id"
                                       string="BBN nghiệm thu"/>
                                <field name="contractor_id" readonly="1"/>
                                <field name="contract_id" readonly="1"/>
                                <field name="invoice_id"
                                       string="Hóa đơn"/>
                                <field name="amount" sum="Σ"/>
                                <field name="description"/>
                                <field name="attachment_count"
                                       string="📎 File"
                                       optional="show"/>
                                <field name="currency_id"
                                       column_invisible="1"/>
                            </list>
                        </field>
                        <group>
                            <group>
                                <field name="dossier_total"/>
                                <field name="dossier_balance"
                                       decoration-danger="dossier_balance != 0"/>
                                <field name="dossier_count"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
