<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Gắn Hạng mục (AC) + Nhóm chi phí trên dòng vendor bill -->
    <record id="view_move_form_cost_actual" model="ir.ui.view">
        <field name="name">account.move.form.cost.actual</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                   position="after">
                <field name="structure_id"
                       string="Hạng mục (AC)"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                       options="{'no_create': True, 'no_quick_create': True}"
                       optional="show"/>
                <field name="cost_category_id"
                       string="Nhóm chi phí"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                       options="{'no_create': True, 'no_quick_create': True}"
                       optional="hide"/>
                <field name="cost_allocation_count"
                       string="Split"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                       optional="hide"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Phân bổ chi phí (AC)" name="cost_allocations"
                      invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="cost_allocation_ids">
                        <list editable="bottom">
                            <field name="move_line_id"
                                   options="{'no_create': True}"
                                   domain="[('move_id', '=', parent.id), ('display_type', '=', 'product')]"/>
                            <field name="structure_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="allowed_category_ids"
                                   column_invisible="1"/>
                            <field name="cost_category_id"
                                   options="{'no_create': True, 'no_quick_create': True}"
                                   optional="show"/>
                            <field name="amount" sum="Σ phân bổ"/>
                            <field name="note" optional="show"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Chia 1 dòng chi phí cho NHIỀU hạng mục (vd thuê cẩu
                        tháp dùng chung). Dòng hóa đơn CÓ phân bổ → AC tính
                        theo phân bổ; KHÔNG có → theo "Hạng mục (AC)" trên
                        dòng. Tổng phân bổ không vượt giá trị dòng.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
