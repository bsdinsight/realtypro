#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
msgid "thiếu ô bắt buộc: %s. Bỏ qua cả sheet — không ghi gì."
msgstr "a mandatory cell is missing: %s. The whole sheet is skipped — nothing is written."

#. module: eam_import
#: code:addons/eam_import/models/eam_import_run.py:0
